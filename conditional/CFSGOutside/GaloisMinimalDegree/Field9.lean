abbrev P9 := ℕ × ℕ
abbrev Q9 := P9 × P9 × P9 × P9

def pm (x y : P9) : P9 := ((x.1 * y.1 + 2 * (x.2 * y.2)) % 3, (x.1 * y.2 + x.2 * y.1) % 3)
def pa (x y : P9) : P9 := ((x.1 + y.1) % 3, (x.2 + y.2) % 3)
def pn (x : P9) : P9 := ((2 * x.1) % 3, (2 * x.2) % 3)

def mulQ (x y : Q9) : Q9 :=
  (pa (pm x.1 y.1) (pm x.2.1 y.2.2.1), pa (pm x.1 y.2.1) (pm x.2.1 y.2.2.2),
    pa (pm x.2.2.1 y.1) (pm x.2.2.2 y.2.2.1), pa (pm x.2.2.1 y.2.1) (pm x.2.2.2 y.2.2.2))

def invQ (x : Q9) : Q9 := (x.2.2.2, pn x.2.1, pn x.2.2.1, x.1)

def detQ (x : Q9) : P9 := pa (pm x.1 x.2.2.2) (pn (pm x.2.1 x.2.2.1))

