import CFSGOutside.Corpus.McLaughlinCentres
import CFSGOutside.Corpus.AlternatingTransvectionGeneration

/-!
# Hall, *Big symplectic or orthogonal monodromy modulo `ℓ`* (2008), Theorem 1.1, alternating case

C. Hall, Duke Math. J. 141 (2008), 179–203 (arXiv:math/0608718), Theorem 1.1: let `V` be an
`F_ℓ`-vector space with a perfect pairing and `G ≤ GL(V)` an irreducible primitive subgroup
preserving it. If the pairing is alternating, `G` contains a transvection and `ℓ ≥ 3`, then
`G = Sp(V)`.

Proof (Hall §3): the subgroup `R` generated by the transvections of `G` is irreducible
(Lemma 3.2 plus primitivity); over the prime field each transvection generates its whole root
group, so McLaughlin's theory applies: every nonzero vector is a centre of `R`; hence `R`
contains every symplectic transvection, which generate `Sp(V)`.
-/

namespace CFSGOutside.HallSymplectic

open Module
open LinearMap (BilinForm)
open CFSGOutside.Corpus CFSGOutside.Corpus.ClassicalGroups.McLaughlin
open CFSGOutside.Corpus.LocalAnalysis.ComponentInitial CFSGOutside.Corpus.ClassicalGroups.Alternating

section General

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- A *transvection*: `g = 1 + φ ⊗ v` with `v ≠ 0`, `φ ≠ 0`, `φ v = 0`. -/
def IsTransvection (g : LinearMap.GeneralLinearGroup K V) : Prop :=
  ∃ (v : V) (φ : Dual K V), v ≠ 0 ∧ φ ≠ 0 ∧ φ v = 0 ∧ (g : V →ₗ[K] V) = 1 + φ.smulRight v

/-- `W` is invariant under every element of `H`. -/
def IsInvariant (H : Subgroup (LinearMap.GeneralLinearGroup K V)) (W : Submodule K V) : Prop :=
  ∀ g ∈ H, ∀ w ∈ W, (g : V →ₗ[K] V) w ∈ W

/-- `G ≤ GL(V)` is *irreducible*: `V ≠ 0` and the only `G`-invariant subspaces are `0`, `V`. -/
def IsIrreducibleGroup (G : Subgroup (LinearMap.GeneralLinearGroup K V)) : Prop :=
  Nontrivial V ∧ ∀ W : Submodule K V, IsInvariant G W → W = ⊥ ∨ W = ⊤

/-- The set of `G`-translates `gW` of a subspace `W`. -/
def translates (G : Subgroup (LinearMap.GeneralLinearGroup K V)) (W : Submodule K V) :
    Set (Submodule K V) :=
  Set.range fun g : G => W.map ((g : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V)

/-- `G ≤ GL(V)` is *primitive* (Hall §3, after [CR, 12.D]): there is no nontrivial proper
subspace `W` such that `V` is the direct sum of the distinct `G`-translates of `W`. -/
def IsPrimitiveGroup (G : Subgroup (LinearMap.GeneralLinearGroup K V)) : Prop :=
  ∀ W : Submodule K V, W ≠ ⊥ → W ≠ ⊤ →
    ¬ (sSupIndep (translates G W) ∧ sSup (translates G W) = ⊤)

lemma gl_inv_apply_apply (g : LinearMap.GeneralLinearGroup K V) (x : V) :
    ((g⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) ((g : V →ₗ[K] V) x) = x := by
  rw [← Module.End.mul_apply, ← Units.val_mul, inv_mul_cancel, Units.val_one,
    Module.End.one_apply]

lemma gl_apply_inv_apply (g : LinearMap.GeneralLinearGroup K V) (x : V) :
    (g : V →ₗ[K] V) (((g⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) x) = x := by
  rw [← Module.End.mul_apply, ← Units.val_mul, mul_inv_cancel, Units.val_one,
    Module.End.one_apply]

lemma gl_mul_apply (g h : LinearMap.GeneralLinearGroup K V) (x : V) :
    ((g * h : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) x =
      (g : V →ₗ[K] V) ((h : V →ₗ[K] V) x) := rfl

lemma map_mul_eq (W : Submodule K V) (g h : LinearMap.GeneralLinearGroup K V) :
    W.map ((g * h : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) =
      (W.map (h : V →ₗ[K] V)).map (g : V →ₗ[K] V) := by
  rw [← Submodule.map_comp]; rfl

lemma finrank_map_gl [FiniteDimensional K V] (W : Submodule K V)
    (g : LinearMap.GeneralLinearGroup K V) :
    finrank K (W.map (g : V →ₗ[K] V)) = finrank K W := by
  have hinj : Function.Injective (g : V →ₗ[K] V) := fun x y h => by
    simpa [gl_inv_apply_apply] using congrArg ((g⁻¹ : LinearMap.GeneralLinearGroup K V) :
      V →ₗ[K] V) h
  exact LinearEquiv.finrank_eq (Submodule.equivMapOfInjective _ hinj W).symm

/-- A minimal nonzero invariant subspace inside a nonzero invariant subspace. -/
lemma exists_minimal [FiniteDimensional K V] (H : Subgroup (LinearMap.GeneralLinearGroup K V))
    (U : Submodule K V) (hU : U ≠ ⊥) (hUinv : IsInvariant H U) :
    ∃ W ≤ U, W ≠ ⊥ ∧ IsInvariant H W ∧
      ∀ W' ≤ W, IsInvariant H W' → W' = ⊥ ∨ W' = W := by
  classical
  have hex : ∃ n, ∃ W ≤ U, W ≠ ⊥ ∧ IsInvariant H W ∧ finrank K W = n :=
    ⟨_, U, le_rfl, hU, hUinv, rfl⟩
  obtain ⟨W, hWU, hW0, hWinv, hWn⟩ := Nat.find_spec hex
  refine ⟨W, hWU, hW0, hWinv, fun W' hW' hW'inv => ?_⟩
  by_cases h0 : W' = ⊥
  · exact Or.inl h0
  right
  have h1 : Nat.find hex ≤ finrank K W' :=
    Nat.find_min' hex ⟨W', hW'.trans hWU, h0, hW'inv, rfl⟩
  exact Submodule.eq_of_le_of_finrank_le hW' (hWn ▸ h1)

end General

section Form

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  {ω : BilinForm K V}

lemma alt_anti (hωalt : ω.IsAlt) (x y : V) : ω x y = - ω y x := by
  rw [← hωalt.neg_eq x y, neg_neg]

/-- A transvection `1 + φ ⊗ v` preserving a nondegenerate alternating form has
`φ = μ · ω(·, v)`. -/
lemma form_of_isometry (hωalt : ω.IsAlt) (hω : ω.Nondegenerate) {v : V} {φ : Dual K V}
    (hv : v ≠ 0) (hiso : ∀ x y, ω (x + φ x • v) (y + φ y • v) = ω x y) :
    ∃ μ : K, ∀ x, φ x = μ * ω x v := by
  have key : ∀ x y, φ y * ω x v = φ x * ω y v := by
    intro x y
    have h := hiso x y
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul,
      hωalt.self_eq_zero] at h
    rw [alt_anti hωalt v y] at h
    linear_combination h
  obtain ⟨x0, hx0⟩ : ∃ x0, ω x0 v ≠ 0 := by
    by_contra hc
    push Not at hc
    apply hv
    apply hω.1 v
    intro n
    rw [alt_anti hωalt, hc n, neg_zero]
  refine ⟨φ x0 / ω x0 v, fun y => ?_⟩
  field_simp
  linear_combination key x0 y

end Form

section Hall

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- The transvections of `G`. -/
def transvSet (G : Subgroup (LinearMap.GeneralLinearGroup K V)) :
    Set (LinearMap.GeneralLinearGroup K V) :=
  {t | t ∈ G ∧ IsTransvection t}

/-- The subgroup `R` of `G` generated by the transvections of `G`. -/
def transvGroup (G : Subgroup (LinearMap.GeneralLinearGroup K V)) :
    Subgroup (LinearMap.GeneralLinearGroup K V) :=
  Subgroup.closure (transvSet G)

variable {G : Subgroup (LinearMap.GeneralLinearGroup K V)}

lemma transvection_apply {t : LinearMap.GeneralLinearGroup K V} {v : V} {φ : Dual K V}
    (ht : (t : V →ₗ[K] V) = 1 + φ.smulRight v) (x : V) :
    (t : V →ₗ[K] V) x = x + φ x • v := by
  rw [ht]; simp [LinearMap.smulRight_apply]

lemma conj_mem_transvSet {g t : LinearMap.GeneralLinearGroup K V} (hg : g ∈ G)
    (ht : t ∈ transvSet G) : g * t * g⁻¹ ∈ transvSet G := by
  obtain ⟨htG, v, φ, hv, hφ, hφv, htv⟩ := ht
  refine ⟨G.mul_mem (G.mul_mem hg htG) (G.inv_mem hg), (g : V →ₗ[K] V) v,
    φ.comp ((g⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V), ?_, ?_, ?_, ?_⟩
  · intro h
    apply hv
    have := congrArg ((g⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) h
    rwa [gl_inv_apply_apply, map_zero] at this
  · intro h
    apply hφ
    ext y
    have := congrArg (fun ψ : Dual K V => ψ ((g : V →ₗ[K] V) y)) h
    simpa [gl_inv_apply_apply] using this
  · simp [gl_inv_apply_apply, hφv]
  · ext x
    simp only [gl_mul_apply, transvection_apply htv, map_add, map_smul, gl_apply_inv_apply,
      LinearMap.add_apply, Module.End.one_apply, LinearMap.smulRight_apply, LinearMap.comp_apply]

lemma transvGroup_le : transvGroup G ≤ G :=
  (Subgroup.closure_le _).2 fun _ ht => ht.1

lemma conj_mem_transvGroup {g r : LinearMap.GeneralLinearGroup K V} (hg : g ∈ G)
    (hr : r ∈ transvGroup G) : g * r * g⁻¹ ∈ transvGroup G := by
  induction hr using Subgroup.closure_induction with
  | mem t ht => exact Subgroup.subset_closure (conj_mem_transvSet hg ht)
  | one => simp
  | mul a b _ _ ha hb =>
    have : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [this]; exact Subgroup.mul_mem _ ha hb
  | inv a _ ha =>
    have : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [this]; exact Subgroup.inv_mem _ ha

lemma isInvariant_map {W : Submodule K V} (hW : IsInvariant (transvGroup G) W)
    {g : LinearMap.GeneralLinearGroup K V} (hg : g ∈ G) :
    IsInvariant (transvGroup G) (W.map (g : V →ₗ[K] V)) := by
  rintro r hr _ ⟨w, hw, rfl⟩
  have hc : g⁻¹ * r * g⁻¹⁻¹ ∈ transvGroup G := conj_mem_transvGroup (G.inv_mem hg) hr
  rw [inv_inv] at hc
  refine ⟨_, hW _ hc w hw, ?_⟩
  simp only [gl_mul_apply, gl_apply_inv_apply]

variable {ω : BilinForm K V}

/-- **Hall, Lemma 3.2.** If `W` is a minimal nonzero `R`-invariant subspace, then `V` is the
direct sum of the distinct `G`-translates of `W`. -/
lemma minimal_decomp [FiniteDimensional K V] (hωalt : ω.IsAlt) (hω : ω.Nondegenerate)
    (hGω : G ≤ bilinIsometryGroup ω) (hGirr : IsIrreducibleGroup G)
    (hT : ∃ t, t ∈ transvSet G) (W : Submodule K V)
    (hW0 : W ≠ ⊥) (hWinv : IsInvariant (transvGroup G) W)
    (hWmin : ∀ W' ≤ W, IsInvariant (transvGroup G) W' → W' = ⊥ ∨ W' = W) :
    sSupIndep (translates G W) ∧ sSup (translates G W) = ⊤ := by
  classical
  have hRG := transvGroup_le (G := G)
  have hiso : ∀ g ∈ G, ∀ x y, ω ((g : V →ₗ[K] V) x) ((g : V →ₗ[K] V) y) = ω x y :=
    fun g hg => hGω hg
  have hTR : ∀ t ∈ transvSet G, t ∈ transvGroup G := fun t ht => Subgroup.subset_closure ht
  -- (i) some transvection acts nontrivially on `W`
  have hS : ∃ t ∈ transvSet G, ∃ w ∈ W, (t : V →ₗ[K] V) w ≠ w := by
    by_contra hc
    push Not at hc
    let U : Submodule K V := ⨆ g : G, W.map ((g : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V)
    have hUinv : IsInvariant G U := by
      intro g0 hg0 x hx
      have hle : U ≤ U.comap (g0 : V →ₗ[K] V) := iSup_le fun g => by
        rintro _ ⟨w, hw, rfl⟩
        exact Submodule.mem_iSup_of_mem ⟨g0 * g, G.mul_mem hg0 g.2⟩ ⟨w, hw, rfl⟩
      exact hle hx
    have hWU : W ≤ U := by
      intro w hw
      exact Submodule.mem_iSup_of_mem (1 : G) ⟨w, hw, rfl⟩
    have hUtop : U = ⊤ := (hGirr.2 U hUinv).resolve_left fun h => hW0 (le_bot_iff.1 (h ▸ hWU))
    obtain ⟨t, ht⟩ := hT
    obtain ⟨htG, v, φ, hv, hφ, hφv, htv⟩ := ht
    have hfix : U ≤ LinearMap.ker ((t : V →ₗ[K] V) - 1) := by
      refine iSup_le fun g => ?_
      rintro _ ⟨w, hw, rfl⟩
      have hc' := hc _ (conj_mem_transvSet (G.inv_mem g.2) ⟨htG, v, φ, hv, hφ, hφv, htv⟩) w hw
      rw [inv_inv] at hc'
      simp only [gl_mul_apply] at hc'
      rw [LinearMap.mem_ker, LinearMap.sub_apply, Module.End.one_apply, sub_eq_zero]
      have := congrArg ((g : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) hc'
      rwa [gl_apply_inv_apply] at this
    obtain ⟨x, hx⟩ : ∃ x, φ x ≠ 0 := by
      by_contra h; push Not at h; exact hφ (LinearMap.ext h)
    have hxU : x ∈ U := hUtop ▸ Submodule.mem_top
    have := hfix hxU
    rw [LinearMap.mem_ker, LinearMap.sub_apply, Module.End.one_apply, sub_eq_zero,
      transvection_apply htv] at this
    exact smul_ne_zero hx hv (by simpa using this)
  -- (ii) the roots of transvections moving `W` span `W`
  let S : Set (LinearMap.GeneralLinearGroup K V) :=
    {t | t ∈ transvSet G ∧ ∃ w ∈ W, (t : V →ₗ[K] V) w ≠ w}
  have hroot : ∀ t ∈ S, ∃ v ∈ W, ∃ φ : Dual K V, v ≠ 0 ∧ φ ≠ 0 ∧ φ v = 0 ∧
      (t : V →ₗ[K] V) = 1 + φ.smulRight v ∧ ∃ w ∈ W, φ w ≠ 0 := by
    rintro t ⟨⟨htG, v, φ, hv, hφ, hφv, htv⟩, w, hw, htw⟩
    have hφw : φ w ≠ 0 := fun h => htw (by rw [transvection_apply htv, h, zero_smul, add_zero])
    have hvW : v ∈ W := by
      have h1 : (t : V →ₗ[K] V) w - w ∈ W := sub_mem (hWinv t (hTR t ⟨htG, v, φ, hv, hφ, hφv, htv⟩) w hw) hw
      rw [transvection_apply htv, add_sub_cancel_left] at h1
      have := W.smul_mem (φ w)⁻¹ h1
      rwa [smul_smul, inv_mul_cancel₀ hφw, one_smul] at this
    exact ⟨v, hvW, φ, hv, hφ, hφv, htv, w, hw, hφw⟩
  have hrange : ∀ t ∈ S, ∀ y, (t : V →ₗ[K] V) y - y ∈ W := by
    intro t htS y
    obtain ⟨v, hvW, φ, -, -, -, htv, -⟩ := hroot t htS
    rw [transvection_apply htv, add_sub_cancel_left]
    exact W.smul_mem _ hvW
  let U2 : Submodule K V := Submodule.span K {x | ∃ t ∈ S, ∃ y, x = (t : V →ₗ[K] V) y - y}
  have hU2W : U2 ≤ W := Submodule.span_le.2 (by rintro _ ⟨t, htS, y, rfl⟩; exact hrange t htS y)
  have hU2inv : IsInvariant (transvGroup G) U2 := by
    intro r hr x hx
    have hle : U2 ≤ U2.comap (r : V →ₗ[K] V) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨t, ⟨htT, w, hw, htw⟩, y, rfl⟩
      refine Submodule.subset_span ⟨r * t * r⁻¹, ⟨conj_mem_transvSet (hRG hr) htT,
        (r : V →ₗ[K] V) w, hWinv r hr w hw, ?_⟩, (r : V →ₗ[K] V) y, ?_⟩
      · simp only [gl_mul_apply, gl_inv_apply_apply]
        intro h
        apply htw
        have := congrArg ((r⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) h
        rwa [gl_inv_apply_apply, gl_inv_apply_apply] at this
      · simp only [gl_mul_apply, gl_inv_apply_apply, map_sub]
    exact hle hx
  have hU2ne : U2 ≠ ⊥ := by
    obtain ⟨t, htT, w, hw, htw⟩ := hS
    intro h
    have : (t : V →ₗ[K] V) w - w ∈ U2 := Submodule.subset_span ⟨t, ⟨htT, w, hw, htw⟩, w, rfl⟩
    rw [h, Submodule.mem_bot, sub_eq_zero] at this
    exact htw this
  have hU2 : U2 = W := (hWmin U2 hU2W hU2inv).resolve_left hU2ne
  -- (iii) `W` is nondegenerate
  have hrad : ∀ x ∈ W, (∀ u ∈ W, ω u x = 0) → x = 0 := by
    let Q : Submodule K V := W ⊓ ω.orthogonal W
    have hQinv : IsInvariant (transvGroup G) Q := by
      rintro r hr x ⟨hxW, hxo⟩
      refine ⟨hWinv r hr x hxW, ?_⟩
      rw [SetLike.mem_coe, LinearMap.BilinForm.mem_orthogonal_iff] at hxo ⊢
      intro n hn
      have h1 := hiso r (hRG hr) (((r⁻¹ : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) n) x
      rw [gl_apply_inv_apply] at h1
      change ω n _ = 0
      rw [h1]
      exact hxo _ (hWinv _ (Subgroup.inv_mem _ hr) n hn)
    rcases hWmin Q inf_le_left hQinv with h | h
    · intro x hxW hx
      have : x ∈ Q := ⟨hxW, (LinearMap.BilinForm.mem_orthogonal_iff).2 fun n hn => hx n hn⟩
      rw [h] at this
      exact (Submodule.mem_bot K).1 this
    · exfalso
      obtain ⟨t, htT, w, hw, htw⟩ := hS
      obtain ⟨v, hvW, φ, hv, hφ, hφv, htv, -⟩ := hroot t ⟨htT, w, hw, htw⟩
      have hφw : φ w ≠ 0 := fun h0 => htw (by rw [transvection_apply htv, h0, zero_smul, add_zero])
      obtain ⟨μ, hμ⟩ := form_of_isometry hωalt hω hv (fun x y => by
        rw [← transvection_apply htv, ← transvection_apply htv]; exact hiso t htT.1 x y)
      have hvQ : v ∈ Q := h ▸ hvW
      have : ω w v = 0 := (LinearMap.BilinForm.mem_orthogonal_iff).1 hvQ.2 w hw
      exact hφw (by rw [hμ, this, mul_zero])
  -- (iv) distinct translates are orthogonal to `W`
  have horth : ∀ g ∈ G, W.map (g : V →ₗ[K] V) ≠ W →
      ∀ x ∈ W.map (g : V →ₗ[K] V), ∀ u ∈ W, ω u x = 0 := by
    intro g hg hne x hx u hu
    have hdisj : W.map (g : V →ₗ[K] V) ⊓ W = ⊥ := by
      have hinv : IsInvariant (transvGroup G) (W.map (g : V →ₗ[K] V) ⊓ W) :=
        fun r hr y hy => ⟨isInvariant_map hWinv hg r hr y hy.1, hWinv r hr y hy.2⟩
      refine (hWmin _ inf_le_right hinv).resolve_right fun h => hne ?_
      have hle : W ≤ W.map (g : V →ₗ[K] V) := by
        intro y hy
        have : y ∈ W.map (g : V →ₗ[K] V) ⊓ W := by rw [h]; exact hy
        exact this.1
      exact (Submodule.eq_of_le_of_finrank_le hle (finrank_map_gl W g).le).symm
    have hfix : ∀ t ∈ S, (t : V →ₗ[K] V) x = x := by
      intro t htS
      have h1 : (t : V →ₗ[K] V) x - x ∈ W.map (g : V →ₗ[K] V) ⊓ W :=
        ⟨sub_mem (isInvariant_map hWinv hg t (hTR t htS.1) x hx) hx, hrange t htS x⟩
      rw [hdisj, Submodule.mem_bot, sub_eq_zero] at h1
      exact h1
    have hle : U2 ≤ LinearMap.ker (ω.flip x) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨t, htS, y, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub]
      have := hiso t htS.1.1 y x
      rw [hfix t htS] at this
      change ω _ x - ω y x = 0
      rw [this, sub_self]
    have := hle (hU2.symm ▸ hu)
    simpa using this
  -- (v) the distinct translates are pairwise orthogonal
  have hpair : ∀ g1 g2 : G, W.map ((g1 : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) ≠
      W.map ((g2 : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V) →
      ∀ a ∈ W.map ((g1 : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V),
      ∀ b ∈ W.map ((g2 : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V), ω a b = 0 := by
    intro g1 g2 hne a ha b hb
    set h : LinearMap.GeneralLinearGroup K V := (g1 : LinearMap.GeneralLinearGroup K V)⁻¹ * g2
    have hhG : h ∈ G := G.mul_mem (G.inv_mem g1.2) g2.2
    have hg2 : (g2 : LinearMap.GeneralLinearGroup K V) = g1 * h := by simp [h]
    have hhne : W.map (h : V →ₗ[K] V) ≠ W := by
      intro heq
      apply hne
      rw [hg2, map_mul_eq, heq]
    obtain ⟨m, hm, rfl⟩ := ha
    obtain ⟨w, hw, rfl⟩ := hb
    rw [hg2, gl_mul_apply, hiso _ g1.2]
    exact horth h hhG hhne _ ⟨w, hw, rfl⟩ m hm
  have hindep : sSupIndep (translates G W) := by
    rintro a ⟨g1, rfl⟩
    rw [Submodule.disjoint_def]
    intro x hx hxs
    have hle : sSup (translates G W \ {W.map ((g1 : LinearMap.GeneralLinearGroup K V) :
        V →ₗ[K] V)}) ≤ ω.orthogonal (W.map ((g1 : LinearMap.GeneralLinearGroup K V) :
        V →ₗ[K] V)) := by
      refine sSup_le ?_
      rintro b ⟨⟨g2, rfl⟩, hb⟩
      intro y hy
      rw [LinearMap.BilinForm.mem_orthogonal_iff]
      intro n hn
      exact hpair g1 g2 (fun h => hb (h ▸ rfl)) n hn y hy
    have hxo := (LinearMap.BilinForm.mem_orthogonal_iff).1 (hle hxs)
    obtain ⟨m, hm, rfl⟩ := hx
    have hm0 : m = 0 := hrad m hm fun u hu => by
      have := hxo _ ⟨u, hu, rfl⟩
      change ω _ _ = 0 at this
      rwa [hiso _ g1.2] at this
    rw [hm0, map_zero]
  have hsup : sSup (translates G W) = ⊤ := by
    rw [translates, sSup_range]
    set U := ⨆ g : G, W.map ((g : LinearMap.GeneralLinearGroup K V) : V →ₗ[K] V)
    have hUinv : IsInvariant G U := by
      intro g0 hg0 x hx
      have hle : U ≤ U.comap (g0 : V →ₗ[K] V) := iSup_le fun g => by
        rintro _ ⟨w, hw, rfl⟩
        exact Submodule.mem_iSup_of_mem ⟨g0 * g, G.mul_mem hg0 g.2⟩ ⟨w, hw, rfl⟩
      exact hle hx
    have hWU : W ≤ U := fun w hw => Submodule.mem_iSup_of_mem (1 : G) ⟨w, hw, rfl⟩
    exact (hGirr.2 U hUinv).resolve_left fun h => hW0 (le_bot_iff.1 (h ▸ hWU))
  exact ⟨hindep, hsup⟩

/-- **Hall, Lemma 3.2 + primitivity.** A minimal nonzero `R`-invariant subspace is all of
`V`. -/
lemma minimal_eq_top [FiniteDimensional K V] (hωalt : ω.IsAlt) (hω : ω.Nondegenerate)
    (hGω : G ≤ bilinIsometryGroup ω) (hGirr : IsIrreducibleGroup G)
    (hprim : IsPrimitiveGroup G) (hT : ∃ t, t ∈ transvSet G) (W : Submodule K V)
    (hW0 : W ≠ ⊥) (hWinv : IsInvariant (transvGroup G) W)
    (hWmin : ∀ W' ≤ W, IsInvariant (transvGroup G) W' → W' = ⊥ ∨ W' = W) : W = ⊤ := by
  by_contra hWtop
  exact hprim W hW0 hWtop (minimal_decomp hωalt hω hGω hGirr hT W hW0 hWinv hWmin)

/-- The transvection subgroup `R` is irreducible (Hall, Lemma 3.2 with primitivity). -/
lemma transvGroup_irred [FiniteDimensional K V] (hωalt : ω.IsAlt) (hω : ω.Nondegenerate)
    (hGω : G ≤ bilinIsometryGroup ω) (hGirr : IsIrreducibleGroup G)
    (hprim : IsPrimitiveGroup G) (hT : ∃ t, t ∈ transvSet G) : Irred (transvGroup G) := by
  intro U hU
  by_cases h0 : U = ⊥
  · exact Or.inl h0
  right
  obtain ⟨W, hWU, hW0, hWinv, hWmin⟩ := exists_minimal _ U h0 hU
  have := minimal_eq_top hωalt hω hGω hGirr hprim hT W hW0 hWinv hWmin
  exact top_le_iff.1 (this ▸ hWU)

end Hall

section PrimeField

variable {ℓ : ℕ} [Fact ℓ.Prime] {V : Type} [AddCommGroup V] [Module (ZMod ℓ) V]
  {G : Subgroup (LinearMap.GeneralLinearGroup (ZMod ℓ) V)}

/-- Over `F_ℓ` a transvection `1 + N` generates its root group: `(1 + N)^n = 1 + n N`. -/
lemma transvection_pow {t : LinearMap.GeneralLinearGroup (ZMod ℓ) V} {v : V}
    {φ : Dual (ZMod ℓ) V} (hφv : φ v = 0) (ht : (t : V →ₗ[ZMod ℓ] V) = 1 + φ.smulRight v)
    (n : ℕ) : ((t ^ n : LinearMap.GeneralLinearGroup (ZMod ℓ) V) : V →ₗ[ZMod ℓ] V) =
      1 + (n : ZMod ℓ) • φ.smulRight v := by
  have hNN : φ.smulRight v * φ.smulRight v = 0 := by
    ext x; simp [LinearMap.smulRight_apply, hφv]
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, Units.val_mul, ih, ht]
    rw [add_mul, mul_add, mul_add, one_mul, mul_one, one_mul, smul_mul_assoc, hNN, smul_zero,
      add_zero]
    push_cast
    rw [add_smul, one_smul]
    abel

lemma isRootElt_of_mem_transvSet {t : LinearMap.GeneralLinearGroup (ZMod ℓ) V} {v : V}
    {φ : Dual (ZMod ℓ) V} (htT : t ∈ transvSet G) (hφv : φ v = 0)
    (ht : (t : V →ₗ[ZMod ℓ] V) = 1 + φ.smulRight v) : IsRootElt (transvGroup G) v φ := by
  refine ⟨hφv, fun c => ⟨t ^ c.val, Subgroup.pow_mem _ (Subgroup.subset_closure htT) _, ?_⟩⟩
  rw [transvection_pow hφv ht, ZMod.natCast_zmod_val]

lemma genByRoots_transvGroup : GenByRoots (transvGroup G) := by
  apply le_antisymm
  · refine Subgroup.closure_mono ?_
    rintro t ⟨htG, v, φ, hv, hφ, hφv, htv⟩
    exact ⟨v, φ, hv, hφ, isRootElt_of_mem_transvSet ⟨htG, v, φ, hv, hφ, hφv, htv⟩ hφv htv, htv⟩
  · refine (Subgroup.closure_le _).2 ?_
    rintro g ⟨v, φ, -, -, hroot, hg⟩
    obtain ⟨g', hg', hg'eq⟩ := hroot.2 1
    have : g = g' := Units.ext (by rw [hg, hg'eq, one_smul])
    exact this ▸ hg'

/-- The last step of Hall's proof: if the transvection subgroup `R` of `G ≤ Sp(V)` is
irreducible, then `G = Sp(V)` (McLaughlin + generation of `Sp` by transvections). -/
theorem eq_symplectic_of_transvGroup_irred [McLaughlinCentres] [AlternatingTransvectionGeneration]
    [FiniteDimensional (ZMod ℓ) V] (hℓ : 3 ≤ ℓ)
    (ω : BilinForm (ZMod ℓ) V) (hω : ω.Nondegenerate) (hωalt : ω.IsAlt)
    (hGω : G ≤ bilinIsometryGroup ω) (hGirr : IsIrreducibleGroup G)
    (hirr : Irred (transvGroup G)) : G = bilinIsometryGroup ω := by
  classical
  have hgen : GenByRoots (transvGroup G) := genByRoots_transvGroup
  have hK : 3 ≤ Nat.card (ZMod ℓ) := by rw [Nat.card_zmod]; exact hℓ
  have hn : 2 ≤ finrank (ZMod ℓ) V := by
    haveI := hGirr.1
    obtain ⟨v, hv⟩ := exists_ne (0 : V)
    obtain ⟨x, hx⟩ : ∃ x, ω v x ≠ 0 := by
      by_contra h; push Not at h; exact hv (hω.1 v h)
    have hli : LinearIndependent (ZMod ℓ) ![v, x] := by
      rw [LinearIndependent.pair_iff]
      intro s t hst
      have h1 := congrArg (ω v) hst
      simp only [map_add, map_smul, smul_eq_mul, hωalt.self_eq_zero, mul_zero, zero_add,
        map_zero] at h1
      have ht : t = 0 := by
        rcases mul_eq_zero.1 h1 with h | h
        · exact h
        · exact absurd h hx
      subst ht
      rw [zero_smul, add_zero] at hst
      exact ⟨(smul_eq_zero.1 hst).resolve_right hv, rfl⟩
    simpa using hli.fintype_card_le_finrank
  have hRG := transvGroup_le (G := G)
  refine le_antisymm hGω ?_
  rw [AlternatingTransvectionGeneration.alternating_transvection_generation hωalt hω, Subgroup.closure_le]
  rintro _ ⟨a, c, rfl⟩
  by_cases ha : a = 0
  · subst ha
    have : symplecticTransvection ω hωalt 0 c = 1 :=
      Units.ext (LinearMap.ext fun x => by simp [symplecticTransvection_apply])
    rw [this]; exact G.one_mem
  obtain ⟨-, φ, hφ0, hroot⟩ := McLaughlinCentres.isCentre_of_ne_zero hK hn hgen hirr ha
  obtain ⟨g1, hg1, hg1eq⟩ := hroot.2 1
  rw [one_smul] at hg1eq
  obtain ⟨μ, hμ⟩ := form_of_isometry hωalt hω ha (fun x y => by
    rw [← transvection_apply hg1eq, ← transvection_apply hg1eq]; exact hGω (hRG hg1) x y)
  have hμ0 : μ ≠ 0 := by
    rintro rfl
    exact hφ0 (LinearMap.ext fun x => by simp [hμ x])
  obtain ⟨g, hg, hgeq⟩ := hroot.2 (c / μ)
  have : symplecticTransvection ω hωalt a c = g := by
    apply Units.ext
    apply LinearMap.ext
    intro x
    rw [symplecticTransvection_apply, hgeq]
    simp only [LinearMap.add_apply, Module.End.one_apply, LinearMap.smul_apply,
      LinearMap.smulRight_apply, smul_smul, hμ x]
    congr 2
    field_simp
  rw [this]
  exact hRG hg

/-- **Hall (2008), Theorem 1.1, alternating case.** "Let `V` be an `F_ℓ`-vector space together
with a perfect pairing `V × V → F_ℓ` and let `G ≤ GL(V)` be an irreducible primitive subgroup
which preserves the pairing. If the pairing is alternating, `G` contains a transvection, and
`ℓ ≥ 3`, then `G` is all of the symplectic group `Sp(V)`." -/
theorem eq_symplectic_of_primitive [McLaughlinCentres] [AlternatingTransvectionGeneration]
    [FiniteDimensional (ZMod ℓ) V] (hℓ : 3 ≤ ℓ)
    (ω : BilinForm (ZMod ℓ) V) (hω : ω.Nondegenerate) (hωalt : ω.IsAlt)
    (hGω : G ≤ bilinIsometryGroup ω) (hGirr : IsIrreducibleGroup G)
    (hprim : IsPrimitiveGroup G) (htv : ∃ g ∈ G, IsTransvection g) :
    G = bilinIsometryGroup ω := by
  have hT : ∃ t, t ∈ transvSet G := by
    obtain ⟨g, hg, hgt⟩ := htv; exact ⟨g, hg, hgt⟩
  exact eq_symplectic_of_transvGroup_irred hℓ ω hω hωalt hGω hGirr
    (transvGroup_irred hωalt hω hGω hGirr hprim hT)

end PrimeField

end CFSGOutside.HallSymplectic

