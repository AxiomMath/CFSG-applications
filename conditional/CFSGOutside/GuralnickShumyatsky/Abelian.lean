import CFSGOutside.Corpus.Gaschutz
import CFSGOutside.GuralnickShumyatsky.Coprime

/-!
# Abelian and central pieces of the induction (Sylow subgroups of abelian groups, Gaschütz,
Frattini)
-/

namespace CFSGOutside.GuralnickShumyatsky

open Subgroup

variable {X : Type} [Group X]

/-- In an abelian group `B` covered by subgroups `T i`, a Sylow subgroup of `B` is generated by
its intersections with the `T i`. -/
theorem isSylowOf_le_iSup_inf [Finite X] {p : ℕ} [Fact p.Prime] {B S : Subgroup X}
    (hB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x) (hS : IsSylowOf p S B) {ι : Type*}
    (T : ι → Subgroup X) (hTB : ∀ i, T i ≤ B) (hBT : B ≤ ⨆ i, T i) :
    S ≤ ⨆ i, S ⊓ T i := by
  have hp := hS.isPGroup
  have hm : ¬ p ∣ S.relIndex B := (isSylowOf_iff.mp hS).2.2
  have hSB := hS.le
  set m := S.relIndex B with hmdef
  have hNorm : (S.subgroupOf B).Normal := ⟨fun n hn g => by
    have : g * n * g⁻¹ = n := by
      rw [mul_inv_eq_iff_eq_mul]
      exact Subtype.ext (hB _ g.2 _ n.2)
    rw [this]; exact hn⟩
  have hpow : ∀ x ∈ B, x ^ m ∈ S := by
    intro x hx
    have := Subgroup.pow_index_mem (S.subgroupOf B) (⟨x, hx⟩ : B)
    exact (mem_subgroupOf.1 this)
  have key : ∀ x ∈ ⨆ i, T i, x ^ m ∈ ⨆ i, S ⊓ T i := by
    intro x hx
    have := Subgroup.iSup_induction (C := fun x => x ∈ B ∧ x ^ m ∈ ⨆ i, S ⊓ T i) T hx
      (fun i x hxi => ⟨hTB i hxi, le_iSup (fun i => S ⊓ T i) i
        ⟨hpow x (hTB i hxi), pow_mem hxi m⟩⟩)
      ⟨B.one_mem, by simp⟩
      (fun x y hx hy => ⟨B.mul_mem hx.1 hy.1, by
        rw [(show Commute x y from hB x hx.1 y hy.1).mul_pow]
        exact mul_mem hx.2 hy.2⟩)
    exact this.2
  intro x hx
  have hxB : x ∈ B := hSB hx
  have hk := key x (hBT hxB)
  obtain ⟨k, hk'⟩ := IsPGroup.iff_orderOf.1 hp (⟨x, hx⟩ : S)
  have hord : orderOf x = p ^ k := by simpa using hk'
  have hcop : m.Coprime (orderOf x) := by
    rw [hord]
    exact Nat.Coprime.pow_right k ((Nat.Prime.coprime_iff_not_dvd Fact.out).2 hm).symm
  obtain ⟨j, hj⟩ := exists_pow_eq_self_of_coprime hcop
  rw [← hj]
  exact pow_mem hk j

/-- The Sylow subgroup of an abelian normal subgroup is normal. -/
theorem isSylowOf_normal_of_comm [Finite X] {p : ℕ} [Fact p.Prime] {N S : Subgroup X} [N.Normal]
    (hN : ∀ x ∈ N, ∀ y ∈ N, x * y = y * x) (hS : IsSylowOf p S N) : S.Normal := by
  obtain ⟨Q, rfl⟩ := hS
  have hQN : Normal (Q : Subgroup N) := ⟨fun n hn g => by
    have : g * n * g⁻¹ = n := by
      rw [mul_inv_eq_iff_eq_mul]
      exact Subtype.ext (hN _ g.2 _ n.2)
    rw [this]; exact hn⟩
  haveI := hQN
  refine ⟨fun x hx g => ?_⟩
  obtain ⟨x', hx', rfl⟩ := mem_map.1 hx
  have hyN : g * (x' : X) * g⁻¹ ∈ N := Normal.conj_mem inferInstance _ x'.2 g
  obtain ⟨k, hk⟩ := IsPGroup.iff_orderOf.1 Q.isPGroup' (⟨x', hx'⟩ : Q)
  set yN : N := ⟨g * (x' : X) * g⁻¹, hyN⟩ with hy
  have hord : orderOf yN = p ^ k := by
    have h1 : orderOf (g * (x' : X) * g⁻¹) = orderOf (x' : X) :=
      orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective (x' : X)
    have h2 : orderOf (x' : X) = orderOf x' := Subgroup.orderOf_coe x'
    have h3 : orderOf x' = p ^ k := by
      rw [← hk]; exact Subgroup.orderOf_coe (⟨x', hx'⟩ : Q)
    have h4 : orderOf yN = orderOf (g * (x' : X) * g⁻¹) := (Subgroup.orderOf_coe yN).symm
    rw [h4, h1, h2, h3]
  have hpg : IsPGroup p (Subgroup.zpowers yN) :=
    IsPGroup.of_card (n := k) (by rw [Nat.card_zpowers, hord])
  obtain ⟨Q', hQ'⟩ := hpg.exists_le_sylow
  have hle : (Q : Subgroup N) ≤ Q' := Q.isPGroup'.le_sylow_of_normal Q'
  have hQ'Q : (Q' : Subgroup N) = Q := Q.is_maximal' Q'.isPGroup' hle
  exact ⟨yN, hQ'Q ▸ hQ' (Subgroup.mem_zpowers yN), rfl⟩

/-- Subgroups of a subgroup centralized by `G` are normalized by `G`. -/
theorem le_normalizer_of_le_of_commutator_eq_bot {G N M : Subgroup X} (hMN : M ≤ N)
    (hNG : ⁅N, G⁆ = ⊥) : G ≤ normalizer (M : Set X) := by
  have h : ∀ g ∈ G, ∀ m ∈ M, g * m * g⁻¹ = m := by
    intro g hg m hm
    have hc : m * g * m⁻¹ * g⁻¹ ∈ ⁅N, G⁆ := commutator_mem_commutator (hMN hm) hg
    rw [hNG, Subgroup.mem_bot] at hc
    rw [mul_inv_eq_iff_eq_mul]
    have : m * g = g * m := by
      have := congrArg (· * g * m) hc
      simpa [mul_assoc] using this
    exact this.symm
  intro g hg
  rw [mem_normalizer_iff]
  intro y
  constructor
  · intro hy; rw [h g hg y hy]; exact hy
  · intro hy
    have := h g⁻¹ (inv_mem hg) _ hy
    have e : g⁻¹ * (g * y * g⁻¹) * g⁻¹⁻¹ = y := by group
    rw [e] at this
    have h2 : g * y * g⁻¹ = y := this.symm
    rw [h2] at hy; exact hy

/-- The Frattini subgroup of `P`, as a subgroup of `X`, is normalized by whatever normalizes
`P`. -/
theorem le_normalizer_frattini {A P : Subgroup X} (hAP : A ≤ normalizer (P : Set X)) :
    A ≤ normalizer (((frattini P).map P.subtype : Subgroup X) : Set X) := by
  have key : ∀ a ∈ normalizer (P : Set X), ∀ x ∈ ((frattini P).map P.subtype : Subgroup X),
      a * x * a⁻¹ ∈ ((frattini P).map P.subtype : Subgroup X) := by
    intro a ha x hx
    obtain ⟨f, hf, rfl⟩ := mem_map.1 hx
    let φ : P ≃* P :=
      { toFun := fun x => ⟨a * x * a⁻¹, (mem_normalizer_iff.1 ha x).1 x.2⟩
        invFun := fun y => ⟨a⁻¹ * y * a, by
          have := (mem_normalizer_iff.1 (inv_mem ha) y).1 y.2
          simpa using this⟩
        left_inv := fun x => by ext; simp [mul_assoc]
        right_inv := fun x => by ext; simp [mul_assoc]
        map_mul' := fun x y => by ext; simp [mul_assoc] }
    have hc := (inferInstance : (frattini P).Characteristic).fixed φ
    have : φ f ∈ frattini P := by
      rw [← hc] at hf; exact hf
    exact mem_map.2 ⟨φ f, this, rfl⟩
  intro a ha0
  have ha := hAP ha0
  rw [mem_normalizer_iff]
  intro x
  constructor
  · exact fun hx => key a ha x hx
  · intro hx
    have := key a⁻¹ (inv_mem ha) _ hx
    simpa [mul_assoc] using this

theorem comm_central_left_aux {Y : Type*} [Group Y] (v l y : Y) (hv : ∀ g, g * v = v * g) :
    v * l * y * (v * l)⁻¹ * y⁻¹ = l * y * l⁻¹ * y⁻¹ := by
  have h := hv (l * y * l⁻¹)
  calc v * l * y * (v * l)⁻¹ * y⁻¹ = v * (l * y * l⁻¹) * v⁻¹ * y⁻¹ := by group
    _ = (l * y * l⁻¹) * v * v⁻¹ * y⁻¹ := by rw [← h]
    _ = _ := by group

theorem comm_central_right_aux {Y : Type*} [Group Y] (v l l' : Y) (hv : ∀ g, g * v = v * g) :
    l * (v * l') * l⁻¹ * (v * l')⁻¹ = l * l' * l⁻¹ * l'⁻¹ := by
  calc l * (v * l') * l⁻¹ * (v * l')⁻¹ = (l * v) * l' * l⁻¹ * l'⁻¹ * v⁻¹ := by group
    _ = (v * l) * l' * l⁻¹ * l'⁻¹ * v⁻¹ := by rw [hv l]
    _ = v * (l * l' * l⁻¹ * l'⁻¹) * v⁻¹ := by group
    _ = (l * l' * l⁻¹ * l'⁻¹) * v * v⁻¹ := by rw [← hv (l * l' * l⁻¹ * l'⁻¹)]
    _ = _ := by group

/-- From Gaschütz's theorem: a perfect group has no nontrivial central `p`-subgroup that is
complemented in a Sylow `p`-subgroup. -/
theorem no_central_complement [CFSGOutside.Corpus.Gaschutz.{0}] [Finite X] {p : ℕ} [Fact p.Prime]
    {G P V M : Subgroup X}
    (hP : IsSylowOf p P G) (hperf : ⁅G, G⁆ = G) (hVP : V ≤ P) (hVG : ⁅V, G⁆ = ⊥) (hV : V ≠ ⊥)
    (hMP : M ≤ P) (hVM : V ⊓ M = ⊥) (hVMP : V ⊔ M = P) : False := by
  have hVG' : V ≤ G := hVP.trans hP.le
  have hMG : M ≤ G := hMP.trans hP.le
  obtain ⟨Q, hQ⟩ := id hP
  set V' : Subgroup G := V.subgroupOf G with hV'
  set M' : Subgroup G := M.subgroupOf G with hM'
  have hcen : ∀ v ∈ V', ∀ g : G, g * v = v * g := by
    intro v hv g
    have hc : (v : X) * g * (v : X)⁻¹ * (g : X)⁻¹ ∈ ⁅V, G⁆ :=
      commutator_mem_commutator (mem_subgroupOf.1 hv) g.2
    rw [hVG, Subgroup.mem_bot] at hc
    apply Subtype.ext
    have : (v : X) * g = g * v := by
      have := congrArg (· * (g : X) * (v : X)) hc
      simpa [mul_assoc] using this
    exact this.symm
  haveI : V'.Normal := ⟨fun n hn g => by
    have : g * n * g⁻¹ = n := by
      rw [mul_inv_eq_iff_eq_mul]; exact hcen n hn g
    rw [this]; exact hn⟩
  haveI : IsMulCommutative V' := ⟨⟨fun a b => Subtype.ext (hcen a.1 a.2 b.1).symm⟩⟩
  have hVp : IsPGroup p V' := (hP.isPGroup.to_le hVP).comap_subtype
  have hmemQ : ∀ x : G, (x : X) ∈ P → x ∈ (Q : Subgroup G) := by
    intro x hx
    rw [← hQ] at hx
    obtain ⟨y, hy, hyx⟩ := mem_map.1 hx
    have : y = x := Subtype.ext hyx
    exact this ▸ hy
  have hMQ : M' ≤ (Q : Subgroup G) := fun x hx => hmemQ x (hMP (mem_subgroupOf.1 hx))
  have hVQ : V' ≤ (Q : Subgroup G) := fun x hx => hmemQ x (hVP (mem_subgroupOf.1 hx))
  have hinf : V' ⊓ M' = ⊥ := by
    rw [eq_bot_iff]
    intro x ⟨h1, h2⟩
    have : (x : X) ∈ V ⊓ M := ⟨mem_subgroupOf.1 h1, mem_subgroupOf.1 h2⟩
    rw [hVM, Subgroup.mem_bot] at this
    exact Subgroup.mem_bot.2 (Subtype.ext this)
  have hsup : V' ⊔ M' = (Q : Subgroup G) := by
    apply le_antisymm (sup_le hVQ hMQ)
    intro x hx
    have h1 : (x : X) ∈ P := by
      rw [← hQ]; exact ⟨x, hx, rfl⟩
    rw [← hVMP] at h1
    have h2 : x ∈ (V ⊔ M).subgroupOf G := mem_subgroupOf.2 h1
    rw [subgroupOf_sup hVG' hMG] at h2
    exact h2
  obtain ⟨L, hL1, hL2⟩ := (CFSGOutside.Corpus.Gaschutz.gaschutz hVp Q).2 ⟨M', hMQ, hinf, hsup⟩
  have hcomm : ⁅(⊤ : Subgroup G), ⊤⁆ ≤ L := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    have hx : x ∈ ((V' ⊔ L : Subgroup G) : Set G) := by rw [hL2]; trivial
    have hy : y ∈ ((V' ⊔ L : Subgroup G) : Set G) := by rw [hL2]; trivial
    rw [Subgroup.normal_mul] at hx hy
    obtain ⟨v, hv, l, hl, rfl⟩ := hx
    obtain ⟨v', hv', l', hl', rfl⟩ := hy
    show v * l * (v' * l') * (v * l)⁻¹ * (v' * l')⁻¹ ∈ L
    rw [comm_central_left_aux v l _ (hcen v hv), comm_central_right_aux v' l l' (hcen v' hv')]
    exact mul_mem (mul_mem (mul_mem hl hl') (inv_mem hl)) (inv_mem hl')
  have htop : ⁅(⊤ : Subgroup G), ⊤⁆ = (⊤ : Subgroup G) := by
    apply Subgroup.map_injective G.subtype_injective
    rw [Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype, hperf]
  have hLtop : L = ⊤ := top_le_iff.1 (htop ▸ hcomm)
  rw [hLtop, inf_top_eq] at hL1
  apply hV
  rw [eq_bot_iff]
  intro x hx
  have : (⟨x, hVG' hx⟩ : G) ∈ V' := mem_subgroupOf.2 hx
  rw [hL1, Subgroup.mem_bot] at this
  exact Subgroup.mem_bot.2 (congrArg Subtype.val this)

/-- The central case at the end of the proof of Theorem 3.1. -/
theorem central_case [CFSGOutside.Corpus.Gaschutz.{0}] [Finite X] {p : ℕ} [Fact p.Prime]
    {G P N R : Subgroup X}
    (hP : IsSylowOf p P G) (hperf : ⁅G, G⁆ = G) (hNP : N ≤ P) (hNG : ⁅N, G⁆ = ⊥) (hN : N ≠ ⊥)
    (hR : R ≤ P) (hPR : P ≤ R ⊔ N)
    (hΦ : N ⊓ (frattini P).map P.subtype = ⊥ ∨ N ≤ (frattini P).map P.subtype) : P ≤ R := by
  have hPp := hP.isPGroup
  have hPG := hP.le
  rcases hΦ with h0 | hle
  · exfalso
    have hNp : IsPGroup p N := hPp.to_le hNP
    haveI : Nontrivial N := (Subgroup.nontrivial_iff_ne_bot N).2 hN
    have hdvd : p ∣ Nat.card N := by
      rcases hNp.card_eq_or_dvd with h | h
      · exact absurd (Subgroup.card_eq_one.1 h) hN
      · exact h
    obtain ⟨zN, hzN⟩ := exists_prime_orderOf_dvd_card' p hdvd
    set z : X := (zN : X) with hzdef
    have hzo : orderOf z = p := by rw [hzdef, Subgroup.orderOf_coe]; exact hzN
    have hzNm : z ∈ N := zN.2
    set zP : P := ⟨z, hNP hzNm⟩ with hzP
    have hz1 : z ≠ 1 := by
      intro h; rw [h, orderOf_one] at hzo; exact (Fact.out : p.Prime).one_lt.ne hzo
    have hzΦ : z ∉ ((frattini P).map P.subtype : Subgroup X) := by
      intro hmem
      have : z ∈ N ⊓ (frattini P).map P.subtype := ⟨hzNm, hmem⟩
      rw [h0, Subgroup.mem_bot] at this
      exact hz1 this
    have hzP' : zP ∉ frattini P := fun h => hzΦ (mem_map.2 ⟨zP, h, rfl⟩)
    have hco : ∃ M₀ : Subgroup P, IsCoatom M₀ ∧ zP ∉ M₀ := by
      by_contra hcon
      push Not at hcon
      apply hzP'
      rw [frattini, Order.radical]
      simp only [Subgroup.mem_iInf, Set.mem_setOf_eq]
      exact fun H hH => hcon H hH
    obtain ⟨M₀, hM₀, hzM⟩ := hco
    set V : Subgroup X := zpowers z with hVdef
    have hVN : V ≤ N := (zpowers_le).2 hzNm
    have hVP : V ≤ P := hVN.trans hNP
    have hVG : ⁅V, G⁆ = ⊥ := eq_bot_iff.2 ((Subgroup.commutator_mono hVN le_rfl).trans hNG.le)
    have hV : V ≠ ⊥ := fun h => hz1 (Subgroup.zpowers_eq_bot.1 h)
    set M : Subgroup X := M₀.map P.subtype with hMdef
    have hMP : M ≤ P := map_subtype_le _
    have hVMP : V ⊔ M = P := by
      have h1 : zpowers zP ⊔ M₀ = ⊤ := by
        apply hM₀.2
        refine lt_of_le_of_ne le_sup_right (fun h => hzM ?_)
        rw [h]; exact (le_sup_left : zpowers zP ≤ zpowers zP ⊔ M₀) (Subgroup.mem_zpowers zP)
      have h2 := congrArg (Subgroup.map P.subtype) h1
      rw [Subgroup.map_sup, MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
        Subgroup.range_subtype] at h2
      exact h2
    have hVM : V ⊓ M = ⊥ := by
      rw [eq_bot_iff]
      intro y ⟨hyV, hyM⟩
      rw [Subgroup.mem_bot]
      have hyp : y ^ p = 1 := by
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hyV
        rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ← hzo, pow_orderOf_eq_one,
          one_zpow]
      have hd : orderOf y ∣ p := orderOf_dvd_of_pow_eq_one hyp
      rcases (Fact.out : p.Prime).eq_one_or_self_of_dvd _ hd with h | h
      · exact orderOf_eq_one_iff.1 h
      · exfalso
        have hle : zpowers y ≤ V := (zpowers_le).2 hyV
        have heq : zpowers y = V := by
          apply Subgroup.eq_of_le_of_card_ge hle
          rw [Nat.card_zpowers, Nat.card_zpowers, h, hzo]
        have hzy : z ∈ zpowers y := heq ▸ Subgroup.mem_zpowers z
        have hzM' : z ∈ M := (zpowers_le).2 hyM hzy
        obtain ⟨w, hw, hwz⟩ := mem_map.1 hzM'
        have : w = zP := Subtype.ext hwz
        exact hzM (this ▸ hw)
    exact no_central_complement hP hperf hVP hVG hV hMP hVM hVMP
  · have hR' : R.subgroupOf P ⊔ frattini P = ⊤ := by
      apply Subgroup.map_injective P.subtype_injective
      rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hR, ← MonoidHom.range_eq_map,
        Subgroup.range_subtype]
      exact le_antisymm (sup_le hR (map_subtype_le _)) (hPR.trans (sup_le_sup_left hle _))
    have h := frattini_nongenerating hR'
    intro x hx
    have : (⟨x, hx⟩ : P) ∈ R.subgroupOf P := h ▸ Subgroup.mem_top _
    exact this

end CFSGOutside.GuralnickShumyatsky
