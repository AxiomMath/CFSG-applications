import CFSGOutside.GuralnickShumyatsky.Cor
import CFSGOutside.GuralnickShumyatsky.Count

/-!
# Guralnick–Shumyatsky, Corollary 3.5: generator counts
-/

namespace CFSGOutside.GuralnickShumyatsky

open Subgroup

/-- **Guralnick–Shumyatsky, Corollary 3.5.** If `A` is elementary abelian of order `q³` acting
coprimely on the finite group `G` and each `C_G(a)'` (`a ∈ A#`) can be generated by at most `m`
elements, then `G'` can be generated by at most `m(q² + q + 1)` elements. -/
theorem corollary_3_5 [CFSGOutside.Corpus.Proposition116B.{0, 0}]
    [CFSGOutside.Corpus.CfsgClassification] [CFSGOutside.Corpus.I713PPrimeHolds]
    [CFSGOutside.Corpus.OddOrder.{0}] [CFSGOutside.Corpus.Gaschutz.{0}]
    [CFSGOutside.Corpus.MinimalNormalSimpleFactors.{0}]
    [CFSGOutside.Corpus.ExistsIsSylowOfNormalizedGeOfCoprime.{0}]
    [CFSGOutside.Corpus.ExistsConjEqOfIsSylowOfNormalizedOfCoprime.{0}]
    [CFSGOutside.Corpus.ExistsIsSylowOfNormalizedOfCoprime.{0}]
    {X : Type} [Group X] [Finite X] {q m : ℕ} {G A : Subgroup X}
    (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3)
    (hm : ∀ a ∈ A, a ≠ 1 → ∃ s : Finset X, s.card ≤ m ∧
      closure (s : Set X) = ⁅cen G a, cen G a⁆) :
    ∃ s : Finset X, s.card ≤ m * (q ^ 2 + q + 1) ∧ closure (s : Set X) = ⁅G, G⁆ := by
  classical
  have hB : ∀ B ∈ cycSubs A, ∃ s : Finset X, s.card ≤ m ∧
      closure (s : Set X) = ⁅cenS G B, cenS G B⁆ := by
    intro B hB
    obtain ⟨a, ha, ha1, rfl⟩ := mem_cycSubs.mp hB
    rw [← cen_eq_cenS]
    exact hm a ha ha1
  choose! t ht using hB
  refine ⟨(cycSubs A).biUnion t, ?_, ?_⟩
  · calc ((cycSubs A).biUnion t).card ≤ ∑ B ∈ cycSubs A, (t B).card := Finset.card_biUnion_le
      _ ≤ ∑ _B ∈ cycSubs A, m := Finset.sum_le_sum fun B hB => (ht B hB).1
      _ = m * (q ^ 2 + q + 1) := by
        rw [Finset.sum_const, card_cycSubs hA hA3, smul_eq_mul, mul_comm]
  · rw [corollary_3_4 hA hA3, iSup_eq_iSup_cycSubs, Finset.coe_biUnion, Subgroup.closure_iUnion]
    refine iSup_congr fun B => ?_
    rw [Subgroup.closure_iUnion]
    refine iSup_congr fun hB => ?_
    exact (ht B hB).2

end CFSGOutside.GuralnickShumyatsky

