import CFSGOutside.Corpus.MinimalNormalSimpleFactors
import CFSGOutside.Corpus.OddOrder
import CFSGOutside.Corpus.Schreier
import CFSGOutside.KurdachenkoShumyatsky.Defs

/-!
# Kurdachenko–Shumyatsky, *The ranks of central factor and commutator groups*, Lemma `schrei`

Let `G` be a finite group of rank `r` with no nontrivial normal soluble subgroups. Then `G` has a
normal series `M ≤ T ≤ G` such that `M` is isomorphic to a direct product of at most `r`
non-abelian simple groups, `T/M` is soluble and `|G/T| ≤ r!`.

Here `M` is the product of the non-abelian simple subgroups of the socle normalised by the socle
(the simple factors of the minimal normal subgroups), and `T` is the kernel of the conjugation
action of `G` on this set of factors. Schreier's conjecture (a corpus theorem, via the
classification) gives that `T/M` is soluble, and the Feit–Thompson theorem (a corpus theorem)
gives an involution in every factor, which bounds the number of factors by the rank.
-/

namespace CFSGOutside.KurdachenkoShumyatsky

open Subgroup Pointwise CFSGOutside.Corpus CFSGOutside.Corpus.ComponentClassification

section Basic

variable {G : Type*} [Group G]

/-- Every element of `A` normalises `K`. -/
def NormBy (A K : Subgroup G) : Prop := ∀ a ∈ A, ∀ k ∈ K, a * k * a⁻¹ ∈ K

/-- `K` is a non-abelian simple group. -/
def NonabSimple (K : Subgroup G) : Prop := IsSimpleGroup K ∧ ∃ a b : K, a * b ≠ b * a

/-- `N` is a minimal normal subgroup of `G`. -/
def IsMinNormal (N : Subgroup G) : Prop :=
  N.Normal ∧ N ≠ ⊥ ∧ ∀ M : Subgroup G, M.Normal → M ≤ N → M = ⊥ ∨ M = N

variable (G) in
/-- The socle: the subgroup generated by the minimal normal subgroups. -/
def socle : Subgroup G := sSup {N : Subgroup G | IsMinNormal N}

theorem NormBy.mono {A A' K : Subgroup G} (h : NormBy A K) (hA : A' ≤ A) : NormBy A' K :=
  fun a ha k hk => h a (hA ha) k hk

theorem NormBy.inf {A K L : Subgroup G} (hK : NormBy A K) (hL : NormBy A L) :
    NormBy A (K ⊓ L) :=
  fun a ha _ hk => ⟨hK a ha _ hk.1, hL a ha _ hk.2⟩

theorem NormBy.iSup {ι : Sort*} {A : Subgroup G} {H : ι → Subgroup G}
    (h : ∀ i, NormBy A (H i)) : NormBy A (⨆ i, H i) := by
  intro a ha k hk
  refine Subgroup.iSup_induction H (C := fun x => a * x * a⁻¹ ∈ ⨆ i, H i) hk
    (fun i x hx => Subgroup.mem_iSup_of_mem i (h i a ha x hx)) (by simp) ?_
  intro x y hx hy
  have : a * (x * y) * a⁻¹ = (a * x * a⁻¹) * (a * y * a⁻¹) := by group
  rw [this]
  exact mul_mem hx hy

theorem NormBy.smul_eq {A K : Subgroup G} (h : NormBy A K) {a : G} (ha : a ∈ A) :
    ConjAct.toConjAct a • K = K := by
  ext x
  rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem, ConjAct.smul_def]
  simp only [ConjAct.ofConjAct_inv, ConjAct.ofConjAct_toConjAct, inv_inv]
  constructor
  · intro hx
    have := h a ha _ hx
    simpa [mul_assoc] using this
  · intro hx
    simpa using h a⁻¹ (inv_mem ha) x hx

theorem conj_mem_of_smul_eq {K : Subgroup G} {t : G} (h : ConjAct.toConjAct t • K = K) {k : G}
    (hk : k ∈ K) : t * k * t⁻¹ ∈ K := by
  have := Subgroup.smul_mem_pointwise_smul k (ConjAct.toConjAct t) K hk
  rw [h, ConjAct.smul_def] at this
  simpa using this

/-- If a set of subgroups is stable under conjugation, its supremum is normal. -/
theorem normal_sSup_of_smul_mem {𝒮 : Set (Subgroup G)}
    (h : ∀ K ∈ 𝒮, ∀ g : ConjAct G, g • K ∈ 𝒮) : (sSup 𝒮).Normal := by
  constructor
  intro n hn g
  have key : ∀ K ∈ 𝒮, ∀ x ∈ K, g * x * g⁻¹ ∈ sSup 𝒮 := by
    intro K hK x hx
    have := Subgroup.smul_mem_pointwise_smul x (ConjAct.toConjAct g) K hx
    rw [ConjAct.smul_def] at this
    simpa using (le_sSup (h K hK (ConjAct.toConjAct g)) : _ ≤ sSup 𝒮) this
  rw [sSup_eq_iSup'] at hn ⊢
  refine Subgroup.iSup_induction _ (C := fun x => g * x * g⁻¹ ∈ ⨆ K : 𝒮, (K : Subgroup G)) hn
    (fun K x hx => by
      have := key K K.2 x hx
      rwa [sSup_eq_iSup'] at this) (by simp) ?_
  intro x y hx hy
  have : g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) := by group
  rw [this]
  exact mul_mem hx hy

theorem socle_normal : (socle G).Normal :=
  normal_sSup_of_smul_mem fun N hN g => by
    have : N.Normal := hN.1
    rw [this.conjAct g]
    exact hN

theorem commute_of_normal_of_inf_eq_bot {N N' : Subgroup G} [N.Normal] [N'.Normal]
    (h : N ⊓ N' = ⊥) {x y : G} (hx : x ∈ N) (hy : y ∈ N') : Commute x y := by
  have h1 : x * y * x⁻¹ * y⁻¹ ∈ N ⊓ N' := by
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · have : x * y * x⁻¹ * y⁻¹ = x * (y * x⁻¹ * y⁻¹) := by group
      rw [this]
      exact mul_mem hx (Normal.conj_mem inferInstance _ (inv_mem hx) y)
    · exact mul_mem (Normal.conj_mem inferInstance _ hy x) (inv_mem hy)
  rw [h, mem_bot] at h1
  calc x * y = (x * y * x⁻¹ * y⁻¹) * (y * x) := by group
    _ = y * x := by rw [h1, one_mul]

theorem IsMinNormal.inf_eq_bot {N N' : Subgroup G} (hN : IsMinNormal N) (hN' : IsMinNormal N')
    (hne : N ≠ N') : N ⊓ N' = ⊥ := by
  have : N.Normal := hN.1
  have : N'.Normal := hN'.1
  rcases hN.2.2 (N ⊓ N') inferInstance inf_le_left with h | h
  · exact h
  · rcases hN'.2.2 N inferInstance (h ▸ inf_le_right) with h' | h'
    · exact absurd h' hN.2.1
    · exact absurd h' hne

end Basic

section Factors

variable {G : Type} [Group G] [Finite G]

variable (G) in
/-- The non-abelian simple subgroups of the socle normalised by the socle. -/
def factors : Set (Subgroup G) :=
  {K | NonabSimple K ∧ K ≤ socle G ∧ NormBy (socle G) K}

theorem factors_smul {K : Subgroup G} (hK : K ∈ factors G) (g : ConjAct G) :
    g • K ∈ factors G := by
  obtain ⟨⟨hs, a, b, hab⟩, hle, hnorm⟩ := hK
  have hsoc : (socle G).Normal := socle_normal
  let e := Subgroup.equivSMul g K
  refine ⟨⟨e.symm.isSimpleGroup, e a, e b, fun h => hab ?_⟩, ?_, ?_⟩
  · simpa using congrArg e.symm h
  · intro x hx
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hx
    have := hle hx
    have h2 := Subgroup.smul_mem_pointwise_smul _ g _ this
    rwa [hsoc.conjAct g, smul_inv_smul] at h2
  · intro s hs x hx
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem] at hx ⊢
    have hs' : g⁻¹ • s ∈ socle G := by
      have := Subgroup.smul_mem_pointwise_smul _ g⁻¹ _ hs
      rwa [hsoc.conjAct] at this
    have := hnorm _ hs' _ hx
    simpa [smul_mul', smul_inv'] using this

theorem factor_absorb {K L : Subgroup G} (hK : K ∈ factors G) (hLK : L ≤ K)
    (hL : NormBy K L) : L = ⊥ ∨ L = K := by
  have hs : IsSimpleGroup K := hK.1.1
  have hn : (L.subgroupOf K).Normal := ⟨fun n hn g => by
    rw [mem_subgroupOf] at hn ⊢
    simpa using hL g g.2 n hn⟩
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (L.subgroupOf K) with h | h
  · left
    rw [subgroupOf_eq_bot] at h
    exact h.eq_bot_of_le hLK
  · right
    rw [subgroupOf_eq_top] at h
    exact le_antisymm hLK h

theorem factor_ne_bot {K : Subgroup G} (hK : K ∈ factors G) : K ≠ ⊥ := by
  have hs : IsSimpleGroup K := hK.1.1
  exact (Subgroup.nontrivial_iff_ne_bot K).mp inferInstance

theorem factors_inf_eq_bot {K K' : Subgroup G} (hK : K ∈ factors G) (hK' : K' ∈ factors G)
    (hne : K ≠ K') : K ⊓ K' = ⊥ := by
  rcases factor_absorb hK inf_le_left ((hK.2.2.inf hK'.2.2).mono hK.2.1) with h | h
  · exact h
  · have hle : K ≤ K' := h ▸ inf_le_right
    rcases factor_absorb hK' hle (hK.2.2.mono hK'.2.1) with h' | h'
    · exact absurd h' (factor_ne_bot hK)
    · exact absurd h' hne

theorem factors_commute {K K' : Subgroup G} (hK : K ∈ factors G) (hK' : K' ∈ factors G)
    (hne : K ≠ K') {x y : G} (hx : x ∈ K) (hy : y ∈ K') : Commute x y := by
  have h1 : x * y * x⁻¹ * y⁻¹ ∈ K ⊓ K' := by
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · have : x * y * x⁻¹ * y⁻¹ = x * (y * x⁻¹ * y⁻¹) := by group
      rw [this]
      exact mul_mem hx (hK.2.2 y (hK'.2.1 hy) _ (inv_mem hx))
    · exact mul_mem (hK'.2.2 x (hK.2.1 hx) y hy) (inv_mem hy)
  rw [factors_inf_eq_bot hK hK' hne, mem_bot] at h1
  calc x * y = (x * y * x⁻¹ * y⁻¹) * (y * x) := by group
    _ = y * x := by rw [h1, one_mul]

theorem not_le_centralizer {K : Subgroup G} (hK : K ∈ factors G) :
    ¬ K ≤ Subgroup.centralizer (K : Set G) := by
  intro h
  obtain ⟨a, b, hab⟩ := hK.1.2
  apply hab
  apply Subtype.ext
  have := (mem_centralizer_iff.mp (h b.2)) a a.2
  simpa using this

noncomputable instance : Fintype (factors G) := Fintype.ofFinite _

/-- The factors as an indexed family. -/
abbrev fam : factors G → Subgroup G := fun K => K.1

theorem fam_commute : Pairwise fun i j : factors G =>
    ∀ x y : G, x ∈ fam i → y ∈ fam j → Commute x y :=
  fun i j hij x y hx hy => factors_commute i.2 j.2 (fun h => hij (Subtype.ext h)) hx hy

theorem fam_indep : iSupIndep (fam (G := G)) := by
  intro i
  rw [disjoint_iff]
  set J := ⨆ (j : factors G) (_ : j ≠ i), fam j
  have hJ : NormBy (socle G) J := NormBy.iSup fun j => NormBy.iSup fun _ => j.2.2.2
  rcases factor_absorb i.2 inf_le_left ((i.2.2.2.inf hJ).mono i.2.2.1) with h | h
  · exact h
  · exfalso
    have hiJ : fam i ≤ J := by
      intro x hx
      have : x ∈ (i : Subgroup G) ⊓ J := by rw [h]; exact hx
      exact this.2
    apply not_le_centralizer i.2
    refine hiJ.trans (iSup_le fun j => iSup_le fun hj => ?_)
    intro y hy
    rw [mem_centralizer_iff]
    intro x hx
    exact (factors_commute i.2 j.2 (fun h => hj (Subtype.ext h).symm) hx hy).eq

variable (G) in
/-- `M`: the product of the factors. -/
def bigM : Subgroup G := sSup (factors G)

theorem bigM_eq_iSup : bigM G = ⨆ i : factors G, fam i := sSup_eq_iSup' _

theorem bigM_normal : (bigM G).Normal :=
  normal_sSup_of_smul_mem fun _ hK g => factors_smul hK g

theorem le_bigM {K : Subgroup G} (hK : K ∈ factors G) : K ≤ bigM G := le_sSup hK

theorem bigM_le_socle : bigM G ≤ socle G := sSup_le fun _ hK => hK.2.1

/-- `M` is the (internal) direct product of the factors. -/
noncomputable def bigMEquiv : ((i : factors G) → fam i) ≃* bigM G :=
  (MonoidHom.ofInjective
    (Subgroup.injective_noncommPiCoprod_of_iSupIndep (hcomm := fam_commute) fam_indep)).trans
    (MulEquiv.subgroupCongr (by rw [Subgroup.noncommPiCoprod_range, bigM_eq_iSup]))

/-- With trivial soluble radical, `C_G(M) = 1`. -/
theorem centralizer_bigM_eq_bot [MinimalNormalSimpleFactors.{0}]
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    Subgroup.centralizer (bigM G : Set G) = ⊥ := by
  have : (bigM G).Normal := bigM_normal
  set C := Subgroup.centralizer (bigM G : Set G)
  have hC : C.Normal := Subgroup.normal_centralizer
  by_contra hC1
  obtain ⟨N, ⟨hNn, hN1, hNC⟩, hNmin⟩ :=
    (Set.toFinite {N : Subgroup G | N.Normal ∧ N ≠ ⊥ ∧ N ≤ C}).exists_minimal
      ⟨C, hC, hC1, le_rfl⟩
  have hmin : ∀ M : Subgroup G, M.Normal → M ≤ N → M = ⊥ ∨ M = N := fun M hM hle =>
    (em (M = ⊥)).imp id fun hM1 => le_antisymm hle (hNmin ⟨hM, hM1, hle.trans hNC⟩ hle)
  have hNmn : IsMinNormal N := ⟨hNn, hN1, hmin⟩
  obtain ⟨r, S, hr1, hSN, hSs, hSconj, hSnorm, e, -⟩ :=
    MinimalNormalSimpleFactors.minimal_normal_simple_factors hNn hN1 hmin
  set i0 : Fin r := ⟨0, hr1⟩
  -- the factor `S i0` is non-abelian
  have hnab : ∃ a b : S i0, a * b ≠ b * a := by
    by_contra hab'
    have hab : ∀ a b : S i0, a * b = b * a := fun a b => by
      by_contra h
      exact hab' ⟨a, b, h⟩
    have hcomm : ∀ j, ∀ a b : S j, a * b = b * a := by
      intro j a b
      obtain ⟨g, hg⟩ := hSconj i0 j
      have ha : (a : G) ∈ conjugate (S i0) g := by rw [← hg]; exact a.2
      have hb : (b : G) ∈ conjugate (S i0) g := by rw [← hg]; exact b.2
      obtain ⟨a', ha', hea⟩ := Subgroup.mem_map.mp ha
      obtain ⟨b', hb', heb⟩ := Subgroup.mem_map.mp hb
      apply Subtype.ext
      have := congrArg Subtype.val (hab ⟨a', ha'⟩ ⟨b', hb'⟩)
      simp only [Subgroup.coe_mul] at this ⊢
      rw [← hea, ← heb]
      simp only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      calc g⁻¹ * a' * g⁻¹⁻¹ * (g⁻¹ * b' * g⁻¹⁻¹) = g⁻¹ * (a' * b') * g := by group
        _ = g⁻¹ * (b' * a') * g := by rw [this]
        _ = g⁻¹ * b' * g⁻¹⁻¹ * (g⁻¹ * a' * g⁻¹⁻¹) := by group
    have hNsolv : Group.IsSolvable N := by
      apply isSolvable_of_comm
      intro x y
      apply e.symm.injective
      rw [map_mul, map_mul]
      funext j
      exact hcomm j _ _
    exact hN1 (hrad N hNn hNsolv)
  -- the factor `S i0` is normalised by the socle
  have hSnormal : ∀ a ∈ N, ∀ k ∈ S i0, a * k * a⁻¹ ∈ S i0 := by
    intro a ha k hk
    have := (hSnorm i0).conj_mem ⟨k, hSN i0 hk⟩ (by rw [mem_subgroupOf]; exact hk) ⟨a, ha⟩
    rw [mem_subgroupOf] at this
    simpa using this
  have hsoc : socle G ≤ Subgroup.normalizer (S i0 : Set G) := by
    refine sSup_le fun N' hN' => ?_
    intro a ha
    rw [mem_normalizer_iff]
    intro k
    by_cases hNN : N' = N
    · subst hNN
      constructor
      · exact hSnormal a ha k
      · intro hk
        have := hSnormal a⁻¹ (inv_mem ha) _ hk
        simpa [mul_assoc] using this
    · have : N'.Normal := hN'.1
      have hinf := IsMinNormal.inf_eq_bot hN' hNmn hNN
      have hfix : ∀ k ∈ N, a * k * a⁻¹ = k := fun k hk => by
        rw [(commute_of_normal_of_inf_eq_bot hinf ha hk).eq, mul_inv_cancel_right]
      constructor
      · intro hk
        rwa [hfix k (hSN i0 hk)]
      · intro hk
        have hkN : k ∈ N := by
          have := Normal.conj_mem hNn _ (hSN i0 hk) a⁻¹
          simpa [mul_assoc] using this
        rwa [hfix k hkN] at hk
  have hS0 : S i0 ∈ factors G := ⟨⟨hSs i0, hnab⟩, (hSN i0).trans (le_sSup hNmn),
    fun a ha k hk => ((mem_normalizer_iff.mp (hsoc ha)) k).mp hk⟩
  obtain ⟨a, b, hab⟩ := hnab
  apply hab
  apply Subtype.ext
  have hbM : (b : G) ∈ bigM G := le_bigM hS0 b.2
  have haC : (a : G) ∈ C := hNC (hSN i0 a.2)
  have := mem_centralizer_iff.mp haC _ hbM
  simpa using this.symm

/-! ### The number of factors is at most the rank -/

/-- A finite set of pairwise commuting elements of order dividing `2` generates a subgroup of
order at most `2 ^ s.card`. -/
theorem card_closure_le {H : Type*} [Group H] [Finite H] (s : Finset H)
    (hcomm : ∀ x ∈ s, ∀ y ∈ s, Commute x y) (h2 : ∀ x ∈ s, x ^ 2 = 1) :
    Nat.card (Subgroup.closure (s : Set H)) ≤ 2 ^ s.card := by
  classical
  let Z : s → Subgroup H := fun x => Subgroup.zpowers (x : H)
  have hZ : Pairwise fun i j : s => ∀ x y : H, x ∈ Z i → y ∈ Z j → Commute x y := by
    intro i j _ x y hx hy
    obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    exact (hcomm _ i.2 _ j.2).zpow_zpow m n
  have hrange : (Subgroup.noncommPiCoprod hZ).range = Subgroup.closure (s : Set H) := by
    rw [Subgroup.noncommPiCoprod_range]
    apply le_antisymm
    · exact iSup_le fun i => (Subgroup.zpowers_le).mpr (Subgroup.subset_closure i.2)
    · rw [Subgroup.closure_le]
      intro x hx
      exact Subgroup.mem_iSup_of_mem (⟨x, hx⟩ : s) (Subgroup.mem_zpowers x)
  rw [← hrange]
  calc Nat.card (Subgroup.noncommPiCoprod hZ).range ≤ Nat.card ((i : s) → Z i) :=
        Nat.card_le_card_of_surjective _ (MonoidHom.rangeRestrict_surjective _)
    _ = ∏ i : s, orderOf (i : H) := by rw [Nat.card_pi]; simp [Z, Nat.card_zpowers]
    _ ≤ 2 ^ (Finset.univ : Finset s).card :=
        Finset.prod_le_pow_card _ _ _ fun i _ => orderOf_le_of_pow_eq_one two_pos (h2 _ i.2)
    _ = 2 ^ s.card := by rw [Finset.card_univ, Fintype.card_coe]

theorem even_card_factor [OddOrder.{0}] {K : Subgroup G} (hK : K ∈ factors G) : 2 ∣ Nat.card K := by
  have hs : IsSimpleGroup K := hK.1.1
  by_contra h
  have hodd : Odd (Nat.card K) := Nat.odd_iff.mpr (Nat.two_dvd_ne_zero.mp h)
  have := OddOrder.isSolvable_of_odd_natCard K hodd
  obtain ⟨a, b, hab⟩ := hK.1.2
  exact hab ((IsSimpleGroup.comm_iff_isSolvable.mpr this) a b)

/-- Each factor has even order, so it contains an involution; these involutions generate an
elementary abelian `2`-group of order `2 ^ k`, so `k ≤ r`. -/
theorem card_factors_le [OddOrder.{0}] {r : ℕ} (hr : HasRankAtMost G r) : Nat.card (factors G) ≤ r := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have ht : ∀ i : factors G, ∃ t : fam i, orderOf t = 2 := fun i =>
    exists_prime_orderOf_dvd_card' 2 (even_card_factor i.2)
  choose t ht using ht
  let Z : factors G → Subgroup G := fun i => Subgroup.zpowers (t i : G)
  have hZle : Z ≤ fam := fun i => (Subgroup.zpowers_le).mpr (t i).2
  have hZ : Pairwise fun i j : factors G => ∀ x y : G, x ∈ Z i → y ∈ Z j → Commute x y :=
    fun i j hij x y hx hy => fam_commute hij x y (hZle i hx) (hZle j hy)
  have hinj := Subgroup.injective_noncommPiCoprod_of_iSupIndep (hcomm := hZ)
    (fam_indep.mono hZle)
  set E := ⨆ i, Z i with hE
  have hrange : (Subgroup.noncommPiCoprod hZ).range = E := Subgroup.noncommPiCoprod_range
  have hord : ∀ i, orderOf (t i : G) = 2 := fun i => by rw [Subgroup.orderOf_coe, ht i]
  have hcardE : Nat.card E = 2 ^ Nat.card (factors G) := by
    rw [← hrange, ← Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv, Nat.card_pi]
    simp [Z, Nat.card_zpowers, hord, Finset.prod_const, Nat.card_eq_fintype_card]
  have hdom_comm : ∀ a b : ((i : factors G) → Z i), a * b = b * a := by
    intro a b
    funext i
    apply Subtype.ext
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (a i).2
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (b i).2
    simp only [Pi.mul_apply, Subgroup.coe_mul, ← hm, ← hn]
    exact ((Commute.refl (t i : G)).zpow_zpow m n).eq
  have hdom_sq : ∀ a : ((i : factors G) → Z i), a ^ 2 = 1 := by
    intro a
    funext i
    apply Subtype.ext
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (a i).2
    simp only [Pi.pow_apply, Pi.one_apply, Subgroup.coe_pow, Subgroup.coe_one, ← hm]
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ← hord i,
      pow_orderOf_eq_one, one_zpow]
  obtain ⟨s, hs, hsE⟩ := hr E
  have hsub : ∀ x ∈ s, x ∈ E := fun x hx => hsE ▸ Subgroup.subset_closure hx
  have hmemE : ∀ x ∈ E, ∃ a, Subgroup.noncommPiCoprod hZ a = x := fun x hx => by
    rw [← hrange] at hx
    exact hx
  have hle := card_closure_le s
    (fun x hx y hy => by
      obtain ⟨a, rfl⟩ := hmemE x (hsub x hx)
      obtain ⟨b, rfl⟩ := hmemE y (hsub y hy)
      show _ * _ = _ * _
      rw [← map_mul, ← map_mul, hdom_comm])
    (fun x hx => by
      obtain ⟨a, rfl⟩ := hmemE x (hsub x hx)
      rw [← map_pow, hdom_sq, map_one])
  rw [hsE, hcardE] at hle
  exact (Nat.pow_le_pow_iff_right (by norm_num)).mp (hle.trans (Nat.pow_le_pow_right two_pos hs))

/-! ### The kernel `T` of the action on the factors -/

instance factorsAction : MulAction (ConjAct G) (factors G) where
  smul g K := ⟨g • K.1, factors_smul K.2 g⟩
  one_smul K := Subtype.ext (one_smul _ K.1)
  mul_smul g h K := Subtype.ext (mul_smul g h K.1)

/-- The permutation representation of `G` on the factors, by conjugation. -/
noncomputable def permRep : G →* Equiv.Perm (factors G) :=
  (MulAction.toPermHom (ConjAct G) (factors G)).comp ConjAct.toConjAct.toMonoidHom

variable (G) in
/-- `T`: the kernel of the action of `G` on the factors. -/
noncomputable abbrev bigT : Subgroup G := (permRep (G := G)).ker

theorem mem_bigT {g : G} :
    g ∈ bigT G ↔ ∀ K : factors G, ConjAct.toConjAct g • (K : Subgroup G) = K := by
  rw [MonoidHom.mem_ker]
  constructor
  · intro h K
    exact congrArg (fun σ : Equiv.Perm (factors G) => ((σ K : factors G) : Subgroup G)) h
  · intro h
    exact Equiv.Perm.ext fun K => Subtype.ext (h K)

theorem card_quot_bigT_le : Nat.card (G ⧸ bigT G) ≤ (Nat.card (factors G)).factorial := by
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange permRep).toEquiv, ← Nat.card_perm]
  exact Subgroup.card_le_card_group _

theorem bigM_le_bigT : bigM G ≤ bigT G := fun _ hm =>
  mem_bigT.mpr fun K => K.2.2.2.smul_eq (bigM_le_socle hm)

/-! ### `T/M` is soluble (Schreier) -/

/-- Conjugation by an element of `T`, restricted to a factor. -/
noncomputable def conjRestr (K : factors G) : bigT G →* MulAut (K : Subgroup G) where
  toFun t :=
    { toFun := fun k => ⟨(t : G) * k * (t : G)⁻¹, conj_mem_of_smul_eq (mem_bigT.mp t.2 K) k.2⟩
      invFun := fun k => ⟨(t : G)⁻¹ * k * (t : G)⁻¹⁻¹,
        conj_mem_of_smul_eq (mem_bigT.mp (inv_mem t.2) K) k.2⟩
      left_inv := fun k => Subtype.ext (by simp [mul_assoc])
      right_inv := fun k => Subtype.ext (by simp [mul_assoc])
      map_mul' := fun a b => Subtype.ext (by simp [mul_assoc]) }
  map_one' := by
    ext k
    simp
  map_mul' := fun a b => by
    ext k
    simp [mul_assoc]

/-- The map `T → ∏ Out(K)`. -/
noncomputable def outerRep :
    bigT G →* ((K : factors G) → OuterAutomorphisms.Outer (K : Subgroup G)) :=
  Pi.monoidHom fun K =>
    (QuotientGroup.mk' (OuterAutomorphisms.inner (K : Subgroup G))).comp (conjRestr K)

theorem isSolvable_pi {ι : Type*} [Finite ι] (A : ι → Type*) [∀ i, Group (A i)]
    (h : ∀ i, Group.IsSolvable (A i)) : Group.IsSolvable ((i : ι) → A i) := by
  have := Fintype.ofFinite ι
  choose n hn using fun i => (isSolvable_def (A i)).mp (h i)
  refine (isSolvable_def _).mpr ⟨∑ i, n i, ?_⟩
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot]
  funext i
  have h1 : x i ∈ derivedSeries (A i) (∑ j, n j) :=
    map_derivedSeries_le_derivedSeries (Pi.evalMonoidHom A i) _ ⟨x, hx, rfl⟩
  have h2 := derivedSeries_antitone (A i)
    (Finset.single_le_sum (fun j _ => Nat.zero_le (n j)) (Finset.mem_univ i)) h1
  rw [hn i, mem_bot] at h2
  exact h2

theorem outer_solvable [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0}) (K : factors G) :
    Group.IsSolvable (OuterAutomorphisms.Outer (K : Subgroup G)) := by
  haveI : IsSimpleGroup (K : Subgroup G) := K.2.1.1
  exact Schreier.schreierFor_inCatalog_holds (K : Subgroup G) K.2.1.2
    (TauCeti.classificationStatement_iff.1 hCFSG (K : Subgroup G))

theorem ker_outerRep_le [MinimalNormalSimpleFactors.{0}]
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    (outerRep (G := G)).ker ≤ (bigM G).subgroupOf (bigT G) := by
  classical
  intro x hx
  rw [MonoidHom.mem_ker] at hx
  have hK : ∀ K : factors G, ∃ y : (K : Subgroup G), MulAut.conj y = conjRestr K x := by
    intro K
    have := congrFun hx K
    change (QuotientGroup.mk (conjRestr K x) : OuterAutomorphisms.Outer (K : Subgroup G)) = 1 at this
    rw [QuotientGroup.eq_one_iff] at this
    exact this
  choose y hy using hK
  set F := Subgroup.noncommPiCoprod (fam_commute (G := G))
  have hzM : F y ∈ bigM G := by
    rw [bigM_eq_iSup, ← Subgroup.noncommPiCoprod_range (hcomm := fam_commute)]
    exact ⟨y, rfl⟩
  have hact : ∀ K : factors G, ∀ k ∈ (K : Subgroup G),
      F y * k * (F y)⁻¹ = (x : G) * k * (x : G)⁻¹ := by
    intro K k hk
    have h1 : (x : G) * k * (x : G)⁻¹ = y K * k * (y K : G)⁻¹ := by
      have := congrArg (fun φ : MulAut (K : Subgroup G) => ((φ ⟨k, hk⟩ : (K : Subgroup G)) : G))
        (hy K)
      simpa [conjRestr] using this.symm
    rw [h1]
    let w : (i : factors G) → fam i := Function.update y K 1
    have hyw : y = Pi.mulSingle K (y K) * w := by
      funext i
      by_cases hi : i = K
      · subst hi
        simp [w]
      · simp [w, hi, Pi.mulSingle_apply]
    have hw : Commute k (F w) := by
      rw [Subgroup.noncommPiCoprod_apply]
      apply Finset.noncommProd_commute
      intro i _
      by_cases hi : i = K
      · subst hi
        simp [w]
      · simp only [w, Function.update_of_ne hi]
        exact fam_commute (fun h => hi h.symm) k _ hk (y i).2
    have hFy : F y = y K * F w := by
      calc F y = F (Pi.mulSingle K (y K) * w) := congrArg F hyw
        _ = y K * F w := by rw [map_mul, Subgroup.noncommPiCoprod_mulSingle]
    rw [hFy]
    have := hw.eq
    calc (y K : G) * F w * k * ((y K : G) * F w)⁻¹
        = y K * (F w * k * (F w)⁻¹) * (y K : G)⁻¹ := by group
      _ = y K * k * (y K : G)⁻¹ := by rw [← this, mul_inv_cancel_right]
  have hu : (F y)⁻¹ * (x : G) ∈ Subgroup.centralizer (bigM G : Set G) := by
    rw [mem_centralizer_iff]
    intro m hm
    have hMle : bigM G ≤ Subgroup.centralizer ({(F y)⁻¹ * (x : G)} : Set G) := by
      refine sSup_le fun K hK => ?_
      intro k hk
      rw [mem_centralizer_iff]
      intro u hu
      rw [Set.mem_singleton_iff] at hu
      subst hu
      have := hact ⟨K, hK⟩ k hk
      calc (F y)⁻¹ * (x : G) * k = (F y)⁻¹ * ((x : G) * k * (x : G)⁻¹) * x := by group
        _ = (F y)⁻¹ * (F y * k * (F y)⁻¹) * x := by rw [this]
        _ = k * ((F y)⁻¹ * x) := by group
    exact (mem_centralizer_iff.mp (hMle hm) _ rfl).symm
  rw [centralizer_bigM_eq_bot hrad, mem_bot] at hu
  rw [mem_subgroupOf, ← inv_mul_eq_one.mp hu]
  exact hzM

theorem quot_solvable [MinimalNormalSimpleFactors.{0}] [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    have : (bigM G).Normal := bigM_normal
    Group.IsSolvable (bigT G ⧸ (bigM G).subgroupOf (bigT G)) := by
  intro this
  haveI : Group.IsSolvable ((K : factors G) → OuterAutomorphisms.Outer (K : Subgroup G)) :=
    isSolvable_pi _ (outer_solvable hCFSG)
  haveI : Group.IsSolvable (bigT G ⧸ (outerRep (G := G)).ker) :=
    solvable_of_solvable_injective (QuotientGroup.kerLift_injective outerRep)
  refine solvable_of_surjective (f := QuotientGroup.map _ _ (MonoidHom.id _)
    (by simpa using ker_outerRep_le hrad)) ?_
  intro q
  induction q using QuotientGroup.induction_on with
  | H a => exact ⟨QuotientGroup.mk a, rfl⟩

end Factors

/-! ### The main result -/

/-- **Ranks of finite groups.** Let G be a finite group of rank r, so that every subgroup of G can be generated by r
elements, whose only soluble normal subgroup is trivial. Then G has normal subgroups M ≤ T such that M is a direct
product of at most r nonabelian simple groups, T/M is soluble, and |G : T| ≤ r!.

Source: L. A. Kurdachenko and P. Shumyatsky, The ranks of central factor and commutator groups, Math. Proc.
Cambridge Philos. Soc. 154 (2013), 63–69, lemma before the proof of Theorem 1.
https://doi.org/10.1017/S0305004112000412

This version takes the corpus theorems it uses as instance arguments; the version in `unconditional/` supplies them
from the CFSG corpus. -/
theorem schrei [MinimalNormalSimpleFactors.{0}] [OddOrder.{0}] [Schreier]
    (hCFSG : TauCeti.ClassificationStatement.{0}) {G : Type} [Group G] [Finite G]
    {r : ℕ} (hr : rank G = r)
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    ∃ (M T : Subgroup G) (_ : M.Normal) (_ : T.Normal), M ≤ T ∧
      (∃ (ι : Type) (_ : Fintype ι) (S : ι → Type) (_ : ∀ i, Group (S i)),
        Fintype.card ι ≤ r ∧ (∀ i, IsSimpleGroup (S i)) ∧
        (∀ i, ∃ a b : S i, a * b ≠ b * a) ∧ Nonempty (M ≃* ((i : ι) → S i))) ∧
      Group.IsSolvable (T ⧸ M.subgroupOf T) ∧ Nat.card (G ⧸ T) ≤ r.factorial := by
  have hrk : HasRankAtMost G r := hr ▸ hasRankAtMost_rank G
  have hn := card_factors_le hrk
  refine ⟨bigM G, bigT G, bigM_normal, MonoidHom.normal_ker _, bigM_le_bigT,
    ⟨factors G, inferInstance, fun K => (K : Subgroup G), fun K => inferInstance, ?_,
      fun K => K.2.1.1, fun K => K.2.1.2, ⟨bigMEquiv.symm⟩⟩, quot_solvable hCFSG hrad, ?_⟩
  · rwa [← Nat.card_eq_fintype_card]
  · exact card_quot_bigT_le.trans (Nat.factorial_le hn)

end CFSGOutside.KurdachenkoShumyatsky
