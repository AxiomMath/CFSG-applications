import Mathlib

/-!
# Kurdachenko–Shumyatsky: the rank of a group

L. A. Kurdachenko, P. Shumyatsky, *The ranks of central factor and commutator groups*, Math. Proc.
Cambridge Philos. Soc. 154 (2013), 63–69, DOI 10.1017/S0305004112000412 (arXiv:1204.4641). The rank
of a group is the least `r` such that every subgroup is generated by at most `r` elements; it is
used in the statement of Lemma `schrei`.
-/

namespace CFSGOutside.KurdachenkoShumyatsky

variable (G : Type*) [Group G]

/-- `G` has rank at most `r`: every subgroup of `G` can be generated by at most `r` elements. -/
def HasRankAtMost (r : ℕ) : Prop :=
  ∀ H : Subgroup G, ∃ s : Finset G, s.card ≤ r ∧ Subgroup.closure (s : Set G) = H

/-- The rank of a group, as in Kurdachenko–Shumyatsky: the least `r` such that every subgroup can be
generated by at most `r` elements (for a finite group every subgroup is finitely generated). -/
noncomputable def rank : ℕ := sInf {r | HasRankAtMost G r}

theorem hasRankAtMost_natCard [Finite G] : HasRankAtMost G (Nat.card G) := by
  classical
  intro H
  have := Fintype.ofFinite G
  refine ⟨(H : Set G).toFinset, ?_, ?_⟩
  · rw [Nat.card_eq_fintype_card]
    exact Finset.card_le_univ _
  · simp

theorem hasRankAtMost_rank [Finite G] : HasRankAtMost G (rank G) :=
  Nat.sInf_mem (s := {r | HasRankAtMost G r}) ⟨_, hasRankAtMost_natCard G⟩

end CFSGOutside.KurdachenkoShumyatsky
