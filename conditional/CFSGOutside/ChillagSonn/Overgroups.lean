import CFSGOutside.ChillagSonn.Defs
import CFSGOutside.ChillagSonn.LinearTwo

/-!
# Chillag–Sonn, Lemma (1.6): overgroups of `PSL(2, q)` in `PΓL(2, q)`

For `q = pⁿ`, `n ≤ 2`, `p` odd, a subgroup `R` of `PΓL(2, q)` containing `PSL(2, q)` and no elementary abelian
subgroup of order 8 is `PSL(2, q)`, `PGL(2, q)` or (for `n = 2`) `PGL*(2, q)`. If `R` contained a field
automorphism `σ ≠ 1`, then `σ` together with two commuting involutions of `PSL(2, p)` would generate an elementary
abelian subgroup of order 8.
-/

noncomputable section

namespace CFSGOutside.ChillagSonn

open CFSGOutside.Corpus CFSGOutside.Corpus.GorensteinWalter Matrix SemidirectProduct
open scoped MatrixGroups

variable {F : Type} [Field F]

/-- The image of `PSL(2, F)` in `PGL(2, F)`. -/
abbrev pslT (F : Type) [Field F] : Subgroup (PGL2 F) :=
  (ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range

/-- `PSL(2, F)` has index 2 in `PGL(2, F)`. -/
theorem index_pslT [Finite F] (hK : ringChar F ≠ 2) : (pslT F).index = 2 := by
  have h1 := (pslT F).index_mul_card
  have h2 : Nat.card (pslT F) = Nat.card (PSL2 F) :=
    (Nat.card_congr (MonoidHom.ofInjective ProjectiveSpecialLinearGroup.toPGL_injective).toEquiv).symm
  rw [h2, LinearTwo.card_PGL2, ← LinearTwo.card_PSL2_mul_two F hK] at h1
  exact Nat.eq_of_mul_eq_mul_right Nat.card_pos (h1.trans (mul_comm _ _))

/-- Ring automorphisms of `F` are `ZMod p`-algebra automorphisms. -/
def ringEquivEquivAlgEquiv (p : ℕ) [Algebra (ZMod p) F] : (F ≃+* F) ≃ (F ≃ₐ[ZMod p] F) where
  toFun σ := AlgEquiv.ofRingEquiv (f := σ) fun x =>
    DFunLike.congr_fun (RingHom.ext_zmod ((σ : F →+* F).comp (algebraMap (ZMod p) F)) (algebraMap (ZMod p) F)) x
  invFun σ := σ.toRingEquiv
  left_inv σ := by ext; rfl
  right_inv σ := by ext; rfl

/-- `|Aut F| = n` for `|F| = pⁿ`. -/
theorem card_ringEquiv [Finite F] {p n : ℕ} [Fact p.Prime] [CharP F p] (hF : Nat.card F = p ^ n) :
    Nat.card (F ≃+* F) = n := by
  let : Algebra (ZMod p) F := ZMod.algebra F p
  have := Fintype.ofFinite F
  rw [Nat.card_congr (ringEquivEquivAlgEquiv p), IsGalois.card_aut_eq_finrank]
  have h := Module.card_eq_pow_finrank (K := ZMod p) (V := F)
  rw [ZMod.card, ← Nat.card_eq_fintype_card, hF] at h
  exact (Nat.pow_right_injective (Fact.out : p.Prime).two_le h).symm

/-- In a group generated by commuting involutions, all elements commute and square to `1`. -/
theorem closure_comm_sq {G : Type*} [Group G] {S : Set G} (hc : ∀ x ∈ S, ∀ y ∈ S, x * y = y * x)
    (hs : ∀ x ∈ S, x ^ 2 = 1) :
    (∀ x ∈ Subgroup.closure S, ∀ y ∈ Subgroup.closure S, x * y = y * x) ∧
      ∀ x ∈ Subgroup.closure S, x ^ 2 = 1 := by
  let := Subgroup.closureCommGroupOfComm (k := S) fun x hx y hy _ => hc x hx y hy
  have hcomm : ∀ x ∈ Subgroup.closure S, ∀ y ∈ Subgroup.closure S, x * y = y * x := fun x hx y hy =>
    congrArg Subtype.val (mul_comm (⟨x, hx⟩ : Subgroup.closure S) ⟨y, hy⟩)
  refine ⟨hcomm, fun x hx => ?_⟩
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact hs x hx
  | one => simp
  | mul x y hx hy ihx ihy => rw [Commute.mul_pow (hcomm x hx y hy), ihx, ihy, one_mul]
  | inv x hx ih => rw [inv_pow, ih, inv_one]

/-- `[[0, 1], [-1, 0]]` in `SL(2, F)`. -/
def matA (F : Type) [Field F] : SL(2, F) := ⟨!![0, 1; -1, 0], by simp [det_fin_two]⟩

/-- `[[x, y], [y, -x]]` in `SL(2, F)`, for `x² + y² = -1`. -/
def matB {x y : F} (h : x ^ 2 + y ^ 2 = -1) : SL(2, F) :=
  ⟨!![x, y; y, -x], by simp [det_fin_two]; linear_combination -h⟩


/-- Two distinct commuting involutions in the image of `PSL(2, F)`, fixed by `σ`. -/
theorem exists_pair (h2 : (2 : F) ≠ 0) {x y : F} (h : x ^ 2 + y ^ 2 = -1) (σ : F ≃+* F)
    (hx : σ x = x) (hy : σ y = y) :
    ∃ a b : PGL2 F, a ∈ pslT F ∧ b ∈ pslT F ∧ a * a = 1 ∧ b * b = 1 ∧ a * b = b * a ∧ a ≠ 1 ∧ b ≠ 1 ∧
      a ≠ b ∧ pgl2FieldAut F σ a = a ∧ pgl2FieldAut F σ b = b := by
  set A := SpecialLinearGroup.toGL (matA F)
  set B := SpecialLinearGroup.toGL (matB h)
  have hA : (A : Matrix (Fin 2) (Fin 2) F) = !![0, 1; -1, 0] := rfl
  have hB : (B : Matrix (Fin 2) (Fin 2) F) = !![x, y; y, -x] := rfl
  have e : ∀ {g g' : GL (Fin 2) F}, g = g' → ∀ i j,
      (g : Matrix (Fin 2) (Fin 2) F) i j = (g' : Matrix (Fin 2) (Fin 2) F) i j := fun h i j => by rw [h]
  refine ⟨ProjGenLinGroup.mk A, ProjGenLinGroup.mk B, ⟨(matA F : PSL2 F), ProjectiveSpecialLinearGroup.toPGL_mk _⟩,
    ⟨(matB h : PSL2 F), ProjectiveSpecialLinearGroup.toPGL_mk _⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [← map_mul, ← map_one ProjGenLinGroup.mk, ProjGenLinGroup.mk_eq_mk_iff]
    refine ⟨-1, ?_⟩
    ext i j; fin_cases i <;> fin_cases j <;> simp [hA, Matrix.mul_apply, Fin.sum_univ_two]
  · rw [← map_mul, ← map_one ProjGenLinGroup.mk, ProjGenLinGroup.mk_eq_mk_iff]
    refine ⟨-1, ?_⟩
    ext i j; fin_cases i <;> fin_cases j <;> simp [hB, Matrix.mul_apply, Fin.sum_univ_two] <;>
      first | ring1 | linear_combination h | linear_combination -h
  · rw [← map_mul ProjGenLinGroup.mk, ← map_mul ProjGenLinGroup.mk, ProjGenLinGroup.mk_eq_mk_iff]
    refine ⟨-1, ?_⟩
    ext i j; fin_cases i <;> fin_cases j <;> simp [hA, hB, Matrix.mul_apply, Fin.sum_univ_two]
  · intro h1
    rw [← map_one ProjGenLinGroup.mk, ProjGenLinGroup.mk_eq_mk_iff] at h1
    obtain ⟨u, hu⟩ := h1
    have := e hu 0 0
    simp [hA, Matrix.mul_apply, Fin.sum_univ_two] at this
  · intro h1
    rw [← map_one ProjGenLinGroup.mk, ProjGenLinGroup.mk_eq_mk_iff] at h1
    obtain ⟨u, hu⟩ := h1
    have h00 := e hu 0 0
    have h11 := e hu 1 1
    simp [hB, Matrix.mul_apply, Fin.sum_univ_two] at h00 h11
    exact h2 (by linear_combination -h00 - h11)
  · intro h1
    rw [ProjGenLinGroup.mk_eq_mk_iff] at h1
    obtain ⟨u, hu⟩ := h1
    have h01 := e hu 0 1
    have h10 := e hu 1 0
    simp [hA, hB, Matrix.mul_apply, Fin.sum_univ_two] at h01 h10
    have : (2 : F) * u = 0 := by linear_combination h01 - h10
    exact u.ne_zero ((mul_eq_zero.mp this).resolve_left h2)
  · change ProjGenLinGroup.mk (GeneralLinearGroup.map (σ : F →+* F) A) = _
    congr 1
    ext i j; fin_cases i <;> fin_cases j <;> simp [hA]
  · change ProjGenLinGroup.mk (GeneralLinearGroup.map (σ : F →+* F) B) = _
    congr 1
    ext i j; fin_cases i <;> fin_cases j <;> simp [hB, hx, hy]


/-- If `R ⊇ PSL(2, F)` has no elementary abelian subgroup of order 8, it contains no field automorphism `σ ≠ 1`
with `σ² = 1`. -/
theorem inr_not_mem [Finite F] {p : ℕ} [Fact p.Prime] [CharP F p] (h2 : (2 : F) ≠ 0)
    {R : Subgroup (PGammaL2 F)} (hR : pslInPGammaL F ≤ R)
    (hE : ∀ E : Subgroup (PGammaL2 F), E ≤ R → (∀ x ∈ E, x ^ 2 = 1) → (∀ x ∈ E, ∀ y ∈ E, x * y = y * x) →
      Nat.card E ≤ 4) {σ : F ≃+* F} (hσ : σ ≠ 1) (hσσ : σ * σ = 1) : inr σ ∉ R := by
  intro hσR
  obtain ⟨x, y, hxy⟩ := CharP.sq_add_sq F p (-1)
  push_cast at hxy
  obtain ⟨a, b, haT, hbT, ha2, hb2, hab, ha1, hb1, hne, hσa, hσb⟩ :=
    exists_pair h2 hxy σ (map_natCast σ x) (map_natCast σ y)
  set S : Set (PGammaL2 F) := {inl a, inl b, inr σ}
  have hc : ∀ u ∈ S, ∀ v ∈ S, u * v = v * u := by
    rintro u (rfl | rfl | rfl) v (rfl | rfl | rfl) <;> first | rfl | (ext <;> simp [hab, hσa, hσb])
  have hs : ∀ u ∈ S, u ^ 2 = 1 := by
    rintro u (rfl | rfl | rfl) <;> rw [sq, ← map_mul] <;> simp [ha2, hb2, hσσ]
  obtain ⟨hcE, hsE⟩ := closure_comm_sq hc hs
  have hER : Subgroup.closure S ≤ R := by
    rw [Subgroup.closure_le]
    rintro u (rfl | rfl | rfl)
    · exact hR (Subgroup.mem_map_of_mem _ haT)
    · exact hR (Subgroup.mem_map_of_mem _ hbT)
    · exact hσR
  have hS : ∀ u ∈ S, u ∈ Subgroup.closure S := fun u hu => Subgroup.subset_closure hu
  have hmem : ∀ i j k : Bool,
      (⟨cond i a 1 * cond j b 1, cond k σ 1⟩ : PGammaL2 F) ∈ Subgroup.closure S := by
    intro i j k
    rw [mk_eq_inl_mul_inr, map_mul]
    refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_
    · cases i
      · simp
      · exact hS _ (by simp [S])
    · cases j
      · simp
      · exact hS _ (by simp [S])
    · cases k
      · simp
      · exact hS _ (by simp [S])
  let f : Bool × Bool × Bool → Subgroup.closure S := fun ⟨i, j, k⟩ => ⟨_, hmem i j k⟩
  have hab1 : a * b ≠ 1 := fun h' =>
    hne ((mul_eq_one_iff_eq_inv.mp h').trans (inv_eq_of_mul_eq_one_left hb2))
  have hf : Function.Injective f := by
    rintro ⟨i, j, k⟩ ⟨i', j', k'⟩ h
    replace h := congrArg (fun z : Subgroup.closure S => ((z : PGammaL2 F).left, (z : PGammaL2 F).right)) h
    simp only [f] at h
    cases i <;> cases j <;> cases k <;> cases i' <;> cases j' <;> cases k' <;>
      simp [ha1, hb1, hne, hab1, hσ, Ne.symm ha1, Ne.symm hb1, Ne.symm hne, Ne.symm hab1, Ne.symm hσ] at h ⊢
  have : Finite (F ≃+* F) := Finite.of_injective (fun σ : F ≃+* F => (σ : F → F))
    fun _ _ h => RingEquiv.ext (congrFun h)
  have : Finite (GL (Fin 2) F) := inferInstance
  have : Finite (PGL2 F) := Finite.of_surjective _ ProjGenLinGroup.mk_surjective
  have : Finite (PGammaL2 F) := Finite.of_injective (fun z : PGammaL2 F => (z.left, z.right))
    fun _ _ h => SemidirectProduct.ext (congrArg Prod.fst h) (congrArg Prod.snd h)
  have h8 := Nat.card_le_card_of_injective f hf
  have h4 := hE _ hER hsE hcE
  rw [Nat.card_eq_fintype_card] at h8
  simp only [Fintype.card_prod, Fintype.card_bool] at h8
  omega


/-- The overgroups of `PSL(2, q)` in `PΓL(2, q)`, `q = pⁿ`, `n ≤ 2`, `p` odd, without an elementary abelian
subgroup of order 8 are `PSL(2, q)`, `PGL(2, q)` and (for `n = 2`) `PGL*(2, q)`. -/
theorem overgroups_of_noElemEight {F : Type} [Field F] [Finite F] {p n : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hn : n = 1 ∨ n = 2) (hF : Nat.card F = p ^ n) (R : Subgroup (PGammaL2 F)) (hR : pslInPGammaL F ≤ R)
    (hE : ∀ E : Subgroup (PGammaL2 F), E ≤ R → (∀ x ∈ E, x ^ 2 = 1) → (∀ x ∈ E, ∀ y ∈ E, x * y = y * x) →
      Nat.card E ≤ 4) :
    Nonempty (R ≃* PSL2 F) ∨ Nonempty (R ≃* PGL2 F) ∨
      (n = 2 ∧ R = PGLStar F ∧ Nat.card R = 2 * Nat.card (PSL2 F)) := by
  have := Fact.mk hp
  have := Fintype.ofFinite F
  have : CharP F p := charP_of_card_eq_prime_pow (by rw [← Nat.card_eq_fintype_card, hF])
  have hK : ringChar F ≠ 2 := by rw [ringChar.eq F p]; exact hp2
  have hT := index_pslT hK
  have hcard := card_ringEquiv hF
  have hTR : ∀ t ∈ pslT F, (inl t : PGammaL2 F) ∈ R := fun t ht => hR (Subgroup.mem_map_of_mem _ ht)
  have hx : ∀ x : PGammaL2 F, x.right = 1 → x = inl x.left := fun x h => by ext <;> simp [h]
  have hinl : ∀ z : PGammaL2 F, inl z.left⁻¹ * z = inr z.right := fun z => by ext <;> simp
  by_cases hright : ∀ x ∈ R, x.right = 1
  · by_cases hleft : ∀ x ∈ R, x.left ∈ pslT F
    · left
      have : R = pslInPGammaL F := le_antisymm (fun x hx' => by
        rw [hx x (hright x hx')]; exact Subgroup.mem_map_of_mem _ (hleft x hx')) hR
      exact ⟨(MulEquiv.subgroupCongr this).trans ((Subgroup.equivMapOfInjective _ _ inl_injective).symm.trans
        (MonoidHom.ofInjective ProjectiveSpecialLinearGroup.toPGL_injective).symm)⟩
    · right; left
      push Not at hleft
      obtain ⟨x, hxR, hxT⟩ := hleft
      have : R = (inl : PGL2 F →* PGammaL2 F).range := by
        ext z
        refine ⟨fun hz => ⟨z.left, (hx z (hright z hz)).symm⟩, ?_⟩
        rintro ⟨w, rfl⟩
        by_cases hw : w ∈ pslT F
        · exact hTR w hw
        · have h1 : w * x.left⁻¹ ∈ pslT F :=
            (Subgroup.mul_mem_iff_of_index_two hT).2 (iff_of_false hw (by simpa using hxT))
          have e : inl (w * x.left⁻¹) * x = inl w := by ext <;> simp [hright x hxR]
          exact e ▸ R.mul_mem (hTR _ h1) hxR
      exact ⟨(MulEquiv.subgroupCongr this).trans (MonoidHom.ofInjective inl_injective).symm⟩
  · right; right
    push Not at hright
    obtain ⟨y, hyR, hy1⟩ := hright
    obtain rfl : n = 2 := by
      rcases hn with rfl | rfl
      · exact absurd (@Subsingleton.elim _ (Nat.card_eq_one_iff_unique.mp (by simpa using hcard)).1 _ _) hy1
      · rfl
    have hσσ : ∀ σ : F ≃+* F, σ * σ = 1 := fun σ => by
      have := pow_card_eq_one' (x := σ); rwa [hcard, sq] at this
    have huniq := (Nat.card_eq_two_iff' (1 : F ≃+* F)).mp hcard
    have h2 : (2 : F) ≠ 0 := Ring.two_ne_zero hK
    have key1 : ∀ z ∈ R, z.right ≠ 1 → z.left ∉ pslT F := fun z hz h1 hzT =>
      inr_not_mem h2 hR hE h1 (hσσ _) (hinl z ▸ R.mul_mem (hTR _ (inv_mem hzT)) hz)
    have hyT := key1 y hyR hy1
    have key2 : ∀ z ∈ R, z.right = 1 → z.left ∈ pslT F := by
      intro z hz h1
      by_contra hzT
      apply key1 (z * y) (R.mul_mem hz hyR) (by simp [h1, hy1])
      simpa [h1] using (Subgroup.mul_mem_iff_of_index_two hT).2 (iff_of_false hzT hyT)
    -- `R ∩ PGL(2, F) = PSL(2, F)` has index 2 in `R`
    have hcardR : Nat.card R = 2 * Nat.card (PSL2 F) := by
      let π : R →* (F ≃+* F) := (SemidirectProduct.rightHom).comp R.subtype
      have hsurj : Function.Surjective π := by
        intro σ
        by_cases hσ : σ = 1
        · exact ⟨1, by rw [map_one, hσ]⟩
        · exact ⟨⟨y, hyR⟩, (huniq.unique hσ hy1).symm⟩
      have hker : π.ker = (pslInPGammaL F).subgroupOf R := by
        ext z
        rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
        constructor
        · intro h
          have h1 : (z : PGammaL2 F).right = 1 := h
          rw [hx _ h1]
          exact Subgroup.mem_map_of_mem _ (key2 z z.2 h1)
        · rintro ⟨w, -, hw⟩
          change (z : PGammaL2 F).right = 1
          rw [← hw]
          simp
      have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup π.ker
      rw [Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective π hsurj).toEquiv, hcard, hker,
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe hR).toEquiv, pslInPGammaL,
        Subgroup.card_map_of_injective inl_injective] at h1
      rw [h1, ← Nat.card_congr (MonoidHom.ofInjective ProjectiveSpecialLinearGroup.toPGL_injective).toEquiv]
    refine ⟨rfl, le_antisymm (fun z hz => Subgroup.subset_closure ?_) ?_, hcardR⟩
    · by_cases h1 : z.right = 1
      · exact Or.inl ⟨h1, key2 z hz h1⟩
      · exact Or.inr ⟨h1, key1 z hz h1⟩
    · rw [PGLStar, Subgroup.closure_le]
      rintro z (⟨h1, hzT⟩ | ⟨h1, hzT⟩)
      · rw [hx z h1]; exact hTR _ hzT
      · have hzy : z.right = y.right := huniq.unique h1 hy1
        have hw : z.left * y.left⁻¹ ∈ pslT F :=
          (Subgroup.mul_mem_iff_of_index_two hT).2 (iff_of_false hzT (by simpa using hyT))
        have : z = inl (z.left * y.left⁻¹) * y := by ext <;> simp [hzy]
        rw [this]; exact R.mul_mem (hTR _ hw) hyR

end CFSGOutside.ChillagSonn
