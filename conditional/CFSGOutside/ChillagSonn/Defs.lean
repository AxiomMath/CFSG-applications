import CFSGOutside.Corpus.Defs.PGammaL2
import CFSGOutside.Corpus.Defs.StatedM11
import CFSGOutside.Corpus.Defs.Components

/-!
# Chillag–Sonn (1981): definitions and statements

D. Chillag and J. Sonn, *Sylow-metacyclic groups and Q-admissibility*, Israel J. Math. 40 (1981), 307–323.

* `IsMetacyclic P`: `P` has a cyclic normal subgroup with cyclic quotient.
* `SylowMetacyclic G`: every Sylow subgroup of `G` is metacyclic.
* `HasSylowTower G`: for every `p`, `G` has a normal subgroup whose order is the part of `|G|` belonging to the primes
  `≥ p`. With `p₁ < ⋯ < pₙ` the primes dividing `|G|` and `Gᵢ` the normal subgroup for `pᵢ₊₁`, this is the paper's
  normal series `G = G₀ ▷ G₁ ▷ ⋯ ▷ Gₙ = 1` with `Gᵢ/Gᵢ₊₁` isomorphic to a Sylow `pᵢ₊₁`-subgroup.
* `PGLStar F`: for `|F| = p²`, the subgroup `PGL*(2, p²)` of `PΓL(2, p²)`, generated by `PSL(2, p²)` and the
  products of a field automorphism `≠ 1` with an element of `PGL(2, p²) ∖ PSL(2, p²)`.
* `IsDoubleStemCover A X`: `A` is a stem extension of `X` by a group of order 2 (a normal `D ≤ Z(A) ∩ A'` of order 2
  with `A/D ≅ X`). The paper's `Ã₇` is the double stem cover of `A₇`, and `PGL(2,q)⁺`, `PGL(2,q)⁻` are the two
  double stem covers of `PGL(2,q)`; the formal statement names them by this property.
-/

namespace CFSGOutside.ChillagSonn

open CFSGOutside.Corpus CFSGOutside.Corpus.GorensteinWalter
open scoped MatrixGroups

/-- `P` is metacyclic: it has a cyclic normal subgroup with cyclic quotient. -/
def IsMetacyclic (P : Type*) [Group P] : Prop :=
  ∃ (N : Subgroup P) (_ : N.Normal), IsCyclic N ∧ IsCyclic (P ⧸ N)

/-- `G` is Sylow-metacyclic: all its Sylow subgroups are metacyclic. -/
def SylowMetacyclic (G : Type*) [Group G] : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (P : Sylow p G), IsMetacyclic P

/-- The part of `n` belonging to the primes `≥ p`. -/
def upperPart (p n : ℕ) : ℕ :=
  ∏ q ∈ n.primeFactors.filter (p ≤ ·), q ^ n.factorization q

/-- `G` has a Sylow tower: for every `p` it has a normal subgroup of order `upperPart p |G|`. -/
def HasSylowTower (G : Type*) [Group G] : Prop :=
  ∀ p : ℕ, ∃ H : Subgroup G, H.Normal ∧ Nat.card H = upperPart p (Nat.card G)

/-- `PSL(2, F)` inside `PΓL(2, F)`. -/
def pslInPGammaL (F : Type) [Field F] : Subgroup (PGammaL2 F) :=
  (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range.map SemidirectProduct.inl

/-- `PGL*(2, p²)`: the subgroup of `PΓL(2, F)` generated by `PSL(2, F)` and the elements whose field automorphism is
not the identity and whose `PGL(2, F)`-part is not in `PSL(2, F)`. For `|F| = p²` with `p` odd it is the index-2
subgroup of `PΓL(2, p²)` other than `PGL(2, p²)` and `PSL(2, p²) ⋊ Aut(F)`. -/
def PGLStar (F : Type) [Field F] : Subgroup (PGammaL2 F) :=
  Subgroup.closure
    ({x | x.right = 1 ∧ x.left ∈ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range} ∪
      {x | x.right ≠ 1 ∧ x.left ∉ (Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range})

/-- `A` is a stem extension of `X` by a group of order 2. -/
def IsDoubleStemCover (A X : Type*) [Group A] [Group X] : Prop :=
  ∃ (D : Subgroup A) (_ : D.Normal), D ≤ Subgroup.center A ⊓ commutator A ∧ Nat.card D = 2 ∧
    Nonempty (A ⧸ D ≃* X)

/-- The conclusion of Lemma (1.5): `A₇`, `M₁₁`, or `PSL(2, pⁿ)` with `n ≤ 2` and `pⁿ ≥ 5`. (The paper writes
`pⁿ ≠ 2, 3`; the extra group `PSL(2, 4)` is isomorphic to `PSL(2, 5)`.) -/
def Lemma15Conclusion (G : Type) [Group G] : Prop :=
  Nonempty (G ≃* alternatingGroup (Fin 7)) ∨ Nonempty (G ≃* Open.StatedM11) ∨
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (p n : ℕ), p.Prime ∧ (n = 1 ∨ n = 2) ∧ Nat.card F = p ^ n ∧
      5 ≤ p ^ n ∧ Nonempty (G ≃* PSL2 F)

/-- The conclusion of Lemma (1.6) for `X = G/S(G)`: `A₇`, `M₁₁`, `PSL(2, pⁿ)` or `PGL(2, pⁿ)` with `n ≤ 2` and
`pⁿ ≥ 5`, or `PGL*(2, p²)`. -/
def Lemma16Conclusion (X : Type) [Group X] : Prop :=
  Nonempty (X ≃* alternatingGroup (Fin 7)) ∨ Nonempty (X ≃* Open.StatedM11) ∨
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (p n : ℕ), p.Prime ∧ (n = 1 ∨ n = 2) ∧ Nat.card F = p ^ n ∧
      5 ≤ p ^ n ∧
      (Nonempty (X ≃* PSL2 F) ∨ Nonempty (X ≃* PGL2 F) ∨ (n = 2 ∧ Nonempty (X ≃* PGLStar F)))

/-- The groups `A` of Theorem 1 (ii) with `A = A'`: `M₁₁`, `A₇`, `Ã₇`, `PSL(2, pⁱ)`, `SL(2, pⁱ)`, `i ≤ 2`,
`pⁱ ≥ 5`. -/
def PerfectList (A : Type) [Group A] : Prop :=
  Nonempty (A ≃* Open.StatedM11) ∨ Nonempty (A ≃* alternatingGroup (Fin 7)) ∨
    IsDoubleStemCover A (alternatingGroup (Fin 7)) ∨
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (p i : ℕ), p.Prime ∧ (i = 1 ∨ i = 2) ∧ Nat.card F = p ^ i ∧
      5 ≤ p ^ i ∧ (Nonempty (A ≃* PSL2 F) ∨ Nonempty (A ≃* SL(2, F)))

/-- The groups `A` of Theorem 1 (ii) with `|A : A'| = 2`: `PGL(2, pⁱ)`, `PGL(2, pⁱ)⁺`, `PGL(2, pⁱ)⁻`, `i ≤ 2`,
`pⁱ ≥ 5`, and `PGL*(2, p²)`. -/
def PGLList (A : Type) [Group A] : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F) (p i : ℕ), p.Prime ∧ (i = 1 ∨ i = 2) ∧ Nat.card F = p ^ i ∧
    5 ≤ p ^ i ∧ (Nonempty (A ≃* PGL2 F) ∨ IsDoubleStemCover A (PGL2 F) ∨ (i = 2 ∧ Nonempty (A ≃* PGLStar F)))

/-- The conclusion of Theorem 1: `G = NA` with `N ⊴ G` of odd order with a Sylow tower and `N ∩ A = 1`, and either
(i) `G` is solvable and `A` is a Hall `{2, 3}`-subgroup (order `2ᵃ3ᵇ`, `N` of order prime to 6), or (ii) `N = O(G)`,
a prime dividing `|A|` and `|N|` has abelian Sylow subgroups in `G` and cyclic ones in `A` and `N`, and either
`A = A'` is one of `M₁₁, A₇, Ã₇, PSL(2, pⁱ), SL(2, pⁱ)` and (unless `A ≅ SL(2, 5)`) `G = A × N`, or `|A : A'| = 2`, `A` is one of `PGL(2, pⁱ)`,
`PGL(2, pⁱ)^±`, `PGL*(2, p²)`, and `|A : C_A(N)| ≤ 2`. -/
def Theorem1Conclusion (G : Type) [Group G] [Finite G] : Prop :=
  ∃ N A : Subgroup G, N.Normal ∧ N ⊓ A = ⊥ ∧ N ⊔ A = ⊤ ∧ Odd (Nat.card N) ∧ HasSylowTower N ∧
    ((Group.IsSolvable G ∧ (∃ a b : ℕ, Nat.card A = 2 ^ a * 3 ^ b) ∧ Nat.Coprime (Nat.card A) A.index ∧
        Nat.Coprime (Nat.card N) 6) ∨
      (N = oddCore G ∧
        (∀ q : ℕ, q.Prime → q ∣ Nat.card A → q ∣ Nat.card N →
          ∀ [Fact q.Prime], (∀ Q : Sylow q G, IsMulCommutative Q) ∧ (∀ Q : Sylow q A, IsCyclic Q) ∧
            (∀ Q : Sylow q N, IsCyclic Q)) ∧
        ((PerfectList A ∧ commutator A = ⊤ ∧
            (IsEmpty (A ≃* SL(2, ZMod 5)) → A ≤ Subgroup.centralizer (N : Set G))) ∨
          (PGLList A ∧ (commutator A).index = 2 ∧ (Subgroup.centralizer (N : Set G)).relIndex A ≤ 2))))

end CFSGOutside.ChillagSonn
