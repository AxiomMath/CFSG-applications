import CFSGOutside.AOVTame.FTransport

/-!
# AOV tameness: the decomposition of `T` into minimal direct factors

With `Good T`, every direct factor of `T` is generated by the minimal direct factors it contains.
Hence `T` is the internal direct product of its minimal direct factors `X_i`, each with
complement `∏_{j ≠ i} X_j` (AOV Proposition 3.5). If each `F_{X_i}(G)` is realized by
`E_i : X_i → H_i`, then `F_T(G)` is realized by `t ↦ (E_i(t_i))_i` (the product of the `F_{X_i}(G)`,
AOV §3).
-/

namespace AndersenOliverVentura.Tame

open Subgroup CFSGOutside.Corpus

attribute [local instance] Nat.fact_prime_two

variable {G : Type} [Group G] [Finite G] {T : Sylow 2 G}

section Basic

lemma decomp_top : Decomp T (T : Subgroup G) ⊥ where
  leX := le_rfl
  leY := bot_le
  inf := inf_bot_eq _
  comm x _ y hy := by rw [mem_bot.1 hy]; group
  sup t ht := ⟨t, ht, 1, one_mem _, (mul_one t).symm⟩
  scX _ _ _ hg := hg
  scY a ha g _ := by
    rw [SetLike.mem_coe, mem_bot] at ha ⊢
    rw [ha]; group

lemma isFactor_top : IsFactor T (T : Subgroup G) := ⟨⊥, decomp_top⟩

lemma IsFactor.le {X : Subgroup G} (h : IsFactor T X) : X ≤ T := let ⟨_, hY⟩ := h; hY.leX

variable (T) in
/-- The minimal direct factors of `T` contained in `Z`. -/
def minBelow (Z : Subgroup G) : Set (Subgroup G) := {Y | IsMinFactor T Y ∧ Y ≤ Z}

end Basic

section Gen
variable [GoldschmidtTheoremA] (hG : Good T)
include hG

/-- Every direct factor is generated by the minimal direct factors it contains. -/
theorem IsFactor.le_sSup_min {Z : Subgroup G} (hZ : IsFactor T Z) : Z ≤ sSup (minBelow T Z) := by
  suffices H : ∀ n, ∀ Z : Subgroup G, Nat.card Z = n → IsFactor T Z → Z ≤ sSup (minBelow T Z) from
    H _ Z rfl hZ
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro Z h hZ
    by_cases hbot : Z = ⊥
    · rw [hbot]; exact bot_le
    by_cases hmin : ∀ X' : Subgroup G, IsFactor T X' → X' ≤ Z → X' = ⊥ ∨ X' = Z
    · exact le_sSup ⟨⟨hZ, hbot, hmin⟩, le_rfl⟩
    push Not at hmin
    obtain ⟨X', hX', hle, hne1, hne2⟩ := hmin
    obtain ⟨C', h'⟩ := hX'
    obtain ⟨W, hW⟩ := hZ
    have hK : IsFactor T (Z ⊓ C') := ⟨_, hW.inf_decomp hG h'.symm⟩
    have hcard1 : Nat.card X' < n := by
      rw [← h]
      by_contra hc; push Not at hc
      exact hne2 (Subgroup.eq_of_le_of_card_ge hle hc)
    have hcard2 : Nat.card (Z ⊓ C' : Subgroup G) < n := by
      rw [← h]
      by_contra hc; push Not at hc
      have e : Z ⊓ C' = Z := Subgroup.eq_of_le_of_card_ge inf_le_left hc
      apply hne1
      have hZC : Z ≤ C' := by rw [← e]; exact inf_le_right
      rw [eq_bot_iff, ← h'.inf]; exact le_inf le_rfl (hle.trans hZC)
    have i1 := ih _ hcard1 X' rfl ⟨C', h'⟩
    have i2 := ih _ hcard2 (Z ⊓ C') rfl hK
    have m1 : sSup (minBelow T X') ≤ sSup (minBelow T Z) :=
      sSup_le_sSup (fun Y hY => ⟨hY.1, hY.2.trans hle⟩)
    have m2 : sSup (minBelow T (Z ⊓ C')) ≤ sSup (minBelow T Z) :=
      sSup_le_sSup (fun Y hY => ⟨hY.1, hY.2.trans inf_le_left⟩)
    intro z hz
    obtain ⟨x, hx, c, hc, rfl⟩ := h'.sup z (hW.leX hz)
    have hcZ : c ∈ Z := by
      have := mul_mem (inv_mem (hle hx)) hz
      simpa using this
    exact mul_mem (m1 (i1 hx)) (m2 (i2 (mem_inf.2 ⟨hcZ, hc⟩)))

end Gen

section MinDec

/-- A family of subgroups decomposing `T` as an internal direct product of direct factors. -/
structure MinDec (T : Sylow 2 G) {ι : Type} (X : ι → Subgroup G) : Prop where
  dec : ∀ i, Decomp T (X i) (⨆ (j) (_ : j ≠ i), X j)
  top : (T : Subgroup G) ≤ ⨆ i, X i

/-- The minimal direct factors of `T`. -/
abbrev MinF (T : Sylow 2 G) := {X : Subgroup G // IsMinFactor T X}

instance : Finite (Subgroup G) := Finite.of_injective _ SetLike.coe_injective

noncomputable instance : Fintype (MinF T) := Fintype.ofFinite _

variable [GoldschmidtTheoremA] (hG : Good T)
include hG

/-- `∏_{j ≠ i} X_j` is a complement of the minimal factor `X_i`. -/
theorem decomp_minF (i : MinF T) : Decomp T i (⨆ (j : MinF T) (_ : j ≠ i), (j : Subgroup G)) := by
  obtain ⟨C, h⟩ := i.2.1
  suffices e : (⨆ (j : MinF T) (_ : j ≠ i), (j : Subgroup G)) = C by rw [e]; exact h
  apply le_antisymm
  · refine iSup₂_le fun j hj => ?_
    rcases j.2.le_or hG h with h1 | h1
    · rcases i.2.2.2 _ j.2.1 h1 with h2 | h2
      · exact absurd h2 j.2.2.1
      · exact absurd (Subtype.ext h2) hj
    · exact h1
  · refine (IsFactor.le_sSup_min hG ⟨_, h.symm⟩).trans (sSup_le fun Y hY => ?_)
    have hYi : (⟨Y, hY.1⟩ : MinF T) ≠ i := by
      intro e
      apply i.2.2.1
      have : (i : Subgroup G) ≤ C := (congrArg Subtype.val e) ▸ hY.2
      rw [eq_bot_iff, ← h.inf]; exact le_inf le_rfl this
    exact le_iSup₂_of_le (⟨Y, hY.1⟩ : MinF T) hYi le_rfl

theorem minDec_minF : MinDec T (fun i : MinF T => (i : Subgroup G)) :=
  ⟨decomp_minF hG, (IsFactor.le_sSup_min hG isFactor_top).trans
    (sSup_le fun Y hY => le_iSup_of_le (⟨Y, hY.1⟩ : MinF T) le_rfl)⟩

end MinDec

lemma MinDec.reindex {ι J : Type} {X : ι → Subgroup G} (hX : MinDec T X) (e : J ≃ ι) :
    MinDec T (X ∘ e) := by
  have key : ∀ j, (⨆ (j') (_ : j' ≠ j), (X ∘ e) j') = ⨆ (i) (_ : i ≠ e j), X i := by
    intro j
    apply le_antisymm
    · exact iSup₂_le fun j' hj' => le_iSup₂_of_le (e j') (fun h => hj' (e.injective h)) le_rfl
    · refine iSup₂_le fun i hi => le_iSup₂_of_le (e.symm i) (fun h => hi ?_) (by simp)
      rw [← h]; simp
  refine ⟨fun j => ?_, ?_⟩
  · rw [key]; exact hX.dec (e j)
  · refine hX.top.trans (iSup_le fun i => le_iSup_of_le (e.symm i) ?_)
    simp

section Real
variable [GoldschmidtTheoremA] (hG : Good T) {ι : Type} [Fintype ι] [DecidableEq ι]
  {X : ι → Subgroup G} (hX : MinDec T X)
include hX

namespace MinDec

lemma le (i : ι) : X i ≤ T := (hX.dec i).leX

lemma le_compl {i j : ι} (h : j ≠ i) : X j ≤ ⨆ (k) (_ : k ≠ i), X k := le_iSup₂_of_le j h le_rfl

lemma commX : Pairwise fun i j => ∀ x y : G, x ∈ X i → y ∈ X j → Commute x y := by
  intro i j hij x y hx hy
  exact (hX.dec i).comm x hx y (hX.le_compl hij.symm hy)

include hG in
lemma commN : Pairwise fun i j => ∀ x y : G, x ∈ normalClosure (X i : Set G) →
    y ∈ normalClosure (X j : Set G) → Commute x y := by
  intro i j hij x y hx hy
  exact (hX.dec i).commute_N hG hx (normalClosure_mono (SetLike.coe_subset_coe.2
    (hX.le_compl hij.symm)) hy)

lemma indep : iSupIndep X := fun i => disjoint_iff.2 (hX.dec i).inf

/-- `∏ X_i → G`. -/
noncomputable def nu : (∀ i, X i) →* G := Subgroup.noncommPiCoprod hX.commX

lemma nu_injective : Function.Injective hX.nu :=
  Subgroup.injective_noncommPiCoprod_of_iSupIndep hX.indep

lemma range_nu : hX.nu.range = T := by
  rw [nu, Subgroup.noncommPiCoprod_range]
  exact le_antisymm (iSup_le hX.le) hX.top

/-- `∏ X_i ≃ T`. -/
noncomputable def equiv : (∀ i, X i) ≃* T :=
  (MonoidHom.ofInjective hX.nu_injective).trans (MulEquiv.subgroupCongr hX.range_nu)

lemma equiv_apply (u : ∀ i, X i) : ((hX.equiv u : T) : G) = hX.nu u := by
  change ((MonoidHom.ofInjective hX.nu_injective u : hX.nu.range) : G) = _
  exact MonoidHom.ofInjective_apply _

lemma nu_symm (t : T) : hX.nu (hX.equiv.symm t) = t := by
  rw [← hX.equiv_apply, MulEquiv.apply_symm_apply]

/-- The component `t_i ∈ X_i` of `t ∈ T`. -/
noncomputable def comp (i : ι) : (T : Subgroup G) →* X i :=
  (Pi.evalMonoidHom (fun i => X i) i).comp hX.equiv.symm.toMonoidHom

lemma comp_apply (i : ι) (t : T) : hX.comp i t = hX.equiv.symm t i := rfl

lemma nu_update_mem (u : ∀ i, X i) (i : ι) :
    hX.nu (Function.update u i 1) ∈ ⨆ (j) (_ : j ≠ i), X j := by
  rw [nu, Subgroup.noncommPiCoprod_apply]
  apply Subgroup.noncommProd_mem
  intro j _
  by_cases hj : j = i
  · subst hj; simp
  · rw [Function.update_of_ne hj]; exact hX.le_compl hj (u j).2

lemma nu_decomp (u : ∀ i, X i) (i : ι) :
    hX.nu u = (u i : G) * hX.nu (Function.update u i 1) := by
  have e : u = Pi.mulSingle i (u i) * Function.update u i 1 := by
    funext j
    by_cases hj : j = i
    · subst hj; simp
    · simp [Pi.mulSingle_eq_of_ne hj, Function.update_of_ne hj]
  conv_lhs => rw [e]
  rw [map_mul, nu, Subgroup.noncommPiCoprod_mulSingle]

lemma comp_spec (t : T) (i : ι) :
    (t : G) = (hX.comp i t : G) * hX.nu (Function.update (hX.equiv.symm t) i 1) :=
  (hX.nu_symm t).symm.trans (hX.nu_decomp _ i)

lemma comp_eq {t : T} {i : ι} {x c : G} (hx : x ∈ X i) (hc : c ∈ ⨆ (j) (_ : j ≠ i), X j)
    (e : (t : G) = x * c) : (hX.comp i t : G) = x :=
  ((hX.dec i).unique (hX.comp i t).2 hx (hX.nu_update_mem _ i) hc
    ((hX.comp_spec t i).symm.trans e)).1

lemma comp_self {i : ι} {x : G} (hx : x ∈ X i) : (hX.comp i ⟨x, hX.le i hx⟩ : G) = x :=
  hX.comp_eq hx (one_mem _) (mul_one x).symm

lemma comp_ne {i j : ι} (h : j ≠ i) {x : G} (hx : x ∈ X j) :
    (hX.comp i ⟨x, hX.le j hx⟩ : G) = 1 :=
  hX.comp_eq (one_mem _) (hX.le_compl h hx) (one_mul x).symm

include hG in
lemma nuN_incl (u : ∀ i, X i) :
    Subgroup.noncommPiCoprod (hX.commN hG)
      (fun i => (⟨(u i : G), subset_normalClosure (u i).2⟩ : normalClosure (X i : Set G))) =
      hX.nu u := by
  rw [nu, Subgroup.noncommPiCoprod_apply, Subgroup.noncommPiCoprod_apply]

variable {H : ι → Type} [∀ i, Group (H i)] (E : ∀ i, X i →* H i)

/-- `t ↦ (E_i(t_i))_i`. -/
noncomputable def piE : (T : Subgroup G) →* ∀ i, H i := MonoidHom.pi fun i => (E i).comp (hX.comp i)

lemma piE_apply (t : T) (i : ι) : hX.piE E t i = E i (hX.comp i t) := rfl

lemma piE_injective (hE : ∀ i, Function.Injective (E i)) : Function.Injective (hX.piE E) := by
  intro t t' e
  apply hX.equiv.symm.injective
  funext i
  exact hE i (congrFun e i)

lemma piE_range {S : ∀ i, Subgroup (H i)} (hr : ∀ i, (E i).range = S i) :
    (hX.piE E).range = Subgroup.pi Set.univ S := by
  ext s
  constructor
  · rintro ⟨t, rfl⟩
    refine (mem_pi _).2 fun i _ => ?_
    rw [← hr i]; exact ⟨_, rfl⟩
  · intro hs
    have hs' : ∀ i, s i ∈ (E i).range := fun i => (hr i).symm ▸ ((mem_pi _).1 hs i (Set.mem_univ i))
    choose u hu using hs'
    refine ⟨hX.equiv u, funext fun i => ?_⟩
    rw [piE_apply, comp_apply, MulEquiv.symm_apply_apply]
    exact hu i

lemma piE_single {i : ι} {x : G} (hx : x ∈ X i) :
    hX.piE E ⟨x, hX.le i hx⟩ = Pi.mulSingle i (E i ⟨x, hx⟩) := by
  funext j
  rw [piE_apply]
  by_cases hj : j = i
  · subst hj
    rw [Pi.mulSingle_eq_same]
    congr 1
    exact Subtype.ext (hX.comp_self hx)
  · rw [Pi.mulSingle_eq_of_ne hj]
    have : hX.comp j ⟨x, hX.le i hx⟩ = 1 := Subtype.ext ((hX.comp_ne (Ne.symm hj) hx).trans rfl)
    rw [this, map_one]

include hG in
/-- **Realization of the product.** If each `F_{X_i}(G)` is realized by `E_i`, then `F_T(G)` is
realized by `t ↦ (E_i(t_i))_i`. -/
theorem realizedBy_piE (hE : ∀ i, Function.Injective (E i))
    (hR : ∀ i, RealizedBy (ofGroup G (X i)) (E i)) : RealizedBy (ofGroup G T) (hX.piE E) := by
  intro P Q φ
  constructor
  · rintro ⟨g, hg⟩
    have hP : P.map (T : Subgroup G).subtype ≤ T := by rintro _ ⟨x, -, rfl⟩; exact x.2
    have hPg : (P.map (T : Subgroup G).subtype).map (MulAut.conj g⁻¹⁻¹).toMonoidHom ≤ T := by
      rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
      simp only [inv_inv, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe, MulAut.conj_apply]
      change g * (x : G) * g⁻¹ ∈ (T : Subgroup G)
      rw [← hg ⟨x, hx⟩]; exact (φ ⟨x, hx⟩ : T).2
    have key : ∀ i, ∃ h : H i, ∀ x : P,
        E i (hX.comp i (φ x)) = h * E i (hX.comp i x) * h⁻¹ := by
      intro i
      obtain ⟨a, ha, b, hb, hab⟩ := (hX.dec i).realize hG hP hPg
      have hcomp : ∀ x : P, (hX.comp i (φ x) : G) = a⁻¹ * (hX.comp i x : G) * a := by
        intro x
        have hxi := hX.comp_spec x i
        have hc := hX.nu_update_mem (hX.equiv.symm x) i
        have e1 := hab ((x : T) : G) ⟨(x : T), x.2, rfl⟩
        have hT : (a * b)⁻¹ * ((hX.comp i x : G) *
            hX.nu (Function.update (hX.equiv.symm x) i 1)) * (a * b) ∈ (T : Subgroup G) := by
          rw [← hxi, e1, inv_inv, ← hg x]; exact (φ x : T).2
        obtain ⟨m1, m2⟩ := (hX.dec i).conj_mem_X hG ha hb (hX.comp i x).2 hc hT
        apply hX.comp_eq m1 m2
        calc ((φ x : T) : G) = g * ((x : T) : G) * g⁻¹ := hg x
          _ = (a * b)⁻¹ * ((x : T) : G) * (a * b) := by rw [e1, inv_inv]
          _ = (a * b)⁻¹ * ((hX.comp i x : G) *
              hX.nu (Function.update (hX.equiv.symm x) i 1)) * (a * b) := by rw [← hxi]
          _ = _ := (hX.dec i).conj_components hG ha hb (hX.comp i x).2 hc
      have hmem : ∀ y : P.map (hX.comp i), a⁻¹ * ((y : X i) : G) * a⁻¹⁻¹ ∈
          (⊤ : Subgroup (X i)).map (X i).subtype := by
        rintro ⟨_, x, hx, rfl⟩
        refine ⟨hX.comp i (φ ⟨x, hx⟩), trivial, ?_⟩
        rw [coe_subtype, hcomp ⟨x, hx⟩, inv_inv]
      obtain ⟨h, hh⟩ := (hR i _ _ (conjMap _ _ a⁻¹ hmem)).1 ⟨a⁻¹, fun _ => rfl⟩
      refine ⟨h, fun x => ?_⟩
      have := hh ⟨hX.comp i x, mem_map_of_mem _ x.2⟩
      refine (congrArg (E i) ?_).trans this
      apply Subtype.ext
      rw [hcomp x, coe_conjMap, inv_inv]
    choose h hh using key
    exact ⟨h, fun x => funext fun i => hh i x⟩
  · rintro ⟨h, hh⟩
    have hh' : ∀ i (x : P), E i (hX.comp i (φ x)) = h i * E i (hX.comp i x) * (h i)⁻¹ :=
      fun i x => congrFun (hh x) i
    have key : ∀ i, ∃ a ∈ normalClosure (X i : Set G), ∀ x : P,
        (hX.comp i (φ x) : G) = a⁻¹ * (hX.comp i x : G) * a := by
      intro i
      obtain ⟨ψ, ⟨gi, hgi⟩, hψ⟩ := (hR i).exists_mem (hE i) (P := P.map (hX.comp i))
        (Q := ⊤) (h i) (by
          rintro ⟨_, x, hx, rfl⟩
          exact ⟨hX.comp i (φ ⟨x, hx⟩), trivial, hh' i ⟨x, hx⟩⟩)
      have hv : ∀ x : P, (hX.comp i (φ x) : G) = gi * (hX.comp i x : G) * gi⁻¹ := by
        intro x
        have e1 := hψ ⟨hX.comp i x, mem_map_of_mem _ x.2⟩
        rw [← hh' i x] at e1
        have e2 := hE i e1
        rw [← e2]; exact hgi _
      set P' : Subgroup G := (P.map (hX.comp i)).map (X i).subtype
      have hP' : P' ≤ T := by rintro _ ⟨y, -, rfl⟩; exact hX.le i y.2
      have hPg : P'.map (MulAut.conj gi⁻¹⁻¹).toMonoidHom ≤ T := by
        rintro _ ⟨_, ⟨_, ⟨x, hx, rfl⟩, rfl⟩, rfl⟩
        simp only [inv_inv, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe, MulAut.conj_apply]
        change gi * (hX.comp i x : G) * gi⁻¹ ∈ (T : Subgroup G)
        rw [← hv ⟨x, hx⟩]; exact hX.le i (hX.comp i _).2
      obtain ⟨a, ha, b, hb, hab⟩ := (hX.dec i).realize hG hP' hPg
      refine ⟨a, ha, fun x => ?_⟩
      have e1 := hab (hX.comp i x : G) ⟨_, mem_map_of_mem _ x.2, rfl⟩
      have hyN : a⁻¹ * (hX.comp i x : G) * a ∈ normalClosure (X i : Set G) := by
        have := (normalClosure_normal (s := (X i : Set G))).conj_mem _
          (subset_normalClosure (hX.comp i x).2) a⁻¹
        simpa using this
      have hcomm := (hX.dec i).commute_N hG hyN hb
      calc (hX.comp i (φ x) : G) = gi * (hX.comp i x : G) * gi⁻¹ := hv x
        _ = (a * b)⁻¹ * (hX.comp i x : G) * (a * b) := by rw [e1, inv_inv]
        _ = b⁻¹ * (a⁻¹ * (hX.comp i x : G) * a) * b := by group
        _ = a⁻¹ * (hX.comp i x : G) * a := by
          rw [mul_assoc, hcomm, inv_mul_cancel_left]
    choose a ha hav using key
    set A := Subgroup.noncommPiCoprod (hX.commN hG)
      (fun i => (⟨a i, ha i⟩ : normalClosure (X i : Set G)))
    refine ⟨A⁻¹, fun x => ?_⟩
    have hx : ((x : T) : G) = Subgroup.noncommPiCoprod (hX.commN hG)
        (fun i => (⟨(hX.equiv.symm x i : G), subset_normalClosure (hX.equiv.symm x i).2⟩ :
          normalClosure (X i : Set G))) := by
      rw [hX.nuN_incl hG, hX.nu_symm]
    have hφ : ((φ x : T) : G) = Subgroup.noncommPiCoprod (hX.commN hG)
        (fun i => (⟨(hX.equiv.symm (φ x) i : G), subset_normalClosure (hX.equiv.symm (φ x) i).2⟩ :
          normalClosure (X i : Set G))) := by
      rw [hX.nuN_incl hG, hX.nu_symm]
    have hfam : (fun i => (⟨(hX.equiv.symm (φ x) i : G),
        subset_normalClosure (hX.equiv.symm (φ x) i).2⟩ : normalClosure (X i : Set G))) =
        (fun i => (⟨a i, ha i⟩ : normalClosure (X i : Set G)))⁻¹ *
          (fun i => (⟨(hX.equiv.symm x i : G), subset_normalClosure (hX.equiv.symm x i).2⟩ :
            normalClosure (X i : Set G))) * (fun i => ⟨a i, ha i⟩) := by
      funext i
      apply Subtype.ext
      simp only [Pi.mul_apply, Pi.inv_apply, MulMemClass.coe_mul, InvMemClass.coe_inv]
      exact hav i x
    rw [hφ, hfam, map_mul, map_mul, map_inv, ← hx, inv_inv]

end MinDec

end Real

end AndersenOliverVentura.Tame
