def transversal (k : ℕ) (j : Fin 12) : List ℕ := ((tbl.getD k []).getD j.val [])

theorem transversal_spec : ∀ k < 5, ∀ j : Fin 12, k ≤ j.val →
    (∀ i < k, evPt (transversal k j) (pt i) = (pt i)) ∧
      evPt (transversal k j) (pt k) = j := by
  decide +kernel

theorem letterFn_mem (n : ℕ) : letterFn n ∈ M12 := by
  have ha : m12gA ∈ M12 := Subgroup.subset_closure (Set.mem_insert _ _)
  have hb : m12gB ∈ M12 := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  match n with
  | 0 => exact ha
  | 1 => exact hb
  | 2 => exact inv_mem ha
  | _ + 3 => exact inv_mem hb

def evPerm (w : List ℕ) : Equiv.Perm (Fin 12) := (w.map letterFn).prod

theorem evPerm_mem (w : List ℕ) : evPerm w ∈ M12 :=
  Subgroup.list_prod_mem _ (by
    intro x hx
    obtain ⟨n, -, rfl⟩ := List.mem_map.1 hx
    exact letterFn_mem n)

theorem evPerm_apply (w : List ℕ) (x : Fin 12) : evPerm w x = evPt w x := by
  induction w with
  | nil => rfl
  | cons n w ih =>
    simp only [evPerm, List.map_cons, List.prod_cons, Equiv.Perm.mul_apply] at ih ⊢
    rw [ih]
    rfl

theorem exists_prefix : ∀ k ≤ 5, ∀ f : ℕ → Fin 12,
    (∀ i j, i < k → j < k → f i = f j → i = j) →
    ∃ h ∈ M12, ∀ i < k, h (pt i) = f i := by
  intro k
  induction k with
  | zero => intro _ f _; exact ⟨1, one_mem _, fun i hi => absurd hi (by omega)⟩
  | succ k ih =>
    intro hk f hf
    obtain ⟨h, hhM, hh⟩ := ih (by omega) f (fun i j hi hj => hf i j (by omega) (by omega))
    set j : Fin 12 := h⁻¹ (f k) with hj
    have hjk : k ≤ j.val := by
      by_contra hlt
      simp only [not_le] at hlt
      have hjnat : (pt j.val) = j := pt_val_self j
      have h1 : h j = f k := by rw [hj]; simp
      have h2 : h (pt j.val) = f j.val := hh j.val hlt
      rw [hjnat] at h2
      have := hf k j.val (by omega) (by omega) (by rw [← h1, h2])
      omega
    obtain ⟨hfix, hmap⟩ := transversal_spec k (by omega) j hjk
    refine ⟨h * evPerm (transversal k j), mul_mem hhM (evPerm_mem _), fun i hi => ?_⟩
    rw [Equiv.Perm.mul_apply, evPerm_apply]
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hik | rfl
    · rw [hfix i hik]; exact hh i hik
    · rw [hmap]; simp [hj]

theorem m12_five_transitive : MulAction.IsMultiplyPretransitive M12 (Fin 12) 5 := by
  have key : ∀ x : Fin 5 ↪ Fin 12, ∃ g : M12, ∀ i : Fin 5,
      (g : Equiv.Perm (Fin 12)) (pt i.val) = x i := by
    intro x
    obtain ⟨h, hhM, hh⟩ := exists_prefix 5 le_rfl (fun i => if hi : i < 5 then x ⟨i, hi⟩ else 0)
      (by
        intro i j hi hj hij
        simp only [hi, hj, dite_true] at hij
        exact Fin.mk.inj_iff.1 (x.injective hij))
    exact ⟨⟨h, hhM⟩, fun i => by simpa [i.2] using hh i.val i.2⟩
  refine MulAction.isMultiplyPretransitive_iff.2 fun x y => ?_
  obtain ⟨gx, hgx⟩ := key x
  obtain ⟨gy, hgy⟩ := key y
  refine ⟨gy * gx⁻¹, ?_⟩
  ext i
  have h1 : (gx⁻¹ : M12) • (x i) = pt i.val := by
    rw [inv_smul_eq_iff]; exact (hgx i).symm
  simp only [Function.Embedding.smul_apply] 
  rw [mul_smul, h1]
  exact congrArg Fin.val (hgy i)

end CFSGOutside.WittDesigns.Witt5612
