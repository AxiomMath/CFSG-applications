import Mathlib

/-!
# The Mathieu group `M12` is 5-transitive

`M12` is the subgroup of `Sym(12)` generated by the two permutations `m12gA` and `m12gB` (copied verbatim
from the corpus definition `CFSG.Blueprint.NativeSporadic.M12`, which is `Subgroup.closure {m12gA, m12gB}`).
A stabilizer chain with explicit transversals, written as words in the generators and checked by kernel
evaluation, shows 5-transitivity.
-/

namespace CFSGOutside.WittDesigns.Witt5612

open Equiv Equiv.Perm

abbrev m12gA : Equiv.Perm (Fin 12) :=
  List.formPerm [0, 3] * List.formPerm [2, 9] * List.formPerm [4, 10] * List.formPerm [5, 11]

abbrev m12gB : Equiv.Perm (Fin 12) :=
  List.formPerm [0, 7, 8] * List.formPerm [1, 2, 3] * List.formPerm [4, 11, 10] *
    List.formPerm [5, 9, 6]

def M12 : Subgroup (Equiv.Perm (Fin 12)) := Subgroup.closure {m12gA, m12gB}

def letterFn : ℕ → Equiv.Perm (Fin 12)
  | 0 => m12gA
  | 1 => m12gB
  | 2 => m12gA⁻¹
  | _ => m12gB⁻¹

def pt (i : ℕ) : Fin 12 := Fin.ofNat 12 i

theorem pt_val_self (j : Fin 12) : (pt j.val) = j := Fin.ext (Nat.mod_eq_of_lt j.2)

def evPt (w : List ℕ) (x : Fin 12) : Fin 12 := w.foldr (fun n y => letterFn n y) x

