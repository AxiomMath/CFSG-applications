import Mathlib

/-!
# Khukhro–Shumyatsky, fixed points: the subgroups in the statements

E. I. Khukhro and P. Shumyatsky, *On the length of finite groups and of fixed points*, Proc. Amer. Math. Soc.
**143** (2015), no. 9, 3781–3790, arXiv:1405.1946.

The fixed-point subgroup `C_G(φ)` of an automorphism (`fixedSub`), the subgroup `[G, φ]` generated by the
elements `g⁻¹ φ(g)` (`commSub`), and the fixed-point subgroup `C_G(A)` of a group `A` acting by automorphisms
(`fixA`), which appear in Theorem 1.3 and Proposition 3.2.
-/

namespace CFSGOutside.KhukhroShumyatskyFixedPointLength

open Subgroup

variable {G : Type*} [Group G]

/-- The fixed-point subgroup `C_G(φ) = {g | φ(g) = g}` of an automorphism `φ` of `G`
(Khukhro–Shumyatsky, Proc. AMS 2015, Proposition 3.2). -/
def fixedSub (φ : MulAut G) : Subgroup G where
  carrier := {g | φ g = g}
  mul_mem' {a b} ha hb := by simp only [Set.mem_setOf_eq] at *; rw [map_mul, ha, hb]
  one_mem' := map_one φ
  inv_mem' {a} ha := by simp only [Set.mem_setOf_eq] at *; rw [map_inv, ha]

lemma mem_fixedSub {φ : MulAut G} {g : G} : g ∈ fixedSub φ ↔ φ g = g := Iff.rfl

/-- The subgroup `[G, φ]` generated by all `g⁻¹ φ(g)`, for an automorphism `φ` of `G`
(Khukhro–Shumyatsky, Proc. AMS 2015, Proposition 3.2). -/
def commSub (φ : MulAut G) : Subgroup G := closure {x | ∃ g, x = g⁻¹ * φ g}

lemma inv_mul_mem_commSub (φ : MulAut G) (g : G) : g⁻¹ * φ g ∈ commSub φ :=
  subset_closure ⟨g, rfl⟩

/-- The fixed points `C_G(A) = {g | ∀ a, a • g = g}` of a group `A` acting on `G` by automorphisms
`α : A →* MulAut G` (Khukhro–Shumyatsky, Proc. AMS 2015, Theorem 1.3). -/
def fixA {A : Type*} [Group A] (α : A →* MulAut G) : Subgroup G where
  carrier := {g | ∀ a, α a g = g}
  mul_mem' {x y} hx hy a := by rw [map_mul, hx a, hy a]
  one_mem' a := map_one _
  inv_mem' {x} hx a := by rw [map_inv, hx a]

end CFSGOutside.KhukhroShumyatskyFixedPointLength
