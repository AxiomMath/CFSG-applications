import CFSGOutside.Corpus.Defs.PGammaL2
import CFSGOutside.Corpus.Defs.LowTwoRankCatalog
import CFSGOutside.GiuliettiKorchmaros.Defs

/-!
# Giulietti–Korchmáros (2019), Theorem 6.1: the statement (odd core-free case)

M. Giulietti, G. Korchmáros, *Algebraic curves with many automorphisms*, Adv. Math. 349 (2019), Theorem 6.1, for
groups with `O(G) = 1`, in group-theoretic form: the hypothesis that `G` is an automorphism group of a curve of even
genus in odd characteristic is replaced by its consequence Lemma 6.2 (`CyclicIndexTwo G`).

The cases, numbered as in the paper (the paper has no case for `SL(2,3)`; it is added as case `(xii)`, see the
README):
* (i) `G` has odd order;
* (ii) `G = O(G) ⋊ S₂`, i.e. (as `O(G) = 1`) `G` is a 2-group;
* (iii) the commutator subgroup of `G` is `SL(2,q)`, `q ≥ 5` odd;
* (iv) `PSL(2,q) ≤ G ≤ PΓL(2,q)`, `q ≥ 3` odd: an embedding of `G` into `PΓL(2,q)` whose image contains `PSL(2,q)`;
* (v) `PSL(3,q) ≤ G ≤ Aut(PSL(3,q))`, `q ≡ 3 (mod 4)`: `G` has a normal subgroup `≅ PSL(3,q)` with trivial
  centralizer (the paper writes `PΓL(3,q)` for the automorphism group);
* (vi) the same with `PSU(3,q)`, `q ≡ 1 (mod 4)`;
* (vii) `G ≅ A₇`; (viii) `G ≅ M₁₁`; (ix) `G ≅ GL(2,3)`;
* (x) `G` is the perfect group of order 5040 with `G/Z(G) ≅ A₇`;
* (xi) `G ≅ SmallGroup(48,28)`, the binary octahedral group;
* (xii) `G ≅ SL(2,3)`.
-/

namespace CFSGOutside.GiuliettiKorchmaros

open scoped MatrixGroups
open CFSGOutside.Corpus

/-- Generators of the binary octahedral group inside `SL(2, ZMod 7)`. -/
def b48A : SL(2, ZMod 7) := ⟨!![0, 1; 6, 3], by decide⟩

/-- Generators of the binary octahedral group inside `SL(2, ZMod 7)`. -/
def b48B : SL(2, ZMod 7) := ⟨!![1, 1; 4, 5], by decide⟩

/-- The binary octahedral group `2O` (GAP `SmallGroup(48,28)`), as the subgroup of `SL(2,7)` generated by an element of
order 8 and one of order 3. -/
def binaryOctahedral : Subgroup SL(2, ZMod 7) := Subgroup.closure {b48A, b48B}

/-- The conclusion of Theorem 6.1 for an odd core-free group `G` (cases (i)–(xii) above). -/
def Theorem61Conclusion (G : Type) [Group G] [Finite G] : Prop :=
  Odd (Nat.card G) ∨
  IsPGroup 2 G ∨
  (∃ (F : Type) (_ : Field F) (_ : Finite F), ringChar F ≠ 2 ∧ 5 ≤ Nat.card F ∧
    Nonempty (commutator G ≃* SL(2, F))) ∨
  (∃ (F : Type) (_ : Field F) (_ : Finite F), ringChar F ≠ 2 ∧ 3 ≤ Nat.card F ∧
    ∃ φ : G →* GorensteinWalter.PGammaL2 F, Function.Injective φ ∧
      ((Matrix.ProjectiveSpecialLinearGroup.toPGL (n := Fin 2) (R := F)).range).map
        SemidirectProduct.inl ≤ φ.range) ∨
  (∃ p k : ℕ, ∃ _hp : Fact p.Prime, 0 < k ∧ p ^ k % 4 = 3 ∧ ∃ N : Subgroup G, N.Normal ∧
    Nonempty (N ≃* PSL(3, GaloisField p k)) ∧ Subgroup.centralizer (N : Set G) = ⊥) ∨
  (∃ p k : ℕ, ∃ _hp : Fact p.Prime, 0 < k ∧ p ^ k % 4 = 1 ∧ ∃ N : Subgroup G, N.Normal ∧
    Nonempty (N ≃* Open.PSU3 p k) ∧ Subgroup.centralizer (N : Set G) = ⊥) ∨
  Nonempty (G ≃* alternatingGroup (Fin 7)) ∨
  Nonempty (G ≃* Open.M11) ∨
  Nonempty (G ≃* GL (Fin 2) (ZMod 3)) ∨
  (commutator G = ⊤ ∧ Nat.card G = 5040 ∧
    Nonempty (G ⧸ Subgroup.center G ≃* alternatingGroup (Fin 7))) ∨
  Nonempty (G ≃* binaryOctahedral) ∨
  Nonempty (G ≃* SL(2, ZMod 3))

end CFSGOutside.GiuliettiKorchmaros
