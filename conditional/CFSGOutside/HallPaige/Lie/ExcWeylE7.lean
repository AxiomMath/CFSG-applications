section
variable [h0 : Corpus.Exc.Liftable] [h1 : Corpus.Exc.Descent]
include h0 h1

/-- **Double cosets of a maximal parabolic subgroup of `W(E7)` contain involutions.** -/
theorem weylCoverE7 : ∃ J : Set (Fin Tag.E7.rank),
    (∃ r, simple Tag.E7 r ∉ (coxeterSystem Tag.E7).parabolic J) ∧
    ∀ w : WeylGroup Tag.E7, ∃ x ∈ (coxeterSystem Tag.E7).parabolic J,
      ∃ y ∈ (coxeterSystem Tag.E7).parabolic J, (x * w * y) * (x * w * y) = 1 :=
  have hA : TauCeti.IsFiniteType (Tag.E7.cartan : Matrix (Fin 7) (Fin 7) ℤ) :=
    isFiniteType_cartan Tag.E7
  have hrows' : ∀ p : Fin 7 × Fin 7, (Tag.E7.cartan : Matrix (Fin 7) (Fin 7) ℤ) p.1 p.2 =
      (rowsE7.getD p.1 []).getD p.2 0 := by
    decide +kernel
  have hrows : ∀ i j : Fin 7, (Tag.E7.cartan : Matrix (Fin 7) (Fin 7) ℤ) i j =
      (rowsE7.getD i []).getD j 0 := fun i j => hrows' (i, j)
  have key := cover_of_lists (r := 7) hA rowsE7 hrows' lamE7 rfl orbitE7 twE7
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hr := simple_not_mem_parabolic hA (lam := vecL lamE7) (r := (6 : Fin 7))
    (ne_of_eq_of_ne (sum_mul_vecL_eq_dotL rowsE7 hrows rfl _) (by decide +kernel))
  ⟨_, ⟨_, hr⟩, key⟩

end

end CFSGOutside.HallPaige.Exc
