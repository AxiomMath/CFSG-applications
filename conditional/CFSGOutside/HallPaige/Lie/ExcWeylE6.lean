import CFSGOutside.HallPaige.Lie.ExcWeyl

/-!
# Weyl group data for `E6`

The orbit of the dominant vector `λ` under the Weyl group, with certificates that every
double coset of the stabilizer `W_J` contains an involution (generated by a script). All checks are by `decide +kernel`.
-/

namespace CFSGOutside.HallPaige.Exc

open CFSGOutside.Corpus.Exc

/-- Rows of the Cartan matrix of type `E6`. -/
def rowsE6 : List (List ℤ) := [[2, 0, -1, 0, 0, 0], [0, 2, 0, -1, 0, 0], [-1, 0, 2, -1, 0, 0], [0, -1, -1, 2, -1, 0], [0, 0, 0, -1, 2, -1], [0, 0, 0, 0, -1, 2]]

/-- The dominant vector `λ` for type `E6` (root coordinates). -/
def lamE6 : List ℤ := [4, 3, 5, 6, 4, 2]

/-- Involutions `t_k` (words, rightmost letter applied first) with `t_k λ` the `J`-dominant
representatives of the `W_J`-orbits. -/
def twE6 : List (List (Fin 6)) := [[], [0], [0, 2, 3, 1, 4, 3, 2, 0]]

/-- The orbit `Wλ` (27 vectors), each with a word in `J` moving it to `t_k λ`, and `k`. -/
def orbitE6 : List (List ℤ × List (Fin 6) × ℕ) := [
  ([4, 3, 5, 6, 4, 2], [], 0),
  ([1, 3, 5, 6, 4, 2], [], 1),
  ([1, 3, 2, 6, 4, 2], [2], 1),
  ([1, 3, 2, 3, 4, 2], [2, 3], 1),
  ([1, 0, 2, 3, 4, 2], [2, 3, 1], 1),
  ([1, 3, 2, 3, 1, 2], [2, 3, 4], 1),
  ([1, 0, 2, 3, 1, 2], [2, 3, 4, 1], 1),
  ([1, 3, 2, 3, 1, -1], [2, 3, 4, 5], 1),
  ([1, 0, 2, 0, 1, 2], [2, 3, 4, 1, 3], 1),
  ([1, 0, 2, 3, 1, -1], [2, 3, 4, 5, 1], 1),
  ([1, 0, -1, 0, 1, 2], [2, 3, 4, 1, 3, 2], 1),
  ([1, 0, 2, 0, 1, -1], [2, 3, 4, 5, 1, 3], 1),
  ([-2, 0, -1, 0, 1, 2], [], 2),
  ([1, 0, -1, 0, 1, -1], [2, 3, 4, 5, 1, 3, 2], 1),
  ([1, 0, 2, 0, -2, -1], [2, 3, 4, 5, 1, 3, 4], 1),
  ([-2, 0, -1, 0, 1, -1], [5], 2),
  ([1, 0, -1, 0, -2, -1], [2, 3, 4, 5, 1, 3, 4, 2], 1),
  ([-2, 0, -1, 0, -2, -1], [5, 4], 2),
  ([1, 0, -1, -3, -2, -1], [2, 3, 4, 5, 1, 3, 4, 2, 3], 1),
  ([-2, 0, -1, -3, -2, -1], [5, 4, 3], 2),
  ([1, -3, -1, -3, -2, -1], [2, 3, 4, 5, 1, 3, 4, 2, 3, 1], 1),
  ([-2, -3, -1, -3, -2, -1], [5, 4, 3, 1], 2),
  ([-2, 0, -4, -3, -2, -1], [5, 4, 3, 2], 2),
  ([-2, -3, -4, -3, -2, -1], [5, 4, 3, 2, 1], 2),
  ([-2, -3, -4, -6, -2, -1], [5, 4, 3, 2, 1, 3], 2),
  ([-2, -3, -4, -6, -5, -1], [5, 4, 3, 2, 1, 3, 4], 2),
  ([-2, -3, -4, -6, -5, -4], [5, 4, 3, 2, 1, 3, 4, 5], 2)]

section
variable [h0 : Corpus.Exc.Liftable] [h1 : Corpus.Exc.Descent]
include h0 h1

/-- **Double cosets of a maximal parabolic subgroup of `W(E6)` contain involutions.** -/
theorem weylCoverE6 : ∃ J : Set (Fin Tag.E6.rank),
    (∃ r, simple Tag.E6 r ∉ (coxeterSystem Tag.E6).parabolic J) ∧
    ∀ w : WeylGroup Tag.E6, ∃ x ∈ (coxeterSystem Tag.E6).parabolic J,
      ∃ y ∈ (coxeterSystem Tag.E6).parabolic J, (x * w * y) * (x * w * y) = 1 :=
  have hA : TauCeti.IsFiniteType (Tag.E6.cartan : Matrix (Fin 6) (Fin 6) ℤ) :=
    isFiniteType_cartan Tag.E6
  have hrows' : ∀ p : Fin 6 × Fin 6, (Tag.E6.cartan : Matrix (Fin 6) (Fin 6) ℤ) p.1 p.2 =
      (rowsE6.getD p.1 []).getD p.2 0 := by
    decide +kernel
  have hrows : ∀ i j : Fin 6, (Tag.E6.cartan : Matrix (Fin 6) (Fin 6) ℤ) i j =
      (rowsE6.getD i []).getD j 0 := fun i j => hrows' (i, j)
  have key := cover_of_lists (r := 6) hA rowsE6 hrows' lamE6 rfl orbitE6 twE6
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hr := simple_not_mem_parabolic hA (lam := vecL lamE6) (r := (0 : Fin 6))
    (ne_of_eq_of_ne (sum_mul_vecL_eq_dotL rowsE6 hrows rfl _) (by decide +kernel))
  ⟨_, ⟨_, hr⟩, key⟩

end

end CFSGOutside.HallPaige.Exc
