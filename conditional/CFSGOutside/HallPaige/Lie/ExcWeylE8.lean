/-- **Double cosets of a maximal parabolic subgroup of `W(E8)` contain involutions.** -/
theorem weylCoverE8 : ∃ J : Set (Fin Tag.E8.rank),
    (∃ r, simple Tag.E8 r ∉ (coxeterSystem Tag.E8).parabolic J) ∧
    ∀ w : WeylGroup Tag.E8, ∃ x ∈ (coxeterSystem Tag.E8).parabolic J,
      ∃ y ∈ (coxeterSystem Tag.E8).parabolic J, (x * w * y) * (x * w * y) = 1 :=
  have hA : TauCeti.IsFiniteType (Tag.E8.cartan : Matrix (Fin 8) (Fin 8) ℤ) :=
    isFiniteType_cartan Tag.E8
  have hrows' : ∀ p : Fin 8 × Fin 8, (Tag.E8.cartan : Matrix (Fin 8) (Fin 8) ℤ) p.1 p.2 =
      (rowsE8.getD p.1 []).getD p.2 0 := by
    decide +kernel
  have hrows : ∀ i j : Fin 8, (Tag.E8.cartan : Matrix (Fin 8) (Fin 8) ℤ) i j =
      (rowsE8.getD i []).getD j 0 := fun i j => hrows' (i, j)
  have key := cover_of_lists (r := 8) hA rowsE8 hrows' lamE8 rfl orbitE8 twE8
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hr := simple_not_mem_parabolic hA (lam := vecL lamE8) (r := (7 : Fin 8))
    (ne_of_eq_of_ne (sum_mul_vecL_eq_dotL rowsE8 hrows rfl _) (by decide +kernel))
  ⟨_, ⟨_, hr⟩, key⟩

end

