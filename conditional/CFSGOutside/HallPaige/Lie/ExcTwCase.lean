import CFSGOutside.HallPaige.Lie.ExcTwTits
import CFSGOutside.HallPaige.Lie.ExcCase

/-!
# The catalogue cases `²E₆(q)` and `³D₄(q)`

The graph-fixed group `Γ = graphFixedRootGroup t K σ` (`K = 𝔽_{q^e}`, `σ = Frob_q`) has the Tits
system `CFSGOutside.HallPaige.ExcTw.titsGF` whose Weyl group is `W(F₄)` (for `²E₆`) or `W(G₂)` (for `³D₄`),
simple reflections to simple reflections (`CFSGOutside.HallPaige.ExcTw.exists_weylEquiv_titsGF`). For the
maximal parabolic subgroup `P = P_J` of hp-exc's Weyl covers (`CFSGOutside.HallPaige.Exc.weylCoverF4`,
`CFSGOutside.HallPaige.Exc.weylCoverG2`) every `P`-double coset `D` of `Γ` meets `D * D`
(`CFSGOutside.HallPaige.Exc.wilcoxCriterion_of_parabolic`). The subgroup `P ⊇ B` is good: for `q` even, `B`
contains the Sylow `2`-subgroup of the split `(B, N)`-pair; for `q` odd, the torus of `B`
contains the Klein four-group generated by `h₁(-1)`, `h₃(-1)` (`²E₆`) or by `h₂(-1)`,
`h₀(-1) h₁(-1) h₃(-1)` (`³D₄`), which lie in `Γ` (`orbitH_mem_graphFixedRootGroup`). The corpus
identifies `Γ` with the TauCeti carrier.
-/

namespace CFSGOutside.HallPaige.ExcTw

open DoubleCoset TauCeti CFSGOutside.Corpus.Exc CFSGOutside.Corpus.ExcTw CFSGOutside.HallPaige.Exc

noncomputable section

/-! ### The Wilcox criterion from a Weyl group isomorphism -/

section Criterion

variable {G : Type} [Group G]

/-- **The Wilcox criterion for a Tits system with Weyl group `W(τ)`.** -/
theorem wilcoxCriterion_of_weylEquiv (T : TauCeti.TitsSystem G) (τ : Tag)
    (Φ : WeylGroup τ ≃* T.WeylGroup) (hΦ : ∀ i, Φ (simple τ i) ∈ T.simple)
    (hcov : ∃ J : Set (Fin τ.rank), (∃ r, simple τ r ∉ (coxeterSystem τ).parabolic J) ∧
      ∀ w : WeylGroup τ, ∃ x ∈ (coxeterSystem τ).parabolic J,
        ∃ y ∈ (coxeterSystem τ).parabolic J, (x * w * y) * (x * w * y) = 1)
    (hgood : ∀ P : Subgroup G, T.subgroupB ≤ P → IsGood P) :
    WilcoxCriterion G := by
  obtain ⟨J, ⟨r, hr⟩, hc⟩ := hcov
  let S₀ : Set T.WeylGroup := Φ '' (simple τ '' J)
  have hS₀ : S₀ ⊆ T.simple := by
    rintro _ ⟨_, ⟨i, -, rfl⟩, rfl⟩
    exact hΦ i
  let J' : Subgroup T.WeylGroup := ((coxeterSystem τ).parabolic J).map Φ.toMonoidHom
  have hJ' : J' = Subgroup.closure S₀ := by
    simp only [J', CoxeterSystem.parabolic, MonoidHom.map_closure]
    rfl
  have hw₀ : Φ (simple τ r) ∉ J' := by
    rintro ⟨x, hx, hxe⟩
    exact hr (Φ.injective hxe ▸ hx)
  refine wilcoxCriterion_of_parabolic T S₀ hS₀ J' hJ' hw₀
    (hgood _ (subgroupB_le_parabolic T S₀ hS₀ J' hJ')) fun w => ?_
  obtain ⟨w', rfl⟩ := Φ.surjective w
  obtain ⟨x, hx, y, hy, h⟩ := hc w'
  refine ⟨Φ x, ⟨x, hx, rfl⟩, Φ y, ⟨y, hy, rfl⟩, ?_⟩
  rw [← map_mul, ← map_mul, ← map_mul, h, map_one]

end Criterion

/-! ### Goodness of the overgroups of the Borel subgroup -/

section Good

variable {t : TwistTag} {K : Type} [Field K] [Finite K] {σ : K ≃+* K}

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

instance finite_GF : Finite (GF t K σ) :=
  haveI := Corpus.Exc.Chevalley.finite_modGL (τ := t.tag) (K := K)
  Subtype.finite

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8

/-- **Goodness for `q` even.** -/
theorem isGood_of_BF_le_of_two [CharP K 2] (hG : IsGood (GF t K σ)) (P : Subgroup (GF t K σ))
    (hP : BF t K σ ≤ P) : IsGood P := by
  obtain ⟨U, hUB, -, -, hidx, -⟩ := (Corpus.ExcTw.GraphFixed.graphFixed_isSplitBNPair t K Nat.prime_two σ).1.split
  refine isGood_of_index_odd hG P ?_
  rw [Nat.odd_iff, ← Nat.two_dvd_ne_zero]
  exact fun h => hidx (h.trans (Subgroup.index_dvd_of_le (hUB.trans hP)))

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

theorem mem_graphFixedRootBorel {g : ModGL t.tag K} (hB : g ∈ borelGroup t.tag K)
    (hΓ : g ∈ GF t K σ) : g ∈ graphFixedRootBorel t K σ.toRingHom :=
  ⟨⟨hB, GF_le_twistedFixedGroup hΓ⟩, hΓ⟩

/-- **Goodness from a Klein four-group in the Borel subgroup.** -/
theorem isGood_of_BF_le_of_klein {u v : ModGL t.tag K}
    (huB : u ∈ borelGroup t.tag K) (hvB : v ∈ borelGroup t.tag K)
    (huΓ : u ∈ GF t K σ) (hvΓ : v ∈ GF t K σ) (hu : u * u = 1) (hv : v * v = 1)
    (huv : u * v = v * u) (hu1 : u ≠ 1) (hv1 : v ≠ 1) (hne : u ≠ v)
    (P : Subgroup (GF t K σ)) (hP : BF t K σ ≤ P) : IsGood P := by
  have hu' : (⟨u, huΓ⟩ : GF t K σ) ∈ P := hP (mem_graphFixedRootBorel huB huΓ)
  have hv' : (⟨v, hvΓ⟩ : GF t K σ) ∈ P := hP (mem_graphFixedRootBorel hvB hvΓ)
  refine isGood_of_two_involutions (u := ⟨⟨u, huΓ⟩, hu'⟩) (v := ⟨⟨v, hvΓ⟩, hv'⟩) ?_ ?_ ?_ ?_ ?_ ?_
  · exact Subtype.ext (Subtype.ext hu)
  · exact Subtype.ext (Subtype.ext hv)
  · exact Subtype.ext (Subtype.ext huv)
  · exact fun h => hu1 (congrArg (fun x : P => ((x : GF t K σ) : ModGL t.tag K)) h)
  · exact fun h => hv1 (congrArg (fun x : P => ((x : GF t K σ) : ModGL t.tag K)) h)
  · exact fun h => hne (congrArg (fun x : P => ((x : GF t K σ) : ModGL t.tag K)) h)

end

theorem units_map_neg_one' {R R' : Type*} [Ring R] [Ring R'] (g : R →+* R') :
    Units.map g.toMonoidHom (-1 : Rˣ) = -1 :=
  Units.ext (by simp)

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8

/-- `orbitH a (-1)` is the product of the `h_i(-1)` over the orbit. -/
theorem coe_orbitH_neg_one (τ : K →+* K) (a : Fin t.foldedTag.rank) :
    (orbitH t K τ a (-1) : ModGL t.tag K) = ((List.range (t.orbit a).card).map fun k =>
      torusElt t.tag K ((t.perm ^ k) (t.orbitMin a)) (-1)).prod := by
  rw [Corpus.ExcTw.GraphFixed.coe_orbitH]
  simp only [units_map_neg_one']

end

end Good

/-! ### The Klein four-groups -/

section Klein

instance : NeZero TwistTag.E6.tag.rank := ⟨by decide⟩
instance : NeZero TwistTag.D4.tag.rank := ⟨by decide⟩
instance : NeZero TwistTag.E6.foldedTag.rank := ⟨by decide⟩
instance : NeZero TwistTag.D4.foldedTag.rank := ⟨by decide⟩

variable {K : Type} [Field K] [Finite K] {σ : K ≃+* K}

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8

theorem torusElt_E6_mem (i : Fin TwistTag.E6.tag.rank) (a : Fin TwistTag.E6.foldedTag.rank) (ha : (TwistTag.E6.orbit a).card = 1)
    (hi : (TwistTag.E6.perm ^ 0) (TwistTag.E6.orbitMin a) = i) :
    torusElt TwistTag.E6.tag K i (-1) ∈ GF TwistTag.E6 K σ := by
  have hm := Corpus.ExcTw.GraphFixed.orbitH_mem_graphFixedRootGroup TwistTag.E6 σ.toRingHom a (-1)
  rw [coe_orbitH_neg_one, ha] at hm
  simpa only [show List.range 1 = [0] from rfl, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil, mul_one, hi] using hm

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.Exc.TorusElt] [h9 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8 h9

/-- **Goodness for `²E₆(q)`, `q` odd.** -/
theorem isGood_E6_of_odd (hK : (-1 : K) ≠ 1) (P : Subgroup (GF TwistTag.E6 K σ))
    (hP : BF TwistTag.E6 K σ ≤ P) : IsGood P := by
  have h1 := torusElt_E6_mem (K := K) (σ := σ) 1 3 (by decide) (by decide)
  have h3 := torusElt_E6_mem (K := K) (σ := σ) 3 2 (by decide) (by decide)
  exact isGood_of_BF_le_of_klein (torusElt_mem_borelGroup _ _) (torusElt_mem_borelGroup _ _)
    h1 h3 (torusElt_neg_one_mul_self _) (torusElt_neg_one_mul_self _)
    (torusElt_neg_one_comm _ _) (torusElt_neg_one_ne_one hK (k := 3) (by decide))
    (torusElt_neg_one_ne_one hK (k := 1) (by decide))
    (torusElt_neg_one_ne hK (k := 1) (by decide) (by decide)) P hP

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

/-- The element `h₀(-1) h₁(-1) h₃(-1)` of `³D₄`. -/
def d4Prod (K : Type) [Field K] : ModGL TwistTag.D4.tag K :=
  torusElt TwistTag.D4.tag K 0 (-1) * (torusElt TwistTag.D4.tag K 1 (-1) *
    torusElt TwistTag.D4.tag K 3 (-1))

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8

theorem d4Prod_mem : d4Prod K ∈ GF TwistTag.D4 K σ := by
  have hm := Corpus.ExcTw.GraphFixed.orbitH_mem_graphFixedRootGroup TwistTag.D4 σ.toRingHom 0 (-1)
  have e0 : (TwistTag.D4.perm ^ 0) (TwistTag.D4.orbitMin 0) = 0 := by decide
  have e1 : (TwistTag.D4.perm ^ 1) (TwistTag.D4.orbitMin 0) = 1 := by decide
  have e2 : (TwistTag.D4.perm ^ 2) (TwistTag.D4.orbitMin 0) = 3 := by decide
  have hc : (TwistTag.D4.orbit 0).card = 3 := by decide
  rw [coe_orbitH_neg_one, hc] at hm
  simpa only [show List.range 3 = [0, 1, 2] from rfl, List.map_cons, List.map_nil,
    List.prod_cons, List.prod_nil, mul_one, e0, e1, e2, d4Prod] using hm

theorem torusElt_D4_two_mem : torusElt TwistTag.D4.tag K 2 (-1) ∈ GF TwistTag.D4 K σ := by
  have hm := Corpus.ExcTw.GraphFixed.orbitH_mem_graphFixedRootGroup TwistTag.D4 σ.toRingHom 1 (-1)
  have e0 : (TwistTag.D4.perm ^ 0) (TwistTag.D4.orbitMin 1) = 2 := by decide
  have hc : (TwistTag.D4.orbit 1).card = 1 := by decide
  rw [coe_orbitH_neg_one, hc] at hm
  simpa only [show List.range 1 = [0] from rfl, List.map_cons, List.map_nil,
    List.prod_cons, List.prod_nil, mul_one, e0] using hm

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt]
include h0 h1 h2 h3 h4 h5

theorem d4Prod_simple (k : Fin TwistTag.D4.tag.rank) :
    (d4Prod K : Module.End K (RootModule TwistTag.D4.tag K))
        (Finsupp.single (Sum.inr ⟨Pi.single k 1, Corpus.Exc.RootPred.basis _ k⟩) 1)
        (Sum.inr ⟨Pi.single k 1, Corpus.Exc.RootPred.basis _ k⟩) =
      (-1 : K) ^ TwistTag.D4.tag.cartan 0 k * ((-1 : K) ^ TwistTag.D4.tag.cartan 1 k *
        (-1 : K) ^ TwistTag.D4.tag.cartan 3 k) := by
  simp only [d4Prod, Units.val_mul, Module.End.mul_apply, torusElt_neg_one_apply,
    Finsupp.single_eq_same, mul_one]
  simp [Label.latticeWeight, Pi.single_apply, mul_comm, mul_left_comm, mul_assoc]

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.Exc.TorusElt] [h9 : Corpus.ExcTw.GraphFixed]
include h0 h1 h2 h3 h4 h5 h6 h7 h8 h9

/-- **Goodness for `³D₄(q)`, `q` odd.** -/
theorem isGood_D4_of_odd (hK : (-1 : K) ≠ 1) (P : Subgroup (GF TwistTag.D4 K σ))
    (hP : BF TwistTag.D4 K σ ≤ P) : IsGood P := by
  have hB : d4Prod K ∈ borelGroup TwistTag.D4.tag K :=
    mul_mem (torusElt_mem_borelGroup _ _)
      (mul_mem (torusElt_mem_borelGroup _ _) (torusElt_mem_borelGroup _ _))
  set h₀ := torusElt TwistTag.D4.tag K 0 (-1)
  set h₁ := torusElt TwistTag.D4.tag K 1 (-1)
  set h₂ := torusElt TwistTag.D4.tag K 2 (-1)
  set h₃ := torusElt TwistTag.D4.tag K 3 (-1)
  have c01 : Commute h₀ h₁ := torusElt_neg_one_comm _ _
  have c03 : Commute h₀ h₃ := torusElt_neg_one_comm _ _
  have c31 : Commute h₃ h₁ := torusElt_neg_one_comm _ _
  have c20 : Commute h₂ h₀ := torusElt_neg_one_comm _ _
  have c21 : Commute h₂ h₁ := torusElt_neg_one_comm _ _
  have c23 : Commute h₂ h₃ := torusElt_neg_one_comm _ _
  have s0 : h₀ * h₀ = 1 := torusElt_neg_one_mul_self _
  have s1 : h₁ * h₁ = 1 := torusElt_neg_one_mul_self _
  have s3 : h₃ * h₃ = 1 := torusElt_neg_one_mul_self _
  have hx : Commute (h₁ * h₃) h₀ := ((c01.symm).mul_left c03.symm)
  have hdd : d4Prod K * d4Prod K = 1 := by
    change h₀ * (h₁ * h₃) * (h₀ * (h₁ * h₃)) = 1
    rw [hx.mul_mul_mul_comm, c31.mul_mul_mul_comm, s0, s1, s3, one_mul, one_mul]
  have hcomm : h₂ * d4Prod K = d4Prod K * h₂ := (c20.mul_right (c21.mul_right c23)).eq
  have hd1 : d4Prod K ≠ 1 := by
    intro h
    have := d4Prod_simple (K := K) 2
    rw [h] at this
    simp only [Units.val_one, Module.End.one_apply, Finsupp.single_eq_same] at this
    rw [show TwistTag.D4.tag.cartan 0 2 = -1 by decide, show TwistTag.D4.tag.cartan 1 2 = -1 by
      decide, show TwistTag.D4.tag.cartan 3 2 = -1 by decide] at this
    simp at this
    exact hK this.symm
  have hne : h₂ ≠ d4Prod K := by
    intro h
    have h1 := torusElt_neg_one_simple (K := K) (τ := TwistTag.D4.tag) 2 0
    have h2 := d4Prod_simple (K := K) 0
    rw [← h] at h2
    rw [h2] at h1
    rw [show TwistTag.D4.tag.cartan 0 0 = 2 by decide, show TwistTag.D4.tag.cartan 1 0 = 0 by
      decide, show TwistTag.D4.tag.cartan 3 0 = 0 by decide,
      show TwistTag.D4.tag.cartan 2 0 = -1 by decide] at h1
    simp at h1
    exact hK h1.symm
  exact isGood_of_BF_le_of_klein (torusElt_mem_borelGroup _ _) hB torusElt_D4_two_mem d4Prod_mem
    (torusElt_neg_one_mul_self _) hdd hcomm (torusElt_neg_one_ne_one hK (k := 0) (by decide))
    hd1 hne P hP

end

end Klein

/-! ### The catalogue cases -/

section Case

theorem neg_one_ne_one_of_charP {K : Type} [Field K] {p : ℕ} [Fact p.Prime] [CharP K p]
    (hp2 : p ≠ 2) : (-1 : K) ≠ 1 := by
  intro h
  have h2 : ((2 : ℕ) : K) = 0 := by push_cast; linear_combination -h
  rw [CharP.cast_eq_zero_iff K p] at h2
  exact hp2 ((Nat.prime_dvd_prime_iff_eq Fact.out Nat.prime_two).1 h2)

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.ExcTw.LabelPerm] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.Liftable] [h5 : Corpus.Exc.Descent] [h6 : Corpus.Exc.BorelNormal] [h7 : Corpus.Exc.Chevalley] [h8 : Corpus.ExcTw.GraphFixed] [h9 : Corpus.ExcTw.Bridges]
include h0 h1 h2 h3 h4 h5 h6 h7 h8 h9

/-- **The minimal-counterexample step for a twisted exceptional family.** -/
theorem catalogueCase_twisted (t : TwistTag) (c : PrimePower → LieTypeIndex)
    (hodd : TwistedBridge t c) (heven : TwistedBridgeEven t c)
    (hcov : ∃ J : Set (Fin t.foldedTag.rank),
      (∃ r, simple t.foldedTag r ∉ (coxeterSystem t.foldedTag).parabolic J) ∧
      ∀ w : WeylGroup t.foldedTag, ∃ x ∈ (coxeterSystem t.foldedTag).parabolic J,
        ∃ y ∈ (coxeterSystem t.foldedTag).parabolic J, (x * w * y) * (x * w * y) = 1)
    (hgoodOdd : ∀ (K : Type) [Field K] [Finite K] (σ : K ≃+* K), (-1 : K) ≠ 1 →
      ∀ P : Subgroup (GF t K σ), BF t K σ ≤ P → IsGood P)
    (q : PrimePower) (hv : (c q).Valid) :
    CatalogueCase (.lie ⟨c q, hv⟩) := by
  set p := q.p
  set f := q.exponent
  have : Fact p.Prime := ⟨q.prime_p⟩
  have hf : f ≠ 0 := q.exponent_pos.ne'
  have ht : t.order ≠ 0 := by cases t <;> decide
  set K := GaloisField p (f * t.order)
  have hq : q.card = p ^ f := rfl
  have hK : Nat.card K = q.card ^ t.order := by
    rw [GaloisField.card p (f * t.order) (Nat.mul_ne_zero hf ht), hq, ← pow_mul]
  let σ : K ≃+* K := iterateFrobeniusEquiv K p f
  have hσ : ∀ x : K, σ.toRingHom x = x ^ q.card := fun x => by
    change iterateFrobeniusEquiv K p f x = _
    rw [iterateFrobeniusEquiv_apply, iterateFrobenius_def, hq]
  obtain ⟨e⟩ : Nonempty (Corpus.ExcTw.DerivedCentralQuotient (twistedFixedGroup t K σ.toRingHom) ≃*
      ValidLieTypeIndex.Group ⟨c q, hv⟩) := by
    by_cases h2 : q.p = 2
    · exact heven q hv h2 K hK σ.toRingHom hσ
    · exact hodd q hv h2 K hK σ.toRingHom hσ
  obtain ⟨E'⟩ := Corpus.ExcTw.Bridges.nonempty_mulEquiv_graphFixedRootGroup' (T := ValidLieTypeIndex.Group ⟨c q, hv⟩)
    t q.prime_p (Nat.one_le_iff_ne_zero.2 hf) (hK.trans (by rw [hq])) (fun x => (hσ x).trans
      (by rw [hq])) e.symm
  let E : GF t K σ ≃* (CFSGIndex.lie ⟨c q, hv⟩).Group := E'.symm
  intro hG hP
  have hG' : IsGood (GF t K σ) := IsGood.of_mulEquiv E.symm hG
  obtain ⟨Φ, hΦ⟩ := exists_weylEquiv_titsGF t K σ q.prime_p
  refine HasCompleteMapping.of_mulEquiv E (hasCompleteMapping_of_wilcoxCriterion cosetStatement
    (wilcoxCriterion_of_weylEquiv (titsGF t K σ q.prime_p) t.foldedTag Φ hΦ hcov fun P hBP => ?_)
    (ProperSubgroupsAdmissible.of_mulEquiv E.symm hP))
  by_cases h2 : p = 2
  · haveI : CharP K 2 := h2 ▸ inferInstance
    exact isGood_of_BF_le_of_two hG' P hBP
  · exact hgoodOdd K σ (neg_one_ne_one_of_charP h2) P hBP

end

section
