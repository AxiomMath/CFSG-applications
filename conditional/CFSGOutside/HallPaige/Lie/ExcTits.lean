import CFSGOutside.HallPaige.Lie.Tits
import CFSGOutside.Corpus.HallPaige.LieExcChevalley
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import CFSGOutside.HallPaige.Reduction

/-!
# Tits systems from split `(B, N)`-pairs, and parabolic subgroups

* `CFSGOutside.HallPaige.Exc.titsSystemOfSplitBN`: the corpus notion `SplitBN B N U n` gives a
  `TauCeti.TitsSystem` with simple reflections the images of the `n i`.
* `CFSGOutside.HallPaige.Exc.parabolic`: for a subgroup `J` of the Weyl group generated by simple
  reflections, the union of the Bruhat cells of `J` is a subgroup `P_J`; it is proper as soon as
  `J ≠ ⊤`.
* `CFSGOutside.HallPaige.Exc.wilcoxCriterion_of_parabolic`: the Wilcox criterion from a good `P_J` such that
  every `J`-double coset of the Weyl group contains an involution.
* `CFSGOutside.HallPaige.Exc.isGood_of_two_involutions`: two distinct commuting involutions make a finite
  group good.
-/

namespace CFSGOutside.HallPaige.Exc

open DoubleCoset TauCeti CFSGOutside.Corpus.Exc
open scoped Pointwise

universe u

section SplitBN

variable {G : Type u} [Group G] {B N U : Subgroup G} {ι : Type*} {n : ι → N}

theorem inf_subgroupOf_eq (B N : Subgroup G) : (B ⊓ N).subgroupOf N = B.subgroupOf N := by
  ext x
  simp [Subgroup.mem_subgroupOf]

/-- The Tits system of a split `(B, N)`-pair. -/
noncomputable def titsSystemOfSplitBN (h : SplitBN B N U n) : TauCeti.TitsSystem G :=
  have hnorm : ((B ⊓ N).subgroupOf N).Normal := h.1
  have hnorm' : (B.subgroupOf N).Normal := inf_subgroupOf_eq B N ▸ hnorm
  { subgroupB := B
    subgroupN := N
    closure_subgroupB_union_subgroupN := by
      rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
      exact h.2.1
    intersection_normal := hnorm'
    simple := Set.range fun i => (QuotientGroup.mk (n i) : N ⧸ B.subgroupOf N)
    closure_simple := by
      intro _
      have hcl := h.2.2.2.2.1
      let e : N ⧸ (B ⊓ N).subgroupOf N ≃* N ⧸ B.subgroupOf N :=
        QuotientGroup.quotientMulEquivOfEq (inf_subgroupOf_eq B N)
      have := congrArg (Subgroup.map e.toMonoidHom) hcl
      rw [MonoidHom.map_closure, Subgroup.map_top_of_surjective _ e.surjective] at this
      rw [← this]
      congr 1
      ext x
      simp only [Set.mem_range, Set.mem_image]
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨_, ⟨i, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
    exists_simpleRep_sq_mem := by
      rintro _ ⟨i, rfl⟩
      refine ⟨n i, rfl, ?_⟩
      have ho := h.2.2.2.1 i
      have h1 : ((n i * n i : N) : N ⧸ (B ⊓ N).subgroupOf N) = 1 := by
        rw [QuotientGroup.mk_mul, ← pow_two, ← ho, pow_orderOf_eq_one]
      rw [QuotientGroup.eq_one_iff] at h1
      exact (Subgroup.mem_inf.1 h1).1
    mul_doubleCoset_subset := by
      rintro _ ⟨i, rfl⟩
      refine ⟨n i, rfl, fun w => ?_⟩
      rintro _ ⟨x, hx, y, hy, rfl⟩
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := mem_doubleCoset.1 hx
      obtain ⟨b₃, hb₃, b₄, hb₄, rfl⟩ := mem_doubleCoset.1 hy
      have hmem : ((n i : N) : G) * (b₂ * b₃) * (w : G) ∈
          ({((n i : N) : G)} : Set G) * (B : Set G) * {(w : G)} :=
        ⟨_, ⟨_, rfl, _, B.mul_mem hb₂ hb₃, rfl⟩, _, rfl, rfl⟩
      rcases h.2.2.2.2.2.1 i w w.2 hmem with h' | h'
      · obtain ⟨_, ⟨c, hc, _, rfl, rfl⟩, d, hd, he⟩ := h'
        left
        refine mem_doubleCoset.2 ⟨b₁ * c, B.mul_mem hb₁ hc, d * b₄, B.mul_mem hd hb₄, ?_⟩
        calc b₁ * (n i : G) * b₂ * (b₃ * w * b₄)
            = b₁ * ((n i : G) * (b₂ * b₃) * w) * b₄ := by group
          _ = b₁ * c * ((n i * w : N) : G) * (d * b₄) := by
            rw [← he]; simp only [Subgroup.coe_mul]; group
      · obtain ⟨_, ⟨c, hc, _, rfl, rfl⟩, d, hd, he⟩ := h'
        right
        refine mem_doubleCoset.2 ⟨b₁ * c, B.mul_mem hb₁ hc, d * b₄, B.mul_mem hd hb₄, ?_⟩
        calc b₁ * (n i : G) * b₂ * (b₃ * w * b₄)
            = b₁ * ((n i : G) * (b₂ * b₃) * w) * b₄ := by group
          _ = b₁ * c * (w : G) * (d * b₄) := by rw [← he]; group
    exists_conj_not_mem := by
      rintro _ ⟨i, rfl⟩
      refine ⟨n i, rfl, ?_⟩
      by_contra hcon
      push Not at hcon
      apply h.2.2.2.2.2.2.1 i
      rintro _ ⟨_, ⟨_, rfl, b, hb, rfl⟩, _, rfl, rfl⟩
      exact hcon ⟨b, hb⟩ }

/-- The Weyl group of the Tits system of a split `(B, N)`-pair is `N / (B ∩ N)`. -/
noncomputable def weylEquiv [((B ⊓ N).subgroupOf N).Normal] (h : SplitBN B N U n) :
    N ⧸ (B ⊓ N).subgroupOf N ≃* (titsSystemOfSplitBN h).WeylGroup :=
  @QuotientGroup.quotientMulEquivOfEq N _ ((B ⊓ N).subgroupOf N) (B.subgroupOf N) _
    (TauCeti.TitsSystem.intersectionNormal (titsSystemOfSplitBN h)) (inf_subgroupOf_eq B N)

theorem weylEquiv_mk [((B ⊓ N).subgroupOf N).Normal] (h : SplitBN B N U n) (x : N) :
    weylEquiv h (x : N ⧸ (B ⊓ N).subgroupOf N) =
      (QuotientGroup.mk x : (titsSystemOfSplitBN h).WeylGroup) := rfl

theorem mk_mem_simple (h : SplitBN B N U n) (i : ι) :
    (QuotientGroup.mk (n i) : (titsSystemOfSplitBN h).WeylGroup) ∈
      (titsSystemOfSplitBN h).simple := ⟨i, rfl⟩

end SplitBN

section Parabolic

variable {G : Type u} [Group G] (T : TauCeti.TitsSystem G)

/-- Right multiplication of a cell of `J` by a cell of the subgroup generated by simple
reflections `S₀ ⊆ T.simple` stays in the union of the cells of `J`, when `J ⊇ S₀`. -/
theorem bruhatCell_mul_subset_iUnion (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) {y : T.WeylGroup} (hy : y ∈ J) :
    ∀ x ∈ J, T.bruhatCell x * T.bruhatCell y ⊆ ⋃ z ∈ J, T.bruhatCell z := by
  rw [hJ] at hy
  induction hy using Subgroup.closure_induction_left with
  | one =>
    intro x hx g hg
    rw [T.bruhatCell_one, T.bruhatCell_mul_subgroupB] at hg
    exact Set.mem_biUnion hx hg
  | mul_left s hs y _ ih =>
    intro x hx g hg
    have hsJ : s ∈ J := hJ ▸ Subgroup.subset_closure hs
    have h1 := (TitsSystem.bruhatCell_mul_subset_mul T s y)
    have h2 := T.bruhatCell_mul_subset_union_of_mem_simple_right x (hS₀ hs)
    obtain ⟨a, ha, b, hb, rfl⟩ := hg
    obtain ⟨c, hc, d, hd, rfl⟩ := h1 hb
    show a * (c * d) ∈ _
    rw [← mul_assoc]
    rcases h2 ⟨a, ha, c, hc, rfl⟩ with h3 | h3
    · exact ih (x * s) (mul_mem hx hsJ) ⟨_, h3, d, hd, rfl⟩
    · exact ih x hx ⟨_, h3, d, hd, rfl⟩
  | inv_mul_cancel s hs y _ ih =>
    intro x hx g hg
    have hsJ : s ∈ J := hJ ▸ Subgroup.subset_closure hs
    rw [T.inv_simple (hS₀ hs)] at hg
    have h1 := (TitsSystem.bruhatCell_mul_subset_mul T s y)
    have h2 := T.bruhatCell_mul_subset_union_of_mem_simple_right x (hS₀ hs)
    obtain ⟨a, ha, b, hb, rfl⟩ := hg
    obtain ⟨c, hc, d, hd, rfl⟩ := h1 hb
    show a * (c * d) ∈ _
    rw [← mul_assoc]
    rcases h2 ⟨a, ha, c, hc, rfl⟩ with h3 | h3
    · exact ih (x * s) (mul_mem hx hsJ) ⟨_, h3, d, hd, rfl⟩
    · exact ih x hx ⟨_, h3, d, hd, rfl⟩

/-- The parabolic subgroup `P_J = ⋃_{w ∈ J} BwB` of a subgroup `J` of the Weyl group generated
by simple reflections. -/
noncomputable def parabolic (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) : Subgroup G where
  carrier := ⋃ z ∈ J, T.bruhatCell z
  one_mem' := Set.mem_biUnion J.one_mem (by rw [T.bruhatCell_one]; exact T.subgroupB.one_mem)
  mul_mem' {a b} ha hb := by
    obtain ⟨x, hx, hax⟩ := Set.mem_iUnion₂.1 ha
    obtain ⟨y, hy, hby⟩ := Set.mem_iUnion₂.1 hb
    exact bruhatCell_mul_subset_iUnion T S₀ hS₀ J hJ hy x hx ⟨a, hax, b, hby, rfl⟩
  inv_mem' {a} ha := by
    obtain ⟨x, hx, hax⟩ := Set.mem_iUnion₂.1 ha
    refine Set.mem_biUnion (inv_mem hx) ?_
    rw [← T.inv_bruhatCell]
    exact Set.inv_mem_inv.2 hax

theorem bruhatCell_subset_parabolic (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) {x : T.WeylGroup} (hx : x ∈ J) :
    T.bruhatCell x ⊆ parabolic T S₀ hS₀ J hJ :=
  fun _ hg => Set.mem_biUnion hx hg

theorem subgroupB_le_parabolic (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) :
    T.subgroupB ≤ parabolic T S₀ hS₀ J hJ := by
  intro g hg
  apply bruhatCell_subset_parabolic T S₀ hS₀ J hJ J.one_mem
  rw [T.bruhatCell_one]
  exact hg

theorem parabolic_ne_top (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) {w : T.WeylGroup} (hw : w ∉ J) :
    parabolic T S₀ hS₀ J hJ ≠ ⊤ := by
  intro htop
  obtain ⟨n, hn, -⟩ := T.exists_mem_bruhatCell w
  have hmem : (n : G) ∈ T.bruhatCell w := by
    rw [← hn, T.bruhatCell_mk]; exact mem_doubleCoset_self _ _ _
  have : (n : G) ∈ parabolic T S₀ hS₀ J hJ := htop ▸ Subgroup.mem_top _
  obtain ⟨x, hx, hnx⟩ := Set.mem_iUnion₂.1 this
  have := T.eq_of_mem_bruhatCell_of_mem hmem hnx
  exact hw (this ▸ hx)

/-- **The Wilcox criterion from a parabolic subgroup.** -/
theorem wilcoxCriterion_of_parabolic (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    (J : Subgroup T.WeylGroup) (hJ : J = Subgroup.closure S₀) {w₀ : T.WeylGroup} (hw₀ : w₀ ∉ J)
    (hgood : IsGood (parabolic T S₀ hS₀ J hJ))
    (hcov : ∀ w : T.WeylGroup, ∃ x ∈ J, ∃ y ∈ J, (x * w * y) * (x * w * y) = 1) :
    WilcoxCriterion G :=
  TitsSystem.wilcoxCriterion_of_weyl_cover T _ (subgroupB_le_parabolic T S₀ hS₀ J hJ)
    (parabolic_ne_top T S₀ hS₀ J hJ hw₀) hgood J
    (fun _ hx => bruhatCell_subset_parabolic T S₀ hS₀ J hJ hx) hcov

end Parabolic

section Good

variable {H : Type*} [Group H]

/-- A finite group with two distinct commuting involutions is good. -/
theorem isGood_of_two_involutions [Finite H] {u v : H} (hu : u * u = 1) (hv : v * v = 1)
    (huv : u * v = v * u) (hu1 : u ≠ 1) (hv1 : v ≠ 1) (hne : u ≠ v) : IsGood H := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let V : Subgroup H := Subgroup.closure {u, v}
  have hC : ∀ g ∈ V, Commute g u ∧ Commute g v := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact ⟨Commute.refl _, huv⟩
      · exact ⟨huv.symm, Commute.refl _⟩
    | one => exact ⟨Commute.one_left _, Commute.one_left _⟩
    | mul x y _ _ hx hy => exact ⟨hx.1.mul_left hy.1, hx.2.mul_left hy.2⟩
    | inv x _ hx => exact ⟨hx.1.inv_left, hx.2.inv_left⟩
  have hcomm : ∀ x ∈ V, ∀ y ∈ V, Commute x y := by
    intro x hx y hy
    induction hy using Subgroup.closure_induction with
    | mem z hz =>
      rcases hz with rfl | rfl
      · exact (hC x hx).1
      · exact (hC x hx).2
    | one => exact Commute.one_right _
    | mul a b _ _ ha hb => exact ha.mul_right hb
    | inv a _ ha => exact ha.inv_right
  have hsq : ∀ g ∈ V, g * g = 1 := by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem x hx => rcases hx with rfl | rfl <;> assumption
    | one => simp
    | mul x y hx hy ihx ihy =>
      calc x * y * (x * y) = x * x * (y * y) := by
            rw [mul_assoc, ← mul_assoc y x y, ← (hcomm x hx y hy).eq]; group
        _ = 1 := by rw [ihx, ihy, one_mul]
    | inv x _ ihx =>
      rw [← mul_inv_rev, ihx, inv_one]
  have hV : IsPGroup 2 V := fun g =>
    ⟨1, Subtype.ext (by simpa [pow_two] using hsq g g.2)⟩
  have huV : u ∈ V := Subgroup.subset_closure (by simp)
  have hvV : v ∈ V := Subgroup.subset_closure (by simp)
  refine isGood_of_injective hV ?_ V.subtype V.subtype_injective
  intro hcyc
  obtain ⟨g, hg⟩ := hcyc.exists_generator
  have hg2 : g * g = 1 := Subtype.ext (by simpa using hsq g g.2)
  have hmem : ∀ x : V, x = 1 ∨ x = g := by
    intro x
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hg x)
    obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' k
    · left
      rw [zpow_mul, zpow_two, hg2, one_zpow]
    · right
      rw [zpow_add, zpow_mul, zpow_two, hg2, one_zpow, one_mul, zpow_one]
  rcases hmem ⟨u, huV⟩ with h1 | h1 <;> rcases hmem ⟨v, hvV⟩ with h2 | h2
  · exact hu1 (congrArg Subtype.val h1)
  · exact hu1 (congrArg Subtype.val h1)
  · exact hv1 (congrArg Subtype.val h2)
  · exact hne (congrArg Subtype.val (h1.trans h2.symm))

end Good

end CFSGOutside.HallPaige.Exc
