import CFSGOutside.HallPaige.Lie.ExcWeyl

/-!
# Weyl group data for `F4`

The orbit of the dominant vector `λ` under the Weyl group, with certificates that every
double coset of the stabilizer `W_J` contains an involution (generated by a script). All checks are by `decide +kernel`.
-/

namespace CFSGOutside.HallPaige.Exc

open CFSGOutside.Corpus.Exc

/-- Rows of the Cartan matrix of type `F4`. -/
def rowsF4 : List (List ℤ) := [[2, -1, 0, 0], [-1, 2, -1, 0], [0, -2, 2, -1], [0, 0, -1, 2]]

/-- The dominant vector `λ` for type `F4` (root coordinates). -/
def lamF4 : List ℤ := [2, 3, 4, 2]

/-- Involutions `t_k` (words, rightmost letter applied first) with `t_k λ` the `J`-dominant
representatives of the `W_J`-orbits. -/
def twF4 : List (List (Fin 4)) := [[], [0], [0, 1, 2, 1, 0], [0, 1, 2, 1, 3, 2, 1, 0], [0, 1, 2, 1, 0, 3, 2, 1, 0, 2, 1, 3, 2, 1, 0]]

/-- The orbit `Wλ` (24 vectors), each with a word in `J` moving it to `t_k λ`, and `k`. -/
def orbitF4 : List (List ℤ × List (Fin 4) × ℕ) := [
  ([2, 3, 4, 2], [], 0),
  ([1, 3, 4, 2], [], 1),
  ([1, 2, 4, 2], [1], 1),
  ([1, 2, 2, 2], [1, 2], 1),
  ([1, 1, 2, 2], [1, 2, 1], 1),
  ([1, 2, 2, 0], [1, 2, 3], 1),
  ([0, 1, 2, 2], [], 2),
  ([1, 1, 2, 0], [1, 2, 3, 1], 1),
  ([0, 1, 2, 0], [3], 2),
  ([1, 1, 0, 0], [1, 2, 3, 1, 2], 1),
  ([0, 1, 0, 0], [3, 2], 2),
  ([1, 0, 0, 0], [1, 2, 3, 1, 2, 1], 1),
  ([0, -1, 0, 0], [3, 2, 1], 2),
  ([-1, 0, 0, 0], [], 3),
  ([-1, -1, 0, 0], [1], 3),
  ([0, -1, -2, 0], [3, 2, 1, 2], 2),
  ([-1, -1, -2, 0], [1, 2], 3),
  ([0, -1, -2, -2], [3, 2, 1, 2, 3], 2),
  ([-1, -2, -2, 0], [1, 2, 1], 3),
  ([-1, -1, -2, -2], [1, 2, 3], 3),
  ([-1, -2, -2, -2], [1, 2, 3, 1], 3),
  ([-1, -2, -4, -2], [1, 2, 3, 1, 2], 3),
  ([-1, -3, -4, -2], [1, 2, 3, 1, 2, 1], 3),
  ([-2, -3, -4, -2], [], 4)]

section
variable [h0 : Corpus.Exc.Liftable] [h1 : Corpus.Exc.Descent]
include h0 h1

/-- **Double cosets of a maximal parabolic subgroup of `W(F4)` contain involutions.** -/
theorem weylCoverF4 : ∃ J : Set (Fin Tag.F4.rank),
    (∃ r, simple Tag.F4 r ∉ (coxeterSystem Tag.F4).parabolic J) ∧
    ∀ w : WeylGroup Tag.F4, ∃ x ∈ (coxeterSystem Tag.F4).parabolic J,
      ∃ y ∈ (coxeterSystem Tag.F4).parabolic J, (x * w * y) * (x * w * y) = 1 :=
  have hA : TauCeti.IsFiniteType (Tag.F4.cartan : Matrix (Fin 4) (Fin 4) ℤ) :=
    isFiniteType_cartan Tag.F4
  have hrows' : ∀ p : Fin 4 × Fin 4, (Tag.F4.cartan : Matrix (Fin 4) (Fin 4) ℤ) p.1 p.2 =
      (rowsF4.getD p.1 []).getD p.2 0 := by
    decide +kernel
  have hrows : ∀ i j : Fin 4, (Tag.F4.cartan : Matrix (Fin 4) (Fin 4) ℤ) i j =
      (rowsF4.getD i []).getD j 0 := fun i j => hrows' (i, j)
  have key := cover_of_lists (r := 4) hA rowsF4 hrows' lamF4 rfl orbitF4 twF4
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have hr := simple_not_mem_parabolic hA (lam := vecL lamF4) (r := (0 : Fin 4))
    (ne_of_eq_of_ne (sum_mul_vecL_eq_dotL rowsF4 hrows rfl _) (by decide +kernel))
  ⟨_, ⟨_, hr⟩, key⟩

end

end CFSGOutside.HallPaige.Exc
