/-!
# The catalogue cases `G₂(q)`, `F₄(q)`, `E₆(q)`, `E₇(q)`, `E₈(q)`

The adjoint Chevalley group `G = adjointGroup τ K` has a split `(B, N)`-pair with Weyl group
the Coxeter group of type `τ` (`CFSGOutside.Corpus.Exc.chevalley_split_bn_pair`). For the maximal
parabolic subgroup `P = P_J` with `J = S ∖ {r}` (`r` the node of the 6, 24, 27, 56 or 240
vectors of the orbit `Wλ`), every `W_J`-double coset of `W` contains an involution
(`CFSGOutside.HallPaige.Exc.weylCoverG2`, …), so every `P`-double coset `D` of `G` meets `D * D`
(`CFSGOutside.HallPaige.TitsSystem.wilcoxCriterion_of_weyl_cover`). The subgroup `P ⊇ B` is good: for `q`
even, `B` contains the Sylow `2`-subgroup `U` (`isSylowTwoOf_posUnipotent`); for `q` odd, the
torus contains the Klein four-group generated by `h_i(-1)`, `h_j(-1)` for adjacent nodes `i`, `j`.
The corpus identifies `G` with the TauCeti carrier.
-/

namespace CFSGOutside.HallPaige.Exc

open CFSGOutside.Corpus.Exc TauCeti

section Torus

variable {τ : Tag} {K : Type} [Field K]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt]
include h0 h1 h2 h3 h4 h5

theorem torusElt_neg_one_apply (i : Fin τ.rank) (x : RootModule τ K) (a : Label τ) :
    (torusElt τ K i (-1) : Module.End K (RootModule τ K)) x a =
      (-1 : K) ^ (∑ j, τ.cartan i j * a.latticeWeight j) * x a := by
  rw [Corpus.Exc.TorusElt.torusElt_apply_eq, Units.val_zpow_eq_zpow_val, Units.val_neg, Units.val_one]

end

theorem neg_one_zpow_mul_self (n : ℤ) : (-1 : K) ^ n * (-1 : K) ^ n = 1 := by
  rcases Int.even_or_odd n with h | h
  · rw [h.neg_one_zpow, one_mul]
  · rw [h.neg_one_zpow, neg_one_mul, neg_neg]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt]
include h0 h1 h2 h3 h4 h5

theorem torusElt_neg_one_mul_self (i : Fin τ.rank) :
    torusElt τ K i (-1) * torusElt τ K i (-1) = 1 := by
  refine Units.ext (LinearMap.ext fun x => Finsupp.ext fun a => ?_)
  rw [Units.val_mul, Module.End.mul_apply, torusElt_neg_one_apply, torusElt_neg_one_apply,
    ← mul_assoc, neg_one_zpow_mul_self, one_mul, Units.val_one, Module.End.one_apply]

theorem torusElt_neg_one_comm (i j : Fin τ.rank) :
    torusElt τ K i (-1) * torusElt τ K j (-1) = torusElt τ K j (-1) * torusElt τ K i (-1) := by
  refine Units.ext (LinearMap.ext fun x => Finsupp.ext fun a => ?_)
  rw [Units.val_mul, Units.val_mul, Module.End.mul_apply, Module.End.mul_apply,
    torusElt_neg_one_apply, torusElt_neg_one_apply, torusElt_neg_one_apply,
    torusElt_neg_one_apply, mul_left_comm]

/-- The value of `h_i(-1)` on the root vector of the simple root `α_k`. -/
theorem torusElt_neg_one_simple (i k : Fin τ.rank) :
    (torusElt τ K i (-1) : Module.End K (RootModule τ K))
        (Finsupp.single (Sum.inr ⟨Pi.single k 1, Corpus.Exc.RootPred.basis _ k⟩) 1)
        (Sum.inr ⟨Pi.single k 1, Corpus.Exc.RootPred.basis _ k⟩) = (-1 : K) ^ τ.cartan i k := by
  rw [torusElt_neg_one_apply, Finsupp.single_eq_same, mul_one]
  congr 1
  simp [Label.latticeWeight, Pi.single_apply]

end

theorem neg_one_zpow_odd {n : ℤ} (h : n % 2 = 1) : (-1 : K) ^ n = -1 :=
  (Int.odd_iff.2 h).neg_one_zpow

theorem neg_one_zpow_even {n : ℤ} (h : n % 2 = 0) : (-1 : K) ^ n = 1 :=
  (Int.even_iff.2 h).neg_one_zpow

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt]
include h0 h1 h2 h3 h4 h5

theorem torusElt_neg_one_ne_one (hK : (-1 : K) ≠ 1) {i k : Fin τ.rank}
    (h : τ.cartan i k % 2 = 1) : torusElt τ K i (-1) ≠ 1 := by
  intro he
  have := torusElt_neg_one_simple (K := K) i k
  rw [he, neg_one_zpow_odd h] at this
  simp at this
  exact hK this.symm

theorem torusElt_neg_one_ne (hK : (-1 : K) ≠ 1) {i j k : Fin τ.rank}
    (hi : τ.cartan i k % 2 = 0) (hj : τ.cartan j k % 2 = 1) :
    torusElt τ K i (-1) ≠ torusElt τ K j (-1) := by
  intro he
  have h1 := torusElt_neg_one_simple (K := K) i k
  rw [he, torusElt_neg_one_simple, neg_one_zpow_odd hj, neg_one_zpow_even hi] at h1
  exact hK h1

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

theorem torusElt_mem_adjointGroup (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t ∈ adjointGroup τ K :=
  mul_mem (weylElt_mem_adjointGroup τ K i t) (weylElt_mem_adjointGroup τ K i (-1))

theorem torusElt_mem_borelGroup (i : Fin τ.rank) (t : Kˣ) :
    torusElt τ K i t ∈ borelGroup τ K :=
  Subgroup.mem_sup_left (Subgroup.subset_closure ⟨(i, t), rfl⟩)

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt]
include h0 h1 h2 h3 h4 h5

/-- **Goodness for `q` odd.** If `(-1 : K) ≠ 1` and `i`, `j` are nodes with
`A_{ij}`, `A_{ji}` odd and `A_{ii}` even, every subgroup of the adjoint group containing the
Borel subgroup contains the Klein four-group `⟨h_i(-1), h_j(-1)⟩` and is good. -/
theorem isGood_of_borelSub_le_of_odd [Finite K] (hK : (-1 : K) ≠ 1) {i j : Fin τ.rank}
    (hij : τ.cartan i j % 2 = 1) (hji : τ.cartan j i % 2 = 1) (hii : τ.cartan i i % 2 = 0)
    [Finite (adjointGroup τ K)] (P : Subgroup (adjointGroup τ K)) (hP : borelSub τ K ≤ P) :
    IsGood P := by
  let u : adjointGroup τ K := ⟨torusElt τ K i (-1), torusElt_mem_adjointGroup i _⟩
  let v : adjointGroup τ K := ⟨torusElt τ K j (-1), torusElt_mem_adjointGroup j _⟩
  have hu : u ∈ P := hP (torusElt_mem_borelGroup i _)
  have hv : v ∈ P := hP (torusElt_mem_borelGroup j _)
  refine isGood_of_two_involutions (u := ⟨u, hu⟩) (v := ⟨v, hv⟩) ?_ ?_ ?_ ?_ ?_ ?_
  · exact Subtype.ext (Subtype.ext (torusElt_neg_one_mul_self i))
  · exact Subtype.ext (Subtype.ext (torusElt_neg_one_mul_self j))
  · exact Subtype.ext (Subtype.ext (torusElt_neg_one_comm i j))
  · intro h
    exact torusElt_neg_one_ne_one hK hij (congrArg (fun x : P => ((x : adjointGroup τ K) :
      ModGL τ K)) h)
  · intro h
    exact torusElt_neg_one_ne_one hK hji (congrArg (fun x : P => ((x : adjointGroup τ K) :
      ModGL τ K)) h)
  · intro h
    exact torusElt_neg_one_ne hK hii hji (congrArg (fun x : P => ((x : adjointGroup τ K) :
      ModGL τ K)) h)

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.SylowTwo]
include h0 h1 h2 h3 h4 h5

/-- **Goodness for `q` even.** Every subgroup of the adjoint group containing the Borel
subgroup contains the Sylow `2`-subgroup `U`, hence has odd index and is good. -/
theorem isGood_of_borelSub_le_of_charTwo [Finite K] [CharP K 2] [Finite (adjointGroup τ K)]
    (hG : IsGood (adjointGroup τ K)) (P : Subgroup (adjointGroup τ K))
    (hP : borelSub τ K ≤ P) : IsGood P := by
  obtain ⟨-, -, hidx⟩ := Corpus.Exc.SylowTwo.isSylowTwoOf_posUnipotent (K := K) τ
  have hUB : posUnipotentSub τ K ≤ borelSub τ K := (Corpus.Exc.Chevalley.chevalley_split_bn_pair τ K).1.2.2.2.2.2.2.2.1
  refine isGood_of_index_odd hG P ?_
  rw [Nat.odd_iff, ← Nat.two_dvd_ne_zero]
  exact fun h => hidx (h.trans (Subgroup.index_dvd_of_le (hUB.trans hP)))

end

end Torus

section Criterion

variable (τ : Tag) (K : Type) [Field K]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

/-- **The Wilcox criterion for the adjoint Chevalley groups.** -/
theorem wilcoxCriterion_adjointGroup
    (hcov : ∃ J : Set (Fin τ.rank), (∃ r, simple τ r ∉ (coxeterSystem τ).parabolic J) ∧
      ∀ w : WeylGroup τ, ∃ x ∈ (coxeterSystem τ).parabolic J,
        ∃ y ∈ (coxeterSystem τ).parabolic J, (x * w * y) * (x * w * y) = 1)
    (hgood : ∀ P : Subgroup (adjointGroup τ K), borelSub τ K ≤ P → IsGood P) :
    WilcoxCriterion (adjointGroup τ K) := by
  obtain ⟨hsb, -, ⟨ψ, hψ⟩, -⟩ := Corpus.Exc.Chevalley.chevalley_split_bn_pair τ K
  let T := titsSystemOfSplitBN hsb
  let φ : WeylGroup τ ≃* T.WeylGroup := ψ.trans (weylEquiv hsb)
  have hφ : ∀ i, φ (simple τ i) = QuotientGroup.mk (weylRep τ K i) := by
    intro i
    change weylEquiv hsb (ψ (simple τ i)) = _
    rw [hψ i, weylEquiv_mk]
    rfl
  obtain ⟨J, ⟨r, hr⟩, hc⟩ := hcov
  let S₀ : Set T.WeylGroup := φ '' (simple τ '' J)
  have hS₀ : S₀ ⊆ T.simple := by
    rintro _ ⟨_, ⟨i, -, rfl⟩, rfl⟩
    rw [hφ]
    exact mk_mem_simple hsb i
  let J' : Subgroup T.WeylGroup := ((coxeterSystem τ).parabolic J).map φ.toMonoidHom
  have hJ' : J' = Subgroup.closure S₀ := by
    simp only [J', CoxeterSystem.parabolic, MonoidHom.map_closure]
    rfl
  have hw₀ : φ (simple τ r) ∉ J' := by
    rintro ⟨x, hx, hxe⟩
    exact hr (φ.injective hxe ▸ hx)
  refine wilcoxCriterion_of_parabolic T S₀ hS₀ J' hJ' hw₀
    (hgood _ (subgroupB_le_parabolic T S₀ hS₀ J' hJ')) fun w => ?_
  obtain ⟨w', rfl⟩ := φ.surjective w
  obtain ⟨x, hx, y, hy, h⟩ := hc w'
  refine ⟨φ x, ⟨x, hx, rfl⟩, φ y, ⟨y, hy, rfl⟩, ?_⟩
  rw [← map_mul, ← map_mul, ← map_mul, h, map_one]

end

end Criterion

section Case

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

instance finite_adjointGroup {τ : Tag} {K : Type} [Field K] [Finite K] :
    Finite (adjointGroup τ K) :=
  haveI := Corpus.Exc.Chevalley.finite_modGL (τ := τ) (K := K)
  Subtype.finite

end

theorem card_galoisField' (q : PrimePower) [Fact q.p.Prime] :
    Nat.card (GaloisField q.p q.exponent) = q.card :=
  GaloisField.card q.p q.exponent q.exponent_pos.ne'

theorem charP_two_of_card {K : Type} [Field K] [Finite K] {q : PrimePower} (hq : q.p = 2)
    (hK : Nat.card K = q.card) : CharP K 2 := by
  haveI : Fintype K := Fintype.ofFinite K
  refine charP_of_card_eq_prime_pow (f := q.exponent) ?_
  rw [← Nat.card_eq_fintype_card, hK, PrimePower.card, hq]

theorem neg_one_ne_one_of_card {K : Type} [Field K] [Finite K] {q : PrimePower} (hq : q.p ≠ 2)
    (hK : Nat.card K = q.card) : (-1 : K) ≠ 1 := by
  intro h
  haveI : Fintype K := Fintype.ofFinite K
  have h2 : (2 : K) = 0 := by linear_combination -h
  haveI : CharP K 2 := (CharP.charP_iff_prime_eq_zero Nat.prime_two).2 (by exact_mod_cast h2)
  obtain ⟨n, -, hn⟩ := FiniteField.card K 2
  rw [← Nat.card_eq_fintype_card, hK, PrimePower.card] at hn
  have hdvd : 2 ∣ q.p ^ q.exponent := hn ▸ dvd_pow_self 2 n.ne_zero
  exact hq ((Nat.prime_dvd_prime_iff_eq Nat.prime_two q.prime_p).1
    (Nat.prime_two.dvd_of_dvd_pow hdvd)).symm

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Exc.TorusElt] [h6 : Corpus.Exc.SylowTwo]
include h0 h1 h2 h3 h4 h5 h6

/-- **The minimal-counterexample step for an untwisted exceptional family.** -/
theorem catalogueCase_untwisted (τ : Tag) (c : PrimePower → LieTypeIndex)
    (hodd : UntwistedBridge τ c) (heven : UntwistedBridgeEven τ c)
    (hcov : ∃ J : Set (Fin τ.rank), (∃ r, simple τ r ∉ (coxeterSystem τ).parabolic J) ∧
      ∀ w : WeylGroup τ, ∃ x ∈ (coxeterSystem τ).parabolic J,
        ∃ y ∈ (coxeterSystem τ).parabolic J, (x * w * y) * (x * w * y) = 1)
    {i j : Fin τ.rank} (hij : τ.cartan i j % 2 = 1) (hji : τ.cartan j i % 2 = 1)
    (hii : τ.cartan i i % 2 = 0) (q : PrimePower) (hv : (c q).Valid) :
    CatalogueCase (.lie ⟨c q, hv⟩) := by
  have : Fact q.p.Prime := ⟨q.prime_p⟩
  set K := GaloisField q.p q.exponent
  have hK : Nat.card K = q.card := card_galoisField' q
  obtain ⟨e⟩ : Nonempty (AdjointQuotient τ K ≃* ValidLieTypeIndex.Group ⟨c q, hv⟩) := by
    by_cases hq : q.p = 2
    · exact heven q hv hq K hK
    · exact hodd q hv hq K hK
  let e₀ : adjointGroup τ K ≃* AdjointQuotient τ K :=
    ((QuotientGroup.quotientMulEquivOfEq Corpus.Exc.Chevalley.center_adjointGroup_eq_bot).trans
      QuotientGroup.quotientBot).symm
  let E : adjointGroup τ K ≃* (CFSGIndex.lie ⟨c q, hv⟩).Group := e₀.trans e
  intro hG hP
  have hG' : IsGood (adjointGroup τ K) := IsGood.of_mulEquiv E.symm hG
  refine HasCompleteMapping.of_mulEquiv E (hasCompleteMapping_of_wilcoxCriterion cosetStatement
    (wilcoxCriterion_adjointGroup τ K hcov fun P hBP => ?_)
    (ProperSubgroupsAdmissible.of_mulEquiv E.symm hP))
  by_cases hq : q.p = 2
  · haveI := charP_two_of_card hq hK
    exact isGood_of_borelSub_le_of_charTwo hG' P hBP
  · exact isGood_of_borelSub_le_of_odd (neg_one_ne_one_of_card hq hK) hij hji hii P hBP

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.Liftable] [h4 : Corpus.Exc.Descent] [h5 : Corpus.Exc.BorelNormal] [h6 : Corpus.Exc.Chevalley] [h7 : Corpus.Exc.TorusElt] [h8 : Corpus.Exc.SylowTwo] [h9 : Corpus.Exc.Bridges]
include h0 h1 h2 h3 h4 h5 h6 h7 h8 h9

/-- **Hall–Paige for `G₂(q)`**: the minimal-counterexample step. -/
theorem catalogueCase_G2 (q : PrimePower) (hv : (LieTypeIndex.G2 q).Valid) :
    CatalogueCase (.lie ⟨.G2 q, hv⟩) :=
  catalogueCase_untwisted .G2 LieTypeIndex.G2 Corpus.Exc.Bridges.untwistedBridge_G2 Corpus.Exc.Bridges.untwistedBridgeEven_G2
    weylCoverG2 (i := (0 : Fin 2)) (j := (1 : Fin 2)) (by decide) (by decide) (by decide) q hv

/-- **Hall–Paige for `F₄(q)`**: the minimal-counterexample step. -/
theorem catalogueCase_F4 (q : PrimePower) (hv : (LieTypeIndex.F4 q).Valid) :
    CatalogueCase (.lie ⟨.F4 q, hv⟩) :=
  catalogueCase_untwisted .F4 LieTypeIndex.F4 Corpus.Exc.Bridges.untwistedBridge_F4 Corpus.Exc.Bridges.untwistedBridgeEven_F4
    weylCoverF4 (i := (0 : Fin 4)) (j := (1 : Fin 4)) (by decide) (by decide) (by decide) q hv

/-- **Hall–Paige for `E₆(q)`**: the minimal-counterexample step. -/
theorem catalogueCase_E6 (q : PrimePower) (hv : (LieTypeIndex.E6 q).Valid) :
    CatalogueCase (.lie ⟨.E6 q, hv⟩) :=
  catalogueCase_untwisted .E6 LieTypeIndex.E6 Corpus.Exc.Bridges.untwistedBridge_E6 Corpus.Exc.Bridges.untwistedBridgeEven_E6
    weylCoverE6 (i := (2 : Fin 6)) (j := (3 : Fin 6)) (by decide) (by decide) (by decide) q hv

/-- **Hall–Paige for `E₇(q)`**: the minimal-counterexample step. -/
theorem catalogueCase_E7 (q : PrimePower) (hv : (LieTypeIndex.E7 q).Valid) :
    CatalogueCase (.lie ⟨.E7 q, hv⟩) :=
  catalogueCase_untwisted .E7 LieTypeIndex.E7 Corpus.Exc.Bridges.untwistedBridge_E7 Corpus.Exc.Bridges.untwistedBridgeEven_E7
    weylCoverE7 (i := (2 : Fin 7)) (j := (3 : Fin 7)) (by decide) (by decide) (by decide) q hv

/-- **Hall–Paige for `E₈(q)`**: the minimal-counterexample step. -/
theorem catalogueCase_E8 (q : PrimePower) (hv : (LieTypeIndex.E8 q).Valid) :
    CatalogueCase (.lie ⟨.E8 q, hv⟩) :=
  catalogueCase_untwisted .E8 LieTypeIndex.E8 Corpus.Exc.Bridges.untwistedBridge_E8 Corpus.Exc.Bridges.untwistedBridgeEven_E8
    weylCoverE8 (i := (2 : Fin 8)) (j := (3 : Fin 8)) (by decide) (by decide) (by decide) q hv

end

end Case

