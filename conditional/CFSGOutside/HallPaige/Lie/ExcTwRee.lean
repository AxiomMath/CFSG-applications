/-!
# The catalogue case `²F₄(q)`, `q = 2^{2m+1} > 2`

Let `Γ = F4.reeGamma K a` (`|K| = 2^{2a+1}`) be the large Ree group of the corpus, inside the
adjoint Chevalley group `G = F₄(K)`, with Borel subgroup `B = B(G) ∩ Γ`, monomial subgroup
`N = N(G) ∩ Γ`, relative Weyl group `W_σ = relWeylRee` generated by the involutions
`z₀ = s₀ s₃`, `z₁ = s₁ s₂ s₁ s₂`, and Bruhat cells `C(w) = B ṅ_w B` (`w ∈ W_σ`), which cover `Γ`.

We build the Tits system `CFSGOutside.HallPaige.ExcTw.titsRee` of `Γ` with simple reflections `[ṅ_{z_j}]`,
comparing with the split `(B, N)`-pair of `G` (`chevalley_split_bn_pair`): an element of `Γ` lies
in the `G`-cell of its `W_σ`-index, the `G`-cells are disjoint, and a product of the
`G`-cells of `x ∈ W_J` and `u` lies in the `G`-cells of `W_J u`, where
`W_J ∩ W_σ = {1, z_j}` (`fixedOrbitWeyl_inter_relWeylRee`); this gives
`C(z_j) C(u) ⊆ C(z_j u) ∪ C(u)`.

The Weyl group of `titsRee` is generated by the two involutions `[ṅ_{z₀}]`, `[ṅ_{z₁}]`, so for
`J = ⟨[ṅ_{z₀}]⟩` every `w` or `[ṅ_{z₀}] w` is an involution (`sq_or_mul_sq_of_mem_closure`), and
the parabolic subgroup `P_J ⊇ B ⊇ U` has odd index (`not_dvd_index_reeFixedPosUnipotent`). Hence
the Wilcox criterion holds (`CFSGOutside.HallPaige.Exc.wilcoxCriterion_of_parabolic`), and the corpus
identifies `Γ` with the TauCeti carrier of `²F₄(2^{2m+1})`, `m ≥ 1`.
-/

namespace CFSGOutside.HallPaige.ExcTw

open DoubleCoset TauCeti CFSGOutside.Corpus.Exc CFSGOutside.Corpus.Ree CFSGOutside.Corpus.Ree.ReeTag
  CFSGOutside.HallPaige.Exc
open scoped Pointwise

noncomputable section

/-! ### Dihedral groups -/

section Dihedral

variable {W : Type*} [Group W]

/-- **In a group generated by two involutions `s`, `t`, every element `w` has `w² = 1` or
`(s w)² = 1`.** -/
theorem sq_or_mul_sq_of_mem_closure {s t : W} (hs : s * s = 1) (ht : t * t = 1) {w : W}
    (hw : w ∈ Subgroup.closure ({s, t} : Set W)) : w * w = 1 ∨ (s * w) * (s * w) = 1 := by
  set ρ := s * t with hρ
  have hsinv : s⁻¹ = s := inv_eq_of_mul_eq_one_right hs
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right ht
  have hconj1 : s * ρ * s⁻¹ = ρ⁻¹ := by
    rw [hρ, mul_inv_rev, htinv, hsinv, ← mul_assoc, hs, one_mul]
  have hconj : ∀ k : ℤ, s * ρ ^ k = ρ ^ (-k) * s := by
    intro k
    have h := map_zpow (MulAut.conj s) ρ k
    rw [MulAut.conj_apply, MulAut.conj_apply, hconj1, inv_zpow', ] at h
    calc s * ρ ^ k = s * ρ ^ k * s⁻¹ * s := by group
      _ = ρ ^ (-k) * s := by rw [h]
  let D : Subgroup W :=
    { carrier := {x | ∃ k : ℤ, x = ρ ^ k ∨ x = ρ ^ k * s}
      mul_mem' := by
        rintro x y ⟨a, rfl | rfl⟩ ⟨b, rfl | rfl⟩
        · exact ⟨a + b, Or.inl (zpow_add ρ a b).symm⟩
        · exact ⟨a + b, Or.inr (by rw [← mul_assoc, ← zpow_add])⟩
        · refine ⟨a - b, Or.inr ?_⟩
          rw [mul_assoc, hconj, ← mul_assoc, ← zpow_add, sub_eq_add_neg]
        · refine ⟨a - b, Or.inl ?_⟩
          rw [mul_assoc, ← mul_assoc s, hconj, mul_assoc, hs, mul_one, ← zpow_add, sub_eq_add_neg]
      one_mem' := ⟨0, Or.inl (zpow_zero ρ).symm⟩
      inv_mem' := by
        rintro x ⟨a, rfl | rfl⟩
        · exact ⟨-a, Or.inl (zpow_neg ρ a).symm⟩
        · refine ⟨a, Or.inr ?_⟩
          rw [mul_inv_rev, hsinv, ← zpow_neg, hconj, neg_neg] }
  have hle : Subgroup.closure ({s, t} : Set W) ≤ D := by
    rw [Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact ⟨0, Or.inr (by rw [zpow_zero, one_mul])⟩
    · refine ⟨-1, Or.inr ?_⟩
      rw [← hconj, zpow_one, hρ, ← mul_assoc, hs, one_mul]
  obtain ⟨k, rfl | rfl⟩ := hle hw
  · right
    have e : (s * ρ ^ k) * (s * ρ ^ k) = (s * ρ ^ k * s) * ρ ^ k := by group
    rw [e, hconj k, mul_assoc (ρ ^ (-k)) s s, hs, mul_one, ← zpow_add, neg_add_cancel, zpow_zero]
  · left
    have e : ρ ^ k * s * (ρ ^ k * s) = ρ ^ k * (s * ρ ^ k) * s := by group
    rw [e, hconj k]
    have e2 : ρ ^ k * (ρ ^ (-k) * s) * s = ρ ^ k * ρ ^ (-k) * (s * s) := by group
    rw [e2, hs, mul_one, ← zpow_add, add_neg_cancel, zpow_zero]

end Dihedral

/-! ### Left multiplication by a parabolic Weyl subgroup -/

section LeftMul

variable {G : Type} [Group G] (T : TauCeti.TitsSystem G)

/-- **The cells of `x ∈ ⟨S₀⟩` times the cell of `w` lie in the cells of `⟨S₀⟩ w`.** -/
theorem bruhatCell_mul_subset_iUnion_mul (S₀ : Set T.WeylGroup) (hS₀ : S₀ ⊆ T.simple)
    {x : T.WeylGroup} (hx : x ∈ Subgroup.closure S₀) :
    ∀ w : T.WeylGroup, T.bruhatCell x * T.bruhatCell w ⊆
      ⋃ y ∈ Subgroup.closure S₀, T.bruhatCell (y * w) := by
  induction hx using Subgroup.closure_induction_left with
  | one =>
    intro w g hg
    rw [T.bruhatCell_one, T.subgroupB_mul_bruhatCell] at hg
    exact Set.mem_biUnion (Subgroup.one_mem _) (by rwa [one_mul])
  | mul_left s hs y _ ih =>
    intro w
    rintro _ ⟨a, ha, b, hb, rfl⟩
    obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := (TitsSystem.bruhatCell_mul_subset_mul T s y) ha
    obtain ⟨y', hy', hab⟩ := Set.mem_iUnion₂.1 (ih w ⟨a₂, ha₂, b, hb, rfl⟩)
    have hsy' : s * y' ∈ Subgroup.closure S₀ := mul_mem (Subgroup.subset_closure hs) hy'
    show a₁ * a₂ * b ∈ _
    rw [mul_assoc]
    rcases T.bruhatCell_mul_subset_union_of_mem_simple (hS₀ hs) (y' * w) ⟨a₁, ha₁, _, hab, rfl⟩
      with h | h
    · exact Set.mem_biUnion hsy' (by rwa [← mul_assoc] at h)
    · exact Set.mem_biUnion hy' h
  | inv_mul_cancel s hs y _ ih =>
    intro w
    rw [T.inv_simple (hS₀ hs)]
    rintro _ ⟨a, ha, b, hb, rfl⟩
    obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := (TitsSystem.bruhatCell_mul_subset_mul T s y) ha
    obtain ⟨y', hy', hab⟩ := Set.mem_iUnion₂.1 (ih w ⟨a₂, ha₂, b, hb, rfl⟩)
    have hsy' : s * y' ∈ Subgroup.closure S₀ := mul_mem (Subgroup.subset_closure hs) hy'
    show a₁ * a₂ * b ∈ _
    rw [mul_assoc]
    rcases T.bruhatCell_mul_subset_union_of_mem_simple (hS₀ hs) (y' * w) ⟨a₁, ha₁, _, hab, rfl⟩
      with h | h
    · exact Set.mem_biUnion hsy' (by rwa [← mul_assoc] at h)
    · exact Set.mem_biUnion hy' h

end LeftMul

/-! ### The ambient Chevalley group `F₄(K)` -/

section Ambient

variable (K : Type) [Field K]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

/-- The Tits system of the adjoint Chevalley group `F₄(K)`. -/
abbrev titsF4 : TauCeti.TitsSystem (adjointGroup F4.tag K) :=
  titsSystemOfSplitBN (Corpus.Exc.Chevalley.chevalley_split_bn_pair F4.tag K).1

/-- The class in `N / (B ∩ N)` of an element of the monomial subgroup of `F₄(K)`. -/
def mkA (n : monomialSub F4.tag K) : (titsF4 K).WeylGroup :=
  QuotientGroup.mk (s := (titsF4 K).intersection) n

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Ree.FiniteWeylGroup]
include h0 h1 h2 h3 h4 h5

/-- The identification `W(F₄) ≃* N / (B ∩ N)` of `chevalley_split_bn_pair`. -/
def φA : WeylGroup F4.tag ≃* (titsF4 K).WeylGroup :=
  (Corpus.Exc.Chevalley.chevalley_split_bn_pair F4.tag K).2.2.1.choose.trans
    (weylEquiv (Corpus.Exc.Chevalley.chevalley_split_bn_pair F4.tag K).1)

end

variable {K}

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4

theorem mkA_mul (a b : monomialSub F4.tag K) : mkA K (a * b) = mkA K a * mkA K b :=
  QuotientGroup.mk_mul (N := (titsF4 K).intersection) a b

theorem mkA_eq_one_iff (n : monomialSub F4.tag K) :
    mkA K n = 1 ↔ ((n : adjointGroup F4.tag K) : ModGL F4.tag K) ∈ borelGroup F4.tag K :=
  QuotientGroup.eq_one_iff (N := (titsF4 K).intersection) n

theorem mkA_eq_iff (n m : monomialSub F4.tag K) :
    mkA K n = mkA K m ↔ ((n⁻¹ * m : monomialSub F4.tag K) : ModGL F4.tag K) ∈ borelGroup F4.tag K :=
  QuotientGroup.eq (s := (titsF4 K).intersection)

theorem bruhatCell_mkA (n : monomialSub F4.tag K) :
    (titsF4 K).bruhatCell (mkA K n) = doubleCoset (n : adjointGroup F4.tag K)
      (borelSub F4.tag K) (borelSub F4.tag K) :=
  (titsF4 K).bruhatCell_mk n

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition] [h3 : Corpus.Exc.BorelNormal] [h4 : Corpus.Exc.Chevalley] [h5 : Corpus.Ree.FiniteWeylGroup]
include h0 h1 h2 h3 h4 h5

theorem φA_simple (i : Fin F4.tag.rank) : φA K (simple F4.tag i) = mkA K (weylRep F4.tag K i) := by
  change weylEquiv _ ((Corpus.Exc.Chevalley.chevalley_split_bn_pair F4.tag K).2.2.1.choose (simple F4.tag i)) = _
  rw [(Corpus.Exc.Chevalley.chevalley_split_bn_pair F4.tag K).2.2.1.choose_spec i, weylEquiv_mk]
  rfl

theorem φA_simple_mem (i : Fin F4.tag.rank) : φA K (simple F4.tag i) ∈ (titsF4 K).simple := by
  rw [φA_simple]
  exact mk_mem_simple _ i

theorem canonicalRep_eq_prod (w : WeylGroup F4.tag) :
    canonicalRep (coxeterSystem F4.tag) K w =
      (((coxeterSystem F4.tag).exists_isReduced w).choose.map
        fun i => weylElt F4.tag K i 1).prod := rfl

theorem canonicalRep_mem_adjointGroup (w : WeylGroup F4.tag) :
    canonicalRep (coxeterSystem F4.tag) K w ∈ adjointGroup F4.tag K := by
  rw [canonicalRep_eq_prod]
  exact list_prod_mem fun x hx => by
    obtain ⟨i, -, rfl⟩ := List.mem_map.1 hx
    exact weylElt_mem_adjointGroup F4.tag K i 1

theorem canonicalRep_mem_monomialSubgroup (w : WeylGroup F4.tag) :
    canonicalRep (coxeterSystem F4.tag) K w ∈ monomialSubgroup F4.tag K := by
  rw [canonicalRep_eq_prod]
  exact list_prod_mem fun x hx => by
    obtain ⟨i, -, rfl⟩ := List.mem_map.1 hx
    exact weylElt_mem_monomialSubgroup F4.tag K i

/-- `ṅ_w` in the monomial subgroup of `F₄(K)`. -/
def nA (w : WeylGroup F4.tag) : monomialSub F4.tag K :=
  ⟨⟨canonicalRep (coxeterSystem F4.tag) K w, canonicalRep_mem_adjointGroup w⟩,
    Subgroup.mem_subgroupOf.2 (canonicalRep_mem_monomialSubgroup w)⟩

theorem nA_eq_prod (w : WeylGroup F4.tag) :
    nA (K := K) w = (((coxeterSystem F4.tag).exists_isReduced w).choose.map
      (weylRep F4.tag K)).prod := by
  apply Subtype.ext
  apply Subtype.ext
  change canonicalRep (coxeterSystem F4.tag) K w = _
  rw [canonicalRep_eq_prod, Subgroup.val_list_prod, Subgroup.val_list_prod, List.map_map,
    List.map_map]
  rfl

/-- **The class of `ṅ_w` is `w`.** -/
theorem mkA_nA (w : WeylGroup F4.tag) : mkA K (nA w) = φA K w := by
  obtain ⟨-, hw⟩ := ((coxeterSystem F4.tag).exists_isReduced w).choose_spec
  rw [nA_eq_prod]
  conv_rhs => rw [hw]
  set ω := ((coxeterSystem F4.tag).exists_isReduced w).choose
  rw [CoxeterSystem.wordProd, map_list_prod, List.map_map]
  let f : monomialSub F4.tag K →* (titsF4 K).WeylGroup :=
    { toFun := mkA K, map_one' := QuotientGroup.mk_one (N := (titsF4 K).intersection),
      map_mul' := mkA_mul }
  change f _ = _
  rw [map_list_prod, List.map_map]
  congr 1
  apply List.map_congr_left
  intro i _
  exact (φA_simple i).symm

end

end Ambient

/-! ### The large Ree group and its Tits system -/

section Ree

variable (K : Type) [Field K] [Finite K] [CharP K F4.prime] (a : ℕ)

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut]
include h0 h1 h2

/-- The large Ree group `Γ`. -/
abbrev RG : Subgroup (ModGL F4.tag K) := F4.reeGamma K a

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

/-- Its Borel subgroup, inside `Γ`. -/
abbrev RB : Subgroup (RG K a) := (F4.reeFixedBorel K a).subgroupOf (RG K a)

/-- Its monomial subgroup, inside `Γ`. -/
abbrev RN : Subgroup (RG K a) := (F4.reeFixedMonomial K a).subgroupOf (RG K a)

end

variable {K a}

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut]
include h0 h1 h2

theorem reeGamma_le_adjointGroup : RG K a ≤ adjointGroup F4.tag K := by
  rintro _ ⟨y, -, rfl⟩
  exact y.2

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

theorem reeFixedBorel_le : F4.reeFixedBorel K a ≤ RG K a := inf_le_right

theorem reeFixedMonomial_le : F4.reeFixedMonomial K a ≤ RG K a := inf_le_right

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut]
include h0 h1 h2

/-- `Γ → F₄(K)`. -/
def ιA (g : RG K a) : adjointGroup F4.tag K := ⟨g, reeGamma_le_adjointGroup g.2⟩

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

/-- An element of `N` in the monomial subgroup of `F₄(K)`. -/
def ιN (n : RN K a) : monomialSub F4.tag K :=
  ⟨ιA (n : RG K a), Subgroup.mem_subgroupOf.2 (Subgroup.mem_inf.1 (Subgroup.mem_subgroupOf.1 n.2)).1⟩

theorem ιN_mul (n m : RN K a) : ιN (n * m) = ιN n * ιN m := rfl

theorem mem_RB_iff (g : RG K a) : g ∈ RB K a ↔ (g : ModGL F4.tag K) ∈ borelGroup F4.tag K :=
  ⟨fun h => (Subgroup.mem_inf.1 (Subgroup.mem_subgroupOf.1 h)).1,
    fun h => Subgroup.mem_subgroupOf.2 (Subgroup.mem_inf.2 ⟨h, g.2⟩)⟩

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits]
include h0 h1 h2 h3 h4 h5 h6 h7

/-- `ṅ_w` as an element of `N`. -/
def nR {w : WeylGroup F4.tag} (hw : w ∈ F4.relWeylRee) : RN K a :=
  ⟨⟨canonicalRep (coxeterSystem F4.tag) K w,
      reeFixedMonomial_le (Corpus.Ree.ReeTag.FixedOrbits.canonicalRep_mem_reeFixedMonomial F4 K a hw)⟩,
    Subgroup.mem_subgroupOf.2 (Corpus.Ree.ReeTag.FixedOrbits.canonicalRep_mem_reeFixedMonomial F4 K a hw)⟩

theorem ιN_nR {w : WeylGroup F4.tag} (hw : w ∈ F4.relWeylRee) : ιN (nR (K := K) (a := a) hw) = nA w :=
  rfl

theorem mkA_ιN_nR {w : WeylGroup F4.tag} (hw : w ∈ F4.relWeylRee) :
    mkA K (ιN (nR (K := K) (a := a) hw)) = φA K w := by
  rw [ιN_nR, mkA_nA]

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup]
include h0 h1 h2 h3 h4 h5 h6

/-- The Bruhat cell `C(w)`, inside `Γ`. -/
def cellR (w : WeylGroup F4.tag) : Set (RG K a) :=
  Subtype.val ⁻¹' F4.reeFixedBruhatCell K a w

theorem mem_reeFixedBruhatCell {w : WeylGroup F4.tag} {x : ModGL F4.tag K} :
    x ∈ F4.reeFixedBruhatCell K a w ↔ ∃ b ∈ F4.reeFixedBorel K a,
      ∃ b' ∈ F4.reeFixedBorel K a, b * canonicalRep (coxeterSystem F4.tag) K w * b' = x := by
  simp only [reeFixedBruhatCell, Set.mem_mul, Set.mem_singleton_iff, SetLike.mem_coe]
  constructor
  · rintro ⟨_, ⟨b, hb, _, rfl, rfl⟩, b', hb', rfl⟩
    exact ⟨b, hb, b', hb', rfl⟩
  · rintro ⟨b, hb, b', hb', rfl⟩
    exact ⟨_, ⟨b, hb, _, rfl, rfl⟩, b', hb', rfl⟩

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits]
include h0 h1 h2 h3 h4 h5 h6 h7

theorem cellR_eq {w : WeylGroup F4.tag} (hw : w ∈ F4.relWeylRee) :
    cellR (K := K) (a := a) w =
      doubleCoset ((nR (K := K) (a := a) hw : RN K a) : RG K a) (RB K a) (RB K a) := by
  ext x
  rw [cellR, Set.mem_preimage, mem_reeFixedBruhatCell, mem_doubleCoset]
  constructor
  · rintro ⟨b, hb, b', hb', hx⟩
    refine ⟨⟨b, reeFixedBorel_le hb⟩, hb, ⟨b', reeFixedBorel_le hb'⟩, hb', Subtype.ext ?_⟩
    rw [← hx]
    rfl
  · rintro ⟨b, hb, b', hb', rfl⟩
    exact ⟨b, hb, b', hb', rfl⟩

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup]
include h0 h1 h2 h3 h4 h5 h6

/-- **An element of `C(w)` lies in the `F₄(K)`-cell of `w`.** -/
theorem ιA_mem_bruhatCell {w : WeylGroup F4.tag} {g : RG K a} (hg : g ∈ cellR (K := K) (a := a) w) :
    ιA g ∈ (titsF4 K).bruhatCell (φA K w) := by
  rw [← mkA_nA, bruhatCell_mkA]
  obtain ⟨b, hb, b', hb', he⟩ := mem_reeFixedBruhatCell.1 hg
  have hbA : b ∈ adjointGroup F4.tag K := reeGamma_le_adjointGroup (reeFixedBorel_le hb)
  have hbA' : b' ∈ adjointGroup F4.tag K := reeGamma_le_adjointGroup (reeFixedBorel_le hb')
  refine mem_doubleCoset.2 ⟨⟨b, hbA⟩, Subgroup.mem_subgroupOf.2 (Subgroup.mem_inf.1 hb).1,
    ⟨b', hbA'⟩, Subgroup.mem_subgroupOf.2 (Subgroup.mem_inf.1 hb').1, Subtype.ext ?_⟩
  exact he.symm

end

section
