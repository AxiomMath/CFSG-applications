variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

theorem mem_bruhatCell_mkA_ιN (n : RN K a) :
    ιA (n : RG K a) ∈ (titsF4 K).bruhatCell (mkA K (ιN n)) := by
  rw [bruhatCell_mkA]
  exact mem_doubleCoset_self _ _ _

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits]
include h0 h1 h2 h3 h4 h5 h6 h7

/-- **The `W_σ`-index of an element of `N`.** -/
theorem exists_mkA_ιN_eq (n : RN K a) :
    ∃ u ∈ F4.relWeylRee, mkA K (ιN n) = φA K u := by
  have hn : ((n : RG K a) : ModGL F4.tag K) ∈ (F4.reeGamma K a : Set (ModGL F4.tag K)) :=
    (n : RG K a).2
  rw [Corpus.Ree.ReeTag.FixedOrbits.reeGamma_eq_iUnion_reeFixedBruhatCell] at hn
  obtain ⟨⟨v, hv⟩, hnv⟩ := Set.mem_iUnion.1 hn
  exact ⟨v, hv, TitsSystem.eq_of_mem_bruhatCell_of_mem _ (mem_bruhatCell_mkA_ιN n)
    (ιA_mem_bruhatCell (g := (n : RG K a)) hnv)⟩

theorem doubleCoset_eq_cellR (n : RN K a) {u : WeylGroup F4.tag} (hu : u ∈ F4.relWeylRee)
    (h : mkA K (ιN n) = φA K u) :
    doubleCoset ((n : RN K a) : RG K a) (RB K a) (RB K a) = cellR (K := K) (a := a) u := by
  rw [cellR_eq hu]
  apply doubleCoset_eq_of_mem
  rw [← mkA_ιN_nR (K := K) (a := a) hu, eq_comm, mkA_eq_iff] at h
  rw [mem_doubleCoset]
  refine ⟨1, one_mem _, ((nR hu : RN K a) : RG K a)⁻¹ * n, ?_, by group⟩
  show _ ∈ RB K a
  rw [mem_RB_iff]
  exact h

/-! #### The Tits system -/

theorem RB_sup_RN : RB K a ⊔ RN K a = ⊤ := by
  have h := Subgroup.comap_sup_eq_of_le_range (f := (RG K a).subtype)
    (H := F4.reeFixedBorel K a) (K := F4.reeFixedMonomial K a)
    (by rw [Subgroup.range_subtype]; exact reeFixedBorel_le)
    (by rw [Subgroup.range_subtype]; exact reeFixedMonomial_le)
  change Subgroup.comap _ _ ⊔ Subgroup.comap _ _ = ⊤
  rw [h, ← Corpus.Ree.ReeTag.FixedOrbits.reeGamma_eq_sup_reeFixedMonomial]
  exact Subgroup.subgroupOf_self _

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley]
include h0 h1 h2 h3 h4 h5

theorem normal_RB_subgroupOf_RN : ((RB K a).subgroupOf (RN K a)).Normal := by
  refine ⟨fun n hn g => ?_⟩
  rw [Subgroup.mem_subgroupOf, mem_RB_iff] at hn ⊢
  have hnorm := Corpus.Exc.BorelNormal.normal_borelSub_inf_monomialSub F4.tag K
  have hmem : ιN n ∈ (borelSub F4.tag K ⊓ monomialSub F4.tag K).subgroupOf
      (monomialSub F4.tag K) :=
    Subgroup.mem_subgroupOf.2 (Subgroup.mem_inf.2 ⟨Subgroup.mem_subgroupOf.2 hn, (ιN n).2⟩)
  have := hnorm.conj_mem _ hmem (ιN g)
  exact Subgroup.mem_subgroupOf.1 (Subgroup.mem_inf.1 (Subgroup.mem_subgroupOf.1 this)).1

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits]
include h0 h1 h2 h3 h4 h5 h6 h7

variable (K a) in
/-- **The Tits system of the large Ree group with simple reflections `[ṅ_{z_j}]`.** -/
def titsRee : TauCeti.TitsSystem (RG K a) where
  subgroupB := RB K a
  subgroupN := RN K a
  closure_subgroupB_union_subgroupN := by
    rw [Subgroup.closure_union, Subgroup.closure_eq, Subgroup.closure_eq]
    exact RB_sup_RN
  intersection_normal := normal_RB_subgroupOf_RN
  simple := Set.range fun j : Fin F4.fixedOrbitCount =>
    (QuotientGroup.mk (nR (K := K) (a := a) (Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem j)) :
      RN K a ⧸ (RB K a).subgroupOf (RN K a))
  closure_simple := by
    intro _
    rw [eq_top_iff]
    rintro x -
    obtain ⟨n, rfl⟩ := QuotientGroup.mk_surjective x
    set C := Subgroup.closure (Set.range fun j : Fin F4.fixedOrbitCount =>
      (QuotientGroup.mk (nR (K := K) (a := a) (Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem j)) :
        RN K a ⧸ (RB K a).subgroupOf (RN K a)))
    let R : Subgroup (ModGL F4.tag K) :=
      ((C.comap (QuotientGroup.mk' ((RB K a).subgroupOf (RN K a)))).map (RN K a).subtype).map
        (RG K a).subtype
    have hT : F4.reeFixedTorus K a ≤ R := by
      intro g hg
      have hgN : g ∈ F4.reeFixedMonomial K a :=
        Subgroup.mem_inf.2 ⟨Subgroup.mem_sup_left (Subgroup.mem_inf.1 hg).1,
          (Subgroup.mem_inf.1 hg).2⟩
      have hgΓ : g ∈ RG K a := (Subgroup.mem_inf.1 hg).2
      refine ⟨⟨g, hgΓ⟩, ⟨⟨⟨g, hgΓ⟩, Subgroup.mem_subgroupOf.2 hgN⟩, ?_, rfl⟩, rfl⟩
      show QuotientGroup.mk' _ _ ∈ C
      rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_subgroupOf.2
        ((mem_RB_iff _).2 (Subgroup.mem_sup_left (Subgroup.mem_inf.1 hg).1)))]
      exact C.one_mem
    have hC : Subgroup.closure (Set.range fun j => canonicalRep (coxeterSystem F4.tag) K
        (F4.fixedOrbitElement j)) ≤ R := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨_, ⟨nR (K := K) (a := a) (Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem j),
        Subgroup.subset_closure ⟨j, rfl⟩, rfl⟩, rfl⟩
    have hN : F4.reeFixedMonomial K a ≤ R := (Corpus.Ree.ReeTag.FixedOrbits.reeFixedMonomial_eq_sup F4 K a) ▸ sup_le hT hC
    obtain ⟨_, ⟨m, hm, rfl⟩, hmn⟩ := hN (Subgroup.mem_subgroupOf.1 n.2)
    have : m = n := Subtype.ext (Subtype.ext hmn)
    subst this
    exact hm
  exists_simpleRep_sq_mem := by
    rintro _ ⟨j, rfl⟩
    have hj := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem (t := F4) j
    refine ⟨nR hj, rfl, Subgroup.mem_subgroupOf.2 ((mem_RB_iff _).2 ?_)⟩
    have h : mkA K (ιN (nR (K := K) (a := a) hj * nR hj)) = 1 := by
      rw [ιN_mul, mkA_mul, mkA_ιN_nR, ← map_mul, Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mul_self, map_one]
    exact (mkA_eq_one_iff _).1 h
  mul_doubleCoset_subset := by
    rintro _ ⟨j, rfl⟩
    have hj := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem (t := F4) j
    refine ⟨nR hj, rfl, fun w => ?_⟩
    obtain ⟨u, hu, hw⟩ := exists_mkA_ιN_eq w
    have e1 : doubleCoset ((nR (K := K) (a := a) hj : RN K a) : RG K a) (RB K a) (RB K a) =
        cellR (K := K) (a := a) (F4.fixedOrbitElement j) := (cellR_eq hj).symm
    have e2 : doubleCoset ((w : RN K a) : RG K a) (RB K a) (RB K a) =
        cellR (K := K) (a := a) u := doubleCoset_eq_cellR w hu hw
    have e3 : doubleCoset ((nR (K := K) (a := a) hj * w : RN K a) : RG K a) (RB K a) (RB K a) =
        cellR (K := K) (a := a) (F4.fixedOrbitElement j * u) :=
      doubleCoset_eq_cellR _ (mul_mem hj hu) (by rw [ιN_mul, mkA_mul, mkA_ιN_nR, hw, map_mul])
    change doubleCoset ((nR (K := K) (a := a) hj : RN K a) : RG K a) (RB K a) (RB K a) *
        doubleCoset ((w : RN K a) : RG K a) (RB K a) (RB K a) ⊆
      doubleCoset ((nR (K := K) (a := a) hj * w : RN K a) : RG K a) (RB K a) (RB K a) ∪
        doubleCoset ((w : RN K a) : RG K a) (RB K a) (RB K a)
    rw [e1, e2, e3]
    rintro _ ⟨X, hX, Y, hY, rfl⟩
    have hXY : ((X * Y : RG K a) : ModGL F4.tag K) ∈
        (F4.reeGamma K a : Set (ModGL F4.tag K)) := (X * Y).2
    rw [Corpus.Ree.ReeTag.FixedOrbits.reeGamma_eq_iUnion_reeFixedBruhatCell] at hXY
    obtain ⟨⟨v, hv⟩, hv'⟩ := Set.mem_iUnion.1 hXY
    have h1 := ιA_mem_bruhatCell (g := X * Y) hv'
    set S₀ : Set (titsF4 K).WeylGroup := φA K '' (simple F4.tag '' F4.fixedOrbitSet j)
    have hS₀ : S₀ ⊆ (titsF4 K).simple := by
      rintro _ ⟨_, ⟨i, -, rfl⟩, rfl⟩
      exact φA_simple_mem i
    have hcl : Subgroup.closure S₀ = (F4.fixedOrbitWeyl j).map (φA K).toMonoidHom := by
      rw [fixedOrbitWeyl, parabolicWeylGroup, MonoidHom.map_closure]
      rfl
    have hz : φA K (F4.fixedOrbitElement j) ∈ Subgroup.closure S₀ := by
      rw [hcl]
      exact ⟨_, Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem_fixedOrbitWeyl j, rfl⟩
    have h2 := bruhatCell_mul_subset_iUnion_mul (titsF4 K) S₀ hS₀ hz (φA K u)
      ⟨ιA X, ιA_mem_bruhatCell hX, ιA Y, ιA_mem_bruhatCell hY, rfl⟩
    obtain ⟨y, hy, h3⟩ := Set.mem_iUnion₂.1 h2
    have heq := TitsSystem.eq_of_mem_bruhatCell_of_mem _ h1 h3
    rw [hcl] at hy
    obtain ⟨x', hx', rfl⟩ := hy
    have hvx : v = x' * u := (φA K).injective (by rw [heq, map_mul]; rfl)
    have hx'W : x' ∈ F4.relWeylRee := by
      have := mul_mem hv (inv_mem hu)
      rwa [hvx, mul_inv_cancel_right] at this
    have hx'' : x' ∈ (F4.fixedOrbitWeyl j : Set (WeylGroup F4.tag)) ∩ F4.relWeylRee :=
      ⟨hx', hx'W⟩
    rw [Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitWeyl_inter_relWeylRee] at hx''
    rcases hx'' with rfl | hx''
    · rw [one_mul] at hvx
      subst hvx
      exact Or.inr hv'
    · rw [Set.mem_singleton_iff] at hx''
      subst hx'' hvx
      exact Or.inl hv'
  exists_conj_not_mem := by
    rintro _ ⟨j, rfl⟩
    have hj := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem (t := F4) j
    refine ⟨nR hj, rfl, ?_⟩
    by_contra! hall
    apply Corpus.Ree.ReeTag.FixedOrbits.not_normal_reeFixedBorel_subgroupOf (t := F4) (K := K) (a := a) j
    refine ⟨fun n hn g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    have hg : (g : ModGL F4.tag K) ∈ (F4.reeFixedBorel K a : Set (ModGL F4.tag K)) ∪
        F4.reeFixedBruhatCell K a (F4.fixedOrbitElement j) := by
      rw [← Corpus.Ree.ReeTag.FixedOrbits.coe_reeGamma_inf_parabolicSubgroup j]
      exact g.2
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rcases hg with hg | hg
    · exact mul_mem (mul_mem hg hn) (inv_mem hg)
    · obtain ⟨b₁, hb₁, b₂, hb₂, he⟩ := mem_reeFixedBruhatCell.1 hg
      set c := canonicalRep (coxeterSystem F4.tag) K (F4.fixedOrbitElement j)
      have hm : b₂ * (n : ModGL F4.tag K) * b₂⁻¹ ∈ F4.reeFixedBorel K a :=
        mul_mem (mul_mem hb₂ hn) (inv_mem hb₂)
      have hc := hall ⟨⟨_, reeFixedBorel_le hm⟩, Subgroup.mem_subgroupOf.2 hm⟩
      rw [Subgroup.mem_subgroupOf] at hc
      have hc' : c * (b₂ * (n : ModGL F4.tag K) * b₂⁻¹) * c⁻¹ ∈ F4.reeFixedBorel K a := hc
      rw [← he]
      have e : b₁ * c * b₂ * (n : ModGL F4.tag K) * (b₁ * c * b₂)⁻¹ =
          b₁ * (c * (b₂ * (n : ModGL F4.tag K) * b₂⁻¹) * c⁻¹) * b₁⁻¹ := by group
      rw [e]
      exact mul_mem (mul_mem hb₁ hc') (inv_mem hb₁)

/-- The class of `n ∈ N` in the Weyl group of `titsRee`. -/
def mkR (n : RN K a) : (titsRee K a).WeylGroup :=
  QuotientGroup.mk (s := (titsRee K a).intersection) n

theorem mkR_mem_simple (j : Fin F4.fixedOrbitCount) :
    mkR (nR (K := K) (a := a) (Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem j)) ∈ (titsRee K a).simple :=
  ⟨j, rfl⟩

theorem mkA_eq_of_mkR_eq {n m : RN K a} (h : mkR n = mkR m) : mkA K (ιN n) = mkA K (ιN m) := by
  have h' : n⁻¹ * m ∈ (titsRee K a).intersection := QuotientGroup.eq.1 h
  rw [mkA_eq_iff]
  exact (mem_RB_iff _).1 (Subgroup.mem_subgroupOf.1 h')

end

