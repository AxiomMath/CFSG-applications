section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits]
include h0 h1 h2 h3 h4 h5 h6 h7

/-- **The Wilcox criterion for the large Ree groups.** -/
theorem wilcoxCriterion_reeGamma (hG : IsGood (RG K a)) : WilcoxCriterion (RG K a) := by
  set T := titsRee K a
  have h0 := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem (t := F4) ⟨0, by decide⟩
  have h1 := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_mem (t := F4) ⟨1, by decide⟩
  set s₀ := mkR (nR (K := K) (a := a) h0)
  set s₁ := mkR (nR (K := K) (a := a) h1)
  have hs₀ : s₀ ∈ T.simple := mkR_mem_simple _
  have hs₁ : s₁ ∈ T.simple := mkR_mem_simple _
  have hcl : Subgroup.closure ({s₀, s₁} : Set T.WeylGroup) = ⊤ := by
    rw [eq_top_iff, ← T.closure_simple]
    refine Subgroup.closure_mono ?_
    rintro _ ⟨⟨k, hk⟩, rfl⟩
    rcases k with _ | _ | k
    · exact Or.inl rfl
    · exact Or.inr rfl
    · exact absurd hk (by change ¬ (_ < 2); omega)
  have hne : s₁ ≠ s₀ := by
    intro h
    have := mkA_eq_of_mkR_eq h
    rw [mkA_ιN_nR, mkA_ιN_nR] at this
    have := Corpus.Ree.ReeTag.FixedOrbits.fixedOrbitElement_injective ((φA K).injective this)
    exact absurd (congrArg Fin.val this) (by decide)
  have hw₀ : s₁ ∉ Subgroup.closure ({s₀} : Set T.WeylGroup) := by
    rw [Subgroup.mem_closure_singleton]
    rintro ⟨k, hk⟩
    have hsq := T.simple_sq_eq_one hs₀
    rcases Int.even_or_odd' k with ⟨m, rfl | rfl⟩
    · rw [zpow_mul, zpow_two, hsq, one_zpow] at hk
      exact T.simple_ne_one hs₁ hk.symm
    · rw [zpow_add_one, zpow_mul, zpow_two, hsq, one_zpow, one_mul] at hk
      exact hne hk.symm
  refine wilcoxCriterion_of_parabolic T {s₀} (Set.singleton_subset_iff.2 hs₀) _ rfl hw₀ ?_ ?_
  · refine isGood_of_index_odd hG _ ?_
    rw [Nat.odd_iff, ← Nat.two_dvd_ne_zero]
    intro h
    have hU : (F4.reeFixedPosUnipotent K a).subgroupOf (RG K a) ≤ RB K a :=
      Subgroup.subgroupOf_mono _ (inf_le_inf_right _ le_sup_right)
    exact Corpus.Ree.ReeTag.FixedOrbits.not_dvd_index_reeFixedPosUnipotent (t := F4) (K := K) (a := a)
      (h.trans (Subgroup.index_dvd_of_le (hU.trans (subgroupB_le_parabolic T _ _ _ rfl))))
  · intro w
    rcases sq_or_mul_sq_of_mem_closure (T.simple_sq_eq_one hs₀) (T.simple_sq_eq_one hs₁)
        (hcl ▸ Subgroup.mem_top w) with h | h
    · exact ⟨1, one_mem _, 1, one_mem _, by simpa using h⟩
    · exact ⟨s₀, Subgroup.subset_closure rfl, 1, one_mem _, by simpa using h⟩

end

end Ree

/-! ### The catalogue case -/

instance charP_galoisField_F4 (n : ℕ) : CharP (GaloisField 2 n) F4.prime :=
  inferInstanceAs (CharP (GaloisField 2 n) 2)

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Ree.ReeTag.ReeAut] [h3 : Corpus.Exc.ParameterAddition] [h4 : Corpus.Exc.BorelNormal] [h5 : Corpus.Exc.Chevalley] [h6 : Corpus.Ree.FiniteWeylGroup] [h7 : Corpus.Ree.ReeTag.FixedOrbits] [h8 : Corpus.Ree.ReeGammaCat]
include h0 h1 h2 h3 h4 h5 h6 h7 h8

/-- **Hall–Paige for `²F₄(2^{2m+1})`, `m ≥ 1`**: the minimal-counterexample step. -/
theorem catalogueCase_reeF4 (m : ℕ) (hv : (LieTypeIndex.reeF4 m).Valid) :
    CatalogueCase (.lie ⟨.reeF4 m, hv⟩) := by
  have hm : 1 ≤ m := (LieTypeIndex.inStandardRange_iff _).1 ((LieTypeIndex.valid_iff _).1 hv).1
  set K := GaloisField 2 (2 * m + 1)
  have hK : Nat.card K = 2 ^ (2 * m + 1) := GaloisField.card 2 (2 * m + 1) (by omega)
  obtain ⟨e⟩ := Corpus.Ree.ReeGammaCat.reeGamma_equiv_cat_of_card hm hv hK
  let E : RG K m ≃* (CFSGIndex.lie ⟨.reeF4 m, hv⟩).Group := e.symm
  intro hG hP
  exact HasCompleteMapping.of_mulEquiv E (hasCompleteMapping_of_wilcoxCriterion cosetStatement
    (wilcoxCriterion_reeGamma (IsGood.of_mulEquiv E.symm hG))
    (ProperSubgroupsAdmissible.of_mulEquiv E.symm hP))

end

