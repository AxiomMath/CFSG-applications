/-- **`Suz` satisfies the permutation-labelling form of the Wilcox–Evans criterion.** -/
theorem permLabelling : PermLabelling TauCeti.SporadicName.Suz.Group :=
  haveI := Corpus.Suz.FiniteCardLe.finite_card_le.1
  permLabelling_of_certOK Corpus.Suz.FiniteCardLe.finite_card_le.2 cert certOK

