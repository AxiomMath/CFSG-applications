/-- **`Co3` satisfies the permutation-labelling form of the Wilcox–Evans criterion.** -/
theorem permLabelling : PermLabelling TauCeti.SporadicName.Co3.Group :=
  haveI := Corpus.Co3.FiniteCardLe.finite_card_le.1
  permLabelling_of_certOK Corpus.Co3.FiniteCardLe.finite_card_le.2 cert certOK

