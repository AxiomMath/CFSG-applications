import CFSGOutside.Corpus.HallPaige.Fi23
import CFSGOutside.HallPaige.Sporadic.ThreeTransposition

/-!
# The Wilcox criterion for `Fi₂₃`

`Fi₂₃` is generated by a class `D` of `31671` `3`-transpositions (corpus: `f23_J`,
`card_class_d`), the centralizer of a transposition `d` is transitive on the transpositions
commuting with `d` (corpus: `star_transitive`), and these exist (from the `F₂₃` structure). The
abstract criterion `CFSGOutside.HallPaige.wilcoxCriterion_of_threeTransposition` applies with
`H = C(d) ≅ 2.Fi₂₂`.

## Main results

* `CFSGOutside.HallPaige.Fi23.wilcoxCriterion_J`: `WilcoxCriterion` for the corpus matrix model `J`.
* `CFSGOutside.HallPaige.Fi23.wilcoxCriterion`: `WilcoxCriterion TauCeti.SporadicName.Fi23.Group`.
-/

namespace CFSGOutside.HallPaige.Fi23

open CFSGOutside.Corpus.Fi23

attribute [local irreducible] decode Fi23Seed1 Fi23Seed2

section
variable [h0 : Corpus.Fi23.Setup]
include h0

instance : Finite J := Subtype.finite

end

section
variable [h0 : Corpus.Fi23.Setup] [h1 : Corpus.Fi23.Theorems]
include h0 h1

theorem pair_J : Pair J D23 := Corpus.Fi23.Theorems.f23_J.1

theorem d_mul_d : d * d = 1 := by
  have h := pair_J.2.2.1 d (IsConj.refl d)
  rw [← sq, ← h]
  exact pow_orderOf_eq_one d

theorem orderOf_mul (x z : J) (hx : IsConj d x) (hz : IsConj d z) :
    orderOf (x * z) = 1 ∨ orderOf (x * z) = 2 ∨ orderOf (x * z) = 3 := by
  have h := pair_J.2.2.2.1 x hx z hz
  simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using h

end

section
variable [h0 : Corpus.Fi23.Setup]
include h0

theorem mem_commClass_iff (x : J) : x ∈ commClass d ↔ x ∈ star := Iff.rfl

end

section
variable [h0 : Corpus.Fi23.Setup] [h1 : Corpus.Fi23.Theorems]
include h0 h1

theorem commClass_trans (x : J) (hx : x ∈ commClass d) (y : J) (hy : y ∈ commClass d) :
    ∃ c : J, c * d = d * c ∧ c * x * c⁻¹ = y := by
  obtain ⟨c, hc⟩ := Corpus.Fi23.Theorems.star_transitive ⟨x, (mem_commClass_iff x).1 hx⟩ ⟨y, (mem_commClass_iff y).1 hy⟩
  refine ⟨c, mem_Cd.1 c.2, ?_⟩
  have h := congrArg Subtype.val hc
  exact h

/-- Some transposition other than `d` commutes with `d`: the images of the transpositions
commuting with a transposition `e₀` form a conjugacy class of the local quotient. -/
theorem commClass_nonempty : (commClass d).Nonempty := by
  obtain ⟨-, e₀, he₀, hF⟩ := Corpus.Fi23.Theorems.f23_J
  obtain ⟨e', he'⟩ := hF.1.2.1
  have hmem : (e' : LocalQuotient D23 e₀) ∈ LocalImages D23 e₀ := by
    rw [he']
    exact IsConj.refl e'
  obtain ⟨f, hf, -⟩ := hmem
  obtain ⟨hfD, hfe, hfc⟩ := hf
  obtain ⟨g, rfl⟩ := isConj_iff.1 (show IsConj d e₀ from he₀)
  refine ⟨g⁻¹ * f * g, ?_, ?_, ?_⟩
  · exact (show IsConj d (f : J) from hfD).trans (isConj_iff.2 ⟨g⁻¹, by group⟩)
  · intro h
    apply hfe
    calc (f : J) = g * (g⁻¹ * f * g) * g⁻¹ := by group
      _ = g * d * g⁻¹ := by rw [h]
  · calc g⁻¹ * f * g * d = g⁻¹ * (f * (g * d * g⁻¹)) * g := by group
      _ = g⁻¹ * ((g * d * g⁻¹) * f) * g := by rw [hfc]
      _ = d * (g⁻¹ * f * g) := by group

/-- **Wilcox criterion for the matrix model of `Fi₂₃`.** -/
theorem wilcoxCriterion_J : WilcoxCriterion J :=
  wilcoxCriterion_of_threeTransposition d d_mul_d orderOf_mul commClass_trans commClass_nonempty
    (by rw [Corpus.Fi23.Theorems.card_class_d]; decide) (by rw [Corpus.Fi23.Theorems.card_class_d]; decide)

/-- The matrix model is isomorphic to the TauCeti presented group. -/
noncomputable def isoJ : J ≃* TauCeti.SporadicName.Fi23.Group :=
  fi23EquivJ.symm.trans Corpus.Fi23.Theorems.nonempty_mulEquiv.some

/-- **Wilcox criterion for the Fischer group `Fi₂₃`.** -/
theorem wilcoxCriterion : WilcoxCriterion TauCeti.SporadicName.Fi23.Group :=
  wilcoxCriterion_of_threeTransposition_of_mulEquiv (G := TauCeti.SporadicName.Fi23.Group)
    (K := J) isoJ d d_mul_d orderOf_mul commClass_trans commClass_nonempty
    (by rw [Corpus.Fi23.Theorems.card_class_d]; decide) (by rw [Corpus.Fi23.Theorems.card_class_d]; decide)

end

end CFSGOutside.HallPaige.Fi23
