import CFSGOutside.HallPaige.Defs
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.Subgroup.Simple

/-!
# Goodness from a Klein four-subgroup

A finite group containing two distinct commuting involutions has non-trivial, non-cyclic Sylow
`2`-subgroups, hence is good. This is how the point stabilizers in the sporadic-group certificates
are shown to be good.
-/

namespace CFSGOutside.HallPaige

variable {H : Type*} [Group H]

/-- Every element of the subgroup generated by two commuting involutions squares to `1`. -/
theorem sq_eq_one_of_mem_closure_pair {u v : H} (hu : u ^ 2 = 1) (hv : v ^ 2 = 1)
    (huv : u * v = v * u) {g : H} (hg : g ∈ Subgroup.closure ({u, v} : Set H)) : g ^ 2 = 1 := by
  have hcomm : ({u, v} : Set H).Pairwise Commute := by
    rintro x (rfl | rfl) y (rfl | rfl) _ <;>
      first | exact Commute.refl _ | exact huv | exact huv.symm
  have hC := Subgroup.isMulCommutative_closure hcomm
  induction hg using Subgroup.closure_induction with
  | mem x hx => rcases hx with rfl | rfl <;> assumption
  | one => simp
  | mul x y hx hy ihx ihy =>
    have hxy : x * y = y * x := by
      have := hC.is_comm.comm ⟨x, hx⟩ ⟨y, hy⟩
      exact congrArg Subtype.val this
    rw [(Commute.mul_pow hxy 2), ihx, ihy, one_mul]
  | inv x hx ihx => rw [inv_pow, ihx, inv_one]

/-- A finite group with two distinct commuting involutions is good. -/
theorem isGood_of_commuting_involutions [Finite H] {u v : H} (hu : u ^ 2 = 1) (hv : v ^ 2 = 1)
    (huv : u * v = v * u) (hu1 : u ≠ 1) (hv1 : v ≠ 1) (hne : u ≠ v) : IsGood H := by
  classical
  have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let V : Subgroup H := Subgroup.closure {u, v}
  have hV : IsPGroup 2 V := fun g =>
    ⟨1, by
      apply Subtype.ext
      simpa using sq_eq_one_of_mem_closure_pair hu hv huv g.2⟩
  obtain ⟨P, hP⟩ := hV.exists_le_sylow
  have huP : u ∈ (P : Subgroup H) := hP (Subgroup.subset_closure (by simp))
  have hvP : v ∈ (P : Subgroup H) := hP (Subgroup.subset_closure (by simp))
  intro Q
  let e : (Q : Subgroup H) ≃* (P : Subgroup H) := Sylow.equiv Q P
  right
  intro hQ
  have hPc : IsCyclic (P : Subgroup H) := isCyclic_of_surjective e.toMonoidHom e.surjective
  have := Fintype.ofFinite (P : Subgroup H)
  have hle := IsCyclic.card_pow_eq_one_le (α := (P : Subgroup H)) (n := 2) (by norm_num)
  have hsub : ({1, ⟨u, huP⟩, ⟨v, hvP⟩} : Finset (P : Subgroup H)) ⊆
      Finset.univ.filter fun a => a ^ 2 = 1 := by
    intro a ha
    simp only [Finset.mem_insert, Finset.mem_singleton] at ha
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    rcases ha with rfl | rfl | rfl
    · simp
    · exact Subtype.ext hu
    · exact Subtype.ext hv
  have h3 : ({1, ⟨u, huP⟩, ⟨v, hvP⟩} : Finset (P : Subgroup H)).card = 3 := by
    rw [Finset.card_insert_of_notMem, Finset.card_pair]
    · intro h; exact hne (congrArg Subtype.val h)
    · simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
      exact ⟨fun h => hu1 (congrArg Subtype.val h).symm,
        fun h => hv1 (congrArg Subtype.val h).symm⟩
  have := Finset.card_le_card hsub
  omega

/-- Subgroup form: a subgroup of a finite group containing two distinct commuting involutions
is good. -/
theorem Subgroup.isGood_of_commuting_involutions {G : Type*} [Group G] [Finite G]
    (K : Subgroup G) {u v : G} (huK : u ∈ K) (hvK : v ∈ K) (hu : u ^ 2 = 1) (hv : v ^ 2 = 1)
    (huv : u * v = v * u) (hu1 : u ≠ 1) (hv1 : v ≠ 1) (hne : u ≠ v) : IsGood K :=
  CFSGOutside.HallPaige.isGood_of_commuting_involutions (u := ⟨u, huK⟩) (v := ⟨v, hvK⟩)
    (Subtype.ext hu) (Subtype.ext hv) (Subtype.ext huv)
    (fun h => hu1 (congrArg Subtype.val h)) (fun h => hv1 (congrArg Subtype.val h))
    (fun h => hne (congrArg Subtype.val h))

end CFSGOutside.HallPaige
