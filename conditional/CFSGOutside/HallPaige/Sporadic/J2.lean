/-- **TauCeti.SporadicName.J2 satisfies the permutation-labelling criterion**, through its action on
315 points (suborbit lengths [1, 10, 32, 32, 80, 160]). -/
theorem permLabelling : PermLabelling TauCeti.SporadicName.J2.Group :=
  model.permLabelling gensOK_gf model_injective 0 (by norm_num) 1 (by norm_num) (by norm_num)
    _ _ _ trans_ok 6 L1 inv1 lab_lt _ hs hs_ok _ _ _ stab_ok _ _ sg_ok cards_ok _ _ pairs_ok
    wu wv 1 1 1 klein_ok

end

