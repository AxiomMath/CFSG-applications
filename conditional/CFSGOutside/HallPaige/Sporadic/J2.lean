/-!
# `J₂` satisfies the permutation-labelling criterion

The action of `J₂` (as the TauCeti presented group) on 315 points, given by permutation tables
of the presentation generators `a, b` computed from the corpus 14-dimensional matrices over
`𝔽₅` (CFSG/Sporadic/Bridge/J2NativeData.lean, `mAl`, `mBe`) acting on the 315 vectors of
Certificates/Data/CFSGNative/PairSchreier/J2Vectors.txt. The tables are checked against the
relators directly, so no corpus theorem about them is used. All certificates are checked by kernel
evaluation.
-/

namespace CFSGOutside.HallPaige.SporadicJ2

open OrbitCert OrbitCert.Model

/-! Generator tables (9 bits per entry). -/

def tg0 : ℕ := 

def tgi0 : ℕ := 

def tg1 : ℕ := 

def tgi1 : ℕ := 

/-- The generator tables. -/
def gf (i : ℕ) (b : Bool) (x : ℕ) : ℕ :=
  tget 9 (cond b (cond (Nat.beq i 0) tg0 (tg1)) (cond (Nat.beq i 0) tgi0 (tgi1))) x

theorem gensOK_gf : gensOK 315 2 gf = true := by decide +kernel

theorem relatorLetters_eq :
    TauCeti.SporadicName.J2.presentation.relatorLetters =
      [[(0, true), (1, true), (0, true), (1, false), (0, false), (1, false)], [(0, true), (1, true), (1, true), (0, true), (1, false), (1, false), (1, false), (1, false), (1, false)], [(0, true), (1, false), (0, true), (1, false), (1, false), (1, false), (0, true), (0, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (1, false), (1, false), (0, true), (0, true), (0, true), (1, false), (0, true), (1, false), (0, true), (1, false), (1, false), (1, false), (0, true), (0, true), (0, true), (1, false), (0, true), (0, true), (0, true), (0, true), (0, true), (0, true), (0, true)]] := by
  rw [(show TauCeti.SporadicName.J2.presentation = TauCeti.Sporadic.j2Presentation from rfl)]
  simp [TauCeti.GroupPresentation.relatorLetters_def, TauCeti.GroupPresentation.relators_def,
    FreeGroup.invRev]

theorem relators_ok : (TauCeti.SporadicName.J2.presentation.relatorLetters.all fun v =>
    allLt 315 fun x => Nat.beq (ev 2 gf v x) x) = true := by
  rw [relatorLetters_eq]; decide +kernel

/-- The permutation model. -/
noncomputable def model : Model 315 2 gf TauCeti.SporadicName.J2.Group :=
  presModel _ (by rw [(show TauCeti.SporadicName.J2.presentation = TauCeti.Sporadic.j2Presentation from rfl)]; simp [TauCeti.GroupPresentation.generatorCount]) gensOK_gf relators_ok

