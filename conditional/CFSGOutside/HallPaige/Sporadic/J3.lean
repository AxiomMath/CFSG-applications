def tg0n : ℕ := 

def tg0 (i : ℕ) : ℕ := tget 14 tg0n i

/-- The inverse of generator 0. -/
def tgi0n : ℕ := 

def tgi0 (i : ℕ) : ℕ := tget 14 tgi0n i

/-- Generator 1. -/
def tg1n : ℕ := 

def tg1 (i : ℕ) : ℕ := tget 14 tg1n i

/-- The inverse of generator 1. -/
def tgi1n : ℕ := 

def tgi1 (i : ℕ) : ℕ := tget 14 tgi1n i

/-- The generator tables. -/
def gf (i : ℕ) (b : Bool) (x : ℕ) : ℕ :=
  (cond b (cond (Nat.beq i 0) tg0 (tg1)) (cond (Nat.beq i 0) tgi0 (tgi1))) x

