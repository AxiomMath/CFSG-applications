import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.Algebra.BigOperators.Fin
import TauCeti.GroupTheory.Presentation.GroupPresentation
import CFSGOutside.HallPaige.Statements

/-!
# Kernel-checked permutation certificates for `PermLabelling`

This file turns a finite certificate, checked by kernel evaluation of boolean functions
(`CFSGOutside.HallPaige.PermKit.CertOK`), into `CFSGOutside.HallPaige.PermLabelling G` for a group `G` given by a
presentation (`CFSGOutside.HallPaige.PermKit.permLabelling_of_certOK`).

The data are permutation tables of degree `n` (each packed into one natural number, so that a
lookup is one shift and one reduction of GMP numbers in the kernel) for the generators of the
presentation, and further permutations, each given with a word in the earlier ones which it is
checked to equal pointwise. The checker verifies:

* the generator tables are permutations satisfying every relator, which gives a homomorphism
  `ρ : P.Group →* Equiv.Perm (Fin n)` (`PresentedGroup.toGroup`);
* `ρ` is transitive (a Schreier forest over the generators);
* a stabilizer chain of the point stabilizer `S` of `x₀` in `ρ.range`: subgroups
  `K₁ ≥ K₂ ≥ ⋯` generated by program elements, with orbit lower bounds whose product times `n`
  is at least a given upper bound `N` for `Nat.card P.Group`, so that `K₁ = S`;
* a labelling of `Fin n` invariant under the generators of `K₁`, whose classes are `K₁`-orbits
  (a Schreier forest with one root per label);
* for each label a word `g` with `g • x₀` and `g² • x₀` both of that label;
* two distinct commuting involutions in `S`, which make the stabilizer good.

No general group theory beyond orbit–stabilizer and Sylow's theorem is used: all the
group-specific content is in the certificate.
-/

namespace CFSGOutside.HallPaige.PermKit

open Equiv

/-! ### Packed tables

A table is a natural number whose entry `i` occupies bits `d * i, …, d * i + d - 1`. Lookups
are a shift and a reduction, both evaluated by the kernel with GMP arithmetic. -/

/-- Entry `i` of a table packed in fields of `d` bits. -/
def get (d P i : ℕ) : ℕ := Nat.mod (Nat.shiftRight P (Nat.mul d i)) (Nat.pow 2 d)

/-! ### Loops -/

theorem nbeq_iff {a b : ℕ} : Nat.beq a b = true ↔ a = b :=
  ⟨Nat.eq_of_beq_eq_true, fun h => h ▸ Nat.beq_refl a⟩

theorem nbeq_false_iff {a b : ℕ} : Nat.beq a b = false ↔ a ≠ b := by
  constructor
  · exact Nat.ne_of_beq_eq_false
  · intro h
    cases e : Nat.beq a b
    · rfl
    · exact absurd (Nat.eq_of_beq_eq_true e) h

/-- `allLt p n` checks `p i` for all `i < n`. -/
def allLt (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | k + 1 => p k && allLt p k

theorem allLt_iff {p : ℕ → Bool} {n : ℕ} : allLt p n = true ↔ ∀ i < n, p i = true := by
  induction n with
  | zero => simp [allLt]
  | succ k ih =>
    simp only [allLt, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h1, h2⟩ i hi
      rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
      · exact h2 i hi
      · exact h1
    · intro h
      exact ⟨h k (Nat.lt_succ_self k), fun i hi => h i (Nat.lt_succ_of_lt hi)⟩

/-- The number of `i < n` with `p i`. -/
def countLt (p : ℕ → Bool) : ℕ → ℕ
  | 0 => 0
  | k + 1 => Nat.add (if p k then 1 else 0) (countLt p k)

theorem countLt_eq (p : ℕ → Bool) (n : ℕ) :
    countLt p n = (Finset.univ.filter fun x : Fin n => p x = true).card := by
  have h1 : countLt p n = ∑ i ∈ Finset.range n, if p i = true then 1 else 0 := by
    induction n with
    | zero => simp [countLt]
    | succ k ih =>
      show (if p k = true then 1 else 0) + countLt p k = _
      rw [ih, Finset.sum_range_succ, add_comm]
  rw [h1, Finset.card_filter, ← Fin.sum_univ_eq_sum_range (fun i => if p i = true then 1 else 0)]

/-! ### Permutations from tables -/

/-- `f` and `b` are mutually inverse tables of a permutation of `Fin n`. -/
def invOK (n d f b : ℕ) : Bool :=
  allLt (fun i => Nat.blt (get d f i) n && Nat.beq (get d b (get d f i)) i &&
    Nat.blt (get d b i) n && Nat.beq (get d f (get d b i)) i) n

theorem invOK_spec {n d f b : ℕ} (h : invOK n d f b = true) {i : ℕ} (hi : i < n) :
    get d f i < n ∧ get d b (get d f i) = i ∧ get d b i < n ∧ get d f (get d b i) = i := by
  have := allLt_iff.1 h i hi
  simp only [Bool.and_eq_true, Nat.blt_eq, nbeq_iff] at this
  exact ⟨this.1.1.1, this.1.1.2, this.1.2, this.2⟩

/-- The permutation of `Fin n` with forward table `f` and inverse table `b` (or `1`). -/
def tabPerm (n d f b : ℕ) : Perm (Fin n) :=
  if h : invOK n d f b = true then
    { toFun := fun i => ⟨get d f i, (invOK_spec h i.2).1⟩
      invFun := fun i => ⟨get d b i, (invOK_spec h i.2).2.2.1⟩
      left_inv := fun i => Fin.ext (invOK_spec h i.2).2.1
      right_inv := fun i => Fin.ext (invOK_spec h i.2).2.2.2 }
  else 1

/-- The table `P` represents `σ`. -/
def Rep {n : ℕ} (d P : ℕ) (σ : Perm (Fin n)) : Prop := ∀ x : Fin n, get d P x = σ x

theorem Rep.unique {n d P : ℕ} {σ τ : Perm (Fin n)} (h1 : Rep d P σ) (h2 : Rep d P τ) :
    σ = τ :=
  Equiv.ext fun x => Fin.ext ((h1 x).symm.trans (h2 x))

theorem rep_tabPerm {n d f b : ℕ} (h : invOK n d f b = true) :
    Rep d f (tabPerm n d f b) ∧ Rep d b (tabPerm n d f b)⁻¹ := by
  refine ⟨fun x => ?_, fun x => ?_⟩
  · simp [tabPerm, h]
  · simp only [tabPerm, h, dite_true]
    rfl

/-- The permutation of a pair of tables. -/
def tp (n d : ℕ) (t : ℕ × ℕ) : Perm (Fin n) := tabPerm n d t.1 t.2

/-! ### Signed references and words

A *code* `c` denotes element `c / 2` of a list, inverted when `c` is odd. -/

/-- The table with code `c`, if any. -/
def tabOf (tabs : List (ℕ × ℕ)) (c : ℕ) : Option ℕ :=
  (tabs[c / 2]?).map fun t => if c % 2 = 0 then t.1 else t.2

/-- Apply an optional table (identity for `none`). -/
def apOpt (d : ℕ) : Option ℕ → ℕ → ℕ
  | some P, x => get d P x
  | none, x => x

/-- Apply the table with code `c` to the point `x`. -/
def lk (tabs : List (ℕ × ℕ)) (d c x : ℕ) : ℕ := apOpt d (tabOf tabs c) x

/-- Apply a word of codes to a point; the last letter is applied first. -/
def evalPt (tabs : List (ℕ × ℕ)) (d : ℕ) (w : List ℕ) (x : ℕ) : ℕ :=
  (w.map (tabOf tabs)).foldr (apOpt d) x

/-- The permutation with code `c`. -/
def pk {n : ℕ} (σs : List (Perm (Fin n))) (c : ℕ) : Perm (Fin n) :=
  match σs[c / 2]? with
  | some σ => if c % 2 = 0 then σ else σ⁻¹
  | none => 1

/-- The product of the permutations of a word of codes. -/
def wordPerm {n : ℕ} (σs : List (Perm (Fin n))) (w : List ℕ) : Perm (Fin n) :=
  (w.map (pk σs)).prod

section Words

variable {n d : ℕ} {tabs : List (ℕ × ℕ)}

theorem lk_eq (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true) (c : ℕ) (x : Fin n) :
    lk tabs d c x = pk (tabs.map (tp n d)) c x := by
  unfold lk tabOf pk
  rw [List.getElem?_map]
  cases ht : tabs[c / 2]? with
  | none => rfl
  | some t =>
    have hmem : t ∈ tabs := List.mem_of_getElem? ht
    have hr := rep_tabPerm (hall t hmem)
    simp only [Option.map_some]
    split_ifs
    · exact hr.1 x
    · exact hr.2 x

theorem evalPt_cons (c : ℕ) (w : List ℕ) (x : ℕ) :
    evalPt tabs d (c :: w) x = lk tabs d c (evalPt tabs d w x) := rfl

theorem evalPt_eq (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true) (w : List ℕ) (x : Fin n) :
    evalPt tabs d w x = wordPerm (tabs.map (tp n d)) w x := by
  induction w with
  | nil => rfl
  | cons c w ih =>
    rw [evalPt_cons, ih, lk_eq hall]
    simp [wordPerm, Perm.mul_apply]

theorem pk_mem {σs : List (Perm (Fin n))} {R : Subgroup (Perm (Fin n))} (h : ∀ σ ∈ σs, σ ∈ R)
    (c : ℕ) : pk σs c ∈ R := by
  unfold pk
  cases hσ : σs[c / 2]? with
  | none => exact R.one_mem
  | some σ =>
    have := h σ (List.mem_of_getElem? hσ)
    split_ifs
    · exact this
    · exact R.inv_mem this

theorem wordPerm_mem {σs : List (Perm (Fin n))} {R : Subgroup (Perm (Fin n))}
    (h : ∀ σ ∈ σs, σ ∈ R) (w : List ℕ) : wordPerm σs w ∈ R := by
  unfold wordPerm
  induction w with
  | nil => exact R.one_mem
  | cons c w ih =>
    rw [List.map_cons, List.prod_cons]
    exact R.mul_mem (pk_mem h c) ih

end Words

/-! ### Straight-line programs -/

theorem pk_mem_of_lt {n : ℕ} {σs : List (Perm (Fin n))} {R : Subgroup (Perm (Fin n))} {K : ℕ}
    (h : ∀ j < K, ∀ σ, σs[j]? = some σ → σ ∈ R) {c : ℕ} (hc : c / 2 < K) : pk σs c ∈ R := by
  unfold pk
  cases hσ : σs[c / 2]? with
  | none => exact R.one_mem
  | some σ =>
    have := h _ hc σ hσ
    split_ifs
    · exact this
    · exact R.inv_mem this

theorem wordPerm_mem_of_lt {n : ℕ} {σs : List (Perm (Fin n))} {R : Subgroup (Perm (Fin n))}
    {K : ℕ} (h : ∀ j < K, ∀ σ, σs[j]? = some σ → σ ∈ R) (w : List ℕ) (hw : ∀ c ∈ w, c / 2 < K) :
    wordPerm σs w ∈ R := by
  unfold wordPerm
  induction w with
  | nil => exact R.one_mem
  | cons c w ih =>
    rw [List.map_cons, List.prod_cons]
    exact R.mul_mem (pk_mem_of_lt h (hw c (List.mem_cons_self ..)))
      (ih fun c hc => hw c (List.mem_cons_of_mem _ hc))

/-! ### Schreier forests -/

/-- A Schreier forest: `dep x = 0` for points outside, `1` for roots; a non-root `x` is the image
of its parent `par x` under generator number `via x`; `cls x` is the index of its root. -/
structure Forest where
  dep : ℕ
  par : ℕ
  via : ℕ
  cls : ℕ

/-- The forest condition at every point, for generators `gs` (element indices) and roots
`reps`. -/
def forestOK (tabs : List (ℕ × ℕ)) (n d : ℕ) (gs reps : List ℕ) (F : Forest) : Bool :=
  allLt (fun x =>
    Nat.beq (get d F.dep x) 0 ||
      (Nat.blt (get d F.cls x) reps.length &&
        (if Nat.beq (get d F.dep x) 1 then Nat.beq (reps.getD (get d F.cls x) 0) x else
          Nat.blt (get d F.par x) n && !Nat.beq (get d F.dep (get d F.par x)) 0 &&
            Nat.blt (get d F.dep (get d F.par x)) (get d F.dep x) &&
            Nat.beq (get d F.cls (get d F.par x)) (get d F.cls x) &&
            Nat.blt (get d F.via x) gs.length &&
            Nat.beq (lk tabs d (2 * gs.getD (get d F.via x) 0) (get d F.par x)) x))) n

/-- The subgroup generated by the elements with indices in `gs`. -/
def Kset {n : ℕ} (σs : List (Perm (Fin n))) (gs : List ℕ) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {σ | ∃ g ∈ gs, σ = pk σs (2 * g)}

theorem forest_reach {tabs : List (ℕ × ℕ)} {n d : ℕ} {gs reps : List ℕ} {F : Forest}
    (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true) (h : forestOK tabs n d gs reps F = true) :
    ∀ x : Fin n, get d F.dep x ≠ 0 → ∃ r : Fin n, (r : ℕ) = reps.getD (get d F.cls x) 0 ∧
      ∃ σ ∈ Kset (tabs.map (tp n d)) gs, σ r = x := by
  have hF := allLt_iff.1 h
  suffices H : ∀ e, ∀ x : Fin n, get d F.dep x = e → e ≠ 0 →
      ∃ r : Fin n, (r : ℕ) = reps.getD (get d F.cls x) 0 ∧
        ∃ σ ∈ Kset (tabs.map (tp n d)) gs, σ r = x from fun x hx => H _ x rfl hx
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
    intro x hxe he
    have hx := hF x x.2
    rw [Bool.or_eq_true] at hx
    rcases hx with h0 | hx
    · exact absurd (hxe ▸ (nbeq_iff.1 h0)) he
    rw [Bool.and_eq_true] at hx
    obtain ⟨-, hx⟩ := hx
    rw [hxe] at hx
    by_cases he1 : e = 1
    · rw [if_pos (by simp [he1])] at hx
      exact ⟨x, (nbeq_iff.1 hx).symm, 1, Subgroup.one_mem _, rfl⟩
    · rw [if_neg (by simpa [nbeq_iff] using he1)] at hx
      simp only [Bool.and_eq_true, Nat.blt_eq, nbeq_iff, Bool.not_eq_true',
        nbeq_false_iff, ne_eq] at hx
      obtain ⟨⟨⟨⟨⟨hp, hp0⟩, hpe⟩, hcls⟩, hv⟩, himg⟩ := hx
      set p : Fin n := ⟨get d F.par x, hp⟩ with hpdef
      obtain ⟨r, hr, σ, hσ, hσr⟩ := ih (get d F.dep p) hpe p rfl hp0
      refine ⟨r, ?_, pk (tabs.map (tp n d)) (2 * gs.getD (get d F.via x) 0) * σ,
        Subgroup.mul_mem _ (Subgroup.subset_closure ⟨_, by
          simp only [List.getD, List.getElem?_eq_getElem hv, Option.getD_some]
          exact List.getElem_mem hv, rfl⟩) hσ, ?_⟩
      · rw [hr]
        change reps.getD (get d F.cls (get d F.par x)) 0 = _
        rw [hcls]
      · apply Fin.ext
        rw [Perm.mul_apply, hσr, ← lk_eq hall]
        exact himg

/-! ### Stabilizer chains -/

/-- One level of a stabilizer chain: generators, base point, orbit forest, orbit bound. -/
structure Level where
  gs : List ℕ
  beta : ℕ
  F : Forest
  m : ℕ

instance : Inhabited Level := ⟨⟨[], 0, ⟨0, 0, 0, 0⟩, 0⟩⟩

/-- The orbit of `beta` under `gs` has at least `m` points. -/
def levelOK (tabs : List (ℕ × ℕ)) (n d : ℕ) (L : Level) : Bool :=
  Nat.blt L.beta n && forestOK tabs n d L.gs [L.beta] L.F &&
    Nat.ble L.m (countLt (fun x => !Nat.beq (get d L.F.dep x) 0) n)

/-- A chain of levels, each generated by elements of the previous one fixing its base point. -/
def chainOK (tabs : List (ℕ × ℕ)) (n d : ℕ) : List Level → Bool
  | [] => true
  | [L] => levelOK tabs n d L
  | L :: L' :: rest => levelOK tabs n d L &&
      L'.gs.all (fun g => L.gs.contains g && Nat.beq (lk tabs d (2 * g) L.beta) L.beta) &&
      chainOK tabs n d (L' :: rest)

/-- The product of the orbit bounds. -/
def chainProd : List Level → ℕ
  | [] => 1
  | L :: rest => L.m * chainProd rest

theorem card_le_of_orbit {n : ℕ} (K K' : Subgroup (Perm (Fin n))) (β : Fin n) (m : ℕ)
    (hK : K' ≤ K) (hfix : ∀ σ ∈ K', σ β = β) (s : Finset (Fin n)) (hs : m ≤ s.card)
    (horb : ∀ x ∈ s, ∃ σ ∈ K, σ β = x) : m * Nat.card K' ≤ Nat.card K := by
  have h1 := Subgroup.card_mul_index (MulAction.stabilizer K β)
  rw [MulAction.index_stabilizer] at h1
  have h2 : m ≤ (MulAction.orbit K β).ncard := by
    refine hs.trans ?_
    rw [← Set.ncard_coe_finset]
    apply Set.ncard_le_ncard _ (Set.toFinite _)
    intro x hx
    obtain ⟨σ, hσ, rfl⟩ := horb x hx
    exact ⟨⟨σ, hσ⟩, rfl⟩
  have h3 : Nat.card K' ≤ Nat.card (MulAction.stabilizer K β) := by
    have hle : K'.subgroupOf K ≤ MulAction.stabilizer K β := by
      intro g hg
      rw [MulAction.mem_stabilizer_iff, Subgroup.smul_def, Perm.smul_def]
      exact hfix _ hg
    calc Nat.card K' = Nat.card (K'.subgroupOf K) :=
          (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hK).toEquiv).symm
      _ ≤ _ := Subgroup.card_le_of_le hle
  rw [← h1, mul_comm (Nat.card _)]
  exact Nat.mul_le_mul h2 h3

theorem kset_mono {n : ℕ} (σs : List (Perm (Fin n))) {gs gs' : List ℕ} (h : ∀ g ∈ gs', g ∈ gs) :
    Kset σs gs' ≤ Kset σs gs := by
  apply Subgroup.closure_mono
  rintro _ ⟨g, hg, rfl⟩
  exact ⟨g, h g hg, rfl⟩

theorem kset_fix {n : ℕ} (σs : List (Perm (Fin n))) {gs : List ℕ} {β : Fin n}
    (h : ∀ g ∈ gs, pk σs (2 * g) β = β) : ∀ σ ∈ Kset σs gs, σ β = β := by
  have : Kset σs gs ≤ MulAction.stabilizer (Perm (Fin n)) β := by
    rw [Kset, Subgroup.closure_le]
    rintro _ ⟨g, hg, rfl⟩
    exact h g hg
  exact fun σ hσ => this hσ

theorem forest_reach_one {tabs : List (ℕ × ℕ)} {n d : ℕ} {gs : List ℕ} {b : ℕ} {F : Forest}
    (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true) (h : forestOK tabs n d gs [b] F = true)
    (hb : b < n) (x : Fin n) (hx : get d F.dep x ≠ 0) :
    ∃ σ ∈ Kset (tabs.map (tp n d)) gs, σ ⟨b, hb⟩ = x := by
  obtain ⟨r, hr, σ, hσ, hσr⟩ := forest_reach hall h x hx
  have hcls : get d F.cls x < 1 := by
    have := allLt_iff.1 h x x.2
    simp only [Bool.or_eq_true, nbeq_iff, hx, false_or, Bool.and_eq_true,
      Nat.blt_eq, List.length_singleton] at this
    exact this.1
  have : r = ⟨b, hb⟩ := by
    apply Fin.ext
    rw [hr, Nat.lt_one_iff.1 hcls]
    rfl
  exact ⟨σ, hσ, this ▸ hσr⟩

theorem orbit_finset {tabs : List (ℕ × ℕ)} {n d : ℕ} (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true)
    {L : Level} (h : levelOK tabs n d L = true) :
    ∃ β : Fin n, (β : ℕ) = L.beta ∧ ∃ s : Finset (Fin n), L.m ≤ s.card ∧
      ∀ x ∈ s, ∃ σ ∈ Kset (tabs.map (tp n d)) L.gs, σ β = x := by
  simp only [levelOK, Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq] at h
  obtain ⟨⟨hb, hF⟩, hm⟩ := h
  refine ⟨⟨L.beta, hb⟩, rfl,
    Finset.univ.filter fun x : Fin n => (!Nat.beq (get d L.F.dep x) 0) = true,
    by rwa [countLt_eq] at hm, ?_⟩
  intro x hx
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Bool.not_eq_true',
    nbeq_false_iff] at hx
  exact forest_reach_one hall hF hb x hx

theorem chain_card {tabs : List (ℕ × ℕ)} {n d : ℕ}
    (hall : ∀ t ∈ tabs, invOK n d t.1 t.2 = true) :
    ∀ (L : Level) (rest : List Level), chainOK tabs n d (L :: rest) = true →
      chainProd (L :: rest) ≤ Nat.card (Kset (tabs.map (tp n d)) L.gs) := by
  intro L rest
  induction rest generalizing L with
  | nil =>
    intro h
    obtain ⟨β, -, s, hs, horb⟩ := orbit_finset hall h
    have := card_le_of_orbit _ ⊥ β L.m bot_le (fun σ hσ => by
      rw [Subgroup.mem_bot.1 hσ]; rfl) s hs horb
    simpa [chainProd] using this
  | cons L' rest ih =>
    intro h
    simp only [chainOK, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem,
      nbeq_iff] at h
    obtain ⟨⟨hL, hgs⟩, hrest⟩ := h
    obtain ⟨β, hβ, s, hs, horb⟩ := orbit_finset hall hL
    have hfix : ∀ σ ∈ Kset (tabs.map (tp n d)) L'.gs, σ β = β := by
      apply kset_fix
      intro g hg
      apply Fin.ext
      rw [← lk_eq hall, hβ]
      exact (hgs g hg).2
    have := card_le_of_orbit _ _ β L.m (kset_mono _ fun g hg => (hgs g hg).1) hfix s hs horb
    calc chainProd (L :: L' :: rest) = L.m * chainProd (L' :: rest) := rfl
      _ ≤ L.m * Nat.card (Kset (tabs.map (tp n d)) L'.gs) := Nat.mul_le_mul_left _ (ih L' hrest)
      _ ≤ _ := this

/-! ### Certificates -/

/-- A complete certificate. -/
structure Cert where
  /-- The degree. -/
  n : ℕ
  /-- The table width, with `n ≤ 2 ^ d`. -/
  d : ℕ
  /-- Forward and inverse tables of the presentation generators. -/
  gens : List (ℕ × ℕ)
  /-- Further elements: a word in the earlier elements, and forward and inverse tables. -/
  elems : List (List ℕ × ℕ × ℕ)
  /-- The base point. -/
  x0 : ℕ
  /-- A Schreier tree of the whole action, over the generators. -/
  trans : Forest
  /-- A stabilizer chain of the stabilizer of `x0`. -/
  levels : List Level
  /-- The labelling forest, over the generators of the first level. -/
  lab : Forest
  /-- One root per label. -/
  labReps : List ℕ
  /-- One word per label. -/
  wit : List (List ℕ)
  /-- Two commuting involutions in the stabilizer (element indices). -/
  iu : ℕ
  iz : ℕ

namespace Cert

/-- All the tables of a certificate. -/
def tabs (c : Cert) : List (ℕ × ℕ) := c.gens ++ c.elems.map (·.2)

/-- The generators of the first level of the chain. -/
def gs1 (c : Cert) : List ℕ := (c.levels.headD default).gs

/-- The label of a point. -/
def cls (c : Cert) (x : ℕ) : ℕ := get c.d c.lab.cls x

/-- Numerical side conditions. -/
def basicOK (c : Cert) (m N : ℕ) : Bool :=
  Nat.ble 2 c.n && Nat.ble c.n (2 ^ c.d) && Nat.blt c.x0 c.n && Nat.beq c.gens.length m &&
    !c.levels.isEmpty && Nat.ble N (c.n * chainProd c.levels) &&
    Nat.beq c.wit.length c.labReps.length

/-- Element `k`: its word only uses earlier elements, its tables are inverse permutations, and
its forward table is the value of its word. -/
def elemOK (c : Cert) (k : ℕ) : Bool :=
  (c.elems.getD k ([], 0, 0)).1.all (fun x => Nat.blt (x / 2) (c.gens.length + k)) &&
    invOK c.n c.d (c.elems.getD k ([], 0, 0)).2.1 (c.elems.getD k ([], 0, 0)).2.2 &&
    allLt (fun x => Nat.beq (get c.d (c.elems.getD k ([], 0, 0)).2.1 x)
      (evalPt c.tabs c.d (c.elems.getD k ([], 0, 0)).1 x)) c.n

/-- A relator word (in codes) evaluates to the identity. -/
def relOK (c : Cert) (w : List ℕ) : Bool :=
  allLt (fun x => Nat.beq (evalPt c.tabs c.d w x) x) c.n

/-- Transitivity. -/
def transOK (c : Cert) (m : ℕ) : Bool :=
  forestOK c.tabs c.n c.d (List.range m) [c.x0] c.trans &&
    allLt (fun x => !Nat.beq (get c.d c.trans.dep x) 0) c.n

/-- The chain, with first-level generators fixing `x0`. -/
def chainCheck (c : Cert) : Bool :=
  c.gs1.all (fun g => Nat.beq (lk c.tabs c.d (2 * g) c.x0) c.x0) && chainOK c.tabs c.n c.d c.levels

/-- The labelling forest covers every point. -/
def labOK (c : Cert) : Bool :=
  forestOK c.tabs c.n c.d c.gs1 c.labReps c.lab &&
    allLt (fun x => !Nat.beq (get c.d c.lab.dep x) 0) c.n

/-- The labelling is invariant under the element `g`. -/
def invG (c : Cert) (g : ℕ) : Bool :=
  allLt (fun x => Nat.beq (c.cls (lk c.tabs c.d (2 * g) x)) (c.cls x)) c.n

/-- The witness of label `k`. -/
def witOK (c : Cert) (k : ℕ) : Bool :=
  Nat.beq (c.cls (evalPt c.tabs c.d (c.wit.getD k []) c.x0)) k &&
    Nat.beq (c.cls (evalPt c.tabs c.d (c.wit.getD k []) (evalPt c.tabs c.d (c.wit.getD k []) c.x0))) k

/-- Two distinct commuting involutions fixing `x0`. -/
def kleinOK (c : Cert) : Bool :=
  let U := lk c.tabs c.d (2 * c.iu)
  let Z := lk c.tabs c.d (2 * c.iz)
  Nat.beq (U c.x0) c.x0 && Nat.beq (Z c.x0) c.x0 &&
  allLt (fun x => Nat.beq (U (U x)) x) c.n && allLt (fun x => Nat.beq (Z (Z x)) x) c.n &&
  allLt (fun x => Nat.beq (U (Z x)) (Z (U x))) c.n &&
  !allLt (fun x => Nat.beq (U x) x) c.n && !allLt (fun x => Nat.beq (Z x) x) c.n &&
  !allLt (fun x => Nat.beq (U x) (Z x)) c.n

end Cert

/-- The code of a letter of a presentation word. -/
def code {m : ℕ} (l : Fin m × Bool) : ℕ := if l.2 then 2 * l.1.val else 2 * l.1.val + 1

/-- The facts checked about a certificate, for relators `rels` over `m` generators and an upper
bound `N` for the order of the presented group. Each field is a kernel computation. -/
structure CertOK (c : Cert) (m : ℕ) (rels : List (List (Fin m × Bool))) (N : ℕ) : Prop where
  basic : c.basicOK m N = true
  gens : ∀ t ∈ c.gens, invOK c.n c.d t.1 t.2 = true
  elems : ∀ k < c.elems.length, c.elemOK k = true
  rels : ∀ i < rels.length, c.relOK ((rels.getD i []).map code) = true
  trans : c.transOK m = true
  chain : c.chainCheck = true
  lab : c.labOK = true
  inv : ∀ j < c.gs1.length, c.invG (c.gs1.getD j 0) = true
  wit : ∀ k < c.labReps.length, c.witOK k = true
  klein : c.kleinOK = true

/-! ### Group theory -/

theorem zpow_of_mul_self {T : Type*} [Group T] {g : T} (hg : g * g = 1) (k : ℤ) :
    g ^ k = 1 ∨ g ^ k = g := by
  have hinv : g⁻¹ = g := inv_eq_of_mul_eq_one_right hg
  induction k using Int.induction_on with
  | zero => left; simp
  | succ k ih =>
    rw [zpow_add_one]
    rcases ih with h | h <;> rw [h]
    · right; simp
    · left; exact hg
  | pred k ih =>
    rw [zpow_sub_one, hinv]
    rcases ih with h | h <;> rw [h]
    · right; simp
    · left; exact hg

/-- A finite group with two distinct commuting involutions has no cyclic Sylow 2-subgroup. -/
theorem not_isCyclic_sylow {T : Type*} [Group T] [Finite T] {u z : T} (hu : u * u = 1)
    (hz : z * z = 1) (huz : u * z = z * u) (hu1 : u ≠ 1) (hz1 : z ≠ 1) (hne : u ≠ z)
    (Q : Sylow 2 T) : ¬ IsCyclic Q := by
  intro hQ
  set V := Subgroup.closure ({u, z} : Set T)
  have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
  have hz' : z⁻¹ = z := inv_eq_of_mul_eq_one_right hz
  have hu2 : ∀ x, u * (u * x) = x := fun x => by rw [← mul_assoc, hu, one_mul]
  have hz2 : ∀ x, z * (z * x) = x := fun x => by rw [← mul_assoc, hz, one_mul]
  have hzu : z * u = u * z := huz.symm
  have hzu' : ∀ x, z * (u * x) = u * (z * x) := fun x => by rw [← mul_assoc, hzu, mul_assoc]
  have hmem : ∀ x ∈ V, x = 1 ∨ x = u ∨ x = z ∨ x = u * z := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with rfl | rfl
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr (Or.inl rfl))
    | one => exact Or.inl rfl
    | mul x y _ _ hx hy =>
      rcases hx with rfl | rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl | rfl <;>
        simp [mul_assoc, hu, hz, hu2, hz2, hzu, hzu']
    | inv x _ hx =>
      rcases hx with rfl | rfl | rfl | rfl <;>
        simp [mul_inv_rev, hu', hz', hzu]
  have hsq : ∀ x ∈ V, x * x = 1 := by
    intro x hx
    rcases hmem x hx with rfl | rfl | rfl | rfl <;>
      simp [mul_assoc, hu, hz, hu2, hz2, hzu, hzu']
  have hV : IsPGroup 2 V := by
    intro x
    refine ⟨1, ?_⟩
    apply Subtype.ext
    simp [pow_two, hsq x.1 x.2]
  obtain ⟨Q', hQ'⟩ := hV.exists_le_sylow
  have hQ'c : IsCyclic Q' := isCyclic_of_surjective (Sylow.equiv Q Q').toMonoidHom
    (Sylow.equiv Q Q').surjective
  have hVc : IsCyclic V := Subgroup.isCyclic_of_le hQ'
  obtain ⟨g, hg⟩ := hVc.exists_generator
  have hg2 : g * g = 1 := Subtype.ext (hsq g.1 g.2)
  have key : ∀ x : V, x = 1 ∨ x = g := by
    intro x
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hg x)
    rw [← hk]
    exact zpow_of_mul_self hg2 k
  have huV : u ∈ V := Subgroup.subset_closure (Set.mem_insert _ _)
  have hzV : z ∈ V := Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  rcases key ⟨u, huV⟩ with h1 | h1
  · exact hu1 (congrArg Subtype.val h1)
  rcases key ⟨z, hzV⟩ with h2 | h2
  · exact hz1 (congrArg Subtype.val h2)
  exact hne (congrArg Subtype.val (h1.trans h2.symm))

theorem map_isCyclic {A B : Type*} [Group A] [Group B] (F : A →* B) (K : Subgroup A)
    [IsCyclic K] : IsCyclic (K.map F) := by
  have e : K.map F = (F.comp K.subtype).range := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  rw [e]
  exact isCyclic_of_surjective _ (MonoidHom.rangeRestrict_surjective _)

/-- If the image of a subgroup `H` contains two distinct commuting involutions, `H` is good. -/
theorem isGood_of_involutions {G T : Type*} [Group G] [Finite G] [Group T] (H : Subgroup G)
    (f : G →* T) {u z : T} (hu0 : u ∈ H.map f) (hz0 : z ∈ H.map f) (hu : u * u = 1)
    (hz : z * z = 1) (huz : u * z = z * u) (hu1 : u ≠ 1) (hz1 : z ≠ 1) (hne : u ≠ z) :
    IsGood H := by
  intro P
  right
  intro hP
  set φ : H →* T := f.comp H.subtype
  have hrange : φ.range = H.map f := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hsurj : Function.Surjective φ.rangeRestrict := φ.rangeRestrict_surjective
  set Q := P.mapSurjective hsurj
  have hQc : IsCyclic Q := by
    have hQ : (Q : Subgroup φ.range) = (P : Subgroup H).map φ.rangeRestrict :=
      Sylow.coe_mapSurjective hsurj P
    have : IsCyclic ((P : Subgroup H).map φ.rangeRestrict) := map_isCyclic _ _
    rw [hQ]
    exact this
  haveI : Finite φ.range := Finite.of_surjective _ hsurj
  have hu' : u ∈ φ.range := hrange ▸ hu0
  have hz' : z ∈ φ.range := hrange ▸ hz0
  refine not_isCyclic_sylow (u := ⟨u, hu'⟩) (z := ⟨z, hz'⟩) (Subtype.ext hu) (Subtype.ext hz)
    (Subtype.ext huz) (fun h => hu1 (congrArg Subtype.val h))
    (fun h => hz1 (congrArg Subtype.val h)) (fun h => hne (congrArg Subtype.val h)) Q hQc

/-! ### Soundness -/

section Sound

variable {P : TauCeti.GroupPresentation}

/-- The images of the generators. -/
def genPerm (c : Cert) (m : ℕ) : Fin m → Perm (Fin c.n) :=
  fun i => pk (c.tabs.map (tp c.n c.d)) (2 * i)

theorem pk_code {n : ℕ} (σs : List (Perm (Fin n))) {m : ℕ} (l : Fin m × Bool) :
    (bif l.2 then pk σs (2 * l.1) else (pk σs (2 * l.1))⁻¹) = pk σs (code l) := by
  obtain ⟨i, b⟩ := l
  cases b
  · simp only [cond_false, code, Bool.false_eq_true, if_false, pk]
    have h1 : (2 * (i : ℕ) + 1) / 2 = i := by omega
    have h2 : (2 * (i : ℕ)) / 2 = i := by omega
    have h3 : (2 * (i : ℕ) + 1) % 2 = 1 := by omega
    have h4 : (2 * (i : ℕ)) % 2 = 0 := by omega
    rw [h1, h2]
    cases σs[(i : ℕ)]? with
    | none => simp
    | some σ => simp [h3, h4]
  · simp [code]

theorem kset_le {n : ℕ} {σs : List (Perm (Fin n))} {R : Subgroup (Perm (Fin n))}
    (h : ∀ σ ∈ σs, σ ∈ R) (gs : List ℕ) : Kset σs gs ≤ R := by
  rw [Kset, Subgroup.closure_le]
  rintro _ ⟨g, -, rfl⟩
  exact pk_mem h _

theorem tabs_getElem?_gens {c : Cert} {j : ℕ} (hj : j < c.gens.length) :
    c.tabs[j]? = c.gens[j]? := by
  unfold Cert.tabs
  rw [List.getElem?_append_left hj]

theorem tabs_getElem?_elems {c : Cert} (k : ℕ) :
    c.tabs[c.gens.length + k]? = (c.elems[k]?).map (·.2) := by
  unfold Cert.tabs
  rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left, List.getElem?_map]

theorem allLt_true_of {p : ℕ → Bool} {n : ℕ} (h : allLt p n = true) {i : ℕ} (hi : i < n) :
    p i = true := allLt_iff.1 h i hi

/-- **Soundness of the certificate checker.** -/
theorem permLabelling_of_certOK {P : TauCeti.GroupPresentation} [Finite P.Group] {N : ℕ}
    (hN : Nat.card P.Group ≤ N) (c : Cert) (hc : CertOK c P.generatorCount P.relators N) :
    PermLabelling P.Group := by
  have hb := hc.basic
  simp only [Cert.basicOK, Bool.and_eq_true, and_assoc, Nat.ble_eq, Nat.blt_eq, nbeq_iff,
    Bool.not_eq_true', List.isEmpty_eq_false_iff] at hb
  obtain ⟨h1, h2, h3, hm, h9, h12, h16⟩ := hb
  have hall : ∀ t ∈ c.tabs, invOK c.n c.d t.1 t.2 = true := by
    intro t ht
    rcases List.mem_append.1 ht with ht | ht
    · exact hc.gens t ht
    · obtain ⟨e, he, rfl⟩ := List.mem_map.1 ht
      obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.1 he
      have := hc.elems k hk
      simp only [Cert.elemOK, Bool.and_eq_true, List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem hk, Option.getD_some] at this
      exact this.1.2
  set σs := c.tabs.map (tp c.n c.d) with hσs
  -- the homomorphism
  have hrel : ∀ r ∈ P.relatorSet, FreeGroup.lift (genPerm c P.generatorCount) r = 1 := by
    intro r hr
    obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hr
    rw [FreeGroup.lift_mk]
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.1 hw
    have hw' := hc.rels i hi
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some] at hw'
    have e : (P.relators[i].map fun x => bif x.2 then genPerm c P.generatorCount x.1
        else (genPerm c P.generatorCount x.1)⁻¹) = (P.relators[i].map code).map (pk σs) := by
      rw [List.map_map]
      exact List.map_congr_left fun l _ => pk_code σs l
    rw [e]
    apply Equiv.ext
    intro x
    apply Fin.ext
    have := allLt_true_of hw' x.2
    rw [nbeq_iff, evalPt_eq hall] at this
    exact this
  set ρ : P.Group →* Perm (Fin c.n) := PresentedGroup.toGroup hrel with hρ
  set R := ρ.range
  have hmemR : ∀ j : ℕ, ∀ σ, σs[j]? = some σ → σ ∈ R := by
    intro j
    induction j using Nat.strong_induction_on with
    | _ j ih =>
      intro σ hσ
      rw [hσs, List.getElem?_map] at hσ
      by_cases hj : j < c.gens.length
      · rw [tabs_getElem?_gens hj] at hσ
        refine ⟨PresentedGroup.of ⟨j, hm ▸ hj⟩, ?_⟩
        rw [hρ, PresentedGroup.toGroup.of]
        change pk σs (2 * j) = _
        have h2j : 2 * j / 2 = j := by omega
        have h2j' : 2 * j % 2 = 0 := by omega
        simp only [pk, h2j, h2j', hσs, List.getElem?_map, tabs_getElem?_gens hj]
        rw [hσ]
        simp
      · obtain ⟨k, rfl⟩ : ∃ k, j = c.gens.length + k := ⟨j - c.gens.length, by omega⟩
        rw [tabs_getElem?_elems] at hσ
        cases hk : c.elems[k]? with
        | none => simp [hk] at hσ
        | some e =>
          simp only [hk, Option.map_some, Option.some.injEq] at hσ
          subst hσ
          have hkl : k < c.elems.length := (List.getElem?_eq_some_iff.1 hk).1
          have he := hc.elems k hkl
          simp only [Cert.elemOK, Bool.and_eq_true, List.getD_eq_getElem?_getD, hk,
            Option.getD_some, List.all_eq_true, Nat.blt_eq] at he
          obtain ⟨⟨hw, hinv⟩, hval⟩ := he
          have hrep : Rep c.d e.2.1 (wordPerm σs e.1) := by
            intro x
            have := allLt_true_of hval x.2
            rw [nbeq_iff, evalPt_eq hall] at this
            exact this
          have heq : tp c.n c.d e.2 = wordPerm σs e.1 := (rep_tabPerm hinv).1.unique hrep
          rw [heq]
          exact wordPerm_mem_of_lt (fun j' hj' σ' hσ' => ih j' hj' σ' hσ') e.1 hw
  have hσR : ∀ σ ∈ σs, σ ∈ R := by
    intro σ hσ
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hσ
    exact hmemR j _ (List.getElem?_eq_getElem hj)
  set x₀ : Fin c.n := ⟨c.x0, h3⟩
  -- transitivity
  have ht := hc.trans
  simp only [Cert.transOK, Bool.and_eq_true] at ht
  have htrans : ∀ y : Fin c.n, ∃ σ ∈ R, σ x₀ = y := by
    intro y
    obtain ⟨σ, hσ, hσy⟩ := forest_reach_one hall ht.1 h3 y
      (by simpa [nbeq_false_iff] using allLt_true_of ht.2 y.2)
    exact ⟨σ, kset_le hσR _ hσ, hσy⟩
  -- the chain
  obtain ⟨L, rest, hL⟩ : ∃ L rest, c.levels = L :: rest := by
    cases hl : c.levels with
    | nil => simp [hl] at h9
    | cons L rest => exact ⟨L, rest, rfl⟩
  have hch := hc.chain
  simp only [Cert.chainCheck, Bool.and_eq_true, List.all_eq_true, nbeq_iff] at hch
  obtain ⟨h10, h11⟩ := hch
  have hgs1 : c.gs1 = L.gs := by simp [Cert.gs1, hL]
  rw [hgs1] at h10
  rw [hL] at h11 h12
  set S := MulAction.stabilizer (Perm (Fin c.n)) x₀ ⊓ R
  set K := Kset σs L.gs
  have hKS : K ≤ S := by
    refine le_inf ((Subgroup.closure_le _).2 ?_) (kset_le hσR _)
    rintro _ ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff, Perm.smul_def]
    apply Fin.ext
    rw [← lk_eq hall]
    exact h10 g hg
  have hKcard : chainProd (L :: rest) ≤ Nat.card K := chain_card hall L rest h11
  have hRcard : Nat.card R = c.n * Nat.card S := by
    have e1 := Subgroup.card_mul_index (MulAction.stabilizer R x₀)
    rw [MulAction.index_stabilizer] at e1
    have horb : MulAction.orbit R x₀ = Set.univ := by
      ext y
      simp only [Set.mem_univ, iff_true]
      obtain ⟨σ, hσ, hσy⟩ := htrans y
      exact ⟨⟨σ, hσ⟩, hσy⟩
    rw [horb, Set.ncard_univ, Nat.card_eq_fintype_card (α := Fin c.n), Fintype.card_fin] at e1
    have e2 : MulAction.stabilizer R x₀ = S.subgroupOf R := by
      ext g
      simp only [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf, S, Subgroup.mem_inf,
        g.2, and_true]
      rfl
    rw [e2, Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_right).toEquiv] at e1
    rw [← e1, mul_comm]
  have hGR : Nat.card R ≤ Nat.card P.Group :=
    Nat.card_le_card_of_surjective _ ρ.rangeRestrict_surjective
  have hKeq : K = S := by
    apply Subgroup.eq_of_le_of_card_ge hKS
    have hn : 0 < c.n := by omega
    have : c.n * Nat.card S ≤ c.n * Nat.card K := by
      rw [← hRcard]
      exact (hGR.trans hN).trans (h12.trans (Nat.mul_le_mul_left _ hKcard))
    exact Nat.le_of_mul_le_mul_left this hn
  -- the labelling
  have hl := hc.lab
  simp only [Cert.labOK, Bool.and_eq_true] at hl
  obtain ⟨h13, h14⟩ := hl
  rw [hgs1] at h13
  have hlab : ∀ y : Fin c.n, get c.d c.lab.dep y ≠ 0 := fun y => by
    simpa [nbeq_false_iff] using allLt_true_of h14 y.2
  have hcls : ∀ y : Fin c.n, c.cls y < c.labReps.length := by
    intro y
    have := allLt_true_of h13 y.2
    simp only [Bool.or_eq_true, nbeq_iff, hlab y, false_or, Bool.and_eq_true,
      Nat.blt_eq] at this
    exact this.1
  have hr : 0 < c.labReps.length := lt_of_le_of_lt (Nat.zero_le _) (hcls x₀)
  have hinv : ∀ σ ∈ K, ∀ y, c.cls (σ y) = c.cls y := by
    intro σ hσ
    induction hσ using Subgroup.closure_induction with
    | mem σ hσ =>
      obtain ⟨g, hg, rfl⟩ := hσ
      intro y
      obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hg
      have hj' : j < c.gs1.length := hgs1 ▸ hj
      have := hc.inv j hj'
      rw [hgs1] at this
      simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj, Option.getD_some] at this
      have := allLt_true_of this y.2
      rw [nbeq_iff, lk_eq hall] at this
      exact this
    | one => intro y; rfl
    | mul σ τ _ _ hσ hτ => intro y; rw [Perm.mul_apply, hσ, hτ]
    | inv σ _ hσ =>
      intro y
      have := hσ (σ⁻¹ y)
      have e : σ (σ⁻¹ y) = y := by simp
      rw [e] at this
      exact this.symm
  refine ⟨c.n, ρ, x₀, c.labReps.length, fun y => ⟨c.cls y % c.labReps.length, Nat.mod_lt _ hr⟩,
    Equiv.refl _, ?_, ?_, fun k => rfl, ?_, ?_, ?_⟩
  · intro y
    obtain ⟨σ, hσ, hσy⟩ := htrans y
    obtain ⟨g, rfl⟩ := hσ
    exact ⟨g, hσy⟩
  · intro y y'
    simp only [Fin.mk.injEq, Nat.mod_eq_of_lt (hcls _)]
    constructor
    · intro hyy
      obtain ⟨r, hr1, σ, hσ, hσr⟩ := forest_reach hall h13 y (hlab y)
      obtain ⟨r', hr1', σ', hσ', hσr'⟩ := forest_reach hall h13 y' (hlab y')
      have hrr : r = r' := Fin.ext (by
        rw [hr1, hr1']; exact congrArg (fun k => c.labReps.getD k 0) hyy)
      have hτ : σ' * σ⁻¹ ∈ S := hKS (K.mul_mem hσ' (K.inv_mem hσ))
      obtain ⟨g, hg⟩ := (Subgroup.mem_inf.1 hτ).2
      refine ⟨g, ?_, ?_⟩
      · rw [hg]; exact (Subgroup.mem_inf.1 hτ).1
      · rw [hg, Perm.mul_apply, ← hσr, show σ⁻¹ (σ r) = r by simp, hrr, hσr']
    · rintro ⟨g, hg0, rfl⟩
      have hgS : ρ g ∈ K := hKeq ▸ Subgroup.mem_inf.2 ⟨hg0, ⟨g, rfl⟩⟩
      exact (hinv _ hgS y).symm
  · intro k
    have hk := hc.wit k k.2
    simp only [Cert.witOK, Bool.and_eq_true, nbeq_iff] at hk
    set w := c.wit.getD k []
    have hw : wordPerm σs w ∈ R := wordPerm_mem hσR w
    obtain ⟨g, hg⟩ := hw
    have e1 : evalPt c.tabs c.d w c.x0 = (ρ g x₀ : ℕ) := by
      rw [hg]; exact evalPt_eq hall w x₀
    have e2 : evalPt c.tabs c.d w (evalPt c.tabs c.d w c.x0) = (ρ (g * g) x₀ : ℕ) := by
      rw [e1, map_mul, Perm.mul_apply, hg]; exact evalPt_eq hall w _
    refine ⟨g, g, ?_, ?_, ?_⟩ <;> apply Fin.ext <;>
      simp only [Equiv.refl_apply, Nat.mod_eq_of_lt (hcls _)]
    · rw [← hk.1, e1]
    · rw [← hk.1, e1]
    · rw [← hk.2, e2]
  · have hk := hc.klein
    simp only [Cert.kleinOK, Bool.and_eq_true, and_assoc] at hk
    obtain ⟨h18, h19, h20, h21, h22, h23, h24, h25⟩ := hk
    set u := pk σs (2 * c.iu)
    set z := pk σs (2 * c.iz)
    have hU : ∀ x : Fin c.n, lk c.tabs c.d (2 * c.iu) x = u x := lk_eq hall _
    have hZ : ∀ x : Fin c.n, lk c.tabs c.d (2 * c.iz) x = z x := lk_eq hall _
    have hmap : ∀ v : Perm (Fin c.n), v ∈ R → v x₀ = x₀ →
        v ∈ ((MulAction.stabilizer (Perm (Fin c.n)) x₀).comap ρ).map ρ := by
      rintro v ⟨g, rfl⟩ hv
      exact ⟨g, by simpa only [SetLike.mem_coe, Subgroup.mem_comap, MulAction.mem_stabilizer_iff,
        Perm.smul_def] using hv, rfl⟩
    have hu0 : u x₀ = x₀ := Fin.ext (by rw [← hU]; exact nbeq_iff.1 h18)
    have hz0 : z x₀ = x₀ := Fin.ext (by rw [← hZ]; exact nbeq_iff.1 h19)
    apply isGood_of_involutions _ ρ (hmap u (pk_mem hσR _) hu0) (hmap z (pk_mem hσR _) hz0)
    · ext x
      have := allLt_true_of h20 x.2
      rw [nbeq_iff, hU, hU] at this
      simpa [Perm.mul_apply] using this
    · ext x
      have := allLt_true_of h21 x.2
      rw [nbeq_iff, hZ, hZ] at this
      simpa [Perm.mul_apply] using this
    · ext x
      have := allLt_true_of h22 x.2
      rw [nbeq_iff, hZ, hU, hU, hZ] at this
      simpa [Perm.mul_apply] using this
    · intro hu1
      have h := h23
      rw [Bool.not_eq_true', Bool.eq_false_iff] at h
      apply h
      apply allLt_iff.2
      intro x hx
      rw [nbeq_iff, hU ⟨x, hx⟩, hu1]
      rfl
    · intro hz1
      have h := h24
      rw [Bool.not_eq_true', Bool.eq_false_iff] at h
      apply h
      apply allLt_iff.2
      intro x hx
      rw [nbeq_iff, hZ ⟨x, hx⟩, hz1]
      rfl
    · intro huz
      have h := h25
      rw [Bool.not_eq_true', Bool.eq_false_iff] at h
      apply h
      apply allLt_iff.2
      intro x hx
      rw [nbeq_iff, hU ⟨x, hx⟩, hZ ⟨x, hx⟩, huz]
  · by_cases h0 : c.x0 = 0
    · exact ⟨⟨1, by omega⟩, fun e => by simp [x₀, h0] at e⟩
    · exact ⟨⟨0, by omega⟩, fun e => h0 (by simpa [x₀] using (congrArg Fin.val e).symm)⟩

end Sound

