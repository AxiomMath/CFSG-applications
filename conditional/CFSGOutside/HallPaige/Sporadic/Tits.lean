/-- Suborbit labels of the 1755 points, packed in 3-bit fields. -/
def titsLabN : ℕ :=
  

/-- Suborbit representatives. -/
def titsReps : List ℕ := [0, 1, 6, 24, 87]

/-- For each suborbit `k`, a word `g` with `g • 0` and `g² • 0` in suborbit `k`. -/
def titsSq : List (List ℕ) := [[], [1, 0, 1, 1, 1, 0, 1, 1], [0, 0, 1, 1], [1], [0, 0]]

/-- Two commuting involutions in the point stabilizer. -/
def titsInvA : List ℕ := [2, 2]

/-- See `titsInvA`. -/
def titsInvB : List ℕ := [3, 3, 3, 3]

/-- Suborbit label of a point (as a natural number). -/
def titsLabF (y : ℕ) : ℕ := Nat.land (Nat.shiftRight titsLabN (3 * y)) 7

/-- Suborbit label of a point. -/
def titsLab (y : Fin 1755) : Fin 5 := ⟨titsLabF y % 5, Nat.mod_lt _ (by norm_num)⟩

theorem titsTr_check : titsTr.length = 1755 ∧
    allIdx (fun y w => titsOK w && titsEval w 0 == y) 0 titsTr = true := by
  decide +kernel

/-- Letters of the stabilizer generators. -/
def titsHOK (w : List ℕ) : Bool := w.all fun k => k == 2 || k == 3 || k == 12

theorem titsHw_check : titsHw.length = 1755 ∧
    allIdx (fun y w => titsHOK w && titsEval w 0 == 0 &&
      titsEval w (titsReps.getD (titsLabF y) 0) == y) 0 titsHw = true := by
  decide +kernel

theorem titsLab_check : (List.range 1755).all (fun y => decide (titsLabF y < 5) &&
    titsLabF (titsVal 2 y) == titsLabF y && titsLabF (titsVal 3 y) == titsLabF y &&
    titsLabF (titsVal 12 y) == titsLabF y) = true := by
  decide +kernel

theorem titsReps_check : (List.range 5).all (fun k => titsLabF (titsReps.getD k 0) == k &&
    decide (titsReps.getD k 0 < 1755)) = true := by
  decide +kernel

theorem titsSq_check : (List.range 5).all (fun k => titsOK (titsSq.getD k []) &&
    titsLabF (titsEval (titsSq.getD k []) 0) == k &&
    titsLabF (titsEval (titsSq.getD k []) (titsEval (titsSq.getD k []) 0)) == k) = true := by
  decide +kernel

theorem titsInv_check : (titsOK titsInvA && titsOK titsInvB && titsEval titsInvA 0 == 0 &&
    titsEval titsInvB 0 == 0 &&
    (List.range 1755).all (fun x => titsEval titsInvA (titsEval titsInvA x) == x &&
      titsEval titsInvB (titsEval titsInvB x) == x &&
      titsEval titsInvA (titsEval titsInvB x) == titsEval titsInvB (titsEval titsInvA x)) &&
    (List.range 1755).any (fun x => titsEval titsInvA x != x) &&
    (List.range 1755).any (fun x => titsEval titsInvB x != x) &&
    (List.range 1755).any (fun x => titsEval titsInvA x != titsEval titsInvB x)) = true := by
  decide +kernel

theorem titsHOK_titsOK {w : List ℕ} (h : titsHOK w = true) : titsOK w = true := by
  simp only [titsHOK, titsOK, List.all_eq_true, Bool.or_eq_true, beq_iff_eq,
    decide_eq_true_eq] at h ⊢
  intro k hk
  rcases h k hk with (rfl | rfl) | rfl <;> norm_num

theorem titsLabF_lt (y : Fin 1755) : titsLabF y < 5 := by
  have := range_all_spec titsLab_check y y.2
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  exact this.1.1.1

theorem titsLab_eq_iff (y y' : Fin 1755) : titsLab y = titsLab y' ↔ titsLabF y = titsLabF y' := by
  simp only [titsLab, Fin.mk.injEq, Nat.mod_eq_of_lt (titsLabF_lt y),
    Nat.mod_eq_of_lt (titsLabF_lt y')]

section
variable [h0 : Corpus.Tits.Theorems]
include h0

theorem titsLab_titsT {k : ℕ} (hk : k = 2 ∨ k = 3 ∨ k = 12) (y : Fin 1755) :
    titsLab (titsT k y) = titsLab y := by
  rw [titsLab_eq_iff, titsT_val (by omega)]
  have := range_all_spec titsLab_check y y.2
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at this
  rcases hk with rfl | rfl | rfl
  · exact this.1.1.2
  · exact this.1.2
  · exact this.2

set_option maxRecDepth 100000 in
/-- The labelling is invariant under the point stabilizer `titsH`. -/
theorem titsLab_titsH {g : Perm (Fin 1755)} (hg : g ∈ titsH) (y : Fin 1755) :
    titsLab (g y) = titsLab y := by
  induction hg using Subgroup.closure_induction generalizing y with
  | mem g hg =>
    obtain ⟨w, hw, rfl⟩ := hg
    simp only [titsHWords, List.mem_cons, List.mem_nil_iff, or_false] at hw
    rcases hw with rfl | rfl | rfl
    · have h := wordIn_single (l := 3) (by norm_num) (by norm_num)
      simp only [Nat.cast_ofNat, Nat.add_one_sub_one] at h
      rw [h]
      exact titsLab_titsT (Or.inl rfl) y
    · have h := wordIn_single (l := 4) (by norm_num) (by norm_num)
      simp only [Nat.cast_ofNat, Nat.add_one_sub_one] at h
      rw [h]
      exact titsLab_titsT (Or.inr (Or.inl rfl)) y
    · have h := wordIn_single (l := 13) (by norm_num) (by norm_num)
      simp only [Nat.cast_ofNat, Nat.add_one_sub_one] at h
      rw [h]
      exact titsLab_titsT (Or.inr (Or.inr rfl)) y
  | one => rfl
  | mul g h _ _ hg hh => rw [Perm.mul_apply, hg, hh]
  | inv g _ hg =>
    have := hg (g⁻¹ y)
    rw [show g (g⁻¹ y) = y from by simp] at this
    exact this.symm

end

/-- The representative of suborbit `k`, as a point. -/
def titsRep (k : ℕ) : Fin 1755 := ⟨titsReps.getD k 0 % 1755, Nat.mod_lt _ (by norm_num)⟩

theorem titsRep_val {k : ℕ} (hk : k < 5) : (titsRep k : ℕ) = titsReps.getD k 0 := by
  have := range_all_spec titsReps_check k hk
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  exact Nat.mod_eq_of_lt this.2

section
variable [h0 : Corpus.Tits.Theorems]
include h0

/-- **The Tits group `²F₄(2)'` satisfies the permutation-labelling criterion** (its action on
1755 points, rank 5). -/
theorem permLabelling_tits (hv : TauCeti.LieTypeIndex.tits.Valid) :
    PermLabelling (TauCeti.CFSGIndex.lie ⟨.tits, hv⟩).Group := by
  obtain ⟨e⟩ := Corpus.Tits.Theorems.nonempty_mulEquiv_titsD_cat hv
  haveI : Finite (Cat ⟨.tits, hv⟩) := Finite.of_equiv _ e.symm.toEquiv
  show PermLabelling (Cat ⟨.tits, hv⟩)
  let ρ : Cat ⟨.tits, hv⟩ →* Perm (Fin 1755) := titsD.subtype.comp e.toMonoidHom
  let el : ∀ w : List ℕ, titsOK w = true → Cat ⟨.tits, hv⟩ :=
    fun w hw => e.symm ⟨titsProd w, titsProd_mem w hw⟩
  have hρ : ∀ w hw, ρ (el w hw) = titsProd w := fun w hw => by simp [ρ, el]
  have hok_app : ∀ v w, titsOK v = true → titsOK w = true → titsOK (v ++ w) = true :=
    fun v w hv hw => by simp only [titsOK] at hv hw ⊢; simp [hv, hw]
  have hel : ∀ v w hv hw, el v hv * el w hw = el (v ++ w) (hok_app v w hv hw) :=
    fun v w hv hw => by
      simp only [el, ← map_mul]
      congr 1
      exact Subtype.ext (by simp [titsProd_append])
  have hel_inj : ∀ v w hv hw, el v hv = el w hw ↔ titsProd v = titsProd w := fun v w hv hw => by
    simp only [el, EmbeddingLike.apply_eq_iff_eq, Subtype.mk.injEq]
  have hone : el [] rfl = 1 := by
    simp only [el, titsProd]
    exact (map_eq_one_iff e.symm e.symm.injective).mpr rfl
  have hperm : ∀ v w hv hw, (∀ x : Fin 1755, titsEval v x = titsEval w x) →
      el v hv = el w hw := fun v w hv hw h =>
    (hel_inj v w hv hw).mpr (Equiv.ext fun x => Fin.ext (by
      rw [titsProd_val v hv, titsProd_val w hw, h]))
  have hev_app : ∀ v w (hv : titsOK v = true) (hw : titsOK w = true) (x : Fin 1755),
      titsEval (v ++ w) x = titsEval v (titsEval w x) := fun v w hv hw x => by
    rw [← titsProd_val _ (hok_app v w hv hw), titsProd_append, Perm.mul_apply,
      titsProd_val v hv, titsProd_val w hw]
  obtain ⟨htrl, htr⟩ := titsTr_check
  obtain ⟨hhwl, hhw⟩ := titsHw_check
  have htr' := allIdx_spec _ [] titsTr 0 htr
  have hhw' := allIdx_spec _ [] titsHw 0 hhw
  simp only [Nat.zero_add, Bool.and_eq_true, beq_iff_eq] at htr' hhw'
  -- words in the stabilizer joining the suborbit representative to each point
  have hP : ∀ y : Fin 1755, ∃ p : Cat ⟨.tits, hv⟩, ρ p 0 = 0 ∧ ρ p (titsRep (titsLabF y)) = y :=
    fun y => by
      obtain ⟨⟨h1, h2⟩, h3⟩ := hhw' y (by rw [hhwl]; exact y.2)
      have hok := titsHOK_titsOK h1
      refine ⟨el _ hok, ?_, ?_⟩
      · rw [hρ _ hok]; exact titsProd_apply_eq hok h2
      · rw [hρ _ hok]
        apply Fin.ext
        rw [titsProd_val _ hok, titsRep_val (titsLabF_lt y), h3]
  have hinvc := titsInv_check
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range, List.any_eq_true,
    bne_iff_ne, ne_eq] at hinvc
  obtain ⟨⟨⟨⟨⟨⟨⟨hokA, hokB⟩, hA0⟩, hB0⟩, hAB⟩, ⟨xa, hxa, hxa'⟩⟩, ⟨xb, hxb, hxb'⟩⟩,
    ⟨xab, hxab, hxab'⟩⟩ := hinvc
  refine permLabelling_of_labels ρ 0 titsLab ?_ ?_ ?_ ?_ (el _ hokA) (el _ hokB) ?_ ?_ ?_ ?_ ?_
    ?_ ?_ ?_ ⟨1, by decide⟩
  · intro y
    obtain ⟨h1, h2⟩ := htr' y (by rw [htrl]; exact y.2)
    exact ⟨el _ h1, by rw [hρ _ h1]; exact titsProd_apply_eq h1 h2⟩
  · intro h h0 y
    have hmem : (e h : Perm (Fin 1755)) ∈ titsH := by
      rw [Corpus.Tits.Theorems.titsH_eq_stab]
      refine ⟨e h, ?_, rfl⟩
      show (e h : Perm (Fin 1755)) ∈ MulAction.stabilizer (Perm (Fin 1755)) (0 : Fin 1755)
      rw [MulAction.mem_stabilizer_iff, Perm.smul_def]
      exact h0
    exact titsLab_titsH hmem y
  · intro y y' hyy
    have hl : titsLabF y = titsLabF y' := (titsLab_eq_iff y y').1 hyy
    obtain ⟨p, hp0, hp1⟩ := hP y
    obtain ⟨q, hq0, hq1⟩ := hP y'
    rw [hl] at hp1
    refine ⟨q * p⁻¹, ?_, ?_⟩
    · rw [map_mul, map_inv, Perm.mul_apply, Perm.inv_eq_iff_eq.mpr hp0.symm, hq0]
    · rw [map_mul, map_inv, Perm.mul_apply, Perm.inv_eq_iff_eq.mpr hp1.symm, hq1]
  · intro k
    have := range_all_spec titsSq_check k k.2
    simp only [Bool.and_eq_true, beq_iff_eq] at this
    obtain ⟨⟨hok, h1⟩, h2⟩ := this
    refine ⟨el _ hok, ?_, ?_⟩
    · rw [hρ _ hok]
      apply Fin.ext
      simp only [titsLab]
      rw [titsProd_val _ hok, Fin.val_zero, h1, Nat.mod_eq_of_lt k.2]
    · rw [hel _ _ hok hok, hρ _ (hok_app _ _ hok hok)]
      apply Fin.ext
      simp only [titsLab]
      rw [titsProd_val _ (hok_app _ _ hok hok), hev_app _ _ hok hok, Fin.val_zero, h2,
        Nat.mod_eq_of_lt k.2]
  · rw [hρ _ hokA]; exact titsProd_apply_eq hokA hA0
  · rw [hρ _ hokB]; exact titsProd_apply_eq hokB hB0
  · rw [hel _ _ hokA hokA, ← hone]
    exact hperm _ _ (hok_app _ _ hokA hokA) rfl fun x => by rw [hev_app _ _ hokA hokA]; exact (hAB x x.2).1.1
  · rw [hel _ _ hokB hokB, ← hone]
    exact hperm _ _ (hok_app _ _ hokB hokB) rfl fun x => by rw [hev_app _ _ hokB hokB]; exact (hAB x x.2).1.2
  · rw [hel _ _ hokA hokB, hel _ _ hokB hokA]
    exact hperm _ _ (hok_app _ _ hokA hokB) (hok_app _ _ hokB hokA) fun x => by
      rw [hev_app _ _ hokA hokB, hev_app _ _ hokB hokA]; exact (hAB x x.2).2
  · intro h
    rw [← hone, hel_inj _ _ hokA rfl] at h
    apply hxa'
    have := titsProd_val _ hokA ⟨xa, hxa⟩
    rw [h] at this
    exact this.symm
  · intro h
    rw [← hone, hel_inj _ _ hokB rfl] at h
    apply hxb'
    have := titsProd_val _ hokB ⟨xb, hxb⟩
    rw [h] at this
    exact this.symm
  · intro h
    rw [hel_inj _ _ hokA hokB] at h
    apply hxab'
    rw [← titsProd_val _ hokA ⟨xab, hxab⟩, ← titsProd_val _ hokB ⟨xab, hxab⟩, h]

end

end Tits

