import CFSGOutside.HallPaige.Sporadic.Mathieu
import CFSGOutside.Corpus.HallPaige.Tits

/-!
# The Tits group satisfies the permutation-labelling criterion

We use the corpus action of `²F₄(2)'` on 1755 points (`Corpus.Tits.titsD`). The stabilizer `H`
of the point `0` is `titsH`, generated by `titsT 2`, `titsT 3`, `titsT 12` (corpus), and has five
orbits of sizes `1, 10, 80, 640, 1024`. We take `σ = 1`: for each suborbit `O` we exhibit `g` with
`g • 0 ∈ O` and `g² • 0 ∈ O`. The suborbit labelling is checked to be invariant under the three
generators of `H` and connected by explicit words; `H` contains two commuting involutions.
All permutations are evaluated on points through the corpus packed table `TitsText.F`.
-/

namespace CFSGOutside.HallPaige

universe u

open Equiv

section General

/-- **The permutation-labelling criterion with `σ = 1`.** A transitive action, a labelling of the
points whose fibres are exactly the orbits of the point stabilizer, for each label an element `g`
with `g • x₀` and `g² • x₀` of that label, and two distinct commuting involutions fixing `x₀`. -/
theorem permLabelling_of_labels {G : Type u} [Group G] [Finite G] {n r : ℕ}
    (ρ : G →* Perm (Fin n)) (x₀ : Fin n) (lab : Fin n → Fin r)
    (htrans : ∀ y, ∃ g, ρ g x₀ = y)
    (hinv : ∀ h, ρ h x₀ = x₀ → ∀ y, lab (ρ h y) = lab y)
    (hconn : ∀ y y', lab y = lab y' → ∃ h, ρ h x₀ = x₀ ∧ ρ h y = y')
    (hsq : ∀ k, ∃ g, lab (ρ g x₀) = k ∧ lab (ρ (g * g) x₀) = k)
    (a b : G) (hax : ρ a x₀ = x₀) (hbx : ρ b x₀ = x₀) (ha : a * a = 1) (hb : b * b = 1)
    (hab : a * b = b * a) (ha1 : a ≠ 1) (hb1 : b ≠ 1) (hne : a ≠ b) (hy : ∃ y, y ≠ x₀) :
    PermLabelling G := by
  refine ⟨n, ρ, x₀, r, lab, Equiv.refl _, htrans, fun y y' => ⟨hconn y y', ?_⟩, fun _ => rfl,
    fun k => ?_, isGood_comap_stabilizer ρ x₀ hax hbx ha hb hab ha1 hb1 hne, hy⟩
  · rintro ⟨h, h0, rfl⟩
    exact (hinv h h0 y).symm
  · obtain ⟨g, h1, h2⟩ := hsq k
    exact ⟨g, g, h1, h1, h2⟩

/-- Check a predicate on the entries of a list together with their indices. -/
def allIdx {α : Type*} (p : ℕ → α → Bool) : ℕ → List α → Bool
  | _, [] => true
  | i, a :: l => p i a && allIdx p (i + 1) l

theorem allIdx_spec {α : Type*} (p : ℕ → α → Bool) (d : α) :
    ∀ (l : List α) (i : ℕ), allIdx p i l = true → ∀ j < l.length, p (i + j) (l.getD j d) = true
  | [], _, _, j, hj => absurd hj (Nat.not_lt_zero _)
  | a :: l, i, h, j, hj => by
    simp only [allIdx, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j =>
      have := allIdx_spec p d l (i + 1) h.2 j (by simpa using hj)
      simpa [Nat.add_assoc, Nat.add_comm 1 j] using this

theorem range_all_spec {n : ℕ} {p : ℕ → Bool} (h : (List.range n).all p = true) :
    ∀ y < n, p y = true := fun y hy =>
  List.all_eq_true.1 h y (List.mem_range.2 hy)

end General

section Tits

open Corpus.Tits

/-- Evaluation of `titsT k` on a point through the corpus packed table. -/
noncomputable def titsVal (k x : ℕ) : ℕ := pg 11 (mask 11) (TitsText.F (18 + k)) x

section
variable [h0 : Corpus.Tits.Theorems]
include h0

theorem titsT_val {k : ℕ} (hk : k < 13) (x : Fin 1755) : (titsT k x : ℕ) = titsVal k x := by
  have h := Corpus.Tits.Theorems.titsT_rep hk x
  rw [Corpus.Tits.Theorems.titsDerivedArrs_get hk, unpack,
    getElem!_pos _ _ (by simp only [Array.size_ofFn]; exact x.2), Array.getElem_ofFn] at h
  exact h.symm

end

/-- The product `titsT k₁ * titsT k₂ * ⋯` of a word of letters `kᵢ`. -/
noncomputable def titsProd : List ℕ → Perm (Fin 1755)
  | [] => 1
  | k :: w => titsT k * titsProd w

/-- Evaluation of `titsProd w` on a point, through `titsVal`. -/
noncomputable def titsEval : List ℕ → ℕ → ℕ
  | [], x => x
  | k :: w, x => titsVal k (titsEval w x)

/-- All letters of a word are `< 13`. -/
def titsOK (w : List ℕ) : Bool := w.all (· < 13)

theorem titsOK_cons {k : ℕ} {w : List ℕ} (h : titsOK (k :: w) = true) :
    k < 13 ∧ titsOK w = true := by
  simpa [titsOK] using h

section
variable [h0 : Corpus.Tits.Theorems]
include h0

theorem titsProd_val : ∀ (w : List ℕ), titsOK w = true → ∀ x : Fin 1755,
    (titsProd w x : ℕ) = titsEval w x
  | [], _, _ => rfl
  | k :: w, h, x => by
    rw [titsProd, Perm.mul_apply, titsT_val (titsOK_cons h).1,
      titsProd_val w (titsOK_cons h).2 x]
    rfl

theorem titsProd_mem : ∀ (w : List ℕ), titsOK w = true → titsProd w ∈ titsD
  | [], _ => titsD.one_mem
  | k :: w, h => titsD.mul_mem (Corpus.Tits.Theorems.titsT_mem_titsD (titsOK_cons h).1)
      (titsProd_mem w (titsOK_cons h).2)

end

theorem titsProd_append (v w : List ℕ) : titsProd (v ++ w) = titsProd v * titsProd w := by
  induction v with
  | nil => simp [titsProd]
  | cons c v ih => simp [titsProd, ih, mul_assoc]

section
variable [h0 : Corpus.Tits.Theorems]
include h0

theorem titsProd_apply_eq {w : List ℕ} (hw : titsOK w = true) {x y : Fin 1755}
    (h : titsEval w x = y) : titsProd w x = y :=
  Fin.ext ((titsProd_val w hw x).trans h)

end

theorem wordIn_single {l : ℕ} (hl : 0 < l) (hl' : l ≤ 13) :
    wordIn 13 titsT [(l : ℤ)] = titsT (l - 1) := by
  have h : toLetters 13 [(l : ℤ)] = [(⟨l - 1, by omega⟩, true)] := by
    simp only [toLetters, List.filterMap_cons, List.filterMap_nil]
    rw [dif_pos (by omega)]
    simp only [Option.some.injEq, List.cons.injEq, and_true, Prod.mk.injEq]
    refine ⟨Fin.ext ?_, ?_⟩ <;> simp <;> omega
  rw [wordIn, h, Quiver.SchreierGraph.evalWord_cons_true, Quiver.SchreierGraph.evalWord_nil,
    mul_one]

