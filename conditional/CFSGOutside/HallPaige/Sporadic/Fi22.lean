theorem certOK : CertOK cert TauCeti.SporadicName.Fi22.presentation.generatorCount TauCeti.SporadicName.Fi22.presentation.relators 64561751654400 where
  basic := ok_basic
  gens := List.all_eq_true.1 ok_gens
  elems := by
    have h : cert.elems.length = 17 := by decide +kernel
    intro k hk
    rw [h] at hk
    match k, hk with
    | 0, _ => exact ok_elem_0
    | 1, _ => exact ok_elem_1
    | 2, _ => exact ok_elem_2
    | 3, _ => exact ok_elem_3
    | 4, _ => exact ok_elem_4
    | 5, _ => exact ok_elem_5
    | 6, _ => exact ok_elem_6
    | 7, _ => exact ok_elem_7
    | 8, _ => exact ok_elem_8
    | 9, _ => exact ok_elem_9
    | 10, _ => exact ok_elem_10
    | 11, _ => exact ok_elem_11
    | 12, _ => exact ok_elem_12
    | 13, _ => exact ok_elem_13
    | 14, _ => exact ok_elem_14
    | 15, _ => exact ok_elem_15
    | 16, _ => exact ok_elem_16
    | _ + 17, h => exact absurd h (by omega)
  rels := by
    have h : TauCeti.SporadicName.Fi22.presentation.relators.length = 13 := by decide +kernel
    intro k hk
    rw [h] at hk
    match k, hk with
    | 0, _ => exact ok_rel_0
    | 1, _ => exact ok_rel_1
    | 2, _ => exact ok_rel_2
    | 3, _ => exact ok_rel_3
    | 4, _ => exact ok_rel_4
    | 5, _ => exact ok_rel_5
    | 6, _ => exact ok_rel_6
    | 7, _ => exact ok_rel_7
    | 8, _ => exact ok_rel_8
    | 9, _ => exact ok_rel_9
    | 10, _ => exact ok_rel_10
    | 11, _ => exact ok_rel_11
    | 12, _ => exact ok_rel_12
    | _ + 13, h => exact absurd h (by omega)
  trans := ok_trans
  chain := ok_chain
  lab := ok_lab
  inv := by
    have h : cert.gs1.length = 13 := by decide +kernel
    intro k hk
    rw [h] at hk
    match k, hk with
    | 0, _ => exact ok_inv_0
    | 1, _ => exact ok_inv_1
    | 2, _ => exact ok_inv_2
    | 3, _ => exact ok_inv_3
    | 4, _ => exact ok_inv_4
    | 5, _ => exact ok_inv_5
    | 6, _ => exact ok_inv_6
    | 7, _ => exact ok_inv_7
    | 8, _ => exact ok_inv_8
    | 9, _ => exact ok_inv_9
    | 10, _ => exact ok_inv_10
    | 11, _ => exact ok_inv_11
    | 12, _ => exact ok_inv_12
    | _ + 13, h => exact absurd h (by omega)
  wit := fun k hk => List.all_eq_true.1 ok_wit k (List.mem_range.2 hk)
  klein := ok_klein

section
variable [h0 : Corpus.Fi22.FiniteCardLe]
include h0

/-- **`Fi22` satisfies the permutation-labelling form of the Wilcox–Evans criterion.** -/
theorem permLabelling : PermLabelling TauCeti.SporadicName.Fi22.Group :=
  haveI := Corpus.Fi22.FiniteCardLe.finite_card_le.1
  permLabelling_of_certOK Corpus.Fi22.FiniteCardLe.finite_card_le.2 cert certOK

end

