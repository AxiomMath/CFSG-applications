
import CFSGOutside.Common.NonsolubleLength
import CFSGOutside.Corpus.PPrimeCore

/-!
# Non-`p`-soluble length of finite groups

For a prime `p`, the *non-`p`-soluble length* `λ_p(G)` of a finite group `G` (Khukhro–Shumyatsky)
is the least number `h` of non-`p`-soluble factors in a normal series
`1 = G₀ ≤ G₁ ≤ ⋯ ≤ G_{2h+1} = G` whose factors `G_{2i+1}/G_{2i}` are `p`-soluble and whose
factors `G_{2i+2}/G_{2i+1}` are direct products of nonabelian simple groups of order divisible
by `p`.

This module provides the infrastructure shared by the formalizations of

* E. I. Khukhro, P. Shumyatsky, *Words and pronilpotent subgroups in profinite groups*,
  J. Aust. Math. Soc. 97 (2014) 343–364 (arXiv:1312.2152), and
* E. I. Khukhro, P. Shumyatsky, *Nonsoluble and non-p-soluble length of finite groups*,
  Israel J. Math. 207 (2015) (arXiv:1310.2434), §2,

and it generalizes the `p = 2` machinery of `CFSGOutside.NonsolubleLength` without
modifying it.

## Main definitions

* `IsPElt p x`, `IsPPrimeElt p x`: `p`-elements and `p'`-elements.
* `Dp p S = O^p(S) ⊓ O^{p'}(S)`, the smallest normal subgroup of `S` with quotient a direct product
  of a `p`-group and a `p'`-group; `PSolSec p A B : ∃ n, Dp^[n] B ≤ A` says that the section
  `B/A` is `p`-soluble (`PSoluble p B` for `A = ⊥`).
* `pSolRad p G`: the `p`-soluble radical `R_p(G)`.
* `IsSemisimplePProd p Y`: `Y` is a finite direct product of nonabelian simple groups of order
  divisible by `p`.
* `NSeriesP p X N h`, `NonPSolubleLengthLE p X h`: series and the bound `λ_p(X) ≤ h`.
* `pKernel p G`: the `p`-kernel subgroup `K_p(G)`, the full preimage of the kernel of the action
  of `G/R_p(G)` on the components of `G/R_p(G)` (which are the simple factors of its socle).

## Main results

* `map_Dp`: `Dp` commutes with homomorphic images (the formation property).
* `pSoluble_of_isSolvable`: soluble groups are `p`-soluble.
* `pSoluble_pSolRad`, `le_pSolRad`, `pSolRad_quotient_eq_bot`: the radical.
* `p_dvd_card_component`: components of `G/R_p(G)` have order divisible by `p`.
* `nonPSolubleLengthLE_succ_of_pKernel` (KS Israel J., Lemma 2.1, via the Schreier conjecture):
  `λ_p(G/K_p(G)) ≤ h → λ_p(G) ≤ h + 1`.
-/

section

namespace CFSGOutside.NonPSolubleLength

open Subgroup
open CFSGOutside.NonsolubleLength (mem_of_pow_mem_of_coprime map_subtype_top
  map_conj_eq_of_mem_normalizer mem_normalizer_of_map_conj_eq dA dA_mono dA_le dA_add map_dA
  map_subtype_derivedSeries isSolvable_quotient_iff isSolvable_subgroup_iff)

section Elements

variable (p : ℕ) {G : Type*} [Group G]

/-- Elements of `p`-power order. -/
def IsPElt (x : G) : Prop := ∃ k : ℕ, x ^ (p ^ k) = 1
/-- Elements of order prime to `p`. -/
def IsPPrimeElt (x : G) : Prop := ∃ m : ℕ, m.Coprime p ∧ x ^ m = 1

/-- `O^{p'}(S)`: the subgroup generated by the `p`-elements of `S`. -/
def pGen (S : Subgroup G) : Subgroup G := closure {x | x ∈ S ∧ IsPElt p x}
/-- `O^{p}(S)`: the subgroup generated by the `p'`-elements of `S`. -/
def pPrimeGen (S : Subgroup G) : Subgroup G := closure {x | x ∈ S ∧ IsPPrimeElt p x}
/-- `Dp(S) = O^p(S) ⊓ O^{p'}(S)`. -/
def Dp (S : Subgroup G) : Subgroup G := pPrimeGen p S ⊓ pGen p S

variable {p}

lemma IsPElt.map {H : Type*} [Group H] (f : G →* H) {x : G} (h : IsPElt p x) :
    IsPElt p (f x) := by
  obtain ⟨k, hk⟩ := h; exact ⟨k, by rw [← map_pow, hk, map_one]⟩

lemma IsPPrimeElt.map {H : Type*} [Group H] (f : G →* H) {x : G} (h : IsPPrimeElt p x) :
    IsPPrimeElt p (f x) := by
  obtain ⟨m, hm, hk⟩ := h; exact ⟨m, hm, by rw [← map_pow, hk, map_one]⟩

variable (p)

lemma pGen_le (S : Subgroup G) : pGen p S ≤ S := (closure_le _).2 fun _ h => h.1
lemma pPrimeGen_le (S : Subgroup G) : pPrimeGen p S ≤ S := (closure_le _).2 fun _ h => h.1
lemma Dp_le (S : Subgroup G) : Dp p S ≤ S := inf_le_left.trans (pPrimeGen_le p S)

lemma pGen_mono {S T : Subgroup G} (h : S ≤ T) : pGen p S ≤ pGen p T :=
  closure_mono fun _ hx => ⟨h hx.1, hx.2⟩
lemma pPrimeGen_mono {S T : Subgroup G} (h : S ≤ T) : pPrimeGen p S ≤ pPrimeGen p T :=
  closure_mono fun _ hx => ⟨h hx.1, hx.2⟩
lemma Dp_mono {S T : Subgroup G} (h : S ≤ T) : Dp p S ≤ Dp p T :=
  inf_le_inf (pPrimeGen_mono p h) (pGen_mono p h)

lemma Dp_iterate_mono (n : ℕ) {S T : Subgroup G} (h : S ≤ T) : (Dp p)^[n] S ≤ (Dp p)^[n] T := by
  induction n generalizing S T with
  | zero => exact h
  | succ n ih => simpa only [Function.iterate_succ_apply] using ih (Dp_mono p h)

lemma Dp_iterate_le (n : ℕ) (S : Subgroup G) : (Dp p)^[n] S ≤ S := by
  induction n with
  | zero => exact le_rfl
  | succ n ih => rw [Function.iterate_succ_apply']; exact (Dp_le p _).trans ih

lemma coprime_pow_of_coprime {m : ℕ} (hm : m.Coprime p) (k : ℕ) : m.Coprime (p ^ k) :=
  Nat.Coprime.pow_right k hm

variable [hp : Fact p.Prime] [Finite G]

/-- Every element has a power with exponent prime to `p` which is a `p`-element. -/
lemma exists_coprime_pow_isPElt (x : G) : ∃ m, m.Coprime p ∧ IsPElt p (x ^ m) := by
  obtain ⟨a, m, hm, h⟩ := Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos x).ne' p
    hp.out.ne_one
  refine ⟨m, ((Nat.Prime.coprime_iff_not_dvd hp.out).2 hm).symm, a, ?_⟩
  rw [← pow_mul, mul_comm, ← h, pow_orderOf_eq_one]

/-- Every element has a `p`-power power which is a `p'`-element. -/
lemma exists_pow_isPPrimeElt (x : G) : ∃ k, IsPPrimeElt p (x ^ (p ^ k)) := by
  obtain ⟨a, m, hm, h⟩ := Nat.exists_eq_pow_mul_and_not_dvd (orderOf_pos x).ne' p
    hp.out.ne_one
  exact ⟨a, m, ((Nat.Prime.coprime_iff_not_dvd hp.out).2 hm).symm, by
    rw [← pow_mul, ← h, pow_orderOf_eq_one]⟩

section Map

variable {G' : Type*} [Group G']

lemma map_pGen (f : G →* G') (S : Subgroup G) : (pGen p S).map f = pGen p (S.map f) := by
  apply le_antisymm
  · rw [pGen, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro _ ⟨x, ⟨hxS, hx⟩, rfl⟩
    exact ⟨mem_map_of_mem f hxS, hx.map f⟩
  · rw [pGen, closure_le]
    rintro y ⟨⟨x, hxS, rfl⟩, k, hk⟩
    obtain ⟨m, hm, hxm⟩ := exists_coprime_pow_isPElt p x
    have h1 : f (x ^ m) ∈ (pGen p S).map f :=
      mem_map_of_mem f (subset_closure ⟨pow_mem hxS m, hxm⟩)
    have h2 : (f x) ^ (p ^ k) ∈ (pGen p S).map f := by rw [hk]; exact one_mem _
    rw [map_pow] at h1
    exact mem_of_pow_mem_of_coprime (coprime_pow_of_coprime p hm k) h1 h2

lemma map_pPrimeGen (f : G →* G') (S : Subgroup G) :
    (pPrimeGen p S).map f = pPrimeGen p (S.map f) := by
  apply le_antisymm
  · rw [pPrimeGen, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro _ ⟨x, ⟨hxS, hx⟩, rfl⟩
    exact ⟨mem_map_of_mem f hxS, hx.map f⟩
  · rw [pPrimeGen, closure_le]
    rintro y ⟨⟨x, hxS, rfl⟩, m, hm, hk⟩
    obtain ⟨k, hxk⟩ := exists_pow_isPPrimeElt p x
    have h1 : f (x ^ (p ^ k)) ∈ (pPrimeGen p S).map f :=
      mem_map_of_mem f (subset_closure ⟨pow_mem hxS _, hxk⟩)
    have h2 : (f x) ^ m ∈ (pPrimeGen p S).map f := by rw [hk]; exact one_mem _
    rw [map_pow] at h1
    exact mem_of_pow_mem_of_coprime (coprime_pow_of_coprime p hm k) h2 h1

lemma map_Dp (f : G →* G') (S : Subgroup G) : (Dp p S).map f = Dp p (S.map f) := by
  apply le_antisymm
  · refine (map_inf_le _ _ _).trans ?_
    rw [map_pPrimeGen, map_pGen]; rfl
  · intro x hx
    have hx1 : x ∈ (pPrimeGen p S).map f := by rw [map_pPrimeGen]; exact hx.1
    have hx2 : x ∈ (pGen p S).map f := by rw [map_pGen]; exact hx.2
    obtain ⟨a, ha, rfl⟩ := hx1
    obtain ⟨b, hb, hab⟩ := hx2
    obtain ⟨m, hm, ham⟩ := exists_coprime_pow_isPElt p a
    obtain ⟨k, hbk⟩ := exists_pow_isPPrimeElt p b
    have h1 : a ^ m ∈ Dp p S :=
      ⟨pow_mem ha m, subset_closure ⟨pow_mem (pPrimeGen_le p S ha) m, ham⟩⟩
    have h2 : b ^ (p ^ k) ∈ Dp p S :=
      ⟨subset_closure ⟨pow_mem (pGen_le p S hb) _, hbk⟩, pow_mem hb _⟩
    have h1' : f a ^ m ∈ (Dp p S).map f := by rw [← map_pow]; exact mem_map_of_mem f h1
    have h2' : f a ^ (p ^ k) ∈ (Dp p S).map f := by
      rw [← hab, ← map_pow]; exact mem_map_of_mem f h2
    exact mem_of_pow_mem_of_coprime (coprime_pow_of_coprime p hm k) h1' h2'

lemma map_Dp_iterate (f : G →* G') (n : ℕ) (S : Subgroup G) :
    ((Dp p)^[n] S).map f = (Dp p)^[n] (S.map f) := by
  induction n generalizing S with
  | zero => rfl
  | succ n ih => simp only [Function.iterate_succ_apply, ih, map_Dp]

end Map

/-- If `S` is normal, so is every `Dp^[n] S`. -/
lemma Dp_iterate_normal (n : ℕ) (S : Subgroup G) [hS : S.Normal] : ((Dp p)^[n] S).Normal := by
  constructor
  intro x hx g
  have hg : g ∈ normalizer (S : Set G) := by
    rw [normalizer_eq_top_iff.mpr hS]; exact mem_top g
  have h := map_Dp_iterate p (MulAut.conj g).toMonoidHom n S
  rw [map_conj_eq_of_mem_normalizer hg] at h
  rw [← h]
  exact ⟨x, hx, rfl⟩

end Elements

/-! ### `p`-soluble sections -/

section PSoluble

variable (p : ℕ) {G : Type*} [Group G]

/-- The section `B/A` is `p`-soluble: some iterate of `Dp` maps `B` into `A`. -/
def PSolSec (A B : Subgroup G) : Prop := ∃ n, (Dp p)^[n] B ≤ A

/-- `B` is `p`-soluble. -/
def PSoluble (B : Subgroup G) : Prop := PSolSec p ⊥ B

variable {p}

lemma PSoluble.mono {A B : Subgroup G} (hAB : A ≤ B) (hB : PSoluble p B) : PSoluble p A := by
  obtain ⟨n, hn⟩ := hB
  exact ⟨n, (Dp_iterate_mono p n hAB).trans hn⟩

lemma PSolSec.trans {A B C : Subgroup G} (h1 : PSolSec p A B) (h2 : PSolSec p B C) :
    PSolSec p A C := by
  obtain ⟨a, ha⟩ := h1
  obtain ⟨b, hb⟩ := h2
  refine ⟨a + b, ?_⟩
  rw [Function.iterate_add_apply]
  exact (Dp_iterate_mono p a hb).trans ha

lemma PSolSec.mono_right {A B C : Subgroup G} (h : PSolSec p A C) (hBC : B ≤ C) :
    PSolSec p A B := by
  obtain ⟨a, ha⟩ := h
  exact ⟨a, (Dp_iterate_mono p a hBC).trans ha⟩

lemma PSolSec.mono_left {A A' B : Subgroup G} (h : PSolSec p A B) (hAA : A ≤ A') :
    PSolSec p A' B := by
  obtain ⟨a, ha⟩ := h
  exact ⟨a, ha.trans hAA⟩

lemma pSolSec_of_le {A B : Subgroup G} (h : B ≤ A) : PSolSec p A B := ⟨0, h⟩

variable [hp : Fact p.Prime] [Finite G]

lemma pSolSec_comap {Y : Type*} [Group Y] [Finite Y] (f : G →* Y) (hf : Function.Surjective f)
    {A B : Subgroup Y} (h : PSolSec p A B) : PSolSec p (A.comap f) (B.comap f) := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k, map_le_iff_le_comap.1 ?_⟩
  rw [map_Dp_iterate, map_comap_eq_self_of_surjective hf]
  exact hk

lemma pSolSec_map {Y : Type*} [Group Y] [Finite Y] (f : G →* Y) {A B : Subgroup G}
    (h : PSolSec p A B) : PSolSec p (A.map f) (B.map f) := by
  obtain ⟨k, hk⟩ := h
  exact ⟨k, by rw [← map_Dp_iterate]; exact map_mono hk⟩

/-- A finite nilpotent group is a direct product of a `p`-group and a `p'`-group: `Dp(Z) = 1`. -/
lemma Dp_top_eq_bot_of_isNilpotent (Z : Type*) [Group Z] [Finite Z] [Group.IsNilpotent Z] :
    Dp p (⊤ : Subgroup Z) = ⊥ := by
  obtain ⟨e⟩ := ((Group.isNilpotent_of_finite_tfae (G := Z)).out 1 5).1 ‹_›
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot, ← e.apply_symm_apply x]
  suffices h : e.symm x = 1 by rw [h, map_one]
  funext q Q
  have hq : (q : ℕ).Prime := Nat.prime_of_mem_primeFactors q.2
  let φ : Z →* (Q : Subgroup Z) :=
    (Pi.evalMonoidHom (fun R : Sylow q Z => ((R : Subgroup Z) : Type _)) Q).comp
      ((Pi.evalMonoidHom (fun r : (Nat.card Z).primeFactors =>
        ∀ R : Sylow r Z, ((R : Subgroup Z) : Type _)) q).comp e.symm.toMonoidHom)
  change φ x = 1
  have hQq : IsPGroup q (Q : Subgroup Z) := Q.isPGroup'
  by_cases hqp : (q : ℕ) = p
  · have : pPrimeGen p (⊤ : Subgroup Z) ≤ φ.ker := by
      rw [pPrimeGen, closure_le]
      rintro y ⟨-, m, hm, hy⟩
      obtain ⟨k, hk⟩ := hQq (φ y)
      have hc : m.Coprime ((q : ℕ) ^ k) := by rw [hqp]; exact coprime_pow_of_coprime p hm k
      exact (pow_eq_one_iff_of_coprime hc).1 ⟨by rw [← map_pow, hy, map_one], hk⟩
    exact this hx.1
  · have : pGen p (⊤ : Subgroup Z) ≤ φ.ker := by
      rw [pGen, closure_le]
      rintro y ⟨-, k, hy⟩
      obtain ⟨j, hj⟩ := hQq (φ y)
      have hcop : (p ^ k).Coprime ((q : ℕ) ^ j) :=
        Nat.Coprime.pow _ _ ((Nat.coprime_primes hp.out hq).2 (Ne.symm hqp))
      exact (pow_eq_one_iff_of_coprime hcop).1 ⟨by rw [← map_pow, hy, map_one], hj⟩
    exact this hx.2

lemma Dp_le_of_isNilpotent {M N : Subgroup G} [(N.subgroupOf M).Normal]
    (h : Group.IsNilpotent (M ⧸ N.subgroupOf M)) : Dp p M ≤ N := by
  let π := QuotientGroup.mk' (N.subgroupOf M)
  have h1 : (Dp p (⊤ : Subgroup M)).map π = ⊥ := by
    rw [map_Dp, map_top_of_surjective π (QuotientGroup.mk'_surjective _)]
    exact Dp_top_eq_bot_of_isNilpotent _
  have h2 : Dp p (⊤ : Subgroup M) ≤ N.subgroupOf M := by
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h1
    exact h1
  rw [← map_subtype_top M, ← map_Dp]
  rintro x ⟨y, hy, rfl⟩
  exact h2 hy

/-- `Dp(M) ≤ [M, M]`. -/
lemma Dp_le_commutator (M : Subgroup G) : Dp p M ≤ ⁅M, M⁆ := by
  have heq : ⁅M, M⁆.subgroupOf M = commutator M := by
    rw [← Subgroup.map_subtype_commutator]
    exact comap_map_eq_self_of_injective M.subtype_injective _
  haveI : (⁅M, M⁆.subgroupOf M).Normal := by rw [heq]; infer_instance
  apply Dp_le_of_isNilpotent
  haveI : Group.IsNilpotent (Abelianization M) := inferInstance
  exact nilpotent_of_mulEquiv (QuotientGroup.quotientMulEquivOfEq heq).symm

/-- The iterates of `Dp` lie below the derived series. -/
lemma Dp_iterate_le_dA (k : ℕ) (M : Subgroup G) : (Dp p)^[k] M ≤ dA k M := by
  induction k generalizing M with
  | zero => exact le_rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    exact (Dp_le_commutator _).trans (commutator_mono (ih M) (ih M))

/-- Soluble subgroups are `p`-soluble. -/
lemma pSoluble_of_isSolvable {M : Subgroup G} (h : Group.IsSolvable M) : PSoluble p M := by
  obtain ⟨k, hk⟩ := (isSolvable_subgroup_iff M).1 h
  exact ⟨k, (Dp_iterate_le_dA k M).trans hk.le⟩

/-- Soluble sections are `p`-soluble. -/
lemma pSolSec_of_dA {A B : Subgroup G} {k : ℕ} (h : dA k B ≤ A) : PSolSec p A B :=
  ⟨k, (Dp_iterate_le_dA k B).trans h⟩

/-- A `p'`-subgroup is `p`-soluble. -/
lemma pSoluble_of_coprime {M : Subgroup G} (h : Nat.Coprime p (Nat.card M)) : PSoluble p M := by
  refine ⟨1, ?_⟩
  show Dp p M ≤ ⊥
  refine inf_le_right.trans ((closure_le _).2 ?_)
  rintro x ⟨hx, k, hk⟩
  have h1 : (⟨x, hx⟩ : M) ^ Nat.card M = 1 := pow_card_eq_one'
  have h2 : (⟨x, hx⟩ : M) ^ (p ^ k) = 1 := Subtype.ext hk
  have := (pow_eq_one_iff_of_coprime (Nat.Coprime.pow_left k h)).1 ⟨h2, h1⟩
  simpa using congrArg Subtype.val this

end PSoluble

/-! ### The `p`-soluble radical -/

section Radical

variable {p : ℕ} [hp : Fact p.Prime] {G : Type*} [Group G] [Finite G]

lemma pSoluble_sup {N M : Subgroup G} [hN : N.Normal] (hNs : PSoluble p N) (hMs : PSoluble p M) :
    PSoluble p (N ⊔ M) := by
  obtain ⟨a, ha⟩ := hNs
  obtain ⟨b, hb⟩ := hMs
  let π := QuotientGroup.mk' N
  have hN0 : N.map π = ⊥ := by rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  have h1 : ((Dp p)^[b] (N ⊔ M)).map π = ⊥ := by
    rw [map_Dp_iterate, Subgroup.map_sup, hN0, bot_sup_eq, ← map_Dp_iterate]
    exact le_bot_iff.1 ((map_mono hb).trans (by rw [Subgroup.map_bot]))
  rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h1
  refine ⟨a + b, ?_⟩
  rw [Function.iterate_add_apply]
  exact (Dp_iterate_mono p a h1).trans ha

variable (p G) in
/-- The `p`-soluble radical `R_p(G)`: the largest normal `p`-soluble subgroup. -/
def pSolRad : Subgroup G := sSup {N : Subgroup G | N.Normal ∧ PSoluble p N}

instance pSolRad_normal : (pSolRad p G).Normal :=
  Subgroup.sSup_normal _ (fun _ h => h.1)

lemma le_pSolRad {N : Subgroup G} [hN : N.Normal] (h : PSoluble p N) : N ≤ pSolRad p G :=
  le_sSup ⟨hN, h⟩

lemma pSoluble_pSolRad : PSoluble p (pSolRad p G) := by
  set S := {N : Subgroup G | N.Normal ∧ PSoluble p N}
  have hne : S.Nonempty := ⟨⊥, normal_bot, ⟨0, le_rfl⟩⟩
  obtain ⟨N, hNS, hmax⟩ := Set.exists_max_image S (fun N => Nat.card N) (Set.toFinite S) hne
  haveI := hNS.1
  have hle : pSolRad p G ≤ N := by
    refine sSup_le fun M hM => ?_
    haveI := hM.1
    have hsup : N ⊔ M ∈ S := ⟨inferInstance, pSoluble_sup hNS.2 hM.2⟩
    have heq : N = N ⊔ M :=
      Subgroup.eq_of_le_of_card_ge le_sup_left (hmax _ hsup)
    rw [heq]; exact le_sup_right
  exact hNS.2.mono hle

/-- `R_p(G/R_p(G)) = 1`: every normal `p`-soluble subgroup of `G/R_p(G)` is trivial. -/
lemma eq_bot_of_normal_pSoluble_quotient {N : Subgroup (G ⧸ pSolRad p G)} [hN : N.Normal]
    (h : PSoluble p N) : N = ⊥ := by
  set R := pSolRad p G
  let π := QuotientGroup.mk' R
  set M := N.comap π
  haveI : M.Normal := hN.comap π
  have hM : PSoluble p M := by
    obtain ⟨a, ha⟩ := (pSoluble_pSolRad : PSoluble p R)
    obtain ⟨b, hb⟩ := h
    refine ⟨a + b, ?_⟩
    rw [Function.iterate_add_apply]
    refine (Dp_iterate_mono p a ?_).trans ha
    have : ((Dp p)^[b] M).map π = ⊥ := by
      rw [map_Dp_iterate, map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective R)]
      exact le_bot_iff.1 hb
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
    exact this
  have hMR : M ≤ R := le_pSolRad hM
  rw [eq_bot_iff]
  intro y hy
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective R y
  rw [mem_bot]
  exact (QuotientGroup.eq_one_iff x).2 (hMR hy)

end Radical

/-! ### Products of simple groups of order divisible by `p`, and the series -/

section Series

universe u

variable (p : ℕ)

/-- `Y` is (isomorphic to) a finite direct product of nonabelian simple groups of order divisible
by `p`. -/
def IsSemisimplePProd (Y : Type u) [Group Y] : Prop :=
  ∃ (ι : Type u) (S : ι → Type u) (_ : ∀ i, Group (S i)), Finite ι ∧
    (∀ i, IsSimpleGroup (S i)) ∧ (∀ i, ∃ a b : S i, a * b ≠ b * a) ∧
    (∀ i, p ∣ Nat.card (S i)) ∧ Nonempty (Y ≃* ∀ i, S i)

variable {p}

lemma IsSemisimplePProd.of_mulEquiv {Y Z : Type u} [Group Y] [Group Z] (e : Y ≃* Z)
    (h : IsSemisimplePProd p Z) : IsSemisimplePProd p Y := by
  obtain ⟨ι, S, _, h1, h2, h3, h4, ⟨f⟩⟩ := h
  exact ⟨ι, S, _, h1, h2, h3, h4, ⟨e.trans f⟩⟩

/-- A trivial group is an empty product. -/
lemma isSemisimplePProd_of_subsingleton {Y : Type u} [Group Y] [Subsingleton Y] :
    IsSemisimplePProd p Y := by
  refine ⟨PEmpty, fun _ => PUnit, fun _ => inferInstance, inferInstance, fun i => i.elim,
    fun i => i.elim, fun i => i.elim, ⟨?_⟩⟩
  exact { toFun := fun _ => fun i => i.elim, invFun := fun _ => 1,
          left_inv := fun _ => Subsingleton.elim _ _, right_inv := fun _ => funext fun i => i.elim,
          map_mul' := fun _ _ => funext fun i => i.elim }

variable (p) {X : Type u} [Group X]

/-- The section `B/A` is a direct product of nonabelian simple groups of order divisible by
`p`. -/
def SemisimplePFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, IsSemisimplePProd p (B ⧸ A.subgroupOf B)

/-- A normal series `N = G₀ ≤ ⋯ ≤ G_{2h+1} = X` whose factors `G_{2i+1}/G_{2i}` are
`p`-soluble and whose factors `G_{2i+2}/G_{2i+1}` are direct products of nonabelian simple groups
of order divisible by `p`. For `N = 1` these are the series defining `λ_p(X)`. -/
structure NSeriesP (X : Type u) [Group X] (N : Subgroup X) (h : ℕ) where
  G : ℕ → Subgroup X
  normal : ∀ i, (G i).Normal
  mono : ∀ i < 2 * h + 1, G i ≤ G (i + 1)
  zero : G 0 = N
  top : G (2 * h + 1) = ⊤
  psol : ∀ i ≤ h, PSolSec p (G (2 * i)) (G (2 * i + 1))
  semisimple : ∀ i < h, SemisimplePFactor p (G (2 * i + 1)) (G (2 * i + 2))

/-- `λ_p(X) ≤ h`: the non-`p`-soluble length of `X` is at most `h`. -/
def NonPSolubleLengthLE (X : Type u) [Group X] (h : ℕ) : Prop := Nonempty (NSeriesP p X ⊥ h)

variable {p} [hp : Fact p.Prime] [Finite X]

section Comap

variable {Y : Type u} [Group Y] [Finite Y] (f : X →* Y) (hf : Function.Surjective f)
include hf

lemma semisimplePFactor_comap {A B : Subgroup Y} [A.Normal] (h : SemisimplePFactor p A B) :
    SemisimplePFactor p (A.comap f) (B.comap f) := by
  obtain ⟨_, h⟩ := h
  exact ⟨inferInstance,
    h.of_mulEquiv (CFSGOutside.NonsolubleLength.comapFactorEquiv f hf A B)⟩

/-- Pull back a series of `Y` along a surjection `f : X → Y`. -/
def NSeriesP.comap {h : ℕ} (s : NSeriesP p Y ⊥ h) : NSeriesP p X f.ker h where
  G i := (s.G i).comap f
  normal i := (s.normal i).comap f
  mono i hi := comap_mono (s.mono i hi)
  zero := by rw [s.zero]; rfl
  top := by rw [s.top, comap_top]
  psol i hi := pSolSec_comap f hf (s.psol i hi)
  semisimple i hi := by
    haveI := s.normal (2 * i + 1)
    exact semisimplePFactor_comap f hf (s.semisimple i hi)

end Comap

/-- Prepend a `p`-soluble normal subgroup at the bottom of a series. -/
def NSeriesP.prependPSoluble {N : Subgroup X} {h : ℕ} (s : NSeriesP p X N h)
    (hN : PSoluble p N) : NSeriesP p X ⊥ h where
  G i := match i with
    | 0 => ⊥
    | j + 1 => s.G (j + 1)
  normal i := match i with
    | 0 => normal_bot
    | j + 1 => s.normal (j + 1)
  mono i hi := match i with
    | 0 => bot_le
    | j + 1 => s.mono (j + 1) hi
  zero := rfl
  top := s.top
  psol i hi := match i with
    | 0 => by
      show PSolSec p ⊥ (s.G 1)
      have := s.psol 0 (Nat.zero_le _)
      rw [show 2 * 0 = 0 from rfl, s.zero] at this
      exact hN.trans this
    | j + 1 => s.psol (j + 1) hi
  semisimple i hi := s.semisimple i hi

/-- Prepend a block `1 ≤ A ≤ B ≤ N` (with `A` `p`-soluble, `B/A` semisimple of order divisible by
`p` and `N/B` `p`-soluble), raising the number of semisimple factors by one. -/
def NSeriesP.prependBlock {N A B : Subgroup X} {h : ℕ} (s : NSeriesP p X N h) [hA : A.Normal]
    [hB : B.Normal] (hAB : A ≤ B) (hBN : B ≤ N) (hAsol : PSoluble p A)
    (hss : SemisimplePFactor p A B) (hNB : PSolSec p B N) : NSeriesP p X ⊥ (h + 1) where
  G i := match i with
    | 0 => ⊥
    | 1 => A
    | 2 => B
    | j + 3 => s.G (j + 1)
  normal i := match i with
    | 0 => normal_bot
    | 1 => hA
    | 2 => hB
    | j + 3 => s.normal (j + 1)
  mono i hi := match i with
    | 0 => bot_le
    | 1 => hAB
    | 2 => hBN.trans (by have := s.mono 0 (by omega); rwa [s.zero] at this)
    | j + 3 => s.mono (j + 1) (by omega)
  zero := rfl
  top := s.top
  psol i hi := match i with
    | 0 => hAsol
    | 1 => by
      show PSolSec p B (s.G 1)
      have := s.psol 0 (Nat.zero_le _)
      rw [show 2 * 0 = 0 from rfl, s.zero] at this
      exact hNB.trans this
    | j + 2 => s.psol (j + 1) (by omega)
  semisimple i hi := match i with
    | 0 => hss
    | j + 1 => s.semisimple j (by omega)

variable (p X) in
/-- A `p`-soluble group has non-`p`-soluble length `0`. -/
lemma nonPSolubleLengthLE_zero_of_pSoluble (h : PSoluble p (⊤ : Subgroup X)) :
    NonPSolubleLengthLE p X 0 := by
  refine ⟨{ G := fun i => match i with
              | 0 => ⊥
              | _ + 1 => ⊤
            normal := fun i => match i with
              | 0 => normal_bot
              | _ + 1 => normal_top
            mono := fun i _ => match i with
              | 0 => bot_le
              | _ + 1 => le_rfl
            zero := rfl
            top := rfl
            psol := fun i hi => ?_
            semisimple := fun i hi => absurd hi (Nat.not_lt_zero _) }⟩
  obtain rfl : i = 0 := Nat.le_zero.1 hi
  exact h

/-- Monotonicity of the bound: pad with trivial factors at the top. -/
lemma NonPSolubleLengthLE.mono {h h' : ℕ} (hh : h ≤ h') (hX : NonPSolubleLengthLE p X h) :
    NonPSolubleLengthLE p X h' := by
  obtain ⟨s⟩ := hX
  refine ⟨{ G := fun i => if i ≤ 2 * h + 1 then s.G i else ⊤
            normal := fun i => by split_ifs; exacts [s.normal i, normal_top]
            mono := fun i hi => by
              split_ifs with h1 h2 h2
              · exact s.mono i (by omega)
              · exact le_top
              · omega
              · exact le_rfl
            zero := by simp [s.zero]
            top := by
              split_ifs with h1
              · have : 2 * h' + 1 = 2 * h + 1 := by omega
                rw [this]; exact s.top
              · rfl
            psol := fun i hi => by
              split_ifs with h1 h2 h2
              · exact s.psol i (by omega)
              · omega
              · omega
              · exact pSolSec_of_le le_rfl
            semisimple := fun i hi => by
              have htriv : SemisimplePFactor p (⊤ : Subgroup X) ⊤ := by
                haveI : ((⊤ : Subgroup X).subgroupOf (⊤ : Subgroup X)).Normal := by
                  rw [subgroupOf_self]; exact normal_top
                haveI : Subsingleton ((⊤ : Subgroup X) ⧸ (⊤ : Subgroup X).subgroupOf ⊤) := by
                  rw [subgroupOf_self]; exact QuotientGroup.subsingleton_quotient_top
                exact ⟨inferInstance, isSemisimplePProd_of_subsingleton⟩
              split_ifs with h1 h2 h2
              · exact s.semisimple i (by omega)
              · have : 2 * i + 1 = 2 * h + 1 := by omega
                rw [this, s.top]; exact htriv
              · omega
              · exact htriv }⟩

end Series

/-! ### The `p`-kernel subgroup and Lemma 2.1 (Khukhro–Shumyatsky) -/

section Kernel

open CFSGOutside.Corpus CFSGOutside.Corpus.LocalCores
open CFSGOutside.NonsolubleLength (kernelOf mem_kernelOf components factorFamily_components
  dA_kernel_le_layer nonab_component kernelOf_components_normal)

variable {p : ℕ} [hp : Fact p.Prime] {G : Type} [Group G] [Finite G]

/-- Change the base of a series along an equality. -/
def NSeriesP.cast {X : Type*} [Group X] {N N' : Subgroup X} {h : ℕ} (s : NSeriesP p X N h)
    (hN : N = N') : NSeriesP p X N' h :=
  { s with zero := s.zero.trans hN }

omit [Finite G] in
/-- The `p'`-core is characteristic. -/
lemma pPrimeCore_map_le {X : Type*} [Group X] [Finite X] (φ : X ≃* X) :
    (pPrimeCore p X).map φ.toMonoidHom ≤ pPrimeCore p X := by
  refine le_sSup ⟨(pPrimeCore_normal).map _ φ.surjective, ?_⟩
  rw [Subgroup.card_map_of_injective φ.injective]
  exact pPrimeCore_coprime_card

omit [Finite G] in
lemma le_pPrimeCore_of_subnormal_aux (n : ℕ) :
    ∀ (X : Type) [Group X] [Finite X], Nat.card X = n → ∀ {A : Subgroup X}, A.IsSubnormal →
      Nat.Coprime p (Nat.card A) → A ≤ pPrimeCore p X := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro X _ _ hcard A hA hcop
  rcases hA.lt_normal with rfl | ⟨M, hMn, hAM, hMlt⟩
  · exact le_sSup ⟨normal_top, hcop⟩
  · have hMcard : Nat.card M < n := by
      rw [← hcard, ← Subgroup.card_top (G := X)]
      exact Subgroup.card_lt_of_lt hMlt
    have hcop' : Nat.Coprime p (Nat.card (A.subgroupOf M)) := by
      rwa [Nat.card_congr (subgroupOfEquivOfLe hAM).toEquiv]
    have h1 := ih _ hMcard M rfl hA.subgroupOf hcop'
    haveI := hMn
    haveI : (pPrimeCore p M).Characteristic :=
      (characteristic_iff_map_le).2 fun φ => pPrimeCore_map_le φ
    have h2 : (pPrimeCore p M).map M.subtype ≤ pPrimeCore p X := by
      refine le_sSup ⟨ConjAct.normal_of_characteristic_of_normal, ?_⟩
      rw [Subgroup.card_map_of_injective M.subtype_injective]
      exact pPrimeCore_coprime_card
    intro x hx
    exact h2 ⟨⟨x, hAM hx⟩, h1 hx, rfl⟩

omit [Finite G] in
/-- A subnormal `p'`-subgroup lies in the `p'`-core. Proved here; in the corpus it is
`CFSG.GH74.GLS.le_pPrimeCore_of_subnormal` (`CFSG/GH74/GLS/AssemblyComponents.lean` line 62). -/
lemma le_pPrimeCore_of_subnormal {X : Type} [Group X] [Finite X] {A : Subgroup X}
    (hA : A.IsSubnormal) (hcop : Nat.Coprime p (Nat.card A)) : A ≤ pPrimeCore p X :=
  le_pPrimeCore_of_subnormal_aux _ X rfl hA hcop

/-- `F(G/R_p(G)) = 1`. -/
lemma fittingSubgroup_quotient_pSolRad_eq_bot : fittingSubgroup (G ⧸ pSolRad p G) = ⊥ := by
  rw [fittingSubgroup, sSup_eq_bot]
  rintro N ⟨hN, hNnil⟩
  haveI := hN
  haveI := hNnil
  exact eq_bot_of_normal_pSoluble_quotient (pSoluble_of_isSolvable inferInstance)

/-- Every component of `G/R_p(G)` has order divisible by `p`. -/
lemma p_dvd_card_component {C : Subgroup (G ⧸ pSolRad p G)} (hC : IsComponent C) :
    p ∣ Nat.card C := by
  by_contra hnd
  have hcop : Nat.Coprime p (Nat.card C) := (Nat.Prime.coprime_iff_not_dvd hp.out).2 hnd
  have hle := le_pPrimeCore_of_subnormal hC.2 hcop
  have hO : pPrimeCore p (G ⧸ pSolRad p G) = ⊥ := by
    haveI : (pPrimeCore p (G ⧸ pSolRad p G)).Normal := pPrimeCore_normal
    exact eq_bot_of_normal_pSoluble_quotient (pSoluble_of_coprime pPrimeCore_coprime_card)
  rw [hO] at hle
  obtain ⟨a, b, hab⟩ := nonab_component fittingSubgroup_quotient_pSolRad_eq_bot ⟨C, hC⟩
  apply hab
  have h1 : a = 1 := Subtype.ext (by simpa using hle a.2)
  have h2 : b = 1 := Subtype.ext (by simpa using hle b.2)
  rw [h1, h2]

/-- The layer of `G/R_p(G)` is a direct product of nonabelian simple groups of order divisible
by `p`. -/
lemma semisimplePFactor_layer :
    SemisimplePFactor p (⊥ : Subgroup (G ⧸ pSolRad p G)) (layer (G ⧸ pSolRad p G)) := by
  set Y := G ⧸ pSolRad p G
  have hF : fittingSubgroup Y = ⊥ := fittingSubgroup_quotient_pSolRad_eq_bot
  refine ⟨inferInstance, ?_⟩
  have hZ : ∀ C : ComponentIndex Y, center C.1 = ⊥ := fun C => component_center_eq_bot hF C.2
  let e1 : (layer Y ⧸ (⊥ : Subgroup Y).subgroupOf (layer Y)) ≃* layer Y :=
    (QuotientGroup.quotientMulEquivOfEq (bot_subgroupOf _)).trans QuotientGroup.quotientBot
  refine IsSemisimplePProd.of_mulEquiv
    (e1.trans (layerEquiv hZ).symm) ?_
  exact ⟨ComponentIndex Y, fun C => C.1, fun C => inferInstance, inferInstance,
    fun C => component_isSimple hF C.2, nonab_component hF, fun C => p_dvd_card_component C.2,
    ⟨MulEquiv.refl _⟩⟩

/-- **Khukhro–Shumyatsky, Israel J. Math., Lemma 2.1** (via the Schreier conjecture), in the
form of a reduction: with `Y = G/R_p(G)` and `K` the kernel of the action of `Y` on its
components, `λ_p(Y/K) ≤ h` implies `λ_p(G) ≤ h + 1`. -/
theorem nonPSolubleLengthLE_succ_of_quotient_kernel [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    {h : ℕ} (hK : NonPSolubleLengthLE p ((G ⧸ pSolRad p G) ⧸
      kernelOf (components (G ⧸ pSolRad p G))) h) :
    NonPSolubleLengthLE p G (h + 1) := by
  set R := pSolRad p G
  set Y := G ⧸ R
  have hF : fittingSubgroup Y = ⊥ := fittingSubgroup_quotient_pSolRad_eq_bot
  set K := kernelOf (components Y)
  haveI : (layer Y).Normal := (factorFamily_components hF).normal
  obtain ⟨s⟩ := hK
  have sY := (s.comap (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K)).cast
    (QuotientGroup.ker_mk' K)
  have hVK : layer Y ≤ K := fun v hv => mem_kernelOf.2 fun S hS =>
    (factorFamily_components hF).normalizes S hS hv
  obtain ⟨k, hk⟩ := dA_kernel_le_layer hF hCFSG
  have sY' := sY.prependBlock (A := ⊥) (B := layer Y) bot_le hVK ⟨0, le_rfl⟩
    semisimplePFactor_layer (pSolSec_of_dA hk)
  have sX := (sY'.comap (QuotientGroup.mk' R) (QuotientGroup.mk'_surjective R)).cast
    (QuotientGroup.ker_mk' R)
  exact ⟨sX.prependPSoluble pSoluble_pSolRad⟩

variable (p G) in
/-- The `p`-kernel subgroup `K_p(G)`: the full preimage in `G` of the kernel of the conjugation
action of `G/R_p(G)` on its components (the simple factors of the socle of `G/R_p(G)`). -/
def pKernel : Subgroup G :=
  (kernelOf (components (G ⧸ pSolRad p G))).comap (QuotientGroup.mk' (pSolRad p G))

instance pKernel_normal : (pKernel p G).Normal := by
  unfold pKernel; infer_instance

lemma pSolRad_le_pKernel : pSolRad p G ≤ pKernel p G := fun x hx => by
  show QuotientGroup.mk' (pSolRad p G) x ∈ kernelOf (components (G ⧸ pSolRad p G))
  rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff x).2 hx]
  exact one_mem _

/-- Transport `λ_p ≤ h` along a group isomorphism. -/
lemma NonPSolubleLengthLE.of_mulEquiv {X Y : Type} [Group X] [Group Y] [Finite X] [Finite Y]
    (e : X ≃* Y) {h : ℕ} (hY : NonPSolubleLengthLE p Y h) : NonPSolubleLengthLE p X h := by
  obtain ⟨s⟩ := hY
  have hk : e.toMonoidHom.ker = ⊥ := (MonoidHom.ker_eq_bot_iff _).2 e.injective
  exact ⟨(s.comap e.toMonoidHom e.surjective).cast hk⟩

/-- **Khukhro–Shumyatsky, Israel J. Math., Lemma 2.1** (via the Schreier conjecture):
`K_p(G)` has non-`p`-soluble length at most `1`; in the form used for inductions,
`λ_p(G/K_p(G)) ≤ h → λ_p(G) ≤ h + 1`. -/
theorem nonPSolubleLengthLE_succ_of_pKernel [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    {h : ℕ} (hK : NonPSolubleLengthLE p (G ⧸ pKernel p G) h) :
    NonPSolubleLengthLE p G (h + 1) := by
  apply nonPSolubleLengthLE_succ_of_quotient_kernel hCFSG
  set R := pSolRad p G
  set K := kernelOf (components (G ⧸ R))
  have hmap : (pKernel p G).map (QuotientGroup.mk' R) = K :=
    map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective R) _
  let e : (G ⧸ R) ⧸ (pKernel p G).map (QuotientGroup.mk' R) ≃* G ⧸ pKernel p G :=
    QuotientGroup.quotientQuotientEquivQuotient R (pKernel p G) pSolRad_le_pKernel
  exact NonPSolubleLengthLE.of_mulEquiv
    ((QuotientGroup.quotientMulEquivOfEq hmap).symm.trans e) hK

end Kernel

/-! ### Normal subgroups of semisimple products, and intersecting series -/

section Normal

universe u

variable {p : ℕ}

lemma center_eq_bot_of_simple_nonab {S : Type*} [Group S] [IsSimpleGroup S]
    (hnab : ∃ a b : S, a * b ≠ b * a) : Subgroup.center S = ⊥ := by
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (Subgroup.center S) with h | h
  · exact h
  · exfalso
    obtain ⟨a, b, hab⟩ := hnab
    have hb : b ∈ Subgroup.center S := h ▸ Subgroup.mem_top b
    exact hab (Subgroup.mem_center_iff.1 hb a)

open Classical in
/-- A normal subgroup of a finite direct product of nonabelian simple groups is the product of
some of the factors. -/
lemma mem_normal_pi_iff {ι : Type u} [Finite ι] {S : ι → Type u} [∀ i, Group (S i)]
    (hS : ∀ i, IsSimpleGroup (S i)) (hnab : ∀ i, ∃ a b : S i, a * b ≠ b * a)
    (N : Subgroup (∀ i, S i)) [hN : N.Normal] (f : ∀ i, S i) :
    f ∈ N ↔ ∀ i, (¬ ∀ s : S i, Pi.mulSingle i s ∈ N) → f i = 1 := by
  constructor
  · intro hf i hi
    set T : Subgroup (S i) := N.comap (MonoidHom.mulSingle S i)
    haveI : T.Normal := hN.comap _
    haveI := hS i
    have hT : T = ⊥ := by
      rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal T with h | h
      · exact h
      · exfalso; apply hi; intro s
        have : s ∈ T := h ▸ Subgroup.mem_top s
        exact this
    have hcen : f i ∈ Subgroup.center (S i) := by
      rw [Subgroup.mem_center_iff]
      intro s
      have hmem : Pi.mulSingle i s * f * (Pi.mulSingle i s)⁻¹ * f⁻¹ ∈ N :=
        N.mul_mem (hN.conj_mem f hf _) (N.inv_mem hf)
      have heq : Pi.mulSingle i s * f * (Pi.mulSingle i s)⁻¹ * f⁻¹ =
          Pi.mulSingle i (s * f i * s⁻¹ * (f i)⁻¹) := by
        funext j
        by_cases hj : j = i
        · subst hj; simp
        · simp [Pi.mulSingle_eq_of_ne hj]
      rw [heq] at hmem
      have : s * f i * s⁻¹ * (f i)⁻¹ ∈ T := hmem
      rw [hT, Subgroup.mem_bot] at this
      have h2 := mul_inv_eq_one.1 this
      rw [mul_inv_eq_iff_eq_mul] at h2
      exact h2
    rw [center_eq_bot_of_simple_nonab (hnab i), Subgroup.mem_bot] at hcen
    exact hcen
  · intro hf
    set H : ∀ i, Subgroup (S i) := fun i => if ∀ s : S i, Pi.mulSingle i s ∈ N then ⊤ else ⊥
    have hle : Subgroup.pi Set.univ H ≤ N := by
      haveI := Fintype.ofFinite ι
      rw [Subgroup.pi_le_iff]
      intro i
      by_cases hi : ∀ s : S i, Pi.mulSingle i s ∈ N
      · rintro _ ⟨s, -, rfl⟩
        exact hi s
      · simp only [H, if_neg hi, Subgroup.map_bot, bot_le]
    apply hle
    intro i _
    by_cases hi : ∀ s : S i, Pi.mulSingle i s ∈ N
    · simp only [H, if_pos hi]; exact Subgroup.mem_top _
    · simp only [H, if_neg hi, Subgroup.mem_bot]; exact hf i hi

open Classical in
/-- A normal subgroup of a direct product of nonabelian simple groups of order divisible by `p`
is again such a product. -/
lemma IsSemisimplePProd.normal {Y : Type u} [Group Y] (h : IsSemisimplePProd p Y)
    (N : Subgroup Y) [hN : N.Normal] : IsSemisimplePProd p N := by
  obtain ⟨ι, S, _, hfin, hS, hnab, hdvd, ⟨e⟩⟩ := h
  set N' := N.map e.toMonoidHom
  haveI : N'.Normal := hN.map _ e.surjective
  set J : Set ι := {i | ∀ s : S i, Pi.mulSingle i s ∈ N'}
  have hmem := mem_normal_pi_iff hS hnab N'
  let φ : N' ≃* ∀ j : J, S j :=
    { toFun := fun f j => (f : ∀ i, S i) j
      invFun := fun g => ⟨fun i => if hi : i ∈ J then g ⟨i, hi⟩ else 1, (hmem _).2 (by
        intro i hi
        simp only [dif_neg (show i ∉ J from hi)])⟩
      left_inv := fun f => by
        apply Subtype.ext
        funext i
        by_cases hi : i ∈ J
        · simp [dif_pos hi]
        · simp only [dif_neg hi]
          exact ((hmem f).1 f.2 i hi).symm
      right_inv := fun g => by
        funext j
        simp [dif_pos j.2]
      map_mul' := fun a b => rfl }
  haveI : Finite J := inferInstance
  exact ⟨J, fun j => S j, fun j => inferInstance, inferInstance, fun j => hS j, fun j => hnab j,
    fun j => hdvd j, ⟨(N.equivMapOfInjective e.toMonoidHom e.injective).trans φ⟩⟩

variable {X : Type u} [Group X]

/-- Intersecting a semisimple section with a normal subgroup. -/
lemma semisimplePFactor_inf {A B C : Subgroup X} [hA : A.Normal] [B.Normal] [hC : C.Normal]
    (hAB : A ≤ B) (h : SemisimplePFactor p A B) : SemisimplePFactor p (A ⊓ C) (B ⊓ C) := by
  obtain ⟨_, h⟩ := h
  let φ : (B ⊓ C : Subgroup X) →* B ⧸ A.subgroupOf B :=
    (QuotientGroup.mk' (A.subgroupOf B)).comp (Subgroup.inclusion inf_le_left)
  have hker : φ.ker = (A ⊓ C).subgroupOf (B ⊓ C) := by
    ext x
    simp only [φ, MonoidHom.mem_ker, MonoidHom.coe_comp, Function.comp_apply,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, mem_subgroupOf, coe_inclusion,
      mem_inf]
    exact ⟨fun h => ⟨h, x.2.2⟩, fun h => h.1⟩
  haveI : φ.range.Normal := by
    constructor
    rintro _ ⟨x, rfl⟩ y
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective _ y
    refine ⟨⟨b * x * b⁻¹, ⟨B.mul_mem (B.mul_mem b.2 x.2.1) (B.inv_mem b.2),
      hC.conj_mem _ x.2.2 b⟩⟩, ?_⟩
    simp [φ]
    rfl
  haveI : ((A ⊓ C).subgroupOf (B ⊓ C)).Normal := by rw [← hker]; infer_instance
  exact ⟨inferInstance, (h.normal φ.range).of_mulEquiv
    ((QuotientGroup.quotientMulEquivOfEq hker.symm).trans (QuotientGroup.quotientKerEquivRange φ))⟩

end Normal

section Inf

universe u

variable {p : ℕ} [hp : Fact p.Prime] {X : Type u} [Group X] [Finite X]

lemma PSolSec.inf {C D : Subgroup X} (h : PSolSec p C D) (A : Subgroup X) :
    PSolSec p (C ⊓ A) (D ⊓ A) := by
  obtain ⟨n, hn⟩ := h
  exact ⟨n, le_inf ((Dp_iterate_mono p n inf_le_left).trans hn)
    ((Dp_iterate_mono p n inf_le_right).trans (Dp_iterate_le p n A))⟩

/-- **Subdirect products.** If `λ_p ≤ a` above `A` and `λ_p ≤ b` above `B` (series of `X`
starting at the normal subgroups `A`, `B`), then there is a series starting at `A ⊓ B` with
`b + a` semisimple factors. -/
def NSeriesP.inf {A B : Subgroup X} [hA : A.Normal] [hB : B.Normal] {a b : ℕ}
    (sA : NSeriesP p X A a) (sB : NSeriesP p X B b) : NSeriesP p X (A ⊓ B) (b + a) where
  G i := if i ≤ 2 * b then sB.G i ⊓ A else sA.G (i - 2 * b)
  normal i := by
    split_ifs
    · haveI := sB.normal i; infer_instance
    · exact sA.normal _
  mono i hi := by
    by_cases h1 : i + 1 ≤ 2 * b
    · rw [if_pos (by omega), if_pos h1]
      exact inf_le_inf_right _ (sB.mono i (by omega))
    · by_cases h2 : i ≤ 2 * b
      · rw [if_pos h2, if_neg h1]
        have hi' : i = 2 * b := by omega
        have := sA.mono 0 (by omega)
        rw [sA.zero] at this
        refine inf_le_right.trans (this.trans ?_)
        rw [show i + 1 - 2 * b = 1 by omega]
      · rw [if_neg h2, if_neg h1, show i + 1 - 2 * b = (i - 2 * b) + 1 by omega]
        exact sA.mono _ (by omega)
  zero := by rw [if_pos (Nat.zero_le _), sB.zero, inf_comm]
  top := by
    rw [if_neg (by omega), show 2 * (b + a) + 1 - 2 * b = 2 * a + 1 by omega, sA.top]
  psol i hi := by
    by_cases h1 : i < b
    · rw [if_pos (by omega), if_pos (by omega)]
      exact (sB.psol i (by omega)).inf A
    · by_cases h2 : i = b
      · subst h2
        rw [if_pos le_rfl, if_neg (by omega), show 2 * i + 1 - 2 * i = 1 by omega]
        have h1' := (sB.psol i le_rfl).inf A
        rw [sB.top, top_inf_eq] at h1'
        have h2' := sA.psol 0 (Nat.zero_le _)
        rw [show 2 * 0 = 0 from rfl, sA.zero] at h2'
        exact h1'.trans h2'
      · rw [if_neg (by omega), if_neg (by omega),
          show 2 * i - 2 * b = 2 * (i - b) by omega,
          show 2 * i + 1 - 2 * b = 2 * (i - b) + 1 by omega]
        exact sA.psol (i - b) (by omega)
  semisimple i hi := by
    by_cases h1 : i < b
    · rw [if_pos (by omega), if_pos (by omega)]
      haveI := sB.normal (2 * i + 1)
      haveI := sB.normal (2 * i + 2)
      exact semisimplePFactor_inf (sB.mono _ (by omega)) (sB.semisimple i h1)
    · rw [if_neg (by omega), if_neg (by omega),
        show 2 * i + 1 - 2 * b = 2 * (i - b) + 1 by omega,
        show 2 * i + 2 - 2 * b = 2 * (i - b) + 2 by omega]
      exact sA.semisimple (i - b) (by omega)

end Inf

