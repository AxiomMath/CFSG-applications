
import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.Nilpotent
import Mathlib.GroupTheory.Solvable
import CFSGOutside.Common.Components
import CFSGOutside.Corpus.OddOrder
import CFSGOutside.Corpus.Schreier

/-!
# Nonsoluble length of finite groups (Khukhro–Shumyatsky)

**Paper.** E. I. Khukhro and P. Shumyatsky, *Nonsoluble and non-p-soluble length of finite groups*,
Israel J. Math. **207** (2015), DOI 10.1007/s11856-015-1180-x, arXiv:1310.2434.

**Definitions (§1, §2 of the paper).** Every finite group `G` has a normal series
`1 = G₀ ≤ G₁ ≤ ⋯ ≤ G_{2h+1} = G` whose factors `G_{2i+1}/G_{2i}` are soluble and whose factors
`G_{2i+2}/G_{2i+1}` are direct products of nonabelian simple groups.  The *nonsoluble length*
`λ(G)` is the least such `h`.  (The paper's text says "for `i` odd the factor `G_{i+1}/G_i` is
soluble"; with `G_0 = 1` and `2h+1` steps the intended reading, used here, is that the factors
starting at even indices are soluble, giving exactly `h` nonsoluble factors.)
Here: `NSeries G ⊥ h`, `NonsolubleLengthLE G h`, `nonsolubleLength G`.
The Fitting height (`FittingSeries`, `FittingHeightLE`, `fittingHeight`) is the least length of a
normal series with nilpotent factors; the `2`-length (`TwoSeries`, `TwoLengthLE`, `twoLength`) is
the least `l` admitting a normal series `1 = G₀ ≤ ⋯ ≤ G_{2l+1}` whose factors are alternately
`2'`-groups and `2`-groups (equivalently, the least number of `2`-factors in a normal series all of
whose factors are `2`- or `2'`-groups).

**Main results.**
* `nonsolubleLength_le_two_mul_maxTwoLength_add_one` — **Theorem 1.1(a)**:
  `λ(G) ≤ 2 L₂ + 1`, `L₂ = maxTwoLength G` the maximum `2`-length of soluble subgroups.
* `nonsolubleLength_le_maxFittingHeight` — **Corollary 1.2**: `λ(G)` is at most the maximum
  Fitting height of soluble subgroups.
* `nonsolubleLengthLE_of_twoLengthLE`, `nonsolubleLengthLE_of_fittingHeightLE` — the same
  statements in "`∀ h`" form.
* `nonsolubleLengthLE_of_ttLengthLE` — **Theorem 3.3**: `λ(G) ≤ L_{2×2'}(G)`, the maximum
  `(2×2')`-length of soluble subgroups.
All of them are stated for `G : Type`, finite, under the hypothesis
`hCFSG : TauCeti.ClassificationStatement.{0}` (the classification of finite simple groups), which
enters only through the Schreier conjecture, as in the paper.

**What the CFSG corpus supplies.**
* Schreier's conjecture: `CFSG.Schreier.schreierFor_inCatalog_holds`
  (`Out(T)` is soluble for every nonabelian finite simple `T` in the catalog; `hCFSG` places every
  finite simple group in the catalog).
* Feit–Thompson: `OddOrder.isSolvable_of_odd_natCard _`.
* Components and the layer (`CFSG.IsComponent`, `CFSG.layer`, `CFSG.LocalCores.layerMul`, …) and,
  for `F(Y) = 1`, from `CFSG.EvenSporadicStandard.SolomonRed`: components are nonabelian simple,
  pairwise trivially intersecting and permuted by conjugation, and `C_Y(E(Y)) = 1`;
  `Lemma213.layerEquiv`: `E(Y) ≅ ∏ components`.  The layer `E(Y)` of `Y = G/R(G)` is the socle
  `Soc(G/R(G))` of the paper, and the components are its simple factors.
* The soluble radical `CFSG.solvableRadical` and its basic properties.

**Proof route.**  The `(2×2')`-length is handled through an element-wise lower series
`D(S) = O^2(S) ⊓ O^{2'}(S)` (closures of odd-order and of `2`-power-order elements), which commutes
with all homomorphic images (`map_D`); `D^n(S) = 1` iff `S` has `(2×2')`-length `≤ n`.  Theorem 3.3
is proved by induction on `n`: pass to `Y = G/R(G)` (Lemma 3.1), let `K` be the kernel of the
conjugation action of `Y` on its components; `K/E(Y)` is soluble by Schreier (Lemma 2.1), so `K`
contributes one nonsoluble factor; and `L_{2×2'}(Y/K) < L_{2×2'}(Y)` (Lemma 3.2, theorem `key`).
For Lemma 3.2 we use a simplification of the paper's argument which avoids its minimal
counterexample and its recursion: for each prime `q`, with `Q ∈ Syl_q(E)` and `P ∈ Syl_2(N_K(Q))`,
the subgroup `T_q = Q·(N_H(Q) ∩ N_H(P))` is soluble (Feit–Thompson), satisfies `T_q K = H`
(two Frattini arguments) and normalizes `Q`; comparing `q = 2` with all odd `q` gives the result.
-/

universe u

section

namespace CFSGOutside.NonsolubleLength

open CFSGOutside.Corpus CFSGOutside.Corpus.LocalCores

section LowerSeries

open Subgroup
variable {G : Type*} [Group G]

/-- Elements of `2`-power order. -/
def IsTwoElt (x : G) : Prop := ∃ k : ℕ, x ^ (2 ^ k) = 1
/-- Elements of odd order. -/
def IsOddElt (x : G) : Prop := ∃ m : ℕ, Odd m ∧ x ^ m = 1

/-- `O^{2'}(S)`: the subgroup generated by the `2`-elements of `S`. -/
def twoGen (S : Subgroup G) : Subgroup G := closure {x | x ∈ S ∧ IsTwoElt x}
/-- `O^{2}(S)`: the subgroup generated by the elements of odd order of `S`. -/
def oddGen (S : Subgroup G) : Subgroup G := closure {x | x ∈ S ∧ IsOddElt x}
/-- `D(S) = O^2(S) ⊓ O^{2'}(S)`, the smallest normal subgroup of `S` with quotient a direct
product of a `2`-group and a `2'`-group. -/
def D (S : Subgroup G) : Subgroup G := oddGen S ⊓ twoGen S

lemma IsTwoElt.map {H : Type*} [Group H] (f : G →* H) {x : G} (h : IsTwoElt x) :
    IsTwoElt (f x) := by
  obtain ⟨k, hk⟩ := h; exact ⟨k, by rw [← map_pow, hk, map_one]⟩

lemma IsOddElt.map {H : Type*} [Group H] (f : G →* H) {x : G} (h : IsOddElt x) :
    IsOddElt (f x) := by
  obtain ⟨m, hm, hk⟩ := h; exact ⟨m, hm, by rw [← map_pow, hk, map_one]⟩

lemma twoGen_le (S : Subgroup G) : twoGen S ≤ S := (closure_le _).2 fun _ h => h.1
lemma oddGen_le (S : Subgroup G) : oddGen S ≤ S := (closure_le _).2 fun _ h => h.1
lemma D_le (S : Subgroup G) : D S ≤ S := inf_le_left.trans (oddGen_le S)

lemma twoGen_mono {S T : Subgroup G} (h : S ≤ T) : twoGen S ≤ twoGen T :=
  closure_mono fun _ hx => ⟨h hx.1, hx.2⟩
lemma oddGen_mono {S T : Subgroup G} (h : S ≤ T) : oddGen S ≤ oddGen T :=
  closure_mono fun _ hx => ⟨h hx.1, hx.2⟩
lemma D_mono {S T : Subgroup G} (h : S ≤ T) : D S ≤ D T :=
  inf_le_inf (oddGen_mono h) (twoGen_mono h)

lemma D_iterate_le (n : ℕ) (S : Subgroup G) : D^[n] S ≤ S := by
  induction n with
  | zero => exact le_rfl
  | succ n ih => rw [Function.iterate_succ_apply']; exact (D_le _).trans ih

/-- If `x ^ m ∈ H` and `x ^ n ∈ H` with `m, n` coprime, then `x ∈ H`. -/
lemma mem_of_pow_mem_of_coprime {H : Subgroup G} {x : G} {m n : ℕ} (hmn : m.Coprime n)
    (hm : x ^ m ∈ H) (hn : x ^ n ∈ H) : x ∈ H := by
  have hb := Nat.gcd_eq_gcd_ab m n
  rw [hmn, Nat.cast_one] at hb
  have : x = (x ^ m) ^ (m.gcdA n) * (x ^ n) ^ (m.gcdB n) := by
    rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, ← zpow_add,
      show (m : ℤ) * m.gcdA n + n * m.gcdB n = 1 from hb.symm, zpow_one]
  rw [this]
  exact mul_mem (zpow_mem hm _) (zpow_mem hn _)

lemma odd_two_pow_coprime {m : ℕ} (hm : Odd m) (k : ℕ) : m.Coprime (2 ^ k) :=
  Nat.Coprime.pow_right k (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2
    (by rwa [← even_iff_two_dvd, Nat.not_even_iff_odd])))

variable [Finite G]

/-- Every element has an odd power which is a `2`-element and a `2`-power power which has odd
order. -/
lemma exists_odd_pow_isTwoElt (x : G) : ∃ m, Odd m ∧ IsTwoElt (x ^ m) := by
  obtain ⟨a, m, hm, h⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos x).ne'
  exact ⟨m, hm, a, by rw [← pow_mul, mul_comm, ← h, pow_orderOf_eq_one]⟩

lemma exists_two_pow_isOddElt (x : G) : ∃ k, IsOddElt (x ^ (2 ^ k)) := by
  obtain ⟨a, m, hm, h⟩ := Nat.exists_eq_two_pow_mul_odd (orderOf_pos x).ne'
  exact ⟨a, m, hm, by rw [← pow_mul, ← h, pow_orderOf_eq_one]⟩

section Map

variable {G' : Type*} [Group G']

lemma map_twoGen (f : G →* G') (S : Subgroup G) : (twoGen S).map f = twoGen (S.map f) := by
  apply le_antisymm
  · rw [twoGen, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro _ ⟨x, ⟨hxS, hx⟩, rfl⟩
    exact ⟨mem_map_of_mem f hxS, hx.map f⟩
  · rw [twoGen, closure_le]
    rintro y ⟨⟨x, hxS, rfl⟩, k, hk⟩
    obtain ⟨m, hm, hxm⟩ := exists_odd_pow_isTwoElt x
    have h1 : f (x ^ m) ∈ (twoGen S).map f :=
      mem_map_of_mem f (subset_closure ⟨pow_mem hxS m, hxm⟩)
    have h2 : (f x) ^ (2 ^ k) ∈ (twoGen S).map f := by rw [hk]; exact one_mem _
    rw [map_pow] at h1
    exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime hm k) h1 h2

lemma map_oddGen (f : G →* G') (S : Subgroup G) : (oddGen S).map f = oddGen (S.map f) := by
  apply le_antisymm
  · rw [oddGen, MonoidHom.map_closure]
    apply Subgroup.closure_mono
    rintro _ ⟨x, ⟨hxS, hx⟩, rfl⟩
    exact ⟨mem_map_of_mem f hxS, hx.map f⟩
  · rw [oddGen, closure_le]
    rintro y ⟨⟨x, hxS, rfl⟩, m, hm, hk⟩
    obtain ⟨k, hxk⟩ := exists_two_pow_isOddElt x
    have h1 : f (x ^ (2 ^ k)) ∈ (oddGen S).map f :=
      mem_map_of_mem f (subset_closure ⟨pow_mem hxS _, hxk⟩)
    have h2 : (f x) ^ m ∈ (oddGen S).map f := by rw [hk]; exact one_mem _
    rw [map_pow] at h1
    exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime hm k) h2 h1

lemma map_D (f : G →* G') (S : Subgroup G) : (D S).map f = D (S.map f) := by
  apply le_antisymm
  · refine (map_inf_le _ _ _).trans ?_
    rw [map_oddGen, map_twoGen]; rfl
  · intro x hx
    have hx1 : x ∈ (oddGen S).map f := by rw [map_oddGen]; exact hx.1
    have hx2 : x ∈ (twoGen S).map f := by rw [map_twoGen]; exact hx.2
    obtain ⟨a, ha, rfl⟩ := hx1
    obtain ⟨b, hb, hab⟩ := hx2
    obtain ⟨m, hm, ham⟩ := exists_odd_pow_isTwoElt a
    obtain ⟨k, hbk⟩ := exists_two_pow_isOddElt b
    have h1 : a ^ m ∈ D S := ⟨pow_mem ha m, subset_closure ⟨pow_mem (oddGen_le S ha) m, ham⟩⟩
    have h2 : b ^ (2 ^ k) ∈ D S := ⟨subset_closure ⟨pow_mem (twoGen_le S hb) _, hbk⟩,
      pow_mem hb _⟩
    have h1' : f a ^ m ∈ (D S).map f := by rw [← map_pow]; exact mem_map_of_mem f h1
    have h2' : f a ^ (2 ^ k) ∈ (D S).map f := by
      rw [← hab, ← map_pow]; exact mem_map_of_mem f h2
    exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime hm k) h1' h2'

lemma map_D_iterate (f : G →* G') (n : ℕ) (S : Subgroup G) :
    (D^[n] S).map f = D^[n] (S.map f) := by
  induction n generalizing S with
  | zero => rfl
  | succ n ih => simp only [Function.iterate_succ_apply, ih, map_D]

end Map

lemma map_conj_eq_of_mem_normalizer {S : Subgroup G} {g : G}
    (hg : g ∈ normalizer (S : Set G)) : S.map (MulAut.conj g).toMonoidHom = S := by
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (mem_normalizer_iff.1 hg y).1 hy
  · intro hx
    refine ⟨g⁻¹ * x * g, (mem_normalizer_iff.1 hg _).2 ?_, ?_⟩
    · simpa [mul_assoc] using hx
    · simp [mul_assoc]

lemma mem_normalizer_of_map_conj_eq {S : Subgroup G} {g : G}
    (h : S.map (MulAut.conj g).toMonoidHom = S) : g ∈ normalizer (S : Set G) := by
  rw [mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    rw [← h]
    exact ⟨x, hx, rfl⟩
  · intro hx
    rw [← h] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    have : y = x := by simpa using hxy
    rwa [← this]

lemma normalizer_le_normalizer_D_iterate (n : ℕ) (S : Subgroup G) :
    normalizer (S : Set G) ≤ normalizer ((D^[n] S : Subgroup G) : Set G) := fun g hg =>
  mem_normalizer_of_map_conj_eq (by rw [map_D_iterate, map_conj_eq_of_mem_normalizer hg])

lemma normalizer_le_normalizer_twoGen (S : Subgroup G) :
    normalizer (S : Set G) ≤ normalizer ((twoGen S : Subgroup G) : Set G) := fun g hg =>
  mem_normalizer_of_map_conj_eq (by rw [map_twoGen, map_conj_eq_of_mem_normalizer hg])

lemma normalizer_le_normalizer_oddGen (S : Subgroup G) :
    normalizer (S : Set G) ≤ normalizer ((oddGen S : Subgroup G) : Set G) := fun g hg =>
  mem_normalizer_of_map_conj_eq (by rw [map_oddGen, map_conj_eq_of_mem_normalizer hg])

lemma isOddElt_of_mem_oddGen {S : Subgroup G} (hS : D S = ⊥) {x : G} (hx : x ∈ oddGen S) :
    IsOddElt x := by
  obtain ⟨m, hm, hxm⟩ := exists_odd_pow_isTwoElt x
  have : x ^ m ∈ D S := ⟨pow_mem hx m, subset_closure ⟨pow_mem (oddGen_le S hx) m, hxm⟩⟩
  rw [hS, mem_bot] at this
  exact ⟨m, hm, this⟩

lemma isTwoElt_of_mem_twoGen {S : Subgroup G} (hS : D S = ⊥) {x : G} (hx : x ∈ twoGen S) :
    IsTwoElt x := by
  obtain ⟨k, hxk⟩ := exists_two_pow_isOddElt x
  have : x ^ (2 ^ k) ∈ D S := ⟨subset_closure ⟨pow_mem (twoGen_le S hx) _, hxk⟩, pow_mem hx _⟩
  rw [hS, mem_bot] at this
  exact ⟨k, this⟩

/-- An element of odd order which is also a `2`-element is trivial. -/
lemma eq_one_of_isOddElt_of_isTwoElt {x : G} (h1 : IsOddElt x) (h2 : IsTwoElt x) : x = 1 := by
  obtain ⟨m, hm, hx⟩ := h1
  obtain ⟨k, hk⟩ := h2
  exact (pow_eq_one_iff_of_coprime (odd_two_pow_coprime hm k)).1 ⟨hx, hk⟩

/-- Coprime commutation: an odd-order element normalizing a subgroup of `2`-elements, which in
turn normalizes a subgroup of odd-order elements containing it, commutes with its elements. -/
lemma commute_of_odd_two {B Q : Subgroup G} (hB : ∀ b ∈ B, IsOddElt b)
    (hQ : ∀ x ∈ Q, IsTwoElt x) {b x : G} (hb : b ∈ B) (hx : x ∈ Q)
    (hbQ : b ∈ normalizer (Q : Set G)) (hxB : x ∈ normalizer (B : Set G)) : b * x = x * b := by
  have hc1 : b * x * b⁻¹ * x⁻¹ ∈ Q :=
    mul_mem ((mem_normalizer_iff.1 hbQ x).1 hx) (inv_mem hx)
  have hc2 : b * x * b⁻¹ * x⁻¹ ∈ B := by
    have : x * b⁻¹ * x⁻¹ ∈ B := (mem_normalizer_iff.1 hxB _).1 (inv_mem hb)
    simpa [mul_assoc] using mul_mem hb this
  have := eq_one_of_isOddElt_of_isTwoElt (hB _ hc2) (hQ _ hc1)
  rw [mul_inv_eq_one, mul_inv_eq_iff_eq_mul] at this
  exact this

section Bridges

variable {M N : Subgroup G} [hN : (N.subgroupOf M).Normal]

lemma pow_mem_of_mk_pow {x : G} (hx : x ∈ M) {k : ℕ}
    (h : (QuotientGroup.mk (⟨x, hx⟩ : M) : M ⧸ N.subgroupOf M) ^ k = 1) : x ^ k ∈ N := by
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_subgroupOf] at h
  simpa using h

lemma D_le_of_isPGroup_two (h : IsPGroup 2 (M ⧸ N.subgroupOf M)) : D M ≤ N := by
  refine inf_le_left.trans ((closure_le _).2 ?_)
  rintro y ⟨hy, m, hm, hym⟩
  obtain ⟨k, hk⟩ := h (QuotientGroup.mk ⟨y, hy⟩)
  exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime hm k) (by rw [hym]; exact one_mem _)
    (pow_mem_of_mk_pow hy hk)

lemma D_le_of_odd_card (h : Odd (Nat.card (M ⧸ N.subgroupOf M))) : D M ≤ N := by
  refine inf_le_right.trans ((closure_le _).2 ?_)
  rintro y ⟨hy, k, hk⟩
  have : (QuotientGroup.mk ⟨y, hy⟩ : M ⧸ N.subgroupOf M) ^ Nat.card (M ⧸ N.subgroupOf M) = 1 :=
    pow_card_eq_one'
  exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime h k) (pow_mem_of_mk_pow hy this)
    (by rw [hk]; exact one_mem _)

end Bridges

/-- A finite nilpotent group is a direct product of a `2`-group and a `2'`-group: `D(Z) = 1`. -/
lemma D_top_eq_bot_of_isNilpotent (Z : Type*) [Group Z] [Finite Z] [Group.IsNilpotent Z] :
    D (⊤ : Subgroup Z) = ⊥ := by
  obtain ⟨e⟩ := ((Group.isNilpotent_of_finite_tfae (G := Z)).out 1 5).1 ‹_›
  rw [eq_bot_iff]
  intro x hx
  rw [mem_bot, ← e.apply_symm_apply x]
  suffices h : e.symm x = 1 by rw [h, map_one]
  funext p P
  have hp : (p : ℕ).Prime := Nat.prime_of_mem_primeFactors p.2
  let φ : Z →* (P : Subgroup Z) :=
    (Pi.evalMonoidHom (fun Q : Sylow p Z => ((Q : Subgroup Z) : Type _)) P).comp
      ((Pi.evalMonoidHom (fun q : (Nat.card Z).primeFactors =>
        ∀ Q : Sylow q Z, ((Q : Subgroup Z) : Type _)) p).comp e.symm.toMonoidHom)
  change φ x = 1
  have hPp : IsPGroup p (P : Subgroup Z) := P.isPGroup'
  by_cases h2 : (p : ℕ) = 2
  · have : oddGen (⊤ : Subgroup Z) ≤ φ.ker := by
      rw [oddGen, closure_le]
      rintro y ⟨-, m, hm, hy⟩
      obtain ⟨k, hk⟩ := hPp (φ y)
      have hc : m.Coprime ((p : ℕ) ^ k) := by rw [h2]; exact odd_two_pow_coprime hm k
      exact (pow_eq_one_iff_of_coprime hc).1
        ⟨by rw [← map_pow, hy, map_one], hk⟩
    exact this hx.1
  · have : twoGen (⊤ : Subgroup Z) ≤ φ.ker := by
      rw [twoGen, closure_le]
      rintro y ⟨-, k, hy⟩
      obtain ⟨j, hj⟩ := hPp (φ y)
      have hcop : (2 ^ k).Coprime ((p : ℕ) ^ j) :=
        Nat.Coprime.pow _ _ ((Nat.coprime_primes Nat.prime_two hp).2 (Ne.symm h2))
      exact (pow_eq_one_iff_of_coprime hcop).1 ⟨by rw [← map_pow, hy, map_one], hj⟩
    exact this hx.2

lemma map_subtype_top (M : Subgroup G) : (⊤ : Subgroup M).map M.subtype = M := by
  rw [← MonoidHom.range_eq_map, range_subtype]

lemma D_le_of_isNilpotent {M N : Subgroup G} [(N.subgroupOf M).Normal]
    (h : Group.IsNilpotent (M ⧸ N.subgroupOf M)) : D M ≤ N := by
  let π := QuotientGroup.mk' (N.subgroupOf M)
  have h1 : (D (⊤ : Subgroup M)).map π = ⊥ := by
    rw [map_D, map_top_of_surjective π (QuotientGroup.mk'_surjective _)]
    exact D_top_eq_bot_of_isNilpotent _
  have h2 : D (⊤ : Subgroup M) ≤ N.subgroupOf M := by
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h1
    exact h1
  rw [← map_subtype_top M, ← map_D]
  rintro x ⟨y, hy, rfl⟩
  exact h2 hy

/-! ### Solubility of sections, computed in the ambient group -/

/-- The derived series of a subgroup, computed in the ambient group. -/
def dA : ℕ → Subgroup G → Subgroup G
  | 0, M => M
  | k + 1, M => ⁅dA k M, dA k M⁆

lemma dA_mono (k : ℕ) {M M' : Subgroup G} (h : M ≤ M') : dA k M ≤ dA k M' := by
  induction k with
  | zero => exact h
  | succ k ih => exact commutator_mono ih ih

lemma dA_le (k : ℕ) (M : Subgroup G) : dA k M ≤ M := by
  induction k with
  | zero => exact le_rfl
  | succ k ih =>
    refine (commutator_le.2 fun a ha b hb => ?_).trans ih
    rw [commutatorElement_def]
    exact mul_mem (mul_mem (mul_mem ha hb) (inv_mem ha)) (inv_mem hb)

lemma dA_add (a b : ℕ) (M : Subgroup G) : dA (a + b) M = dA a (dA b M) := by
  induction a with
  | zero => simp [dA]
  | succ a ih => rw [Nat.succ_add, dA, ih, dA]

lemma map_dA {G' : Type*} [Group G'] (f : G →* G') (k : ℕ) (M : Subgroup G) :
    (dA k M).map f = dA k (M.map f) := by
  induction k with
  | zero => rfl
  | succ k ih => rw [dA, map_commutator, ih, dA]

lemma map_subtype_derivedSeries (M : Subgroup G) (k : ℕ) :
    (derivedSeries M k).map M.subtype = dA k M := by
  induction k with
  | zero => rw [derivedSeries_zero, map_subtype_top]; rfl
  | succ k ih => rw [derivedSeries_succ, map_commutator, ih, dA]

lemma isSolvable_quotient_iff {M N : Subgroup G} [(N.subgroupOf M).Normal] :
    Group.IsSolvable (M ⧸ N.subgroupOf M) ↔ ∃ k, dA k M ≤ N := by
  rw [isSolvable_def]
  refine exists_congr fun k => ?_
  rw [← map_derivedSeries_eq (QuotientGroup.mk'_surjective (N.subgroupOf M)), Subgroup.map_eq_bot_iff,
    QuotientGroup.ker_mk', ← map_subtype_derivedSeries, map_le_iff_le_comap]
  rfl

lemma isSolvable_subgroup_iff (M : Subgroup G) :
    Group.IsSolvable M ↔ ∃ k, dA k M = ⊥ := by
  rw [isSolvable_def]
  refine exists_congr fun k => ?_
  rw [← map_subtype_derivedSeries, ← map_bot M.subtype,
    (map_injective M.subtype_injective).eq_iff]

end LowerSeries

section GroupLemmas

open Subgroup
open scoped Pointwise
variable {G : Type u} [Group G] [Finite G]

lemma isSolvable_of_le {X Y : Subgroup G} (h : X ≤ Y) (hY : Group.IsSolvable Y) :
    Group.IsSolvable X := by
  rw [isSolvable_subgroup_iff] at hY ⊢
  obtain ⟨k, hk⟩ := hY
  exact ⟨k, le_bot_iff.1 (hk ▸ dA_mono k h)⟩

/-- **(Feit–Thompson)** A finite group with a normal `2`-subgroup of odd index is soluble. -/
lemma isSolvable_of_normal_two_odd_index [OddOrder.{u}] {X P : Subgroup G} (hPX : P ≤ X) (hP2 : IsPGroup 2 P)
    (hXP : X ≤ normalizer (P : Set G)) (hodd : Odd (P.relIndex X)) : Group.IsSolvable X := by
  haveI : (P.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hPX).2 hXP
  haveI : Group.IsSolvable (X ⧸ P.subgroupOf X) :=
    OddOrder.isSolvable_of_odd_natCard _ (by rwa [relIndex, index] at hodd)
  haveI : Group.IsSolvable (P.subgroupOf X) := by
    haveI := (hP2.of_equiv (subgroupOfEquivOfLe hPX).symm).isNilpotent
    infer_instance
  exact Group.isSolvable_of_subgroup_quotient (P.subgroupOf X)

lemma isSolvable_sup_of_le_normalizer {Q X : Subgroup G} (hQ : Group.IsSolvable Q)
    (hX : Group.IsSolvable X) (hXQ : X ≤ normalizer (Q : Set G)) :
    Group.IsSolvable (Q ⊔ X : Subgroup G) := by
  set Y : Subgroup G := Q ⊔ X
  have hYQ : Y ≤ normalizer (Q : Set G) := sup_le le_normalizer hXQ
  haveI : (Q.subgroupOf Y).Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).2 hYQ
  have e := subgroupOfEquivOfLe (le_sup_left : Q ≤ Y)
  haveI : Group.IsSolvable (Q.subgroupOf Y) :=
    Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective
  have hsurj : Function.Surjective ((QuotientGroup.mk' (Q.subgroupOf Y)).comp
      (inclusion (le_sup_right : X ≤ Y))) := by
    intro z
    obtain ⟨⟨y, hy⟩, rfl⟩ := QuotientGroup.mk'_surjective _ z
    have hy' : y ∈ (X : Set G) * (Q : Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right X Q hXQ, sup_comm]; exact hy
    obtain ⟨x, hx, q, hq, rfl⟩ := hy'
    refine ⟨⟨x, hx⟩, ?_⟩
    simp only [MonoidHom.coe_comp, Function.comp_apply, QuotientGroup.mk'_apply]
    rw [QuotientGroup.eq]
    simpa [mem_subgroupOf] using inv_mem hq
  haveI : Group.IsSolvable (Y ⧸ Q.subgroupOf Y) := Group.isSolvable_of_surjective hsurj
  exact Group.isSolvable_of_subgroup_quotient (Q.subgroupOf Y)

/-- Relative Frattini argument. -/
lemma frattini_rel {p : ℕ} [Fact p.Prime] {A N : Subgroup G} (hNA : N ≤ A)
    (hA : A ≤ normalizer (N : Set G)) (P : Sylow p N) {x : G} (hx : x ∈ A) :
    ∃ b ∈ A ⊓ normalizer (((P : Subgroup N).map N.subtype : Subgroup G) : Set G),
      ∃ n ∈ N, x = b * n := by
  set N0 := N.subgroupOf A
  haveI : N0.Normal := (normal_subgroupOf_iff_le_normalizer hNA).2 hA
  let e := subgroupOfEquivOfLe hNA
  let P0 : Sylow p N0 := P.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  have hP0 : ((P0 : Subgroup N0).map N0.subtype).map A.subtype =
      (P : Subgroup N).map N.subtype := by
    rw [show (P0 : Subgroup N0) = (P : Subgroup N).map e.symm.toMonoidHom from
      Sylow.coe_mapSurjective _ _, map_map, map_map]
    rfl
  have hfr := Sylow.normalizer_sup_eq_top P0
  have hxA : (⟨x, hx⟩ : A) ∈ ((normalizer ((P0 : Subgroup N0).map N0.subtype : Set A) ⊔ N0 :
      Subgroup A) : Set A) := by rw [hfr]; trivial
  rw [mul_normal] at hxA
  obtain ⟨b, hb, n, hn, hbn⟩ := hxA
  refine ⟨b, ⟨b.2, ?_⟩, n, hn, (congrArg Subtype.val hbn).symm⟩
  rw [← hP0]
  exact le_normalizer_map A.subtype ⟨b, hb, rfl⟩

lemma mem_map_conj_iff {S : Subgroup G} {c y : G} :
    y ∈ S.map (MulAut.conj c).toMonoidHom ↔ c⁻¹ * y * c ∈ S := by
  constructor
  · rintro ⟨s, hs, rfl⟩
    simpa [mul_assoc] using hs
  · intro h
    exact ⟨_, h, by simp [mul_assoc]⟩

/-- A Sylow `q`-subgroup of `V` meets every normal subgroup `S` of `V` of order divisible
by `q` nontrivially. -/
lemma exists_ne_one_mem_sylow_inf {q : ℕ} [Fact q.Prime] {V S : Subgroup G} (hSV : S ≤ V)
    (hVS : V ≤ normalizer (S : Set G)) (hdvd : q ∣ Nat.card S) (Q : Sylow q V) :
    ∃ y ∈ (Q : Subgroup V).map V.subtype, y ∈ S ∧ y ≠ 1 := by
  obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' q hdvd
  let z : V := ⟨y, hSV y.2⟩
  have hz : orderOf z = q := by
    rw [← Subgroup.orderOf_coe, ← hy, ← Subgroup.orderOf_coe (a := y)]
  have hp : IsPGroup q (zpowers z) := IsPGroup.of_card (n := 1) (by
    rw [Nat.card_zpowers, hz, pow_one])
  obtain ⟨Q', hQ'⟩ := hp.exists_le_sylow
  obtain ⟨v, hv⟩ := MulAction.exists_smul_eq V Q' Q
  have h1 : MulAut.conj v • z ∈ MulAut.conj v • (Q' : Subgroup V) :=
    Subgroup.smul_mem_pointwise_smul _ _ _ (hQ' (mem_zpowers z))
  rw [← Sylow.coe_subgroup_smul] at h1
  subst hv
  refine ⟨_, mem_map_of_mem V.subtype (show MulAut.conj v • z ∈ ((v • Q' : Sylow q V) :
    Subgroup V) from h1), ?_, ?_⟩
  · simp only [MulAut.smul_def, MulAut.conj_apply, coe_subtype, coe_mul, coe_inv]
    exact (mem_normalizer_iff.1 (hVS v.2) y).1 y.2
  · simp only [MulAut.smul_def, MulAut.conj_apply, coe_subtype, coe_mul, coe_inv, ne_eq,
      mul_inv_eq_one, mul_eq_left]
    intro h
    have : z = 1 := Subtype.ext h
    rw [this, orderOf_one] at hz
    exact (Fact.out : q.Prime).one_lt.ne hz

/-! ### The kernel of the action on a family of simple factors -/

section Kernel

variable (𝒮 : Set (Subgroup G))

/-- The kernel `K = ⋂ N_G(S)` of the conjugation action of `G` on a family `𝒮` of subgroups. -/
def kernelOf : Subgroup G := ⨅ S ∈ 𝒮, normalizer (S : Set G)

variable {𝒮}

lemma mem_kernelOf {x : G} : x ∈ kernelOf 𝒮 ↔ ∀ S ∈ 𝒮, x ∈ normalizer (S : Set G) := by
  simp [kernelOf, mem_iInf]

lemma kernelOf_anti {𝒯 : Set (Subgroup G)} (h : 𝒯 ⊆ 𝒮) : kernelOf 𝒮 ≤ kernelOf 𝒯 :=
  fun _ hx => mem_kernelOf.2 fun S hS => mem_kernelOf.1 hx S (h hS)

lemma conj_comp_conj (a b : G) : (MulAut.conj a).toMonoidHom.comp (MulAut.conj b).toMonoidHom =
    (MulAut.conj (a * b)).toMonoidHom := by
  ext x; simp [mul_assoc]

lemma kernelOf_normal (hconj : ∀ S ∈ 𝒮, ∀ g : G, S.map (MulAut.conj g).toMonoidHom ∈ 𝒮) :
    (kernelOf 𝒮).Normal := by
  refine ⟨fun x hx g => mem_kernelOf.2 fun S hS => ?_⟩
  have h1 := mem_kernelOf.1 hx _ (hconj S hS g⁻¹)
  have h1 := map_conj_eq_of_mem_normalizer h1
  apply mem_normalizer_of_map_conj_eq
  have e : (MulAut.conj (g * x * g⁻¹)).toMonoidHom = (MulAut.conj g).toMonoidHom.comp
      ((MulAut.conj x).toMonoidHom.comp (MulAut.conj g⁻¹).toMonoidHom) := by
    rw [conj_comp_conj, conj_comp_conj, mul_assoc]
  rw [e, ← map_map, ← map_map, h1, map_map, conj_comp_conj, mul_inv_cancel]
  ext y; simp

lemma mem_normalizer_of_commute
    (hconj : ∀ S ∈ 𝒮, ∀ g : G, S.map (MulAut.conj g).toMonoidHom ∈ 𝒮)
    (hdisj : ∀ S ∈ 𝒮, ∀ S' ∈ 𝒮, S ≠ S' → S ⊓ S' = ⊥) {S : Subgroup G} (hS : S ∈ 𝒮)
    {b y : G} (hy : y ∈ S) (hy1 : y ≠ 1) (hby : b * y = y * b) :
    b ∈ normalizer (S : Set G) := by
  apply mem_normalizer_of_map_conj_eq
  by_contra hne
  have hmem : y ∈ S.map (MulAut.conj b).toMonoidHom := by
    rw [mem_map_conj_iff]
    rw [mul_assoc, ← hby, ← mul_assoc, inv_mul_cancel, one_mul]
    exact hy
  have := hdisj _ (hconj S hS b) S hS hne
  have hy' : y ∈ S.map (MulAut.conj b).toMonoidHom ⊓ S := ⟨hmem, hy⟩
  rw [this, mem_bot] at hy'
  exact hy1 hy'

end Kernel

end GroupLemmas

section KernelLemma

open Subgroup
open scoped Pointwise
variable {G : Type u} [Group G] [Finite G]

/-- A conjugation-invariant family `𝒮` of pairwise trivially-intersecting nonsoluble subgroups of
a normal subgroup `V`, each normalized by `V`.  (For `V` a direct product of nonabelian simple
groups `S₁ × ⋯ × Sₘ`, the family `{S₁, …, Sₘ}` is an instance.) -/
structure FactorFamily (𝒮 : Set (Subgroup G)) (V : Subgroup G) : Prop where
  normal : V.Normal
  le : ∀ S ∈ 𝒮, S ≤ V
  normalizes : ∀ S ∈ 𝒮, V ≤ normalizer (S : Set G)
  conj : ∀ S ∈ 𝒮, ∀ g : G, S.map (MulAut.conj g).toMonoidHom ∈ 𝒮
  disj : ∀ S ∈ 𝒮, ∀ S' ∈ 𝒮, S ≠ S' → S ⊓ S' = ⊥
  nonsol : ∀ S ∈ 𝒮, ¬ Group.IsSolvable S

lemma mem_normalizer_inf {A B : Subgroup G} {c : G} (hA : c ∈ normalizer (A : Set G))
    (hB : c ∈ normalizer (B : Set G)) : c ∈ normalizer ((A ⊓ B : Subgroup G) : Set G) := by
  rw [mem_normalizer_iff] at hA hB ⊢
  intro y
  simp only [SetLike.mem_coe, mem_inf] at hA hB ⊢
  rw [hA y, hB y]

lemma mem_of_mk_eq {K M : Subgroup G} [K.Normal] {x y : G}
    (h : (x : G ⧸ K) = (y : G ⧸ K)) (hy : y ∈ M) (hKM : K ≤ M) : x ∈ M := by
  have := QuotientGroup.eq.1 h.symm
  have hx : x = y * (y⁻¹ * x) := by group
  rw [hx]
  exact mul_mem hy (hKM this)

lemma isTwoElt_of_isPGroup {Q : Subgroup G} (hQ : IsPGroup 2 Q) {x : G} (hx : x ∈ Q) :
    IsTwoElt x := by
  obtain ⟨k, hk⟩ := hQ ⟨x, hx⟩
  exact ⟨k, by simpa using congrArg Subtype.val hk⟩

lemma isOddElt_of_isPGroup {q : ℕ} (hq : Odd q) {Q : Subgroup G} (hQ : IsPGroup q Q) {x : G}
    (hx : x ∈ Q) : IsOddElt x := by
  obtain ⟨k, hk⟩ := hQ ⟨x, hx⟩
  exact ⟨q ^ k, hq.pow, by simpa using congrArg Subtype.val hk⟩

lemma two_dvd_card_of_not_isSolvable [OddOrder.{u}] {S : Subgroup G} (hS : ¬ Group.IsSolvable S) :
    2 ∣ Nat.card S := by
  by_contra h
  exact hS (OddOrder.isSolvable_of_odd_natCard _ (Nat.odd_iff.2 (Nat.two_dvd_ne_zero.1 h)))

lemma exists_odd_prime_dvd_card_of_not_isSolvable [OddOrder.{u}] {S : Subgroup G}
    (hS : ¬ Group.IsSolvable S) : ∃ q, q.Prime ∧ Odd q ∧ q ∣ Nat.card S := by
  obtain ⟨e, m, hm, he⟩ := Nat.exists_eq_two_pow_mul_odd (Nat.card_pos (α := S)).ne'
  have hm1 : m ≠ 1 := by
    rintro rfl
    rw [mul_one] at he
    haveI := (IsPGroup.of_card he : IsPGroup 2 S).isNilpotent
    exact hS inferInstance
  refine ⟨m.minFac, Nat.minFac_prime hm1, ?_, ?_⟩
  · exact Odd.of_dvd_nat hm (Nat.minFac_dvd m)
  · rw [he]; exact Dvd.dvd.mul_left (Nat.minFac_dvd m) _

variable {𝒮 : Set (Subgroup G)} {V : Subgroup G}

/-- The subgroup `T` of Lemma 3.2: for a prime `q`, a Sylow `q`-subgroup `Q` of `V`, a Sylow
`2`-subgroup `P` of `N_K(Q)`, and `T = Q · (N_H(Q) ∩ N_H(P))`. -/
lemma exists_T [OddOrder.{u}] (hF : FactorFamily 𝒮 V) {H : Subgroup G} (hKH : kernelOf 𝒮 ≤ H)
    (hsol : ∃ k, dA k H ≤ kernelOf 𝒮) (q : ℕ) [Fact q.Prime] :
    ∃ Q T : Subgroup G, (∀ S ∈ 𝒮, q ∣ Nat.card S → ∃ y ∈ Q, y ∈ S ∧ y ≠ 1) ∧
      IsPGroup q Q ∧ Q ≤ T ∧ T ≤ H ∧ T ≤ normalizer (Q : Set G) ∧ Group.IsSolvable T ∧
      ∀ h ∈ H, ∃ t ∈ T, ∃ k ∈ kernelOf 𝒮, h = t * k := by
  set K := kernelOf 𝒮
  haveI hKn : K.Normal := kernelOf_normal hF.conj
  haveI := hF.normal
  have hVK : V ≤ K := fun v hv => mem_kernelOf.2 fun S hS => hF.normalizes S hS hv
  obtain ⟨Q0⟩ : Nonempty (Sylow q V) := inferInstance
  set Qg : Subgroup G := (Q0 : Subgroup V).map V.subtype
  set NK : Subgroup G := normalizer (Qg : Set G) ⊓ K
  obtain ⟨P0⟩ : Nonempty (Sylow 2 NK) := inferInstance
  set Pg : Subgroup G := (P0 : Subgroup NK).map NK.subtype
  set T0 : Subgroup G := normalizer (Qg : Set G) ⊓ normalizer (Pg : Set G) ⊓ H
  have hQV : Qg ≤ V := map_subtype_le _
  have hQp : IsPGroup q Qg := Q0.isPGroup'.map V.subtype
  have hT0Q : T0 ≤ normalizer (Qg : Set G) := inf_le_left.trans inf_le_left
  -- solubility of `T0`
  have hT0sol : Group.IsSolvable T0 := by
    set L : Subgroup G := normalizer (Pg : Set G) ⊓ NK
    have hPL : Pg ≤ L := le_inf le_normalizer (map_subtype_le _)
    have hLsol : Group.IsSolvable L := by
      refine isSolvable_of_normal_two_odd_index hPL (P0.isPGroup'.map NK.subtype) inf_le_left ?_
      have h1 := relIndex_mul_relIndex Pg L NK hPL inf_le_right
      have h2 : Pg.relIndex NK = (P0 : Subgroup NK).index := by
        show ((P0 : Subgroup NK).map NK.subtype).relIndex NK = _
        rw [relIndex]
        congr 1
        ext y
        simp [mem_subgroupOf]
      have h3 : Odd (Pg.relIndex NK) := by
        rw [h2]; exact Nat.odd_iff.2 (Nat.two_dvd_ne_zero.1 P0.not_dvd_index)
      rw [← h1] at h3
      exact Nat.Odd.of_mul_left h3
    obtain ⟨k, hk⟩ := hsol
    obtain ⟨j, hj⟩ := (isSolvable_subgroup_iff L).1 hLsol
    rw [isSolvable_subgroup_iff]
    refine ⟨j + k, ?_⟩
    rw [dA_add]
    refine le_bot_iff.1 (hj ▸ dA_mono j ?_)
    intro y hy
    have hyT : y ∈ T0 := dA_le k T0 hy
    have hyK : y ∈ K := hk (dA_mono k inf_le_right hy)
    exact ⟨hyT.1.2, hyT.1.1, hyK⟩
  refine ⟨Qg, Qg ⊔ T0, fun S hS hdvd => ?_, hQp, le_sup_left,
    sup_le (hQV.trans (hVK.trans hKH)) inf_le_right, sup_le le_normalizer hT0Q,
    isSolvable_sup_of_le_normalizer (by haveI := hQp.isNilpotent; infer_instance) hT0sol hT0Q,
    fun h hh => ?_⟩
  · obtain ⟨y, hy, hyS, hy1⟩ :=
      exists_ne_one_mem_sylow_inf (hF.le S hS) (hF.normalizes S hS) hdvd Q0
    exact ⟨y, hy, hyS, hy1⟩
  · -- two Frattini arguments
    have hfr := Sylow.normalizer_sup_eq_top Q0
    have hh' : h ∈ ((normalizer (Qg : Set G) ⊔ V : Subgroup G) : Set G) := by rw [hfr]; trivial
    rw [mul_normal] at hh'
    obtain ⟨a, ha, v, hv, rfl⟩ := hh'
    have haH : a ∈ H := by
      have := mul_mem hh (inv_mem (hVK.trans hKH hv))
      simpa using this
    have hNA : NK ≤ normalizer (Qg : Set G) ⊓ H := inf_le_inf_left _ hKH
    have hA : normalizer (Qg : Set G) ⊓ H ≤ normalizer (NK : Set G) := by
      intro c hc
      refine mem_normalizer_inf (le_normalizer hc.1) ?_
      rw [mem_normalizer_iff]
      intro y
      exact ⟨fun hy => hKn.conj_mem y hy c, fun hy => by
        simpa [mul_assoc] using hKn.conj_mem _ hy c⁻¹⟩
    obtain ⟨b, hb, n, hn, rfl⟩ := frattini_rel hNA hA P0 ⟨ha, haH⟩
    refine ⟨b, mem_sup_right ⟨⟨hb.1.1, hb.2⟩, hb.1.2⟩, n * v, mul_mem hn.2 (hVK hv), ?_⟩
    group

/-- **Lemma 3.2 (Khukhro–Shumyatsky), in the form used here.**  Let `K` be the kernel of the
conjugation action on a family of simple factors.  If `H ≥ K` with `H/K` soluble and
`D^n(H/K) ≠ 1`, then some soluble subgroup `T ≤ H` has `D^{n+1}(T) ≠ 1`. -/
theorem key [OddOrder.{u}] (hF : FactorFamily 𝒮 V) {H : Subgroup G} (hKH : kernelOf 𝒮 ≤ H)
    (hsol : ∃ k, dA k H ≤ kernelOf 𝒮) (n : ℕ) (hn : ¬ D^[n] H ≤ kernelOf 𝒮) :
    ∃ T ≤ H, Group.IsSolvable T ∧ D^[n + 1] T ≠ ⊥ := by
  by_contra hcon
  push Not at hcon
  apply hn
  set K := kernelOf 𝒮
  haveI hKn : K.Normal := kernelOf_normal hF.conj
  have himage : ∀ T : Subgroup G, T ≤ H → (∀ h ∈ H, ∃ t ∈ T, ∃ k ∈ K, h = t * k) →
      ∀ x ∈ D^[n] H, ∃ w ∈ D^[n] T, (x : G ⧸ K) = (w : G ⧸ K) := by
    intro T hTH hdec x hx
    let π := QuotientGroup.mk' K
    have hmap : H.map π = T.map π := by
      refine le_antisymm ?_ (map_mono hTH)
      rintro _ ⟨h, hh, rfl⟩
      obtain ⟨t, ht, k, hk, rfl⟩ := hdec h hh
      refine ⟨t, ht, ?_⟩
      simp [π, (QuotientGroup.eq_one_iff k).2 hk]
    have : π x ∈ (D^[n] T).map π := by
      rw [map_D_iterate, ← hmap, ← map_D_iterate]; exact mem_map_of_mem π hx
    obtain ⟨w, hw, hwx⟩ := this
    exact ⟨w, hw, hwx.symm⟩
  have hW : ∀ T : Subgroup G, T ≤ H → Group.IsSolvable T → D (D^[n] T) = ⊥ := by
    intro T hTH hTs
    have := hcon T hTH hTs
    rwa [Function.iterate_succ_apply'] at this
  have hnorm : ∀ T : Subgroup G, T ≤ normalizer ((D^[n] T : Subgroup G) : Set G) := fun T =>
    le_normalizer.trans (normalizer_le_normalizer_D_iterate n T)
  intro x hx
  -- the prime `2`
  obtain ⟨Q2, T2, hhit2, hQ2p, hQT2, hT2H, hT2N, hT2s, hdec2⟩ := exists_T hF hKH hsol 2
  have hBK : oddGen (D^[n] T2) ≤ K := by
    intro b hb
    refine mem_kernelOf.2 fun S hS => ?_
    obtain ⟨y, hyQ, hyS, hy1⟩ := hhit2 S hS (two_dvd_card_of_not_isSolvable (hF.nonsol S hS))
    have hbT : b ∈ T2 := D_iterate_le n T2 (oddGen_le _ hb)
    have hcomm := commute_of_odd_two (B := oddGen (D^[n] T2)) (Q := Q2)
      (fun b hb => isOddElt_of_mem_oddGen (hW T2 hT2H hT2s) hb)
      (fun x hx => isTwoElt_of_isPGroup hQ2p hx) hb hyQ (hT2N hbT)
      (normalizer_le_normalizer_oddGen _ (hnorm T2 (hQT2 hyQ)))
    exact mem_normalizer_of_commute hF.conj hF.disj hS hyS hy1 hcomm
  obtain ⟨w, hw, hxw⟩ := himage T2 hT2H hdec2 x hx
  obtain ⟨a, ha⟩ := exists_two_pow_isOddElt w
  have hxa : x ^ (2 ^ a) ∈ K := by
    refine mem_of_mk_eq (y := w ^ (2 ^ a)) (by rw [QuotientGroup.mk_pow, QuotientGroup.mk_pow,
      hxw]) (hBK (subset_closure ⟨pow_mem hw _, ha⟩)) le_rfl
  refine mem_kernelOf.2 fun S hS => ?_
  -- an odd prime dividing `|S|`
  obtain ⟨q, hq, hqodd, hqS⟩ := exists_odd_prime_dvd_card_of_not_isSolvable (hF.nonsol S hS)
  haveI : Fact q.Prime := ⟨hq⟩
  obtain ⟨Qq, Tq, hhitq, hQqp, hQTq, hTqH, hTqN, hTqs, hdecq⟩ := exists_T hF hKH hsol q
  obtain ⟨w', hw', hxw'⟩ := himage Tq hTqH hdecq x hx
  obtain ⟨m, hm, hw'm⟩ := exists_odd_pow_isTwoElt w'
  have hAS : w' ^ m ∈ normalizer (S : Set G) := by
    obtain ⟨y, hyQ, hyS, hy1⟩ := hhitq S hS hqS
    have hb : w' ^ m ∈ twoGen (D^[n] Tq) := subset_closure ⟨pow_mem hw' m, hw'm⟩
    have hbT : w' ^ m ∈ Tq := D_iterate_le n Tq (twoGen_le _ hb)
    have hcomm := commute_of_odd_two (B := Qq) (Q := twoGen (D^[n] Tq))
      (fun x hx => isOddElt_of_isPGroup hqodd hQqp hx)
      (fun x hx => isTwoElt_of_mem_twoGen (hW Tq hTqH hTqs) hx) hyQ hb
      (normalizer_le_normalizer_twoGen _ (hnorm Tq (hQTq hyQ))) (hTqN hbT)
    exact mem_normalizer_of_commute hF.conj hF.disj hS hyS hy1 hcomm.symm
  have hKS : K ≤ normalizer (S : Set G) := fun k hk => mem_kernelOf.1 hk S hS
  have hxm : x ^ m ∈ normalizer (S : Set G) :=
    mem_of_mk_eq (y := w' ^ m) (by rw [QuotientGroup.mk_pow, QuotientGroup.mk_pow, hxw']) hAS hKS
  exact mem_of_pow_mem_of_coprime (odd_two_pow_coprime hm a) hxm (hKS hxa)

end KernelLemma

section NonsolubleSeries

open Subgroup

/-- `Y` is (isomorphic to) a finite direct product of nonabelian simple groups. -/
def IsSemisimpleProd (Y : Type u) [Group Y] : Prop :=
  ∃ (ι : Type u) (S : ι → Type u) (_ : ∀ i, Group (S i)), Finite ι ∧
    (∀ i, IsSimpleGroup (S i)) ∧ (∀ i, ∃ a b : S i, a * b ≠ b * a) ∧ Nonempty (Y ≃* ∀ i, S i)

lemma IsSemisimpleProd.of_mulEquiv {Y Z : Type u} [Group Y] [Group Z] (e : Y ≃* Z)
    (h : IsSemisimpleProd Z) : IsSemisimpleProd Y := by
  obtain ⟨ι, S, _, h1, h2, h3, ⟨f⟩⟩ := h
  exact ⟨ι, S, _, h1, h2, h3, ⟨e.trans f⟩⟩

variable {X : Type u} [Group X]

/-- The section `B/A` is soluble. -/
def SolubleFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, Group.IsSolvable (B ⧸ A.subgroupOf B)

/-- The section `B/A` is a direct product of nonabelian simple groups. -/
def SemisimpleFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, IsSemisimpleProd (B ⧸ A.subgroupOf B)

/-- A normal series `N = G₀ ≤ G₁ ≤ ⋯ ≤ G_{2h+1} = X` in which the factors `G_{2i+1}/G_{2i}`
(`0 ≤ i ≤ h`) are soluble and the factors `G_{2i+2}/G_{2i+1}` (`0 ≤ i < h`) are direct products of
nonabelian simple groups.  For `N = 1` these are the series in the definition of the nonsoluble
length `λ(X)` (Khukhro–Shumyatsky, §1). -/
structure NSeries (X : Type u) [Group X] (N : Subgroup X) (h : ℕ) where
  G : ℕ → Subgroup X
  normal : ∀ i, (G i).Normal
  mono : ∀ i < 2 * h + 1, G i ≤ G (i + 1)
  zero : G 0 = N
  top : G (2 * h + 1) = ⊤
  sol : ∀ i ≤ h, SolubleFactor (G (2 * i)) (G (2 * i + 1))
  semisimple : ∀ i < h, SemisimpleFactor (G (2 * i + 1)) (G (2 * i + 2))

/-- `λ(X) ≤ h`: the nonsoluble length of `X` is at most `h`. -/
def NonsolubleLengthLE (X : Type u) [Group X] (h : ℕ) : Prop := Nonempty (NSeries X ⊥ h)

variable [Finite X]

lemma solubleFactor_iff {A B : Subgroup X} [A.Normal] :
    SolubleFactor A B ↔ ∃ k, dA k B ≤ A :=
  ⟨fun ⟨_, h⟩ => isSolvable_quotient_iff.1 h, fun h => ⟨inferInstance, isSolvable_quotient_iff.2 h⟩⟩

lemma dA_top (k : ℕ) : dA k (⊤ : Subgroup X) = derivedSeries X k := by
  induction k with
  | zero => rfl
  | succ k ih => rw [dA, ih, derivedSeries_succ]

section Comap

variable {Y : Type u} [Group Y] [Finite Y] (f : X →* Y) (hf : Function.Surjective f)
include hf

lemma solubleFactor_comap {A B : Subgroup Y} [A.Normal] (h : SolubleFactor A B) :
    SolubleFactor (A.comap f) (B.comap f) := by
  rw [solubleFactor_iff] at h ⊢
  obtain ⟨k, hk⟩ := h
  refine ⟨k, map_le_iff_le_comap.1 ?_⟩
  rw [map_dA, map_comap_eq_self_of_surjective hf]
  exact hk

/-- The section `f⁻¹(B)/f⁻¹(A)` is isomorphic to `B/A`. -/
noncomputable def comapFactorEquiv (A B : Subgroup Y) [A.Normal] :
    (B.comap f) ⧸ (A.comap f).subgroupOf (B.comap f) ≃* B ⧸ A.subgroupOf B := by
  let ψ : (B.comap f) →* B :=
    { toFun := fun x => ⟨f x, x.2⟩
      map_one' := by ext; simp
      map_mul' := fun a b => by ext; simp }
  let φ : (B.comap f) →* B ⧸ A.subgroupOf B := (QuotientGroup.mk' _).comp ψ
  have hφ : Function.Surjective φ := by
    intro z
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective _ z
    obtain ⟨x, hx⟩ := hf b
    refine ⟨⟨x, by simp [hx]⟩, ?_⟩
    simp only [φ, ψ, MonoidHom.coe_comp, Function.comp_apply, MonoidHom.coe_mk, OneHom.coe_mk]
    congr 1
    ext
    exact hx
  have hker : φ.ker = (A.comap f).subgroupOf (B.comap f) := by
    ext x
    simp [φ, ψ, mem_subgroupOf, QuotientGroup.eq_one_iff]
  exact (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective φ hφ)

lemma semisimpleFactor_comap {A B : Subgroup Y} [A.Normal] (h : SemisimpleFactor A B) :
    SemisimpleFactor (A.comap f) (B.comap f) := by
  obtain ⟨_, h⟩ := h
  exact ⟨inferInstance, h.of_mulEquiv (comapFactorEquiv f hf A B)⟩

/-- Pull back a series of `Y` along a surjection `f : X → Y`, giving a series of `X` starting
at `ker f`. -/
def NSeries.comap {h : ℕ} (s : NSeries Y ⊥ h) : NSeries X f.ker h where
  G i := (s.G i).comap f
  normal i := (s.normal i).comap f
  mono i hi := comap_mono (s.mono i hi)
  zero := by rw [s.zero]; rfl
  top := by rw [s.top, comap_top]
  sol i hi := by
    haveI := s.normal (2 * i)
    exact solubleFactor_comap f hf (s.sol i hi)
  semisimple i hi := by
    haveI := s.normal (2 * i + 1)
    exact semisimpleFactor_comap f hf (s.semisimple i hi)

end Comap

/-- Prepend a soluble normal subgroup at the bottom of a series. -/
def NSeries.prependSoluble {N : Subgroup X} {h : ℕ} (s : NSeries X N h) (hN : ∃ k, dA k N = ⊥) :
    NSeries X ⊥ h where
  G i := match i with
    | 0 => ⊥
    | j + 1 => s.G (j + 1)
  normal i := match i with
    | 0 => normal_bot
    | j + 1 => s.normal (j + 1)
  mono i hi := match i with
    | 0 => bot_le
    | j + 1 => s.mono (j + 1) hi
  zero := rfl
  top := s.top
  sol i hi := match i with
    | 0 => by
      show SolubleFactor ⊥ (s.G 1)
      haveI := s.normal 0
      obtain ⟨a, ha⟩ := (solubleFactor_iff.1 (s.sol 0 (Nat.zero_le _)))
      obtain ⟨b, hb⟩ := hN
      refine solubleFactor_iff.2 ⟨b + a, ?_⟩
      rw [dA_add, ← hb]
      exact dA_mono b (ha.trans s.zero.le)
    | j + 1 => s.sol (j + 1) hi
  semisimple i hi := s.semisimple i hi

/-- Prepend a block `1 ≤ A ≤ B ≤ N` (with `A` soluble, `B/A` semisimple and `N/B` soluble) to a
series starting at `N`, raising the number of semisimple factors by one. -/
def NSeries.prependBlock {N A B : Subgroup X} {h : ℕ} (s : NSeries X N h) [hA : A.Normal]
    [hB : B.Normal] (hAB : A ≤ B) (hBN : B ≤ N) (hAsol : ∃ k, dA k A = ⊥)
    (hss : SemisimpleFactor A B) (hNB : ∃ k, dA k N ≤ B) : NSeries X ⊥ (h + 1) where
  G i := match i with
    | 0 => ⊥
    | 1 => A
    | 2 => B
    | j + 3 => s.G (j + 1)
  normal i := match i with
    | 0 => normal_bot
    | 1 => hA
    | 2 => hB
    | j + 3 => s.normal (j + 1)
  mono i hi := match i with
    | 0 => bot_le
    | 1 => hAB
    | 2 => hBN.trans (by have := s.mono 0 (by omega); rwa [s.zero] at this)
    | j + 3 => s.mono (j + 1) (by omega)
  zero := rfl
  top := s.top
  sol i hi := match i with
    | 0 => by
      show SolubleFactor ⊥ A
      obtain ⟨k, hk⟩ := hAsol
      exact solubleFactor_iff.2 ⟨k, hk.le⟩
    | 1 => by
      show SolubleFactor B (s.G 1)
      haveI := s.normal 0
      obtain ⟨a, ha⟩ := (solubleFactor_iff.1 (s.sol 0 (Nat.zero_le _)))
      obtain ⟨b, hb⟩ := hNB
      refine solubleFactor_iff.2 ⟨b + a, ?_⟩
      rw [dA_add]
      exact (dA_mono b (ha.trans s.zero.le)).trans hb
    | j + 2 => s.sol (j + 1) (by omega)
  semisimple i hi := match i with
    | 0 => hss
    | j + 1 => s.semisimple j (by omega)

/-- A soluble group has nonsoluble length `0`. -/
lemma nonsolubleLengthLE_zero_of_isSolvable [Group.IsSolvable X] : NonsolubleLengthLE X 0 := by
  refine ⟨{ G := fun i => match i with
              | 0 => ⊥
              | _ + 1 => ⊤
            normal := fun i => match i with
              | 0 => normal_bot
              | _ + 1 => normal_top
            mono := fun i _ => match i with
              | 0 => bot_le
              | _ + 1 => le_rfl
            zero := rfl
            top := rfl
            sol := fun i hi => ?_
            semisimple := fun i hi => absurd hi (Nat.not_lt_zero _) }⟩
  obtain rfl : i = 0 := Nat.le_zero.1 hi
  show SolubleFactor ⊥ ⊤
  obtain ⟨k, hk⟩ := (isSolvable_def X).1 inferInstance
  exact solubleFactor_iff.2 ⟨k, by rw [dA_top, hk]⟩

end NonsolubleSeries

section Layer

open Subgroup
open scoped commutatorElement

section Layer

variable {Y : Type} [Group Y] [Finite Y]

/-- Conjugation by an element of `N_Y(L)`, as an automorphism of `L`. -/
def conjAut (L : Subgroup Y) : normalizer (L : Set Y) →* MulAut L where
  toFun k :=
    { toFun := fun l => ⟨k * l * k⁻¹, (mem_normalizer_iff.1 k.2 l).1 l.2⟩
      invFun := fun l => ⟨(k : Y)⁻¹ * l * k, (mem_normalizer_iff.1 k.2 _).2 (by
        simpa [mul_assoc] using l.2)⟩
      left_inv := fun l => by ext; simp [mul_assoc]
      right_inv := fun l => by ext; simp [mul_assoc]
      map_mul' := fun a b => by ext; simp [mul_assoc] }
  map_one' := by ext; simp
  map_mul' := fun a b => by ext; simp [mul_assoc]

lemma not_isSolvable_of_simple_nonab {S : Type*} [Group S] [IsSimpleGroup S]
    (h : ∃ a b : S, a * b ≠ b * a) : ¬ Group.IsSolvable S := by
  intro hs
  obtain ⟨a, b, hab⟩ := h
  have hn : (⁅(⊤ : Subgroup S), (⊤ : Subgroup S)⁆ : Subgroup S).Normal := inferInstance
  rcases hn.eq_bot_or_eq_top with h | h
  · apply hab
    have : ⁅a, b⁆ ∈ ⁅(⊤ : Subgroup S), ⊤⁆ := commutator_mem_commutator (mem_top a) (mem_top b)
    rw [h, mem_bot, commutatorElement_eq_one_iff_mul_comm] at this
    exact this
  · have hds : ∀ n, derivedSeries S n = ⊤ := by
      intro n
      induction n with
      | zero => rfl
      | succ n ih => rw [derivedSeries_succ, ih, h]
    obtain ⟨n, hn⟩ := (isSolvable_def S).1 hs
    rw [hds n] at hn
    have : a = b := by
      have ha : a ∈ (⊤ : Subgroup S) := mem_top a
      have hb : b ∈ (⊤ : Subgroup S) := mem_top b
      rw [hn, mem_bot] at ha hb
      rw [ha, hb]
    exact hab (by rw [this])

variable (Y) in
/-- The set of components of `Y`. -/
def components : Set (Subgroup Y) := {L | IsComponent L}

variable (hF : fittingSubgroup Y = ⊥)
include hF

lemma nonab_component (C : ComponentIndex Y) : ∃ a b : C.1, a * b ≠ b * a := by
  obtain ⟨a, ha, b, hb, hab⟩ := component_nonab hF C.2
  exact ⟨⟨a, ha⟩, ⟨b, hb⟩, fun h => hab (congrArg Subtype.val h)⟩

/-- The components of a group with trivial Fitting subgroup form a family of simple factors of
the layer (`= Soc(Y)`). -/
lemma factorFamily_components : FactorFamily (components Y) (layer Y) where
  normal := inferInstance
  le := fun S hS => component_le_layer hS
  normalizes := fun S hS => layer_le_normalizer hS
  conj := fun S hS g => isComponent_conj hS g
  disj := fun S hS S' hS' hne => component_inf_eq_bot hF hS hS' hne
  nonsol := fun S hS => by
    haveI := component_isSimple hF hS
    exact not_isSolvable_of_simple_nonab (nonab_component hF ⟨S, hS⟩)

/-- The layer of a group with trivial Fitting subgroup is a direct product of nonabelian simple
groups. -/
lemma semisimpleFactor_layer : SemisimpleFactor (⊥ : Subgroup Y) (layer Y) := by
  refine ⟨inferInstance, ?_⟩
  have hZ : ∀ C : ComponentIndex Y, center C.1 = ⊥ := fun C => component_center_eq_bot hF C.2
  let e1 : (layer Y ⧸ (⊥ : Subgroup Y).subgroupOf (layer Y)) ≃* layer Y :=
    (QuotientGroup.quotientMulEquivOfEq (bot_subgroupOf _)).trans QuotientGroup.quotientBot
  refine IsSemisimpleProd.of_mulEquiv
    (e1.trans (layerEquiv hZ).symm) ?_
  exact ⟨ComponentIndex Y, fun C => C.1, fun C => inferInstance, inferInstance,
    fun C => component_isSimple hF C.2, nonab_component hF, ⟨MulEquiv.refl _⟩⟩

/-- **Lemma 2.1 (Khukhro–Shumyatsky), via the Schreier conjecture.**  The kernel of the action on
the components is soluble modulo the layer. -/
lemma dA_kernel_le_layer [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0}) :
    ∃ k, dA k (kernelOf (components Y)) ≤ layer Y := by
  set K := kernelOf (components Y)
  have hKC : ∀ C : ComponentIndex Y, K ≤ normalizer (C.1 : Set Y) := fun C k hk =>
    mem_kernelOf.1 hk C.1 C.2
  let Φ : K →* ∀ C : ComponentIndex Y, ComponentClassification.OuterAutomorphisms.Outer C.1 :=
    Pi.monoidHom fun C => (QuotientGroup.mk' _).comp ((conjAut C.1).comp (inclusion (hKC C)))
  haveI : ∀ C : ComponentIndex Y,
      Group.IsSolvable (ComponentClassification.OuterAutomorphisms.Outer C.1) := by
    intro C
    haveI := component_isSimple hF C.2
    exact Schreier.schreierFor_inCatalog_holds C.1 (nonab_component hF C)
      (TauCeti.classificationStatement_iff.1 hCFSG C.1)
  haveI : Group.IsSolvable
      (∀ C : ComponentIndex Y, ComponentClassification.OuterAutomorphisms.Outer C.1) :=
    isSolvable_pi_of_finite
  obtain ⟨j, hj⟩ := (isSolvable_def _).1 this
  have hker : Φ.ker.map K.subtype ≤ layer Y := by
    rintro _ ⟨k, hk, rfl⟩
    have hk' : ∀ C : ComponentIndex Y,
        ∃ s : C.1, MulAut.conj s = conjAut C.1 (inclusion (hKC C) k) := by
      intro C
      have h1 := congrFun (MonoidHom.mem_ker.1 hk) C
      have h2 : conjAut C.1 (inclusion (hKC C) k) ∈
          ComponentClassification.OuterAutomorphisms.inner C.1 :=
        (QuotientGroup.eq_one_iff _).1 h1
      obtain ⟨s, hs⟩ := h2
      exact ⟨s, hs⟩
    choose s hs using hk'
    set x := layerMul Y s
    have hx : x ∈ layer Y := by rw [← layerMul_range]; exact ⟨s, rfl⟩
    have hcen : x⁻¹ * k ∈ centralizer (layer Y : Set Y) := by
      apply mem_centralizer_layer_of_forall
      intro C c hc
      have h1 : (k : Y) * c * (k : Y)⁻¹ = (s C : Y) * c * (s C : Y)⁻¹ := by
        have := congrArg (fun φ : MulAut C.1 => ((φ ⟨c, hc⟩ : C.1) : Y)) (hs C)
        simpa [conjAut, MulAut.conj_apply] using this.symm
      have h2 : x * c * x⁻¹ = (s C : Y) * c * (s C : Y)⁻¹ := by
        have hc' : layerMul Y (Pi.mulSingle C ⟨c, hc⟩) = c := layerMul_mulSingle C ⟨c, hc⟩
        have hpi : s * Pi.mulSingle C ⟨c, hc⟩ * s⁻¹ =
            Pi.mulSingle C (s C * ⟨c, hc⟩ * (s C)⁻¹) := by
          funext D
          by_cases hD : D = C
          · subst hD; simp
          · simp [Pi.mulSingle_eq_of_ne hD]
        calc x * c * x⁻¹ = layerMul Y (s * Pi.mulSingle C ⟨c, hc⟩ * s⁻¹) := by
              rw [map_mul, map_mul, map_inv, hc']
          _ = (s C : Y) * c * (s C : Y)⁻¹ := by rw [hpi, layerMul_mulSingle]; simp
      have h3 : (k : Y) * c * (k : Y)⁻¹ = x * c * x⁻¹ := h1.trans h2.symm
      calc x⁻¹ * k * c = x⁻¹ * ((k : Y) * c * (k : Y)⁻¹) * k := by group
        _ = x⁻¹ * (x * c * x⁻¹) * k := by rw [h3]
        _ = c * (x⁻¹ * k) := by group
    rw [centralizer_layer_eq_bot hF, mem_bot, inv_mul_eq_one] at hcen
    show (k : Y) ∈ layer Y
    rw [← hcen]
    exact hx
  refine ⟨j, ?_⟩
  rw [← map_subtype_derivedSeries]
  refine le_trans (map_mono ?_) hker
  rw [← Subgroup.map_eq_bot_iff]
  exact le_bot_iff.1 ((map_derivedSeries_le_derivedSeries Φ j).trans hj.le)

end Layer

/-- The quotient by the soluble radical has trivial Fitting subgroup. -/
lemma fittingSubgroup_quotient_solvableRadical_eq_bot (X : Type) [Group X] [Finite X] :
    fittingSubgroup (X ⧸ solvableRadical X) = ⊥ := by
  set R := solvableRadical X
  let π := QuotientGroup.mk' R
  rw [fittingSubgroup, sSup_eq_bot]
  rintro N ⟨hN, hNnil⟩
  set M := N.comap π
  haveI : M.Normal := hN.comap π
  have hMsol : Group.IsSolvable M := by
    haveI := hNnil
    obtain ⟨k, hk⟩ := (isSolvable_subgroup_iff N).1 inferInstance
    obtain ⟨j, hj⟩ := (isSolvable_subgroup_iff R).1
      isSolvable_solvableRadical
    rw [isSolvable_subgroup_iff]
    refine ⟨j + k, ?_⟩
    have h1 : dA k M ≤ R := by
      have : (dA k M).map π = ⊥ := by
        rw [map_dA, map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective R), hk]
      rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
      exact this
    rw [dA_add]
    exact le_bot_iff.1 (hj ▸ dA_mono j h1)
  have hMR : M ≤ R := le_solvableRadical inferInstance hMsol
  rw [eq_bot_iff]
  intro y hy
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective R y
  rw [mem_bot]
  exact (QuotientGroup.eq_one_iff x).2 (hMR hy)

end Layer

section TheoremThreeThree

open Subgroup
/-- `L_{2×2'}(X) ≤ n`: every soluble subgroup `H` of `X` has `(2×2')`-length at most `n`, i.e.
`D^n(H) = 1` where `D` is the lower `(2×2')`-series. -/
def TTLengthLE (X : Type*) [Group X] (n : ℕ) : Prop :=
  ∀ H : Subgroup X, Group.IsSolvable H → D^[n] H = ⊥

lemma isSolvable_comap_mk {X : Type*} [Group X] [Finite X] {R : Subgroup X} [R.Normal]
    (hR : Group.IsSolvable R) {Z : Subgroup (X ⧸ R)} (hZ : Group.IsSolvable Z) :
    Group.IsSolvable (Z.comap (QuotientGroup.mk' R)) := by
  set M := Z.comap (QuotientGroup.mk' R)
  obtain ⟨k, hk⟩ := (isSolvable_subgroup_iff Z).1 hZ
  obtain ⟨j, hj⟩ := (isSolvable_subgroup_iff R).1 hR
  rw [isSolvable_subgroup_iff]
  refine ⟨j + k, ?_⟩
  have h1 : dA k M ≤ R := by
    have : (dA k M).map (QuotientGroup.mk' R) = ⊥ := by
      rw [map_dA, map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective R), hk]
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
    exact this
  rw [dA_add]
  exact le_bot_iff.1 (hj ▸ dA_mono j h1)

/-- **Lemma 3.1** (for the soluble radical): `L_{2×2'}(X/R(X)) ≤ L_{2×2'}(X)`. -/
lemma ttLengthLE_quotient_solvableRadical {X : Type*} [Group X] [Finite X] {n : ℕ}
    (h : TTLengthLE X n) : TTLengthLE (X ⧸ solvableRadical X) n := by
  intro Z hZ
  have := h _ (isSolvable_comap_mk
    isSolvable_solvableRadical hZ)
  rw [← map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _) Z, ← map_D_iterate,
    this, Subgroup.map_bot]

instance kernelOf_components_normal (Y : Type) [Group Y] [Finite Y] :
    (kernelOf (components Y)).Normal :=
  kernelOf_normal fun _ hS g => isComponent_conj hS g

/-- **Lemma 3.2**: `L_{2×2'}(Y/K(Y)) < L_{2×2'}(Y)` when `F(Y) = 1`. -/
lemma ttLengthLE_quotient_kernel [OddOrder.{0}] {Y : Type} [Group Y] [Finite Y] (hF : fittingSubgroup Y = ⊥)
    {n : ℕ} (h : TTLengthLE Y (n + 1)) : TTLengthLE (Y ⧸ kernelOf (components Y)) n := by
  intro Z hZ
  set K := kernelOf (components Y)
  let π := QuotientGroup.mk' K
  set H := Z.comap π
  have hKH : K ≤ H := by
    intro k hk
    show π k ∈ Z
    rw [show π k = 1 from (QuotientGroup.eq_one_iff k).2 hk]
    exact one_mem _
  have hsol : ∃ k, dA k H ≤ K := by
    obtain ⟨k, hk⟩ := (isSolvable_subgroup_iff Z).1 hZ
    refine ⟨k, ?_⟩
    have : (dA k H).map π = ⊥ := by
      rw [map_dA, map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective K), hk]
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at this
  by_contra hne
  have hn : ¬ D^[n] H ≤ K := by
    intro hle
    apply hne
    rw [← map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective K) Z, ← map_D_iterate,
      Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    exact hle
  obtain ⟨T, -, hTs, hT⟩ := key (factorFamily_components hF) hKH hsol n hn
  exact hT (h T hTs)

/-- Change the base of a series along an equality. -/
def NSeries.cast {X : Type*} [Group X] {N N' : Subgroup X} {h : ℕ} (s : NSeries X N h)
    (hN : N = N') : NSeries X N' h :=
  { s with zero := s.zero.trans hN }

/-- **Theorem 3.3 (Khukhro–Shumyatsky).**  `λ(G) ≤ L_{2×2'}(G)`. -/
theorem nonsolubleLengthLE_of_ttLengthLE [OddOrder.{0}] [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0}) :
    ∀ (n : ℕ) (X : Type) [Group X] [Finite X], TTLengthLE X n → NonsolubleLengthLE X n := by
  intro n
  induction n with
  | zero =>
    intro X _ _ h
    haveI : Subsingleton X := by
      refine ⟨fun a b => ?_⟩
      have key : ∀ x : X, x = 1 := fun x => by
        have := h (zpowers x) inferInstance
        have hx : x ∈ zpowers x := mem_zpowers x
        rw [Function.iterate_zero, id] at this
        rwa [this, mem_bot] at hx
      rw [key a, key b]
    exact nonsolubleLengthLE_zero_of_isSolvable
  | succ n ih =>
    intro X _ _ h
    set R := solvableRadical X
    set Y := X ⧸ R
    have hF : fittingSubgroup Y = ⊥ := fittingSubgroup_quotient_solvableRadical_eq_bot X
    have hY : TTLengthLE Y (n + 1) := ttLengthLE_quotient_solvableRadical h
    set K := kernelOf (components Y)
    haveI : (layer Y).Normal := (factorFamily_components hF).normal
    obtain ⟨s⟩ := ih (Y ⧸ K) (ttLengthLE_quotient_kernel hF hY)
    have sY := (s.comap (QuotientGroup.mk' K) (QuotientGroup.mk'_surjective K)).cast
      (QuotientGroup.ker_mk' K)
    have hVK : layer Y ≤ K := fun v hv => mem_kernelOf.2 fun S hS =>
      (factorFamily_components hF).normalizes S hS hv
    have sY' := sY.prependBlock (A := ⊥) (B := layer Y) bot_le hVK ⟨0, rfl⟩
      (semisimpleFactor_layer hF) (dA_kernel_le_layer hF hCFSG)
    have sX := (sY'.comap (QuotientGroup.mk' R) (QuotientGroup.mk'_surjective R)).cast
      (QuotientGroup.ker_mk' R)
    exact ⟨sX.prependSoluble ((isSolvable_subgroup_iff R).1
      isSolvable_solvableRadical)⟩

end TheoremThreeThree

section MainResults

open Subgroup
open scoped Pointwise

section Defs

variable {X : Type u} [Group X]

/-- The section `B/A` is nilpotent. -/
def NilpotentFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, Group.IsNilpotent (B ⧸ A.subgroupOf B)

/-- The section `B/A` is a `2`-group. -/
def TwoGroupFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, IsPGroup 2 (B ⧸ A.subgroupOf B)

/-- The section `B/A` is a `2'`-group (has odd order). -/
def OddOrderFactor (A B : Subgroup X) : Prop :=
  ∃ _ : (A.subgroupOf B).Normal, Odd (Nat.card (B ⧸ A.subgroupOf B))

/-- A normal series `1 = G₀ ≤ ⋯ ≤ G_h = X` with nilpotent factors. -/
structure FittingSeries (X : Type u) [Group X] (h : ℕ) where
  G : ℕ → Subgroup X
  normal : ∀ i, (G i).Normal
  mono : ∀ i < h, G i ≤ G (i + 1)
  zero : G 0 = ⊥
  top : G h = ⊤
  nilpotent : ∀ i < h, NilpotentFactor (G i) (G (i + 1))

/-- The Fitting height of `X` is at most `h`. -/
def FittingHeightLE (X : Type u) [Group X] (h : ℕ) : Prop := Nonempty (FittingSeries X h)

/-- A normal series `1 = G₀ ≤ G₁ ≤ ⋯ ≤ G_{2l+1} = X` whose factors are alternately `2'`-groups
(`G_{2i+1}/G_{2i}`) and `2`-groups (`G_{2i+2}/G_{2i+1}`). -/
structure TwoSeries (X : Type u) [Group X] (l : ℕ) where
  G : ℕ → Subgroup X
  normal : ∀ i, (G i).Normal
  mono : ∀ i < 2 * l + 1, G i ≤ G (i + 1)
  zero : G 0 = ⊥
  top : G (2 * l + 1) = ⊤
  odd : ∀ i ≤ l, OddOrderFactor (G (2 * i)) (G (2 * i + 1))
  two : ∀ i < l, TwoGroupFactor (G (2 * i + 1)) (G (2 * i + 2))

/-- The `2`-length of the (soluble) group `X` is at most `l`. -/
def TwoLengthLE (X : Type u) [Group X] (l : ℕ) : Prop := Nonempty (TwoSeries X l)

end Defs

section Bridges

variable {Z : Type u} [Group Z] [Finite Z]

lemma D_iterate_top_eq_bot_of_series (s : ℕ → Subgroup Z) (m : ℕ) (h0 : s 0 = ⊥)
    (hm : s m = ⊤) (hstep : ∀ i < m, D (s (i + 1)) ≤ s i) : D^[m] (⊤ : Subgroup Z) = ⊥ := by
  have key : ∀ k ≤ m, D^[k] (⊤ : Subgroup Z) ≤ s (m - k) := by
    intro k
    induction k with
    | zero => intro _; rw [Nat.sub_zero, hm]; exact le_rfl
    | succ k ih =>
      intro hk
      rw [Function.iterate_succ_apply']
      have h1 := D_mono (ih (Nat.le_of_succ_le hk))
      have h2 := hstep (m - (k + 1)) (by omega)
      rw [show m - (k + 1) + 1 = m - k by omega] at h2
      exact h1.trans h2
  have := key m le_rfl
  rwa [Nat.sub_self, h0, le_bot_iff] at this

variable {X : Type u} [Group X] [Finite X]

/-- Fitting height `≤ h` implies `(2×2')`-length `≤ h`. -/
lemma D_iterate_eq_bot_of_fittingHeightLE {H : Subgroup X} {h : ℕ} (hH : FittingHeightLE H h) :
    D^[h] H = ⊥ := by
  obtain ⟨s⟩ := hH
  have := D_iterate_top_eq_bot_of_series s.G h s.zero s.top fun i hi => by
    obtain ⟨_, hn⟩ := s.nilpotent i hi
    exact D_le_of_isNilpotent hn
  rw [← map_subtype_top H, ← map_D_iterate, this, Subgroup.map_bot]

/-- `2`-length `≤ l` implies `(2×2')`-length `≤ 2l+1`. -/
lemma D_iterate_eq_bot_of_twoLengthLE {H : Subgroup X} {l : ℕ} (hH : TwoLengthLE H l) :
    D^[2 * l + 1] H = ⊥ := by
  obtain ⟨s⟩ := hH
  have := D_iterate_top_eq_bot_of_series s.G (2 * l + 1) s.zero s.top fun i hi => by
    obtain ⟨j, rfl | rfl⟩ := Nat.even_or_odd' i
    · obtain ⟨_, hn⟩ := s.odd j (by omega)
      exact D_le_of_odd_card hn
    · obtain ⟨_, hn⟩ := s.two j (by omega)
      exact D_le_of_isPGroup_two hn
  rw [← map_subtype_top H, ← map_D_iterate, this, Subgroup.map_bot]

end Bridges

/-- **Corollary 1.2 (Khukhro–Shumyatsky).**  If every soluble subgroup of the finite group `G`
has Fitting height at most `h`, then the nonsoluble length of `G` is at most `h`. -/
theorem nonsolubleLengthLE_of_fittingHeightLE [OddOrder.{0}] [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    (G : Type) [Group G] [Finite G] (h : ℕ)
    (hfit : ∀ H : Subgroup G, Group.IsSolvable H → FittingHeightLE H h) :
    NonsolubleLengthLE G h :=
  nonsolubleLengthLE_of_ttLengthLE hCFSG h G fun H hH => D_iterate_eq_bot_of_fittingHeightLE
    (hfit H hH)

/-- **Theorem 1.1(a) (Khukhro–Shumyatsky).**  If every soluble subgroup of the finite group `G`
has `2`-length at most `l`, then the nonsoluble length of `G` is at most `2l + 1`. -/
theorem nonsolubleLengthLE_of_twoLengthLE [OddOrder.{0}] [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    (G : Type) [Group G] [Finite G] (l : ℕ)
    (h2 : ∀ H : Subgroup G, Group.IsSolvable H → TwoLengthLE H l) :
    NonsolubleLengthLE G (2 * l + 1) :=
  nonsolubleLengthLE_of_ttLengthLE hCFSG (2 * l + 1) G fun H hH =>
    D_iterate_eq_bot_of_twoLengthLE (h2 H hH)

/-! ### Numerical invariants -/

section Numeric

variable {X : Type u} [Group X]

lemma subsingleton_quotient_self (A : Subgroup X) : Subsingleton (A ⧸ A.subgroupOf A) := by
  refine ⟨fun a b => ?_⟩
  induction a using QuotientGroup.induction_on
  induction b using QuotientGroup.induction_on
  rw [QuotientGroup.eq]
  simp [mem_subgroupOf]

lemma nilpotentFactor_self (A : Subgroup X) : NilpotentFactor A A := by
  haveI := subsingleton_quotient_self A
  exact ⟨by rw [subgroupOf_self]; exact normal_top, inferInstance⟩

lemma oddOrderFactor_self (A : Subgroup X) : OddOrderFactor A A := by
  haveI := subsingleton_quotient_self A
  refine ⟨by rw [subgroupOf_self]; exact normal_top, ?_⟩
  rw [Nat.card_unique]
  exact odd_one

lemma twoGroupFactor_self (A : Subgroup X) : TwoGroupFactor A A := by
  haveI := subsingleton_quotient_self A
  haveI : (A.subgroupOf A).Normal := by rw [subgroupOf_self]; exact normal_top
  exact ⟨this, IsPGroup.of_subsingleton _ _⟩

lemma fittingHeightLE_mono {h h' : ℕ} (hh : h ≤ h') (H : FittingHeightLE X h) :
    FittingHeightLE X h' := by
  obtain ⟨s⟩ := H
  refine ⟨{ G := fun i => s.G (min i h)
            normal := fun i => s.normal _
            mono := fun i _ => ?_
            zero := by simp [s.zero]
            top := by rw [min_eq_right hh]; exact s.top
            nilpotent := fun i _ => ?_ }⟩
  · by_cases hi : i < h
    · rw [min_eq_left hi.le, min_eq_left (Nat.succ_le_of_lt hi)]; exact s.mono i hi
    · rw [min_eq_right (by omega), min_eq_right (by omega)]
  · by_cases hi : i < h
    · show NilpotentFactor (s.G (min i h)) (s.G (min (i + 1) h))
      rw [min_eq_left hi.le, min_eq_left (Nat.succ_le_of_lt hi)]; exact s.nilpotent i hi
    · show NilpotentFactor (s.G (min i h)) (s.G (min (i + 1) h))
      rw [min_eq_right (by omega), min_eq_right (by omega)]
      exact nilpotentFactor_self _

lemma twoLengthLE_mono {l l' : ℕ} (hl : l ≤ l') (H : TwoLengthLE X l) : TwoLengthLE X l' := by
  obtain ⟨s⟩ := H
  refine ⟨{ G := fun i => s.G (min i (2 * l + 1))
            normal := fun i => s.normal _
            mono := fun i _ => ?_
            zero := by simp [s.zero]
            top := by rw [min_eq_right (by omega)]; exact s.top
            odd := fun i _ => ?_
            two := fun i _ => ?_ }⟩
  · by_cases hi : i < 2 * l + 1
    · rw [min_eq_left hi.le, min_eq_left (Nat.succ_le_of_lt hi)]; exact s.mono i hi
    · rw [min_eq_right (by omega), min_eq_right (by omega)]
  · show OddOrderFactor (s.G (min (2 * i) (2 * l + 1))) (s.G (min (2 * i + 1) (2 * l + 1)))
    by_cases hi : i ≤ l
    · rw [min_eq_left (by omega), min_eq_left (by omega)]; exact s.odd i hi
    · rw [min_eq_right (by omega), min_eq_right (by omega)]; exact oddOrderFactor_self _
  · show TwoGroupFactor (s.G (min (2 * i + 1) (2 * l + 1))) (s.G (min (2 * i + 2) (2 * l + 1)))
    by_cases hi : i < l
    · rw [min_eq_left (by omega), min_eq_left (by omega)]; exact s.two i hi
    · rw [min_eq_right (by omega), min_eq_right (by omega)]; exact twoGroupFactor_self _

lemma derivedSeries_succ_le (k : ℕ) : derivedSeries X (k + 1) ≤ derivedSeries X k := by
  rw [derivedSeries_succ]; exact commutator_le_left _ _

lemma nilpotentFactor_derivedSeries (k : ℕ) :
    NilpotentFactor (derivedSeries X (k + 1)) (derivedSeries X k) := by
  set B := derivedSeries X k
  set A := derivedSeries X (k + 1)
  have hcomm : ∀ a b : B ⧸ A.subgroupOf B, a * b = b * a := by
    intro a b
    induction a using QuotientGroup.induction_on with | H a => ?_
    induction b using QuotientGroup.induction_on with | H b => ?_
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, mem_subgroupOf]
    have hmem : (b : X)⁻¹ * (a : X)⁻¹ * b * a ∈ A := by
      have := commutator_mem_commutator (H₁ := B) (H₂ := B) (inv_mem b.2) (inv_mem a.2)
      rw [commutatorElement_def, inv_inv, inv_inv] at this
      exact this
    simpa [mul_assoc] using hmem
  letI : CommGroup (B ⧸ A.subgroupOf B) := { (inferInstance : Group _) with mul_comm := hcomm }
  exact ⟨inferInstance, inferInstance⟩

/-- Every finite soluble group has finite Fitting height. -/
lemma exists_fittingHeightLE [Group.IsSolvable X] : ∃ h, FittingHeightLE X h := by
  obtain ⟨d, hd⟩ := (isSolvable_def X).1 inferInstance
  refine ⟨d, ⟨{ G := fun i => derivedSeries X (d - i)
                normal := fun i => derivedSeries_normal X _
                mono := fun i hi => ?_
                zero := by simpa using hd
                top := by simp
                nilpotent := fun i hi => ?_ }⟩⟩
  · show derivedSeries X (d - i) ≤ derivedSeries X (d - (i + 1))
    rw [show d - i = d - (i + 1) + 1 by omega]
    exact derivedSeries_succ_le _
  · show NilpotentFactor (derivedSeries X (d - i)) (derivedSeries X (d - (i + 1)))
    rw [show d - i = d - (i + 1) + 1 by omega]
    exact nilpotentFactor_derivedSeries _

variable [Finite X]

lemma oddGen_normal {M : Subgroup X} [hM : M.Normal] : (oddGen M).Normal := by
  refine ⟨fun x hx g => ?_⟩
  have : g ∈ normalizer ((oddGen M : Subgroup X) : Set X) :=
    normalizer_le_normalizer_oddGen M (by
      rw [mem_normalizer_iff]; intro y
      exact ⟨fun hy => hM.conj_mem y hy g, fun hy => by
        simpa [mul_assoc] using hM.conj_mem _ hy g⁻¹⟩)
  exact (mem_normalizer_iff.1 this x).1 hx

/-- In a section `M/N` with `M/N` nilpotent, `(N ⊔ O^2(M))/N` is a `2'`-group and
`M/(N ⊔ O^2(M))` is a `2`-group. -/
lemma factor_split {N M : Subgroup X} [N.Normal] [M.Normal] (hNM : N ≤ M)
    (hnil : NilpotentFactor N M) :
    OddOrderFactor N (N ⊔ oddGen M) ∧ TwoGroupFactor (N ⊔ oddGen M) M := by
  obtain ⟨_, hnil⟩ := hnil
  haveI : (oddGen M).Normal := oddGen_normal
  -- elements of `O^2(M)` have odd order modulo `N`
  have hodd : ∀ y ∈ oddGen M, ∃ m, Odd m ∧ y ^ m ∈ N := by
    intro y hy
    let π := QuotientGroup.mk' (N.subgroupOf M)
    have hD : D (⊤ : Subgroup (M ⧸ N.subgroupOf M)) = ⊥ := D_top_eq_bot_of_isNilpotent _
    have hyM : y ∈ M := oddGen_le M hy
    have h1 : (⟨y, hyM⟩ : M) ∈ oddGen (⊤ : Subgroup M) := by
      have : oddGen ((⊤ : Subgroup M).map M.subtype) = (oddGen (⊤ : Subgroup M)).map M.subtype :=
        (map_oddGen _ _).symm
      rw [map_subtype_top] at this
      rw [this] at hy
      obtain ⟨z, hz, hzy⟩ := hy
      rwa [show z = ⟨y, hyM⟩ from Subtype.ext hzy] at hz
    have h2 : π ⟨y, hyM⟩ ∈ oddGen (⊤ : Subgroup (M ⧸ N.subgroupOf M)) := by
      rw [← map_top_of_surjective π (QuotientGroup.mk'_surjective _), ← map_oddGen]
      exact mem_map_of_mem π h1
    obtain ⟨m, hm, hm1⟩ := isOddElt_of_mem_oddGen hD h2
    refine ⟨m, hm, ?_⟩
    have : (⟨y, hyM⟩ : M) ^ m ∈ N.subgroupOf M := by
      rw [← QuotientGroup.ker_mk' (N.subgroupOf M), MonoidHom.mem_ker, map_pow]; exact hm1
    simpa [mem_subgroupOf] using this
  constructor
  · refine ⟨inferInstance, ?_⟩
    by_contra hev
    rw [Nat.not_odd_iff_even, even_iff_two_dvd] at hev
    obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' 2 hev
    induction g using QuotientGroup.induction_on with | H x => ?_
    obtain ⟨x, hx⟩ := x
    have hx' : x ∈ (oddGen M : Set X) * (N : Set X) := by
      rw [← mul_normal, sup_comm]; exact hx
    obtain ⟨y, hy, n, hn, rfl⟩ := hx'
    obtain ⟨m, hm, hym⟩ := hodd y hy
    have hpow : (QuotientGroup.mk (⟨y * n, hx⟩ : ↥(N ⊔ oddGen M)) :
        ↥(N ⊔ oddGen M) ⧸ N.subgroupOf (N ⊔ oddGen M)) ^ m = 1 := by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_subgroupOf]
      have : (y * n) ^ m * (y ^ m)⁻¹ ∈ N := by
        refine (QuotientGroup.eq_one_iff ((y * n) ^ m * (y ^ m)⁻¹)).1 ?_
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_pow, QuotientGroup.mk_mul,
          (QuotientGroup.eq_one_iff n).2 hn, mul_one, QuotientGroup.mk_inv,
          QuotientGroup.mk_pow, mul_inv_cancel]
      simpa using mul_mem this hym
    have := orderOf_dvd_of_pow_eq_one hpow
    rw [hg] at this
    exact (Nat.not_even_iff_odd.2 hm) (even_iff_two_dvd.2 this)
  · refine ⟨inferInstance, fun g => ?_⟩
    induction g using QuotientGroup.induction_on with | H x => ?_
    obtain ⟨k, hk⟩ := exists_two_pow_isOddElt (x : X)
    refine ⟨k, ?_⟩
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_subgroupOf]
    exact mem_sup_right (subset_closure ⟨pow_mem x.2 _, hk⟩)

/-- `2`-length is at most Fitting height; in particular every finite soluble group has finite
`2`-length. -/
lemma twoLengthLE_of_fittingHeightLE {h : ℕ} (H : FittingHeightLE X h) : TwoLengthLE X h := by
  obtain ⟨s⟩ := H
  haveI := s.normal
  let G' : ℕ → Subgroup X := fun j =>
    if j % 2 = 0 then s.G (j / 2) else
      if j / 2 < h then s.G (j / 2) ⊔ oddGen (s.G (j / 2 + 1)) else ⊤
  have hG'e : ∀ i, G' (2 * i) = s.G i := fun i => by simp [G']
  have hG'o : ∀ i < h, G' (2 * i + 1) = s.G i ⊔ oddGen (s.G (i + 1)) := fun i hi => by
    simp [G', Nat.add_mod, show (2 * i + 1) / 2 = i by omega, hi]
  have hG'h : G' (2 * h + 1) = ⊤ := by simp [G', Nat.add_mod, show (2 * h + 1) / 2 = h by omega]
  have hnormal : ∀ j, (G' j).Normal := by
    intro j
    by_cases hj : j % 2 = 0
    · simp only [G', hj, if_true]; exact s.normal _
    · simp only [G', hj, if_false]
      split_ifs
      · haveI := s.normal (j / 2 + 1)
        haveI : (oddGen (s.G (j / 2 + 1))).Normal := oddGen_normal
        infer_instance
      · exact normal_top
  refine ⟨{ G := G'
            normal := hnormal
            mono := fun j hj => ?_
            zero := by rw [show (0 : ℕ) = 2 * 0 from rfl, hG'e]; exact s.zero
            top := hG'h
            odd := fun i hi => ?_
            two := fun i hi => ?_ }⟩
  · obtain ⟨i, rfl | rfl⟩ := Nat.even_or_odd' j
    · by_cases hi : i < h
      · rw [hG'e, hG'o i hi]; exact le_sup_left
      · rw [hG'e, show i = h by omega, hG'h]; exact le_top
    · have hi : i < h := by omega
      rw [hG'o i hi, show 2 * i + 1 + 1 = 2 * (i + 1) by ring, hG'e]
      exact sup_le (s.mono i hi) (oddGen_le _)
  · by_cases hi' : i < h
    · rw [hG'e, hG'o i hi']
      haveI := s.normal i; haveI := s.normal (i + 1)
      exact (factor_split (s.mono i hi') (s.nilpotent i hi')).1
    · rw [hG'e, show i = h by omega, hG'h, s.top]; exact oddOrderFactor_self _
  · rw [hG'o i hi, show 2 * i + 2 = 2 * (i + 1) by ring, hG'e]
    haveI := s.normal i; haveI := s.normal (i + 1)
    exact (factor_split (s.mono i hi) (s.nilpotent i hi)).2

end Numeric

section Invariants

variable (X : Type u) [Group X]

/-- The nonsoluble length `λ(X)`. -/
noncomputable def nonsolubleLength : ℕ := sInf {h | NonsolubleLengthLE X h}

/-- The Fitting height of `X`. -/
noncomputable def fittingHeight : ℕ := sInf {h | FittingHeightLE X h}

/-- The `2`-length of `X`. -/
noncomputable def twoLength : ℕ := sInf {l | TwoLengthLE X l}

/-- The maximum Fitting height of soluble subgroups of `X`. -/
noncomputable def maxFittingHeight : ℕ :=
  sSup {k | ∃ H : Subgroup X, Group.IsSolvable H ∧ fittingHeight H = k}

/-- `L₂(X)`: the maximum `2`-length of soluble subgroups of `X`. -/
noncomputable def maxTwoLength : ℕ :=
  sSup {k | ∃ H : Subgroup X, Group.IsSolvable H ∧ twoLength H = k}

variable {X} [Finite X]

lemma fittingHeightLE_fittingHeight [Group.IsSolvable X] : FittingHeightLE X (fittingHeight X) :=
  Nat.sInf_mem exists_fittingHeightLE

lemma twoLengthLE_twoLength [Group.IsSolvable X] : TwoLengthLE X (twoLength X) :=
  Nat.sInf_mem (exists_fittingHeightLE.imp fun _ => twoLengthLE_of_fittingHeightLE)

lemma bddAbove_of_subgroup (f : Subgroup X → ℕ) :
    BddAbove {k | ∃ H : Subgroup X, Group.IsSolvable H ∧ f H = k} :=
  ((Set.finite_range f).subset (by rintro _ ⟨H, -, rfl⟩; exact ⟨H, rfl⟩)).bddAbove

end Invariants

/-- **Corollary 1.2 (Khukhro–Shumyatsky)**, numerical form: `λ(G)` is at most the maximum
Fitting height of soluble subgroups of `G`. -/
theorem nonsolubleLength_le_maxFittingHeight [OddOrder.{0}] [Schreier] (hCFSG : TauCeti.ClassificationStatement.{0})
    (G : Type) [Group G] [Finite G] : nonsolubleLength G ≤ maxFittingHeight G := by
  refine Nat.sInf_le (nonsolubleLengthLE_of_fittingHeightLE hCFSG G _ fun H hH => ?_)
  exact fittingHeightLE_mono (le_csSup (bddAbove_of_subgroup _) ⟨H, hH, rfl⟩)
    fittingHeightLE_fittingHeight

/-- **Theorem 1.1(a) (Khukhro–Shumyatsky)**, numerical form: `λ(G) ≤ 2 L₂ + 1`, where `L₂` is
the maximum `2`-length of soluble subgroups of `G`. -/
theorem nonsolubleLength_le_two_mul_maxTwoLength_add_one [OddOrder.{0}] [Schreier]
    (hCFSG : TauCeti.ClassificationStatement.{0}) (G : Type) [Group G] [Finite G] :
    nonsolubleLength G ≤ 2 * maxTwoLength G + 1 := by
  refine Nat.sInf_le (nonsolubleLengthLE_of_twoLengthLE hCFSG G _ fun H hH => ?_)
  exact twoLengthLE_mono (le_csSup (bddAbove_of_subgroup _) ⟨H, hH, rfl⟩) twoLengthLE_twoLength

end MainResults

end CFSGOutside.NonsolubleLength
