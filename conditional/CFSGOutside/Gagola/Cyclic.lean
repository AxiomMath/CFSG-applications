import CFSGOutside.Gagola.Chars

/-!
# Characters over an invariant character with cyclic quotient

If `L ⊴ A` with `A/L` cyclic, generated by `a L`, and `θ ∈ Irr L` is `a`-invariant, then every irreducible
character `ψ` of `A` lying over `θ` restricts to `θ` itself: `ψ(1) = θ(1)`. (This is the part of
Isaacs 11.22, "an invariant character extends when the quotient is cyclic", that Gagola uses in the
proof of Theorem 2.5.) The normal subgroup is given as the image of an injective homomorphism `ι`.
-/

namespace CFSGOutside.Gagola

open scoped BigOperators
open Classical Module

noncomputable section

theorem cyclic_res_eq {A L : Type*} [Group A] [Fintype A] [Group L] [Fintype L]
    (ι : L →* A) (c : L →* L) (a : A) (hc : ∀ l, ι (c l) = a⁻¹ * ι l * a)
    (hgen : ∀ x : A, ∃ (l : L) (k : ℕ), x = ι l * a ^ k)
    {θ : L → ℂ} (hθ : θ ∈ Irr L) (hinv : ∀ l, θ (c l) = θ l)
    {ψ : A → ℂ} (hψ : ψ ∈ Irr A) (h : mult (pull ι ψ) θ ≠ 0) : ψ 1 = θ 1 := by
  obtain ⟨n, X, hX, rfl⟩ := hθ
  obtain ⟨m, ρ, hρ, rfl⟩ := hψ
  -- the space of intertwiners `X → ρ ∘ ι` is nonzero
  set ρL : Representation ℂ L (Fin m → ℂ) := ρ.comp ι
  have hcharL : ρL.character = pull ι ρ.character := by funext l; rfl
  have hU : finrank ℂ (X.IntertwiningMap ρL) ≠ 0 := by
    have h1 := Representation.card_inv_mul_sum_char_mul_char_eq_finrank X ρL
    have h2 := ((irr_isNatComb (⟨m, ρ, hρ, rfl⟩ : ρ.character ∈ Irr A)).pull ι).mult_eq
      (⟨n, X, hX, rfl⟩ : X.character ∈ Irr L)
    rw [← hcharL] at h2
    simp only [ip] at h2
    rw [← h2] at h1
    intro h0
    rw [h0] at h1
    exact h (by exact_mod_cast h1)
  -- an intertwiner `P : X → X ∘ c`, which is invertible
  set Xc : Representation ℂ L (Fin n → ℂ) := X.comp c
  have hP : finrank ℂ (X.IntertwiningMap Xc) = 1 := by
    have h1 := Representation.card_inv_mul_sum_char_mul_char_eq_finrank X Xc
    have hcc : Xc.character = X.character := by
      funext l; exact hinv l
    rw [hcc] at h1
    have h2 := ip_irr_self (⟨n, X, hX, rfl⟩ : X.character ∈ Irr L)
    simp only [ip] at h2
    rw [h2] at h1
    exact_mod_cast h1.symm
  have hPne : Nontrivial (X.IntertwiningMap Xc) :=
    Module.nontrivial_of_finrank_eq_succ hP
  obtain ⟨P, hP0⟩ := exists_ne (0 : X.IntertwiningMap Xc)
  have hPinj : Function.Injective P := by
    rcases hX.injective_or_eq_zero P with h | h
    · exact h
    · exact absurd h hP0
  have hPsurj : Function.Surjective P :=
    (LinearMap.injective_iff_surjective (f := P.toLinearMap)).mp hPinj
  have hPint : ∀ l v, P (X l v) = X (c l) (P v) := fun l v =>
    LinearMap.congr_fun (P.isIntertwining' l) v
  -- the operator `Q f = ρ(a) ∘ f ∘ P` on intertwiners
  let Q : Module.End ℂ (X.IntertwiningMap ρL) :=
    { toFun := fun f =>
        { toLinearMap := (ρ a) ∘ₗ f.toLinearMap ∘ₗ P.toLinearMap
          isIntertwining' := fun l => by
            apply LinearMap.ext; intro v
            simp only [LinearMap.coe_comp, Function.comp_apply]
            have hf := LinearMap.congr_fun (f.isIntertwining' (c l)) (P v)
            simp only [LinearMap.coe_comp, Function.comp_apply] at hf
            have e1 : P.toLinearMap (X l v) = X (c l) (P v) := hPint l v
            rw [e1, hf]
            show ρ a (ρ (ι (c l)) (f (P v))) = ρ (ι l) (ρ a (f (P v)))
            rw [hc l, ← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul]
            congr 2; group }
      map_add' := fun f g => by ext v; simp
      map_smul' := fun r f => by ext v; simp }
  have hUnt : Nontrivial (X.IntertwiningMap ρL) :=
    Module.nontrivial_of_finrank_pos (Nat.pos_of_ne_zero hU)
  obtain ⟨μ, hμ⟩ := Module.End.exists_eigenvalue Q
  obtain ⟨f, hf⟩ := hμ.exists_hasEigenvector
  have hfQ : Q f = μ • f := hf.apply_eq_smul
  have hf0 : f ≠ 0 := hf.2
  have hfinj : Function.Injective f := by
    rcases hX.injective_or_eq_zero f with h | h
    · exact h
    · exact absurd h hf0
  -- the range of `f` is `ρ`-invariant
  have hfint : ∀ l v, f (X l v) = ρ (ι l) (f v) := fun l v =>
    LinearMap.congr_fun (f.isIntertwining' l) v
  have hfa : ∀ w, ρ a (f (P w)) = μ • f w := by
    intro w
    have := congrArg (fun g : X.IntertwiningMap ρL => g w) hfQ
    simpa [Q] using this
  set F := f.toLinearMap with hF
  have hmemA : ∀ v, ρ a (F v) ∈ LinearMap.range F := by
    intro v
    obtain ⟨w, rfl⟩ := hPsurj v
    have := hfa w
    change ρ a (F (P w)) = μ • F w at this
    rw [this]
    exact Submodule.smul_mem _ _ ⟨w, rfl⟩
  have hmemL : ∀ l v, ρ (ι l) (F v) ∈ LinearMap.range F := by
    intro l v
    have := hfint l v
    change F (X l v) = ρ (ι l) (F v) at this
    rw [← this]
    exact ⟨_, rfl⟩
  have hpow : ∀ (k : ℕ) (w : Fin n → ℂ), ∃ w', ρ (a ^ k) (F w) = F w' := by
    intro k
    induction k with
    | zero => intro w; exact ⟨w, by simp⟩
    | succ k ih =>
      intro w
      obtain ⟨w₁, hw₁⟩ := hmemA w
      obtain ⟨w₂, hw₂⟩ := ih w₁
      refine ⟨w₂, ?_⟩
      rw [pow_succ, map_mul, Module.End.mul_apply, ← hw₁, hw₂]
  have hinvar : ∀ x : A, ∀ ⦃v⦄, v ∈ LinearMap.range F → ρ x v ∈ LinearMap.range F := by
    intro x v hv
    obtain ⟨l, k, rfl⟩ := hgen x
    obtain ⟨w, rfl⟩ := hv
    rw [map_mul, Module.End.mul_apply]
    obtain ⟨w', hw'⟩ := hpow k w
    rw [hw']
    exact hmemL l w'
  let S : Subrepresentation ρ := ⟨LinearMap.range F, fun x _ hv => hinvar x hv⟩
  have hnt : Nontrivial (Fin n → ℂ) := Module.nontrivial_of_finrank_pos hX.finrank_pos
  have hS : S = ⊤ := by
    rcases eq_bot_or_eq_top S with h | h
    · exfalso
      obtain ⟨v, hv0⟩ := exists_ne (0 : Fin n → ℂ)
      have hv : F v ∈ S.toSubmodule := ⟨v, rfl⟩
      rw [h] at hv
      have hv' : F v ∈ (⊥ : Submodule ℂ (Fin m → ℂ)) := hv
      rw [Submodule.mem_bot] at hv'
      exact hv0 (hfinj (by change F v = F 0; rw [hv', map_zero]))
    · exact h
  have hsurj : Function.Surjective F := by
    intro v
    have : v ∈ S.toSubmodule := by rw [hS]; trivial
    obtain ⟨w, hw⟩ := this
    exact ⟨w, hw⟩
  have hdim : finrank ℂ (Fin n → ℂ) = finrank ℂ (Fin m → ℂ) :=
    LinearEquiv.finrank_eq (LinearEquiv.ofBijective F ⟨hfinj, hsurj⟩)
  rw [Representation.char_one, Representation.char_one, hdim]

end

end CFSGOutside.Gagola
