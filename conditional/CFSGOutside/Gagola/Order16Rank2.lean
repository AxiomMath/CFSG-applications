import CFSGOutside.Corpus.RankTwoSylowShapes
import CFSGOutside.Corpus.HoltAtMostOneInvolution
import CFSGOutside.Corpus.CardStatedClassicalModelTwo
import CFSGOutside.Corpus.Defs.TwoRank

/-!
# Nonabelian Sylow 2-subgroups of order 16 in simple groups of 2-rank at most two

If a finite nonabelian simple group `X` of 2-rank at most two has a nonabelian Sylow 2-subgroup `S` of order
16, then `S` has an element of order 8. The inputs are `HoltAtMostOneInvolution` (2-rank one),
`RankTwoSylowShapes` (2-rank two) and `CardStatedClassicalModelTwo` (to exclude `PSU(3, 4)`).
-/

namespace CFSGOutside.Gagola

open CFSGOutside.Corpus

section Rank

variable {X : Type} [Group X] [Finite X]

/-- Elementary abelian subgroups have order at most two when the 2-rank is at most one. -/
lemma card_le_two_of_elemAbelian (h : Open.twoRank X ≤ 1) (E : Subgroup X)
    (hE : Open.IsElemAbelian 2 E) : Nat.card E ≤ 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hp : IsPGroup 2 E := by
    rw [IsPGroup.iff_orderOf]
    intro x
    have h2 : orderOf x ∣ 2 ^ 1 := by
      rw [pow_one]
      apply orderOf_dvd_of_pow_eq_one
      apply Subtype.ext
      simpa using hE.2 x x.2
    obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 h2
    exact ⟨k, hk⟩
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 hp
  have hbdd : BddAbove {k | ∃ E' : Subgroup X, E' ≤ ⊤ ∧ Open.IsElemAbelian 2 E' ∧
      Nat.card E' = 2 ^ k} := by
    refine ⟨Nat.card X, ?_⟩
    rintro k ⟨E', -, -, hk⟩
    have := Subgroup.card_le_card_group E'
    rw [hk] at this
    exact (Nat.lt_two_pow_self (n := k)).le.trans this
  have hnle : n ≤ Open.twoRank X := le_csSup hbdd ⟨E, le_top, hE, hn⟩
  calc Nat.card E = 2 ^ n := hn
    _ ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)

/-- The four-element subgroup generated by two commuting involutions. -/
def kleinSub (s z : X) (hs : s * s = 1) (hz : z * z = 1) (hc : z * s = s * z) : Subgroup X where
  carrier := {1, s, z, s * z}
  mul_mem' := by
    have l1 : ∀ x, s * (s * x) = x := fun x => by rw [← mul_assoc, hs, one_mul]
    have l2 : ∀ x, z * (z * x) = x := fun x => by rw [← mul_assoc, hz, one_mul]
    have l3 : ∀ x, z * (s * x) = s * (z * x) := fun x => by rw [← mul_assoc, hc, mul_assoc]
    intro a b ha hb
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb ⊢
    rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
      simp [mul_assoc, hs, hz, hc, l1, l2, l3]
  one_mem' := by simp
  inv_mem' := by
    have hs' : s⁻¹ = s := inv_eq_of_mul_eq_one_right hs
    have hz' : z⁻¹ = z := inv_eq_of_mul_eq_one_right hz
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha ⊢
    rcases ha with rfl | rfl | rfl | rfl <;> simp [hs', hz', hc]

lemma eq_of_commute_involutions (h : Open.twoRank X ≤ 1) (s z : X) (hs : orderOf s = 2)
    (hz : orderOf z = 2) (hc : z * s = s * z) : s = z := by
  by_contra hne
  have hs2 : s * s = 1 := by rw [← sq]; exact orderOf_dvd_iff_pow_eq_one.1 (by rw [hs])
  have hz2 : z * z = 1 := by rw [← sq]; exact orderOf_dvd_iff_pow_eq_one.1 (by rw [hz])
  have hs1 : s ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hs; omega
  have hz1 : z ≠ 1 := fun h1 => by rw [h1, orderOf_one] at hz; omega
  have hE : Open.IsElemAbelian 2 (kleinSub s z hs2 hz2 hc) := by
    have l1 : ∀ x, s * (s * x) = x := fun x => by rw [← mul_assoc, hs2, one_mul]
    have l2 : ∀ x, z * (z * x) = x := fun x => by rw [← mul_assoc, hz2, one_mul]
    have l3 : ∀ x, z * (s * x) = s * (z * x) := fun x => by rw [← mul_assoc, hc, mul_assoc]
    refine ⟨⟨⟨fun a b => ?_⟩⟩, fun x hx => ?_⟩
    · apply Subtype.ext
      obtain ⟨a, ha⟩ := a
      obtain ⟨b, hb⟩ := b
      change a * b = b * a
      change a ∈ ({1, s, z, s * z} : Set X) at ha
      change b ∈ ({1, s, z, s * z} : Set X) at hb
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
      rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
        simp [mul_assoc, hs2, hz2, hc, l1, l2, l3]
    · change x ∈ ({1, s, z, s * z} : Set X) at hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl | rfl | rfl <;> simp [sq, mul_assoc, hs2, hz2, hc, l1, l2, l3]
  have hcard := card_le_two_of_elemAbelian h _ hE
  have := Fintype.ofFinite (kleinSub s z hs2 hz2 hc)
  have h3 : 2 < Fintype.card (kleinSub s z hs2 hz2 hc) := by
    apply Fintype.two_lt_card_iff.mpr
    refine ⟨⟨1, by simp [kleinSub]⟩, ⟨s, by simp [kleinSub]⟩, ⟨z, by simp [kleinSub]⟩, ?_, ?_, ?_⟩
    · intro e; exact hs1 (by simpa using (congrArg Subtype.val e).symm)
    · intro e; exact hz1 (by simpa using (congrArg Subtype.val e).symm)
    · intro e; exact hne (by simpa using congrArg Subtype.val e)
  rw [← Nat.card_eq_fintype_card] at h3
  omega

end Rank

section Atmost

variable {X : Type} [Group X] [Finite X]

lemma atMostOne_of_rank (h : Open.twoRank X ≤ 1) (S : Subgroup X) (hS : IsPGroup 2 S)
    [Nontrivial S] : AtMostOneInvolution S := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  haveI : Nontrivial (Subgroup.center S) := hS.center_nontrivial
  have hC : IsPGroup 2 (Subgroup.center S) := hS.to_subgroup _
  obtain ⟨n, hn⟩ := (IsPGroup.iff_card).1 hC
  have hn0 : n ≠ 0 := by
    rintro rfl
    have := Finite.one_lt_card (α := Subgroup.center S)
    rw [pow_zero] at hn
    omega
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := Subgroup.center S) 2
    (by rw [hn]; exact dvd_pow_self 2 hn0)
  have hzc : ∀ g : S, g * (z : S) = (z : S) * g := fun g =>
    (Subgroup.mem_center_iff.1 z.2 g)
  have key : ∀ s : S, orderOf s = 2 → s = (z : S) := by
    intro s hs
    have hz' : orderOf (z : S) = 2 := by rw [← hz]; exact Subgroup.orderOf_coe z
    apply Subtype.ext
    apply eq_of_commute_involutions h
    · rw [Subgroup.orderOf_coe, hs]
    · rw [Subgroup.orderOf_coe, hz']
    · exact congrArg Subtype.val (hzc s).symm
  intro s t hs ht
  rw [key s hs, key t ht]

end Atmost

section Transport

lemma exists8_of_equiv {X : Type} [Group X] {S : Subgroup X} {G' : Type*} [Group G']
    (e : S ≃* G') {g : G'} (hg : orderOf g = 8) : ∃ x ∈ S, orderOf x = 8 :=
  ⟨(e.symm g : X), (e.symm g).2, by rw [Subgroup.orderOf_coe, MulEquiv.orderOf_eq, hg]⟩

lemma natCard_dihedral (m : ℕ) [NeZero m] : Nat.card (DihedralGroup m) = 2 * m := by
  rw [Nat.card_eq_fintype_card, DihedralGroup.card]

lemma natCard_quaternion (m : ℕ) [NeZero m] : Nat.card (QuaternionGroup m) = 4 * m := by
  rw [Nat.card_eq_fintype_card, QuaternionGroup.card]

end Transport

section Semidihedral

/-- A group of order 16 generated by `x` and `b`, with `b` an involution normalising `⟨x⟩`, has an element
of order 8. -/
lemma exists_orderOf_eight_of_generators {P : Type*} [Group P] [Finite P] (hP : Nat.card P = 16)
    (x b : P) (hgen : ∀ g : P, g ∈ Subgroup.closure ({x, b} : Set P)) (hb : b * b = 1)
    (hbx : b * x * b⁻¹ ∈ Subgroup.zpowers x) : ∃ g : P, orderOf g = 8 := by
  have hdvd : orderOf x ∣ 2 ^ 4 := by
    have := orderOf_dvd_natCard x
    rwa [hP] at this
  obtain ⟨k, hk, hkx⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hdvd
  have hbinv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  by_cases hk3 : k = 3
  · exact ⟨x, by rw [hkx, hk3]; norm_num⟩
  by_cases hk4 : k = 4
  · refine ⟨x ^ 2, ?_⟩
    rw [orderOf_pow_of_dvd (by norm_num) (by rw [hkx, hk4]; norm_num), hkx, hk4]
    norm_num
  exfalso
  have hx4 : x ^ 4 = 1 := by
    apply orderOf_dvd_iff_pow_eq_one.1
    rw [hkx]
    have : 2 ^ k ∣ 2 ^ 2 := pow_dvd_pow 2 (by omega)
    simpa using this
  -- the subgroup `⟨x⟩` is normal
  set N : Subgroup P := Subgroup.zpowers x with hN
  have hbN : ∀ y, y ∈ N → b * y * b⁻¹ ∈ N := by
    intro y hy
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.1 hy
    have : b * x ^ i * b⁻¹ = (b * x * b⁻¹) ^ i := by
      rw [← conj_zpow]
    rw [this]
    exact Subgroup.zpow_mem _ hbx i
  have hnorm : N.Normal := by
    refine ⟨fun y hy g => ?_⟩
    have key : ∀ g ∈ Subgroup.closure ({x, b} : Set P), ∀ y ∈ N,
        g * y * g⁻¹ ∈ N ∧ g⁻¹ * y * g ∈ N := by
      intro g hg
      refine Subgroup.closure_induction (p := fun g _ => ∀ y ∈ N, g * y * g⁻¹ ∈ N ∧ g⁻¹ * y * g ∈ N)
        ?_ ?_ ?_ ?_ hg
      · rintro g (rfl | rfl) y hy
        · refine ⟨?_, ?_⟩
          · exact N.mul_mem (N.mul_mem (Subgroup.mem_zpowers _) hy) (N.inv_mem (Subgroup.mem_zpowers _))
          · exact N.mul_mem (N.mul_mem (N.inv_mem (Subgroup.mem_zpowers _)) hy) (Subgroup.mem_zpowers _)
        · refine ⟨hbN y hy, ?_⟩
          have := hbN y hy
          rwa [hbinv] at this ⊢
      · intro y hy; simpa using hy
      · intro g h _ _ hg hh y hy
        refine ⟨?_, ?_⟩
        · have := (hg _ ((hh y hy).1))
          simpa [mul_assoc] using this.1
        · have := (hh _ ((hg y hy).2))
          simpa [mul_assoc] using this.2
      · intro g _ hg y hy
        simpa using (hg y hy).symm
    exact (key g (hgen g) y hy).1
  have hcardN : Nat.card N ≤ 4 := by
    rw [hN, Nat.card_zpowers]
    exact Nat.le_of_dvd (by norm_num) (orderOf_dvd_of_pow_eq_one hx4)
  have hq : Nat.card (P ⧸ N) ≤ 2 := by
    set π := QuotientGroup.mk' N with hπ
    have hπx : π x = 1 := by
      rw [hπ, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Subgroup.mem_zpowers x
    have hπb : Subgroup.zpowers (π b) = ⊤ := by
      rw [eq_top_iff]
      intro q _
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
      have hle : Subgroup.closure ({x, b} : Set P) ≤ (Subgroup.zpowers (π b)).comap π := by
        rw [Subgroup.closure_le]
        rintro y (rfl | rfl)
        · simp [hπx]
        · exact Subgroup.mem_zpowers _
      exact hle (hgen g)
    rw [← Subgroup.card_top (G := P ⧸ N), ← hπb, Nat.card_zpowers]
    apply Nat.le_of_dvd (by norm_num)
    apply orderOf_dvd_of_pow_eq_one
    rw [sq, ← map_mul, hb, map_one]
  have h16 := Subgroup.card_eq_card_quotient_mul_card_subgroup N
  rw [hP] at h16
  nlinarith

lemma exists8_of_semidihedral (n : ℕ) (hP : Nat.card (Open.SemidihedralGroup n) = 16) :
    ∃ g : Open.SemidihedralGroup n, orderOf g = 8 := by
  haveI : Finite (Open.SemidihedralGroup n) := Nat.finite_of_card_ne_zero (by omega)
  have h1 : PresentedGroup.mk (Open.semidihedralRels n) (FreeGroup.of 1 ^ 2) = 1 :=
    PresentedGroup.one_of_mem (by simp [Open.semidihedralRels])
  have h2 : PresentedGroup.mk (Open.semidihedralRels n)
      (FreeGroup.of 1 * FreeGroup.of 0 * (FreeGroup.of 1)⁻¹ * (FreeGroup.of 0 ^ (2 ^ (n - 2) - 1))⁻¹)
      = 1 :=
    PresentedGroup.one_of_mem (by simp [Open.semidihedralRels])
  simp only [map_mul, map_pow, map_inv] at h1 h2
  refine exists_orderOf_eight_of_generators hP (PresentedGroup.of 0) (PresentedGroup.of 1) ?_ ?_ ?_
  · intro g
    have h := PresentedGroup.closure_range_of (Open.semidihedralRels n)
    have hr : Set.range (PresentedGroup.of : Fin 2 → Open.SemidihedralGroup n) =
        {PresentedGroup.of 0, PresentedGroup.of 1} := by
      ext y; simp [Fin.exists_fin_two, eq_comm]
    rw [hr] at h
    rw [h]; trivial
  · rw [← sq]; exact h1
  · rw [mul_inv_eq_one] at h2
    have h3 : (PresentedGroup.of 1 * PresentedGroup.of 0 * (PresentedGroup.of 1)⁻¹ :
        Open.SemidihedralGroup n) = PresentedGroup.of 0 ^ (2 ^ (n - 2) - 1) := h2
    rw [h3]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers _) _

end Semidihedral

section Final

variable {X : Type} [Group X] [Finite X]

/-- A Sylow 2-subgroup of order 16 of a group with a model `PSU(3, 4)` cannot occur: `|PSU(3, 4)| = 62400`
has Sylow 2-subgroups of order 64. -/
lemma not_unitary [CardStatedClassicalModelTwo] {H : Type} [Group H]
    (hH : Open.StatedClassicalModel H .PSU 3 2 2) (U : Sylow 2 H) : Nat.card U ≠ 16 := by
  have hc : Nat.card H = 62400 := by
    have := (CardStatedClassicalModelTwo.card_statedClassicalModel_two hH).2.1 rfl
    rw [this]
    decide +kernel
  haveI : Finite H := Nat.finite_of_card_ne_zero (by omega)
  intro h16
  have h1 := Subgroup.card_mul_index (U : Subgroup H)
  have h2 := U.not_dvd_index
  rw [hc, show Nat.card (U : Subgroup H) = 16 from h16] at h1
  apply h2
  omega

lemma not_wreathed (n : ℕ) (hn : 2 ≤ n) : Nat.card (Open.WreathedTwoGroup n) ≠ 16 := by
  intro h
  rw [RegularWreathProduct.card] at h
  have e1 : Nat.card (Multiplicative (ZMod (2 ^ n))) = 2 ^ n := by
    haveI : NeZero (2 ^ n) := ⟨by positivity⟩
    rw [Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
  have e2 : Nat.card (Multiplicative (ZMod 2)) = 2 := by
    rw [Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
  rw [e1, e2] at h
  have : 4 ≤ 2 ^ n := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) hn
  nlinarith

/-- A nonabelian Sylow 2-subgroup of order 16 in a simple group of 2-rank at most two has an element of
order 8. -/
theorem sylow16_rank_le_two [RankTwoSylowShapes] [HoltAtMostOneInvolution.{0}]
    [CardStatedClassicalModelTwo]
    {X : Type} [Group X] [Finite X] [IsSimpleGroup X] (hnonab : ∃ a b : X, a * b ≠ b * a)
    (S : Sylow 2 X) (hS : Nat.card S = 16) (hSnab : ¬ IsMulCommutative (S : Subgroup X))
    (hrank : CFSGOutside.Corpus.Open.twoRank X ≤ 2) : ∃ x ∈ (S : Subgroup X), orderOf x = 8 := by
  haveI : Nontrivial (S : Subgroup X) := Finite.one_lt_card_iff_nontrivial.1 (by rw [hS]; norm_num)
  rcases Nat.lt_or_ge (Open.twoRank X) 2 with h1 | h2
  · -- 2-rank at most one
    have hP : IsPGroup 2 (S : Subgroup X) := S.isPGroup'
    have hone := atMostOne_of_rank (by omega) (S : Subgroup X) hP
    rcases HoltAtMostOneInvolution.isCyclic_or_quaternion_of_atMostOneInvolution hP hone with
      hcyc | ⟨n, hn, ⟨e⟩⟩
    · exact absurd (by
        haveI := hcyc
        exact ⟨⟨fun a b => IsCyclic.commGroup.mul_comm a b⟩⟩) hSnab
    · haveI : NeZero (2 ^ (n - 2)) := ⟨by positivity⟩
      have hc := natCard_quaternion (2 ^ (n - 2))
      rw [← Nat.card_congr e.toEquiv, hS] at hc
      refine exists8_of_equiv e (g := QuaternionGroup.a 1) ?_
      rw [QuaternionGroup.orderOf_a_one]
      omega
  · have hr2 : Open.twoRank X = 2 := le_antisymm hrank h2
    rcases RankTwoSylowShapes.rank_two_sylow_shapes hnonab hr2 S with
      ⟨n, hn, ⟨e⟩⟩ | ⟨n, hn, ⟨e⟩⟩ | ⟨n, hn, ⟨e⟩⟩ | ⟨H, _, U, hH, ⟨e⟩⟩
    · haveI : NeZero (2 ^ (n - 1)) := ⟨by positivity⟩
      have hc := natCard_dihedral (2 ^ (n - 1))
      rw [← Nat.card_congr e.toEquiv, hS] at hc
      refine exists8_of_equiv e (g := DihedralGroup.r 1) ?_
      rw [DihedralGroup.orderOf_r_one]
      omega
    · have hc : Nat.card (Open.SemidihedralGroup n) = 16 := by
        rw [← Nat.card_congr e.toEquiv, hS]
      obtain ⟨g, hg⟩ := exists8_of_semidihedral n hc
      exact exists8_of_equiv e hg
    · exact absurd (by rw [← Nat.card_congr e.toEquiv, hS]) (not_wreathed n hn)
    · exact absurd (by rw [← Nat.card_congr e.toEquiv, hS]) (not_unitary hH U)

end Final


end CFSGOutside.Gagola
