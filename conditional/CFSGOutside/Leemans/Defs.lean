import Mathlib

/-!
# C-groups and string C-groups

The definitions used in the statement of Leemans' theorem. D. Leemans, *Almost simple groups of Suzuki type
acting on polytopes*, Proc. Amer. Math. Soc. **134** (2006), 3649–3651, DOI 10.1090/S0002-9939-06-08448-6,
Theorem 1.
-/

namespace CFSGOutside.Leemans

/-- A *string C-group* of rank `n` (the automorphism group of an abstract regular `n`-polytope), as in
Leemans, Theorem 1: `G` is generated by involutions `ρ 0, …, ρ (n-1)`, with `ρ i` and `ρ j` commuting when
`|i - j| ≥ 2`, and the intersection property
`⟨ρ i : i ∈ I⟩ ∩ ⟨ρ j : j ∈ J⟩ = ⟨ρ k : k ∈ I ∩ J⟩`. -/
structure IsStringCGroup {G : Type*} [Group G] {n : ℕ} (ρ : Fin n → G) : Prop where
  involution : ∀ i, orderOf (ρ i) = 2
  generates : Subgroup.closure (Set.range ρ) = ⊤
  string : ∀ i j : Fin n, i.val + 2 ≤ j.val → ρ i * ρ j = ρ j * ρ i
  intersection : ∀ I J : Set (Fin n),
    Subgroup.closure (ρ '' I) ⊓ Subgroup.closure (ρ '' J) = Subgroup.closure (ρ '' (I ∩ J))

/-- A *C-group* of rank `n`, as in Leemans, Theorem 1: `G` is generated by involutions `ρ 0, …, ρ (n-1)`
satisfying the intersection property `⟨ρ i : i ∈ I⟩ ∩ ⟨ρ j : j ∈ J⟩ = ⟨ρ k : k ∈ I ∩ J⟩`. -/
structure IsCGroup {G : Type*} [Group G] {n : ℕ} (ρ : Fin n → G) : Prop where
  involution : ∀ i, orderOf (ρ i) = 2
  generates : Subgroup.closure (Set.range ρ) = ⊤
  intersection : ∀ I J : Set (Fin n),
    Subgroup.closure (ρ '' I) ⊓ Subgroup.closure (ρ '' J) = Subgroup.closure (ρ '' (I ∩ J))

end CFSGOutside.Leemans
