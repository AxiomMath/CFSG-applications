/-!
# A rank-three string C-group presentation of the Suzuki groups

For `X ≅ Sz(q)`, `q = 2 ^ n` (`IsSz n X`), `exists_rank_three` gives three involutions `ρ₀, ρ₁, ρ₂` of
`X` generating it, with `ρ₀ρ₂ = ρ₂ρ₀`, `o(ρ₀ρ₁) = q - 1`, and the intersection property of C-groups
(Leemans' construction). `⟨ρ₀, ρ₁⟩` is the maximal dihedral subgroup `D_{2(q-1)}` of `Sz(q)`.

The inputs are the corpus facts about `Sz(q)` stated as classes in `CFSGOutside.Corpus`: the point/torus axioms
`SuzukiTorusData`, involution centralizers are `2`-groups, and the local analysis of subgroups containing a
torus (`EqTopOrLeNormalizerTorus`).
-/

noncomputable section

namespace CFSGOutside.Leemans

open Subgroup
open CFSGOutside.Corpus (IsSz SuzukiTorusData SuzukiMatrixGroup EqTopOrLeNormalizerTorus
  IsPGroupCentralizerOfIsSz Opq4dExistsMulEquivSuzukiMatrixGroup SuzukiTorusDataOfMulEquiv
  SuzukiTorusDataSuzukiMatrixGroup)

/-! ### Groups generated by two involutions -/

section Dihedral

variable {G : Type*} [Group G]

theorem zpow_eq_one_or_self {c : G} (hc : c * c = 1) (i : ℤ) : c ^ i = 1 ∨ c ^ i = c := by
  obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' i
  · left
    rw [zpow_mul, zpow_two, hc, one_zpow]
  · right
    rw [zpow_add, zpow_mul, zpow_two, hc, one_zpow, one_mul, zpow_one]

theorem eq_one_or_eq_of_mem_closure_singleton {a x : G} (ha : a * a = 1)
    (hx : x ∈ closure {a}) : x = 1 ∨ x = a := by
  rw [← zpowers_eq_closure] at hx
  obtain ⟨i, rfl⟩ := mem_zpowers_iff.mp hx
  exact zpow_eq_one_or_self ha i

theorem mul_zpow_conj {a b : G} (ha : a * a = 1) (hb : b * b = 1) (i : ℤ) :
    a * (a * b) ^ i = (a * b) ^ (-i) * a := by
  have hainv : a⁻¹ = a := inv_eq_of_mul_eq_one_right ha
  have hbinv : b⁻¹ = b := inv_eq_of_mul_eq_one_right hb
  have h1 : a * (a * b) * a⁻¹ = (a * b)⁻¹ := by
    rw [mul_inv_rev, hainv, hbinv, ← mul_assoc, ha, one_mul]
  have h2 : a * (a * b) ^ i * a⁻¹ = (a * b) ^ (-i) := by
    rw [← conj_zpow, h1, zpow_neg, inv_zpow]
  calc a * (a * b) ^ i = a * (a * b) ^ i * a⁻¹ * a := (inv_mul_cancel_right _ a).symm
    _ = (a * b) ^ (-i) * a := by rw [h2]

/-- Every element of the group generated by two involutions `a, b` is a "rotation" `(ab)^i` or a
"reflection" `(ab)^i a`. -/
theorem mem_closure_pair_dihedral {a b x : G} (ha : a * a = 1) (hb : b * b = 1)
    (hx : x ∈ closure {a, b}) : ∃ i : ℤ, x = (a * b) ^ i ∨ x = (a * b) ^ i * a := by
  have hc := mul_zpow_conj ha hb
  let D : Subgroup G :=
    { carrier := {x | ∃ i : ℤ, x = (a * b) ^ i ∨ x = (a * b) ^ i * a}
      mul_mem' := by
        rintro x y ⟨i, rfl | rfl⟩ ⟨j, rfl | rfl⟩
        · exact ⟨i + j, Or.inl (zpow_add _ _ _).symm⟩
        · exact ⟨i + j, Or.inr (by rw [zpow_add, mul_assoc])⟩
        · exact ⟨i + -j, Or.inr (by rw [mul_assoc, hc, ← mul_assoc, zpow_add])⟩
        · exact ⟨i + -j, Or.inl (by
            rw [mul_assoc, ← mul_assoc a, hc, mul_assoc, ha, mul_one, zpow_add])⟩
      one_mem' := ⟨0, Or.inl (zpow_zero _).symm⟩
      inv_mem' := by
        rintro x ⟨i, rfl | rfl⟩
        · exact ⟨-i, Or.inl (zpow_neg _ _).symm⟩
        · refine ⟨i, Or.inr ?_⟩
          rw [mul_inv_rev, inv_eq_of_mul_eq_one_right ha, ← zpow_neg, hc, neg_neg] }
  have hle : closure {a, b} ≤ D := by
    rw [closure_le]
    intro y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with rfl | rfl
    · exact ⟨0, Or.inr (by rw [zpow_zero, one_mul])⟩
    · exact ⟨-1, Or.inr (by
        rw [zpow_neg, zpow_one, mul_inv_rev, inv_mul_cancel_right,
          inv_eq_of_mul_eq_one_right hb])⟩
  exact hle hx

theorem reflection_mul_self {a b : G} (ha : a * a = 1) (hb : b * b = 1) (i : ℤ) :
    ((a * b) ^ i * a) * ((a * b) ^ i * a) = 1 := by
  rw [mul_assoc, ← mul_assoc a, mul_zpow_conj ha hb, mul_assoc, ha, mul_one, ← zpow_add,
    add_neg_cancel, zpow_zero]

/-- Two commuting involutions generate a group of order at most four. -/
theorem mem_closure_pair_of_commute {a b x : G} (ha : a * a = 1) (hb : b * b = 1)
    (hab : a * b = b * a) (hx : x ∈ closure {a, b}) :
    x = 1 ∨ x = a ∨ x = b ∨ x = a * b := by
  have hc : (a * b) * (a * b) = 1 := by
    calc (a * b) * (a * b) = a * (b * a) * b := by group
      _ = a * (a * b) * b := by rw [hab]
      _ = (a * a) * (b * b) := by group
      _ = 1 := by rw [ha, hb, one_mul]
  obtain ⟨i, rfl | rfl⟩ := mem_closure_pair_dihedral ha hb hx
  · rcases zpow_eq_one_or_self hc i with h | h <;> simp [h]
  · rcases zpow_eq_one_or_self hc i with h | h
    · simp [h]
    · right; right; left
      rw [h, mul_assoc, ← hab, ← mul_assoc, ha, one_mul]

theorem inf_eq_bot_of_not_mem {a : G} (ha : a * a = 1) {K : Subgroup G} (hK : a ∉ K) :
    closure {a} ⊓ K = ⊥ := by
  rw [eq_bot_iff_forall]
  rintro x ⟨hx1, hx2⟩
  rcases eq_one_or_eq_of_mem_closure_singleton ha hx1 with rfl | rfl
  · rfl
  · exact (hK hx2).elim

theorem eq_one_of_mul_self_eq_one_of_odd {y : G} (hy : y * y = 1) (ho : Odd (orderOf y)) :
    y = 1 := by
  have h2 : orderOf y ∣ 2 := orderOf_dvd_of_pow_eq_one (by rw [sq, hy])
  rcases (Nat.dvd_prime Nat.prime_two).mp h2 with h | h
  · exact orderOf_eq_one_iff.mp h
  · rw [h] at ho
    exact absurd ho (by decide)

theorem mul_self_eq_one_of_orderOf {y : G} (hy : orderOf y = 2) : y * y = 1 := by
  rw [← sq, ← hy, pow_orderOf_eq_one]

/-- The intersection property for three generators, from the six "local" cases. -/
theorem intersection_rank_three (a b c : G)
    (h01_12 : closure {a, b} ⊓ closure {b, c} ≤ closure {b})
    (h01_02 : closure {a, b} ⊓ closure {a, c} ≤ closure {a})
    (h02_12 : closure {a, c} ⊓ closure {b, c} ≤ closure {c})
    (h0 : closure {a} ⊓ closure {b, c} = ⊥) (h1 : closure {b} ⊓ closure {a, c} = ⊥)
    (h2 : closure {c} ⊓ closure {a, b} = ⊥) (I J : Set (Fin 3)) :
    closure (![a, b, c] '' I) ⊓ closure (![a, b, c] '' J) =
      closure (![a, b, c] '' (I ∩ J)) := by
  set ρ := ![a, b, c] with hρ
  have hP : ∀ i j k : Fin 3, i ≠ j → i ≠ k → j ≠ k →
      closure (ρ '' {i, k}) ⊓ closure (ρ '' {j, k}) ≤ closure (ρ '' {k}) := by
    intro i j k hij hik hjk
    fin_cases i <;> fin_cases j <;> fin_cases k <;> simp [hρ] at hij hik hjk ⊢ <;>
      (try simp only [Set.pair_comm c b, Set.pair_comm b a, Set.pair_comm c a]) <;>
      first
      | exact h01_12 | exact h01_02 | exact h02_12
      | exact (inf_comm _ _).trans_le h01_12 | exact (inf_comm _ _).trans_le h01_02
      | exact (inf_comm _ _).trans_le h02_12
  have hQ : ∀ i j k : Fin 3, i ≠ j → i ≠ k → j ≠ k →
      closure (ρ '' {i, k}) ⊓ closure (ρ '' {j}) = ⊥ := by
    intro i j k hij hik hjk
    fin_cases i <;> fin_cases j <;> fin_cases k <;> simp [hρ] at hij hik hjk ⊢ <;>
      (try simp only [Set.pair_comm c b, Set.pair_comm b a, Set.pair_comm c a]) <;>
      first
      | exact (inf_comm _ _).trans h0 | exact (inf_comm _ _).trans h1
      | exact (inf_comm _ _).trans h2
  have hmono : ∀ {A B : Set (Fin 3)}, A ⊆ B → closure (ρ '' A) ≤ closure (ρ '' B) :=
    fun h => closure_mono (Set.image_mono h)
  refine le_antisymm ?_ (le_inf (hmono Set.inter_subset_left) (hmono Set.inter_subset_right))
  by_cases hIJ : I ⊆ J
  · rw [Set.inter_eq_left.mpr hIJ]; exact inf_le_left
  by_cases hJI : J ⊆ I
  · rw [Set.inter_eq_right.mpr hJI]; exact inf_le_right
  obtain ⟨i, hiI, hiJ⟩ := Set.not_subset.mp hIJ
  obtain ⟨j, hjJ, hjI⟩ := Set.not_subset.mp hJI
  have hij : i ≠ j := fun h => hjI (h ▸ hiI)
  obtain ⟨k, hki, hkj, hall⟩ : ∃ k : Fin 3, k ≠ i ∧ k ≠ j ∧ ∀ x : Fin 3, x = i ∨ x = j ∨ x = k := by
    fin_cases i <;> fin_cases j <;>
      first
      | exact absurd rfl hij
      | exact ⟨0, by decide⟩ | exact ⟨1, by decide⟩ | exact ⟨2, by decide⟩
  have hI : I ⊆ {i, k} := fun x hx => by
    rcases hall x with rfl | rfl | rfl
    · exact Or.inl rfl
    · exact absurd hx hjI
    · exact Or.inr rfl
  have hJ : J ⊆ {j, k} := fun x hx => by
    rcases hall x with rfl | rfl | rfl
    · exact absurd hx hiJ
    · exact Or.inl rfl
    · exact Or.inr rfl
  by_cases hkI : k ∈ I
  · by_cases hkJ : k ∈ J
    · calc _ ≤ closure (ρ '' {i, k}) ⊓ closure (ρ '' {j, k}) := inf_le_inf (hmono hI) (hmono hJ)
        _ ≤ closure (ρ '' {k}) := hP i j k hij hki.symm hkj.symm
        _ ≤ _ := hmono (Set.singleton_subset_iff.mpr (show k ∈ I ∩ J from ⟨hkI, hkJ⟩))
    · have hJ' : J ⊆ {j} := fun x hx => by
        rcases hJ hx with h | h
        · exact h
        · exact absurd (h ▸ hx) hkJ
      calc _ ≤ closure (ρ '' {i, k}) ⊓ closure (ρ '' {j}) := inf_le_inf (hmono hI) (hmono hJ')
        _ = ⊥ := hQ i j k hij hki.symm hkj.symm
        _ ≤ _ := bot_le
  · have hI' : I ⊆ {i} := fun x hx => by
      rcases hI hx with h | h
      · exact h
      · exact absurd (h ▸ hx) hkI
    calc _ ≤ closure (ρ '' {i}) ⊓ closure (ρ '' {j, k}) := inf_le_inf (hmono hI') (hmono hJ)
      _ = ⊥ := by rw [inf_comm]; exact hQ j i k hij.symm hkj.symm hki.symm
      _ ≤ _ := bot_le

end Dihedral

/-! ### Consequences of the point/torus axioms -/

section TorusData

variable {X : Type*} [Group X] [Finite X] {q : ℕ}

/-- The torus `N(U) ∩ N(V)` of two Sylow `2`-subgroups. -/
abbrev torus (U V : Sylow 2 X) : Subgroup X :=
  normalizer ((U : Subgroup X) : Set X) ⊓ normalizer ((V : Subgroup X) : Set X)

theorem mem_torus {U V : Sylow 2 X} {g : X} : g ∈ torus U V ↔ g • U = U ∧ g • V = V :=
  ⟨fun h => ⟨Sylow.smul_eq_iff_mem_normalizer.mpr h.1, Sylow.smul_eq_iff_mem_normalizer.mpr h.2⟩,
    fun h => ⟨Sylow.smul_eq_iff_mem_normalizer.mp h.1, Sylow.smul_eq_iff_mem_normalizer.mp h.2⟩⟩

theorem card_torus (h : SuzukiTorusData X q) {U V : Sylow 2 X} (hne : U ≠ V) :
    Nat.card (torus U V) = q - 1 :=
  h.inf_normalizer_card U V hne

/-- A nonidentity element fixing two points fixes no third point. -/
theorem eq_or_eq_of_smul_eq (h : SuzukiTorusData X q) {g : X} (hg : g ≠ 1) {U V P : Sylow 2 X}
    (hUV : U ≠ V) (hU : g • U = U) (hV : g • V = V) (hP : g • P = P) : P = U ∨ P = V := by
  by_contra hne
  push Not at hne
  obtain ⟨hPU, hPV⟩ := hne
  have hVU := hUV.symm
  have hUP := hPU.symm
  have hVP := hPV.symm
  have hle := h.fixes_le_two g hg
  let f : Fin 3 → {S : Sylow 2 X // g • S = S} := ![⟨U, hU⟩, ⟨V, hV⟩, ⟨P, hP⟩]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f]
  have := Nat.card_le_card_of_injective f hf
  rw [Nat.card_eq_fintype_card (α := Fin 3), Fintype.card_fin] at this
  omega

theorem exists_ne_sylow (h : SuzukiTorusData X q) (hq : 1 ≤ q) (U : Sylow 2 X) :
    ∃ V, V ≠ U := by
  by_contra hcon
  push Not at hcon
  have h1 := Nat.card_le_card_of_surjective (fun _ : Fin 1 => U) (fun A => ⟨0, (hcon A).symm⟩)
  rw [h.card_points, Nat.card_eq_fintype_card (α := Fin 1), Fintype.card_fin] at h1
  have : 0 < q ^ 2 := pow_pos hq 2
  omega

/-- The point stabilizer acts regularly on the other points, so `X` is `2`-transitive: some
element swaps two given points. -/
theorem exists_swap (h : SuzukiTorusData X q) {U V : Sylow 2 X} (hne : U ≠ V) :
    ∃ g : X, g • U = V ∧ g • V = U := by
  obtain ⟨g₁, hg₁⟩ := MulAction.exists_smul_eq X U V
  have hW : g₁ • V ≠ V := by
    intro hh
    exact hne (MulAction.injective g₁ (hg₁.trans hh.symm))
  obtain ⟨v, hv, -⟩ := h.regular V (g₁ • V) U hW hne
  have hvV : (v : X) • V = V := Sylow.smul_eq_iff_mem_normalizer.mpr (le_normalizer v.2)
  refine ⟨v * g₁, ?_, ?_⟩
  · rw [mul_smul, hg₁, hvV]
  · rw [mul_smul, hv]

theorem exists_ne_one_mem_torus (h : SuzukiTorusData X q) (hq : 3 ≤ q) {U V : Sylow 2 X}
    (hne : U ≠ V) : ∃ t ∈ torus U V, t ≠ 1 := by
  by_contra hcon
  push Not at hcon
  have hbot : torus U V = ⊥ := (eq_bot_iff_forall _).mpr hcon
  have := card_torus h hne
  rw [hbot, card_bot] at this
  omega

theorem odd_orderOf_of_mem_torus (h : SuzukiTorusData X q) (hq : Odd (q - 1)) {U V : Sylow 2 X}
    (hne : U ≠ V) {y : X} (hy : y ∈ torus U V) : Odd (orderOf y) :=
  hq.of_dvd_nat ((Subgroup.orderOf_dvd_natCard _ hy).trans (card_torus h hne).dvd)

/-- The set-stabilizer of the pair `{U, V}`. -/
def stab2 (U V : Sylow 2 X) : Subgroup X where
  carrier := {g | (g • U = U ∧ g • V = V) ∨ (g • U = V ∧ g • V = U)}
  mul_mem' := by
    rintro a b (⟨ha1, ha2⟩ | ⟨ha1, ha2⟩) (⟨hb1, hb2⟩ | ⟨hb1, hb2⟩) <;>
      simp [Set.mem_setOf_eq, mul_smul, ha1, ha2, hb1, hb2]
  one_mem' := Or.inl ⟨one_smul _ _, one_smul _ _⟩
  inv_mem' := by
    rintro a (⟨ha1, ha2⟩ | ⟨ha1, ha2⟩)
    · exact Or.inl ⟨inv_smul_eq_iff.mpr ha1.symm, inv_smul_eq_iff.mpr ha2.symm⟩
    · exact Or.inr ⟨inv_smul_eq_iff.mpr ha2.symm, inv_smul_eq_iff.mpr ha1.symm⟩

theorem mem_stab2 {U V : Sylow 2 X} {g : X} :
    g ∈ stab2 U V ↔ (g • U = U ∧ g • V = V) ∨ (g • U = V ∧ g • V = U) := Iff.rfl

theorem normalizer_torus_le_stab2 (h : SuzukiTorusData X q) (hq : 3 ≤ q) {U V : Sylow 2 X}
    (hne : U ≠ V) : normalizer ((torus U V : Subgroup X) : Set X) ≤ stab2 U V := by
  intro y hy
  obtain ⟨t, ht, ht1⟩ := exists_ne_one_mem_torus h hq hne
  have hs : y * t * y⁻¹ ∈ torus U V := (mem_normalizer_iff.mp hy t).mp ht
  have hs1 : y * t * y⁻¹ ≠ 1 := by
    intro h1
    apply ht1
    have : t = y⁻¹ * (y * t * y⁻¹) * y := by group
    rw [this, h1]
    group
  obtain ⟨hsU, hsV⟩ := mem_torus.mp hs
  obtain ⟨htU, htV⟩ := mem_torus.mp ht
  have hfix : ∀ P : Sylow 2 X, t • P = P → (y * t * y⁻¹) • (y • P) = y • P := by
    intro P hP
    rw [smul_smul, inv_mul_cancel_right, mul_smul, hP]
  have h1 := eq_or_eq_of_smul_eq h hs1 hne hsU hsV (hfix U htU)
  have h2 := eq_or_eq_of_smul_eq h hs1 hne hsU hsV (hfix V htV)
  have h3 : y • U ≠ y • V := fun h' => hne (MulAction.injective y h')
  rw [mem_stab2]
  rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2
  · exact absurd (h1.trans h2.symm) h3
  · exact Or.inl ⟨h1, h2⟩
  · exact Or.inr ⟨h1, h2⟩
  · exact absurd (h1.trans h2.symm) h3

/-- A Sylow `2`-subgroup has an involution commuting with any given involution `w` and
different from it (otherwise `w` would be the unique involution of `Z(S)` for the Sylow
`2`-subgroup `S ∋ w`, and a torus normalizing `S` would centralize it). -/
theorem exists_commuting_involution (h : SuzukiTorusData X q) (hq : 3 ≤ q) {w : X}
    (hw : orderOf w = 2) : ∃ z : X, orderOf z = 2 ∧ z ≠ w ∧ w * z = z * w := by
  by_contra hcon
  push Not at hcon
  have hwp : IsPGroup 2 (zpowers w) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hw, pow_one])
  obtain ⟨S, hS⟩ := hwp.exists_le_sylow
  have hwS : w ∈ (S : Subgroup X) := hS (mem_zpowers w)
  haveI hSnt : Nontrivial S := by
    rw [← Finite.one_lt_card_iff_nontrivial, h.card_sylow S]
    nlinarith
  have hZp : IsPGroup 2 (center S) := S.isPGroup'.to_subgroup _
  have hZnt := S.isPGroup'.center_nontrivial
  obtain ⟨c, hc⟩ := exists_prime_orderOf_dvd_card' (G := center S) 2 (by
    rcases hZp.card_eq_or_dvd with h1 | h1
    · exact absurd h1 (Finite.one_lt_card_iff_nontrivial.mpr hZnt).ne'
    · exact h1)
  have hc2 : orderOf ((c : S) : X) = 2 := by
    rw [Subgroup.orderOf_coe, Subgroup.orderOf_coe, hc]
  have hcw : ((c : S) : X) = w := by
    by_contra hne
    apply hcon _ hc2 hne
    exact congrArg Subtype.val (mem_center_iff.mp c.2 ⟨w, hwS⟩)
  have hwc : ∀ s ∈ (S : Subgroup X), s * w = w * s := by
    intro s hs
    have := congrArg Subtype.val (mem_center_iff.mp c.2 ⟨s, hs⟩)
    simpa [hcw] using this
  obtain ⟨S', hS'⟩ := exists_ne_sylow h (by omega) S
  obtain ⟨t, htT, ht1⟩ := exists_ne_one_mem_torus h hq hS'.symm
  have hzS : t * w * t⁻¹ ∈ (S : Subgroup X) := (mem_normalizer_iff.mp htT.1 w).mp hwS
  have hz2 : orderOf (t * w * t⁻¹) = 2 := by
    rw [← MulAut.conj_apply, MulEquiv.orderOf_eq, hw]
  have hzw : t * w * t⁻¹ = w := by
    by_contra hne
    exact hcon _ hz2 hne (hwc _ hzS).symm
  have := h.inf_normalizer_free S S' hS'.symm t htT ht1 ⟨w, hwS⟩ hzw
  have hw1 : w = 1 := congrArg Subtype.val this
  rw [hw1, orderOf_one] at hw
  exact absurd hw (by decide)

end TorusData

/-! ### `Sz(q)` -/

section Suzuki

variable {n : ℕ} {X : Type} [Group X] [Opq4dExistsMulEquivSuzukiMatrixGroup]

theorem isSz_facts (hX : IsSz n X) : Odd n ∧ 3 ≤ n := by
  obtain ⟨m, hm, rfl, -⟩ := Opq4dExistsMulEquivSuzukiMatrixGroup.opq4d_exists_mulEquiv_suzukiMatrixGroup
    hX
  exact ⟨⟨m, rfl⟩, by omega⟩

theorem eight_le (hX : IsSz n X) : 8 ≤ 2 ^ n :=
  calc 8 = 2 ^ 3 := by norm_num
    _ ≤ 2 ^ n := Nat.pow_le_pow_right (by norm_num) (isSz_facts hX).2

theorem odd_two_pow_sub_one (hX : IsSz n X) : Odd (2 ^ n - 1) :=
  Nat.Even.sub_odd Nat.one_le_two_pow
    (Nat.even_pow.mpr ⟨even_two, by have := (isSz_facts hX).2; omega⟩) odd_one

variable [Finite X] [SuzukiTorusDataSuzukiMatrixGroup] [SuzukiTorusDataOfMulEquiv.{0, 0}]

/-- `Sz(q)` satisfies the point/torus axioms. -/
theorem torusData (hX : IsSz n X) : SuzukiTorusData X (2 ^ n) := by
  obtain ⟨m, hm, rfl, ⟨e⟩⟩ :=
    Opq4dExistsMulEquivSuzukiMatrixGroup.opq4d_exists_mulEquiv_suzukiMatrixGroup hX
  haveI : Finite (SuzukiMatrixGroup m) := Finite.of_equiv X e.toEquiv
  exact SuzukiTorusDataOfMulEquiv.of_mulEquiv e
    (SuzukiTorusDataSuzukiMatrixGroup.suzukiTorusData_suzukiMatrixGroup m (by omega))

variable [IsPGroupCentralizerOfIsSz]

/-- An element swapping two points is an involution. -/
theorem orderOf_eq_two_of_swap (hX : IsSz n X) {U V : Sylow 2 X} (hne : U ≠ V) {g : X}
    (hU : g • U = V) (hV : g • V = U) : orderOf g = 2 := by
  have h := torusData hX
  have hq := odd_two_pow_sub_one hX
  have hs : g ^ 2 ∈ torus U V :=
    mem_torus.mpr ⟨by rw [sq, mul_smul, hU, hV], by rw [sq, mul_smul, hV, hU]⟩
  have hso := odd_orderOf_of_mem_torus h hq hne hs
  have hg1 : g ≠ 1 := by
    rintro rfl
    rw [one_smul] at hU
    exact hne hU
  have hpos : 0 < orderOf g := orderOf_pos g
  by_cases hgo : Odd (orderOf g)
  · exfalso
    obtain ⟨k, hk⟩ := hgo
    have hgeq : g = (g ^ 2) ^ (k + 1) := by
      rw [← pow_mul, show 2 * (k + 1) = orderOf g + 1 by omega, pow_succ, pow_orderOf_eq_one,
        one_mul]
    have hgT : g ∈ torus U V := by
      rw [hgeq]
      exact pow_mem hs _
    exact hne ((mem_torus.mp hgT).1.symm.trans hU)
  · have h2 : 2 ∣ orderOf g := even_iff_two_dvd.mp (Nat.not_odd_iff_even.mp hgo)
    have hxo : orderOf (g ^ (orderOf g / 2)) = 2 := orderOf_pow_orderOf_div hpos.ne' h2
    have hc : g ^ 2 ∈ centralizer ({g ^ (orderOf g / 2)} : Set X) := by
      rw [mem_centralizer_singleton_iff]
      exact (Commute.pow_pow_self g 2 _).eq
    obtain ⟨k, hk⟩ := IsPGroupCentralizerOfIsSz.isPGroup_centralizer_of_isSz hX hxo ⟨g ^ 2, hc⟩
    have hk' : (g ^ 2) ^ (2 ^ k) = 1 := by simpa using congrArg Subtype.val hk
    have hdvd : orderOf (g ^ 2) ∣ 2 ^ k := orderOf_dvd_of_pow_eq_one hk'
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
    have hj0 : j = 0 := by
      by_contra hj0
      rw [hj] at hso
      exact (Nat.not_odd_iff_even.mpr (Nat.even_pow.mpr ⟨even_two, hj0⟩)) hso
    rw [hj0, pow_zero, orderOf_eq_one_iff] at hj
    exact orderOf_eq_prime hj hg1

/-- The data of Leemans' construction: two points `U ≠ V`, an involution `w` swapping them, a
generator `t` of the torus `N(U) ∩ N(V)` (of order `q - 1`), and an involution `z ≠ w`
commuting with `w`. -/
theorem exists_leemans_data (hX : IsSz n X) :
    ∃ (U V : Sylow 2 X) (w t z : X), U ≠ V ∧ w • U = V ∧ w • V = U ∧ orderOf w = 2 ∧
      t ∈ torus U V ∧ (∀ y ∈ torus U V, ∃ i : ℤ, y = t ^ i) ∧ orderOf t = 2 ^ n - 1 ∧
      orderOf z = 2 ∧ z ≠ w ∧ w * z = z * w := by
  have h := torusData hX
  have hq8 := eight_le hX
  obtain ⟨U⟩ : Nonempty (Sylow 2 X) := inferInstance
  obtain ⟨V, hVU⟩ := exists_ne_sylow h (by omega) U
  have hne : U ≠ V := hVU.symm
  obtain ⟨w, hwU, hwV⟩ := exists_swap h hne
  have hw2 := orderOf_eq_two_of_swap hX hne hwU hwV
  haveI : IsCyclic (torus U V) := h.inf_normalizer_isCyclic U V hne
  obtain ⟨t₀, ht₀⟩ := IsCyclic.exists_generator (α := torus U V)
  obtain ⟨z, hz2, hzw, hwz⟩ := exists_commuting_involution h (by omega) hw2
  refine ⟨U, V, w, t₀, z, hne, hwU, hwV, hw2, t₀.2, fun y hy => ?_, ?_, hz2, hzw, hwz⟩
  · obtain ⟨i, hi⟩ := mem_zpowers_iff.mp (ht₀ ⟨y, hy⟩)
    exact ⟨i, by rw [← Subgroup.coe_zpow, hi]⟩
  · rw [Subgroup.orderOf_coe, orderOf_eq_card_of_forall_mem_zpowers ht₀, card_torus h hne]

variable [EqTopOrLeNormalizerTorus]

/-- **Leemans' rank-three generating triple.** `Sz(q)` is generated by three involutions
`ρ₀, ρ₁, ρ₂` with `ρ₀ρ₂ = ρ₂ρ₀`, `o(ρ₀ρ₁) = q - 1`, satisfying the intersection property
`⟨ρ i : i ∈ I⟩ ∩ ⟨ρ j : j ∈ J⟩ = ⟨ρ k : k ∈ I ∩ J⟩`. -/
theorem exists_rank_three (hX : IsSz n X) :
    ∃ ρ : Fin 3 → X, (∀ i, orderOf (ρ i) = 2) ∧ closure (Set.range ρ) = ⊤ ∧
      ρ 0 * ρ 2 = ρ 2 * ρ 0 ∧ orderOf (ρ 0 * ρ 1) = 2 ^ n - 1 ∧
      ∀ I J : Set (Fin 3), closure (ρ '' I) ⊓ closure (ρ '' J) = closure (ρ '' (I ∩ J)) := by
  have h := torusData hX
  have hq8 := eight_le hX
  have hqo := odd_two_pow_sub_one hX
  obtain ⟨U, V, w, t, z, hne, hwU, hwV, hw2, htT, hTt, hto, hz2, hzw, hwz⟩ :=
    exists_leemans_data hX
  obtain ⟨htU, htV⟩ := mem_torus.mp htT
  have ht1 : t ≠ 1 := by
    rintro rfl
    rw [orderOf_one] at hto
    omega
  have hww := mul_self_eq_one_of_orderOf hw2
  have hzz := mul_self_eq_one_of_orderOf hz2
  have hwtU : (w * t) • U = V := by rw [mul_smul, htU, hwU]
  have hwtV : (w * t) • V = U := by rw [mul_smul, htV, hwV]
  have hwt2 := orderOf_eq_two_of_swap hX hne hwtU hwtV
  have hwtwt := mul_self_eq_one_of_orderOf hwt2
  -- `z` does not preserve `{U, V}`
  have hzbad : (z • U = U ∨ z • U = V) → (z • V = U ∨ z • V = V) → False := by
    rintro (h1 | h1) (h2 | h2)
    · exact hne (MulAction.injective z (h1.trans h2.symm))
    · have : orderOf z ∣ 2 ^ n - 1 :=
        (Subgroup.orderOf_dvd_natCard _ (mem_torus.mpr ⟨h1, h2⟩)).trans (card_torus h hne).dvd
      rw [hz2] at this
      exact (Nat.not_even_iff_odd.mpr hqo) (even_iff_two_dvd.mpr this)
    · have hwzT : w * z ∈ torus U V :=
        mem_torus.mpr ⟨by rw [mul_smul, h1, hwV], by rw [mul_smul, h2, hwU]⟩
      have hsq : (w * z) * (w * z) = 1 := by
        calc (w * z) * (w * z) = w * (z * w) * z := by group
          _ = w * (w * z) * z := by rw [hwz]
          _ = (w * w) * (z * z) := by group
          _ = 1 := by rw [hww, hzz, one_mul]
      have h1' := eq_one_of_mul_self_eq_one_of_odd hsq (odd_orderOf_of_mem_torus h hqo hne hwzT)
      apply hzw
      rw [← inv_eq_of_mul_eq_one_right hww]
      exact eq_inv_of_mul_eq_one_right h1'
    · exact hne (MulAction.injective z (h1.trans h2.symm))
  have hzstab : z ∉ stab2 U V := by
    rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)
    · exact hzbad (Or.inl h1) (Or.inr h2)
    · exact hzbad (Or.inr h1) (Or.inl h2)
  -- no nontrivial torus element lies in `⟨wt, z⟩`
  have hR : ∀ y ∈ torus U V, y ≠ 1 → y ∈ closure ({w * t, z} : Set X) → False := by
    intro y hyT hy1 hyY
    obtain ⟨j, hj | hj⟩ := mem_closure_pair_dihedral hwtwt hzz hyY
    · have hcy : (w * t * z) * y = y * (w * t * z) := by
        rw [hj]
        exact (Commute.self_zpow _ j).eq
      obtain ⟨hyU, hyV⟩ := mem_torus.mp hyT
      have hfix : ∀ P : Sylow 2 X, y • P = P → y • ((w * t * z) • P) = (w * t * z) • P := by
        intro P hP
        rw [smul_smul, ← hcy, ← smul_smul, hP]
      have hcU := eq_or_eq_of_smul_eq h hy1 hne hyU hyV (hfix U hyU)
      have hcV := eq_or_eq_of_smul_eq h hy1 hne hyU hyV (hfix V hyV)
      have hzc : ∀ P : Sylow 2 X, z • P = (w * t) • ((w * t * z) • P) := by
        intro P
        rw [smul_smul, ← mul_assoc, hwtwt, one_mul]
      apply hzbad
      · rw [hzc]
        rcases hcU with h1 | h1 <;> rw [h1]
        · exact Or.inr hwtU
        · exact Or.inl hwtV
      · rw [hzc]
        rcases hcV with h1 | h1 <;> rw [h1]
        · exact Or.inr hwtU
        · exact Or.inl hwtV
    · exact hy1 (eq_one_of_mul_self_eq_one_of_odd (hj ▸ reflection_mul_self hwtwt hzz j)
        (odd_orderOf_of_mem_torus h hqo hne hyT))
  -- the three non-memberships
  have hD : closure ({w, w * t} : Set X) ≤ stab2 U V := by
    rw [closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact Or.inr ⟨hwU, hwV⟩
    · exact Or.inr ⟨hwtU, hwtV⟩
  have hN2 : z ∉ closure ({w, w * t} : Set X) := fun hz => hzstab (hD hz)
  have hN0 : w ∉ closure ({w * t, z} : Set X) := by
    intro hw
    have : t ∈ closure ({w * t, z} : Set X) := by
      simpa using mul_mem (inv_mem hw)
        (subset_closure (Set.mem_insert _ _) : w * t ∈ closure ({w * t, z} : Set X))
    exact hR t htT ht1 this
  have hN1 : w * t ∉ closure ({w, z} : Set X) := by
    intro hx
    rcases mem_closure_pair_of_commute hww hzz hwz hx with h1 | h1 | h1 | h1
    · rw [h1, one_smul] at hwtU
      exact hne hwtU
    · exact ht1 (mul_eq_left.mp h1)
    · exact hzbad (Or.inr (h1 ▸ hwtU)) (Or.inl (h1 ▸ hwtV))
    · have htz : t = z := mul_left_cancel h1
      exact hzbad (Or.inl (htz ▸ htU)) (Or.inr (htz ▸ htV))
  -- the three pair intersections
  have hC1 : closure ({w, w * t} : Set X) ⊓ closure ({w * t, z} : Set X) ≤ closure {w * t} := by
    rintro x ⟨hx1, hx2⟩
    have hwwt : w * (w * t) = t := by rw [← mul_assoc, hww, one_mul]
    obtain ⟨i, hi | hi⟩ := mem_closure_pair_dihedral hww hwtwt hx1
    · rw [hwwt] at hi
      by_cases hx1' : x = 1
      · rw [hx1']
        exact one_mem _
      · exfalso
        exact hR x (by rw [hi]; exact zpow_mem htT i) hx1' hx2
    · rw [hwwt] at hi
      have hy : x * (w * t) ∈ closure ({w * t, z} : Set X) :=
        mul_mem hx2 (subset_closure (Set.mem_insert _ _))
      have hyT : x * (w * t) ∈ torus U V := by
        rw [hi, mul_assoc, ← mul_assoc w, hww, one_mul]
        exact mul_mem (zpow_mem htT i) htT
      by_cases hy1 : x * (w * t) = 1
      · rw [eq_inv_of_mul_eq_one_left hy1]
        exact inv_mem (subset_closure rfl)
      · exact (hR _ hyT hy1 hy).elim
  have hC2 : closure ({w, w * t} : Set X) ⊓ closure ({w, z} : Set X) ≤ closure {w} := by
    rintro x ⟨hx1, hx2⟩
    rcases mem_closure_pair_of_commute hww hzz hwz hx2 with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact subset_closure rfl
    · exact (hN2 hx1).elim
    · exact (hN2 (by simpa using mul_mem (inv_mem (subset_closure (Set.mem_insert _ _))) hx1)).elim
  have hC3 : closure ({w, z} : Set X) ⊓ closure ({w * t, z} : Set X) ≤ closure {z} := by
    rintro x ⟨hx1, hx2⟩
    rcases mem_closure_pair_of_commute hww hzz hwz hx1 with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact (hN0 hx2).elim
    · exact subset_closure rfl
    · have hz : z ∈ Subgroup.closure ({w * t, z} : Set X) := subset_closure (Set.mem_insert_of_mem _ rfl)
      have hx2' : w * z ∈ Subgroup.closure ({w * t, z} : Set X) := hx2
      exact (hN0 (by simpa using mul_mem hx2' (inv_mem hz))).elim
  refine ⟨![w, w * t, z], ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    fin_cases i
    · exact hw2
    · exact hwt2
    · exact hz2
  · -- generation: the closure contains the torus and `w`, but not inside `N(torus)`
    set Y := closure (Set.range ![w, w * t, z]) with hYdef
    have hwY : w ∈ Y := subset_closure ⟨0, rfl⟩
    have hwtY : w * t ∈ Y := subset_closure ⟨1, rfl⟩
    have hzY : z ∈ Y := subset_closure ⟨2, rfl⟩
    have htY : t ∈ Y := by simpa using mul_mem (inv_mem hwY) hwtY
    have hTY : torus U V ≤ Y := fun y hy => by
      obtain ⟨i, rfl⟩ := hTt y hy
      exact zpow_mem htY i
    rcases EqTopOrLeNormalizerTorus.eq_top_or_le_normalizer_torus hX hne hTY hwY hwU with h1 | h1
    · exact h1
    · exact (hzstab (normalizer_torus_le_stab2 h (by omega) hne (h1 hzY))).elim
  · exact hwz
  · show orderOf (w * (w * t)) = _
    rw [← mul_assoc, hww, one_mul, hto]
  · exact intersection_rank_three w (w * t) z hC1 (by simpa only [Set.pair_comm] using hC2)
      hC3 (inf_eq_bot_of_not_mem hww hN0) (inf_eq_bot_of_not_mem hwtwt hN1)
      (inf_eq_bot_of_not_mem hzz hN2)

end Suzuki

end CFSGOutside.Leemans
