/-!
# Leemans (2006): almost simple groups of Suzuki type acting on polytopes

**Paper.** D. Leemans, *Almost simple groups of Suzuki type acting on polytopes*,
Proc. Amer. Math. Soc. **134** (2006), 3649–3651, DOI 10.1090/S0002-9939-06-08448-6.

**Theorem 1** (as quoted in Leemans' survey, arXiv:1910.08843, Theorem 6.1): *Let `Sz(q) ≤ G ≤ Aut(Sz(q))`
with `q = 2 ^ (2e+1)` and `e > 0`. Then `G` is a C-group if and only if `G = Sz(q)`. Moreover, if
`(G, {ρ₀, …, ρ_{n-1}})` is a string C-group, then `n = 3`.*

Here `Sz(q)` is the copy `CFSGOutside.Corpus.suzukiGroup a K` of the corpus Suzuki group (`|K| = 2 ^ (2a+1)`,
`a ≥ 1`), and `Sz(q) ≤ G ≤ Aut(Sz(q))` is a subgroup `G` of `MulAut (suzukiGroup a K)` containing the inner
automorphisms; `Sz(q)` itself is identified with the inner automorphisms.

* `leemans_theorem_1`: Theorem 1, together with the same statement for string C-groups.
* `leemans_suzuki`: a string C-group `G` equals `Inn(Sz(q))` and has rank `3`.
* `eq_inner_of_closure_involutions`: a group generated by involutions equals `Inn(Sz(q))`.
* `exists_isStringCGroup_inner`: `Inn(Sz(q))` is a string C-group of rank `3`.

The corpus inputs are the classes of `CFSGOutside.Corpus`: `Out(Sz(q))` has odd order, involution centralizers
of `Sz(q)` are Sylow `2`-subgroups, `Sz(q)` is simple and nonabelian, and the facts of
`CFSGOutside.Leemans.SuzukiMaximal` on the subgroups of `Sz(q)`.
-/

noncomputable section

namespace CFSGOutside.Leemans

open CFSGOutside.Corpus (suzukiGroup IsSz SuzukiOuterAutomorphismGroupHasOddOrder SuzukiCentralizerEqSylow
  SuzukiMemCentralizerOfSqEqOne SuzukiGroupSimpleNonab Opq4dExistsMulEquivSuzukiMatrixGroup
  SuzukiTorusDataSuzukiMatrixGroup SuzukiTorusDataOfMulEquiv IsPGroupCentralizerOfIsSz
  EqTopOrLeNormalizerTorus)
open CFSGOutside.Corpus.ComponentClassification

theorem IsStringCGroup.isCGroup {G : Type*} [Group G] {n : ℕ} {ρ : Fin n → G}
    (hρ : IsStringCGroup ρ) : IsCGroup ρ :=
  ⟨hρ.involution, hρ.generates, hρ.intersection⟩

/-- String C-groups are transported along isomorphisms. -/
theorem IsStringCGroup.map_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) {n : ℕ}
    {ρ : Fin n → G} (hρ : IsStringCGroup ρ) : IsStringCGroup (fun i => e (ρ i)) := by
  have key : ∀ S : Set (Fin n), Subgroup.closure ((fun i => e (ρ i)) '' S) =
      (Subgroup.closure (ρ '' S)).map e.toMonoidHom := fun S => by
    rw [MonoidHom.map_closure, Set.image_image]
    rfl
  refine ⟨fun i => by rw [MulEquiv.orderOf_eq]; exact hρ.involution i, ?_, ?_, ?_⟩
  · rw [← Set.image_univ, key, Set.image_univ, hρ.generates,
      Subgroup.map_top_of_surjective _ e.surjective]
  · intro i j hij
    rw [← map_mul, ← map_mul, hρ.string i j hij]
  · intro I J
    rw [key, key, key, ← Subgroup.map_inf _ _ _ e.injective, hρ.intersection]

/-- Commuting is transitive on involutions. -/
def CommTransOnInvolutions (H : Type*) [Group H] : Prop :=
  ∀ x y z : H, orderOf x = 2 → orderOf y = 2 → orderOf z = 2 →
    x * y = y * x → y * z = z * y → x * z = z * x

theorem CommTransOnInvolutions.of_mulEquiv {H H' : Type*} [Group H] [Group H'] (e : H ≃* H')
    (h : CommTransOnInvolutions H) : CommTransOnInvolutions H' := by
  intro x y z hx hy hz hxy hyz
  rw [← MulEquiv.orderOf_eq e.symm] at hx hy hz
  have := h _ _ _ hx hy hz (by rw [← map_mul, ← map_mul, hxy]) (by rw [← map_mul, ← map_mul, hyz])
  simpa using congrArg e this

theorem commute_all_of_closure {H : Type*} [Group H] (s : Set H)
    (hs : Subgroup.closure s = ⊤) (hc : ∀ x ∈ s, ∀ y ∈ s, x * y = y * x) :
    ∀ x y : H, x * y = y * x := by
  have h1 : Subgroup.closure s ≤ Subgroup.centralizer s :=
    (Subgroup.closure_le _).mpr fun x hx => Subgroup.mem_centralizer_iff.mpr fun y hy =>
      hc y hy x hx
  rw [← Subgroup.centralizer_closure, hs] at h1
  intro x y
  exact Subgroup.mem_centralizer_iff.mp (h1 (Subgroup.mem_top y)) x (Subgroup.mem_top x)

/-- The rank argument (Leemans): in a nonabelian simple group in which commuting is transitive on
involutions, every string C-group representation has rank `3`. -/
theorem rank_eq_three {H : Type*} [Group H] [IsSimpleGroup H]
    (hnab : ∃ x y : H, x * y ≠ y * x) (htrans : CommTransOnInvolutions H)
    {n : ℕ} {ρ : Fin n → H} (hρ : IsStringCGroup ρ) : n = 3 := by
  obtain ⟨x₀, y₀, hxy₀⟩ := hnab
  have habel : ∀ (hc : ∀ i j, ρ i * ρ j = ρ j * ρ i), False := by
    intro hc
    apply hxy₀
    refine commute_all_of_closure _ hρ.generates ?_ x₀ y₀
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact hc i j
  have hstr : ∀ i j : Fin n, (i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) →
      ρ i * ρ j = ρ j * ρ i := by
    intro i j h
    rcases h with h | h
    · exact hρ.string i j h
    · exact (hρ.string j i h).symm
  rcases Nat.lt_or_ge n 3 with hn | hn
  · interval_cases n
    · exact (habel fun i => i.elim0).elim
    · exact (habel fun i j => by rw [Subsingleton.elim i j]).elim
    · -- rank 2: `⟨ρ 0 ρ 1⟩` is a normal subgroup of index at most 2
      exfalso
      set r := ρ 0 * ρ 1 with hr
      have hinv0 : ρ 0 * ρ 0 = 1 := by
        have := pow_orderOf_eq_one (ρ 0); rwa [hρ.involution 0, sq] at this
      have hinv1 : ρ 1 * ρ 1 = 1 := by
        have := pow_orderOf_eq_one (ρ 1); rwa [hρ.involution 1, sq] at this
      have h0 : (ρ 0)⁻¹ = ρ 0 := inv_eq_of_mul_eq_one_right hinv0
      have h1 : (ρ 1)⁻¹ = ρ 1 := inv_eq_of_mul_eq_one_right hinv1
      have hrinv : r⁻¹ = ρ 1 * ρ 0 := by rw [hr, mul_inv_rev, h0, h1]
      have hconj : ∀ i : Fin 2, ρ i * r * (ρ i)⁻¹ = r⁻¹ := by
        intro i
        rw [hrinv]
        fin_cases i
        · show ρ 0 * (ρ 0 * ρ 1) * (ρ 0)⁻¹ = ρ 1 * ρ 0
          rw [h0, ← mul_assoc, hinv0, one_mul]
        · show ρ 1 * (ρ 0 * ρ 1) * (ρ 1)⁻¹ = ρ 1 * ρ 0
          rw [h1, mul_assoc, mul_assoc, hinv1, mul_one]
      have hnorm : (Subgroup.zpowers r).Normal := by
        have hle : Subgroup.closure (Set.range ρ) ≤
            Subgroup.normalizer (Subgroup.zpowers r : Set H) := by
          rw [Subgroup.closure_le]
          rintro _ ⟨i, rfl⟩
          rw [SetLike.mem_coe, Subgroup.mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
          change Subgroup.zpowers (ρ i * r * (ρ i)⁻¹) = _
          rw [hconj i, Subgroup.zpowers_inv]
        rw [hρ.generates, top_le_iff, Subgroup.normalizer_eq_top_iff] at hle
        exact hle
      rcases hnorm.eq_bot_or_eq_top with h | h
      · rw [Subgroup.zpowers_eq_bot] at h
        have h01 : ρ 0 = ρ 1 := by
          rw [eq_inv_of_mul_eq_one_left h, h1]
        exact habel fun i j => by
          fin_cases i <;> fin_cases j <;> simp [h01]
      · apply hxy₀
        have hx : x₀ ∈ Subgroup.zpowers r := h ▸ Subgroup.mem_top x₀
        have hy : y₀ ∈ Subgroup.zpowers r := h ▸ Subgroup.mem_top y₀
        obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
        exact (Commute.zpow_zpow_self r m k).eq
  · rcases Nat.eq_or_lt_of_le hn with h | h
    · exact h.symm
    · -- rank `≥ 4`: all `ρ i` commute with `ρ 0`, hence with each other
      exfalso
      have h0 : ∀ i : Fin n, ρ i * ρ ⟨0, by omega⟩ = ρ ⟨0, by omega⟩ * ρ i := by
        intro i
        rcases Nat.lt_or_ge i.val 2 with hi | hi
        · interval_cases hi' : i.val
          · have : i = ⟨0, by omega⟩ := Fin.ext hi'
            rw [this]
          · have h1 : i = ⟨1, by omega⟩ := Fin.ext hi'
            have := htrans (ρ i) (ρ ⟨n - 1, by omega⟩) (ρ ⟨0, by omega⟩) (hρ.involution _)
              (hρ.involution _) (hρ.involution _)
              (hstr _ _ (Or.inl (by rw [h1]; simp only; omega)))
              (hstr _ _ (Or.inr (by simp only; omega)))
            exact this
        · exact hstr _ _ (Or.inr (by simp only; omega))
      exact habel fun i j => htrans (ρ i) (ρ ⟨0, by omega⟩) (ρ j) (hρ.involution _)
        (hρ.involution _) (hρ.involution _) (h0 i) (h0 j).symm

section Suzuki

variable {a : ℕ} {K : Type} [Field K] [Finite K]

theorem commTransOnInvolutions_suzuki [SuzukiGroupSimpleNonab] [SuzukiCentralizerEqSylow]
    [SuzukiMemCentralizerOfSqEqOne.{0}]
    (hK : Nat.card K = 2 ^ (2 * a + 1)) (ha : 1 ≤ a) :
    CommTransOnInvolutions (suzukiGroup a K) := by
  haveI := (SuzukiGroupSimpleNonab.suzukiGroup_simple_nonab ha hK).1
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro x y z hx hy hz hxy hyz
  have hyp : IsPGroup 2 (Subgroup.zpowers y) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hy, pow_one])
  obtain ⟨Q, hQ⟩ := hyp.exists_le_sylow
  have hyQ : y ∈ Q := hQ (Subgroup.mem_zpowers y)
  have hC := SuzukiCentralizerEqSylow.centralizer_eq_sylow hK hy Q hyQ
  have hxQ : x ∈ (Q : Subgroup (suzukiGroup a K)) := by
    rw [← hC, Subgroup.mem_centralizer_singleton_iff]; exact hxy
  have hzQ : z ∈ (Q : Subgroup (suzukiGroup a K)) := by
    rw [← hC, Subgroup.mem_centralizer_singleton_iff]; exact hyz.symm
  have hx2 : x ^ 2 = 1 := by rw [← hx, pow_orderOf_eq_one]
  have := SuzukiMemCentralizerOfSqEqOne.mem_centralizer_of_sq_eq_one hK (MulEquiv.refl _) Q hxQ hx2
  exact (Subgroup.mem_centralizer_iff.mp this z hzQ).symm

theorem conj_injective_suzuki [SuzukiGroupSimpleNonab] (hK : Nat.card K = 2 ^ (2 * a + 1)) (ha : 1 ≤ a) :
    Function.Injective (MulAut.conj : suzukiGroup a K →* MulAut (suzukiGroup a K)) := by
  obtain ⟨-, hsimple, hnab⟩ := SuzukiGroupSimpleNonab.suzukiGroup_simple_nonab ha hK
  rw [injective_iff_map_eq_one]
  intro g hg
  have hcen : g ∈ Subgroup.center (suzukiGroup a K) := by
    rw [Subgroup.mem_center_iff]
    intro h
    have := congrArg (fun φ : MulAut (suzukiGroup a K) => φ h) hg
    simp only [MulAut.conj_apply, MulAut.one_apply] at this
    calc h * g = g * h * g⁻¹ * g := by rw [this]
      _ = g * h := by group
  rcases (inferInstance : (Subgroup.center (suzukiGroup a K)).Normal).eq_bot_or_eq_top with h | h
  · rwa [h, Subgroup.mem_bot] at hcen
  · exfalso
    obtain ⟨x, y, hxy⟩ := hnab
    have hx : x ∈ Subgroup.center (suzukiGroup a K) := h ▸ Subgroup.mem_top x
    exact hxy ((Subgroup.mem_center_iff.mp hx y).symm)

/-- **Leemans, Theorem 1 (first part, "only if").** *Let `Sz(q) ≤ G ≤ Aut(Sz(q))`,
`q = 2 ^ (2e+1)`, `e > 0`. If `G` is generated by involutions (in particular if `G` is a
C-group), then `G = Sz(q)`.* Here `Sz(q)` is the group of inner automorphisms. -/
theorem eq_inner_of_closure_involutions [SuzukiOuterAutomorphismGroupHasOddOrder]
    (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G)
    (X : Set (MulAut (suzukiGroup a K))) (hX : ∀ x ∈ X, orderOf x = 2)
    (hgen : Subgroup.closure X = G) : G = OuterAutomorphisms.inner (suzukiGroup a K) := by
  refine le_antisymm ?_ hG
  rw [← hgen, Subgroup.closure_le]
  intro x hx
  have hp : IsPGroup 2 (Subgroup.zpowers x) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hX x hx, pow_one])
  exact (SuzukiOuterAutomorphismGroupHasOddOrder.suzuki_outer_automorphism_group_has_odd_order
    ha hK).2 _ hp (Subgroup.mem_zpowers x)

/-- **Leemans, Theorem 1.** *Let `Sz(q) ≤ G ≤ Aut(Sz(q))` with `q = 2 ^ (2e+1)` and `e > 0`.
If `(G, {ρ₀, …, ρ_{n-1}})` is a string C-group (the automorphism group of an abstract regular
polytope of rank `n`), then `G = Sz(q)` and `n = 3`.* -/
theorem leemans_suzuki [SuzukiGroupSimpleNonab]
    [SuzukiCentralizerEqSylow] [SuzukiMemCentralizerOfSqEqOne.{0}]
    [SuzukiOuterAutomorphismGroupHasOddOrder] (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G)
    {n : ℕ} (ρ : Fin n → G) (hρ : IsStringCGroup ρ) :
    G = OuterAutomorphisms.inner (suzukiGroup a K) ∧ n = 3 := by
  have hGeq : G = OuterAutomorphisms.inner (suzukiGroup a K) := by
    refine eq_inner_of_closure_involutions ha hK G hG (Set.range fun i => (ρ i : MulAut _)) ?_ ?_
    · rintro _ ⟨i, rfl⟩
      rw [Subgroup.orderOf_coe, hρ.involution i]
    · change Subgroup.closure (Set.range (G.subtype ∘ ρ)) = G
      rw [Set.range_comp, ← MonoidHom.map_closure, hρ.generates,
        ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  refine ⟨hGeq, ?_⟩
  obtain ⟨-, hsimple, hnab⟩ := SuzukiGroupSimpleNonab.suzukiGroup_simple_nonab ha hK
  -- `G ≅ Sz(q)`
  let e : G ≃* suzukiGroup a K :=
    (MulEquiv.subgroupCongr hGeq).trans
      (MonoidHom.ofInjective (conj_injective_suzuki hK ha)).symm
  haveI := hsimple
  haveI : IsSimpleGroup G := e.isSimpleGroup
  have hnab' : ∃ x y : G, x * y ≠ y * x := by
    obtain ⟨x, y, hxy⟩ := hnab
    exact ⟨e.symm x, e.symm y, fun h => hxy (by simpa using congrArg e h)⟩
  exact rank_eq_three hnab' ((commTransOnInvolutions_suzuki hK ha).of_mulEquiv e.symm) hρ

theorem isSz_suzukiGroup (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    IsSz (2 * a + 1) (suzukiGroup a K) :=
  ⟨rfl, a, ha, K, inferInstance, inferInstance, rfl, hK, ⟨MulEquiv.refl _⟩⟩

/-- Leemans' construction: `Sz(q)` is a string C-group of rank three, with `ρ₀ρ₁` of order
`q - 1` (so `⟨ρ₀, ρ₁⟩` is the maximal dihedral subgroup `D_{2(q-1)}`). -/
theorem exists_isStringCGroup_suzuki [SuzukiGroupSimpleNonab] [Opq4dExistsMulEquivSuzukiMatrixGroup]
    [SuzukiTorusDataSuzukiMatrixGroup]
    [SuzukiTorusDataOfMulEquiv.{0, 0}] [IsPGroupCentralizerOfIsSz] [EqTopOrLeNormalizerTorus]
    (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    ∃ ρ : Fin 3 → suzukiGroup a K, IsStringCGroup ρ ∧
      orderOf (ρ 0 * ρ 1) = 2 ^ (2 * a + 1) - 1 := by
  haveI := (SuzukiGroupSimpleNonab.suzukiGroup_simple_nonab ha hK).1
  obtain ⟨ρ, hinv, hgen, h02, h01, hint⟩ := exists_rank_three (isSz_suzukiGroup ha hK)
  refine ⟨ρ, ⟨hinv, hgen, fun i j hij => ?_, hint⟩, h01⟩
  fin_cases i <;> fin_cases j <;> first | exact h02 | (exfalso; simp at hij)

/-- **Leemans, Theorem 1, "if" direction.** `Sz(q) = Inn(Sz(q))` is a string C-group (of
rank `3`). -/
theorem exists_isStringCGroup_inner [SuzukiGroupSimpleNonab] [Opq4dExistsMulEquivSuzukiMatrixGroup]
    [SuzukiTorusDataSuzukiMatrixGroup]
    [SuzukiTorusDataOfMulEquiv.{0, 0}] [IsPGroupCentralizerOfIsSz] [EqTopOrLeNormalizerTorus]
    (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    ∃ ρ : Fin 3 → OuterAutomorphisms.inner (suzukiGroup a K), IsStringCGroup ρ := by
  obtain ⟨ρ, hρ, -⟩ := exists_isStringCGroup_suzuki ha hK
  exact ⟨_, hρ.map_mulEquiv (MonoidHom.ofInjective (conj_injective_suzuki hK ha))⟩

/-- **Polytopes of Suzuki groups.** Let q = 2^(2a+1) with a ≥ 1 and let G be a group of automorphisms of the Suzuki
group Sz(q) containing all inner automorphisms. Then G is generated by a tuple of involutions with the intersection
property ⟨ρᵢ : i ∈ I⟩ ∩ ⟨ρⱼ : j ∈ J⟩ = ⟨ρₖ : k ∈ I ∩ J⟩ if and only if G is the inner automorphism group, the same
holds for string C-group representations (where ρᵢ and ρⱼ commute whenever |i − j| ≥ 2), and every string C-group
representation of Sz(q) has exactly 3 generators.

Source: D. Leemans, Almost simple groups of Suzuki type acting on polytopes, Proc. Amer. Math. Soc. 134 (2006),
3649–3651, Theorem 1. https://doi.org/10.1090/S0002-9939-06-08448-6

This version takes the corpus theorems it uses as instance arguments; the version in `unconditional/` supplies them
from the CFSG corpus. -/
theorem leemans_theorem_1 [SuzukiGroupSimpleNonab]
    [SuzukiCentralizerEqSylow] [SuzukiMemCentralizerOfSqEqOne.{0}]
    [SuzukiOuterAutomorphismGroupHasOddOrder] [Opq4dExistsMulEquivSuzukiMatrixGroup]
    [SuzukiTorusDataSuzukiMatrixGroup] [SuzukiTorusDataOfMulEquiv.{0, 0}] [IsPGroupCentralizerOfIsSz]
    [EqTopOrLeNormalizerTorus] (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G) :
    ((∃ (n : ℕ) (ρ : Fin n → G), IsCGroup ρ) ↔ G = OuterAutomorphisms.inner (suzukiGroup a K)) ∧
      ((∃ (n : ℕ) (ρ : Fin n → G), IsStringCGroup ρ) ↔ G = OuterAutomorphisms.inner (suzukiGroup a K)) ∧
      ∀ (n : ℕ) (ρ : Fin n → G), IsStringCGroup ρ → n = 3 := by
  have hif : G = OuterAutomorphisms.inner (suzukiGroup a K) → ∃ ρ : Fin 3 → G, IsStringCGroup ρ := by
    rintro rfl
    exact exists_isStringCGroup_inner ha hK
  refine ⟨⟨fun ⟨n, ρ, hρ⟩ => ?_, fun hGeq => ?_⟩,
    ⟨fun ⟨n, ρ, hρ⟩ => (leemans_suzuki ha hK G hG ρ hρ).1, fun hGeq => ?_⟩,
    fun n ρ hρ => (leemans_suzuki ha hK G hG ρ hρ).2⟩
  · refine eq_inner_of_closure_involutions ha hK G hG (Set.range fun i => (ρ i : MulAut _)) ?_ ?_
    · rintro _ ⟨i, rfl⟩
      rw [Subgroup.orderOf_coe, hρ.involution i]
    · change Subgroup.closure (Set.range (G.subtype ∘ ρ)) = G
      rw [Set.range_comp, ← MonoidHom.map_closure, hρ.generates,
        ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  · obtain ⟨ρ, hρ⟩ := hif hGeq
    exact ⟨3, ρ, hρ.isCGroup⟩
  · obtain ⟨ρ, hρ⟩ := hif hGeq
    exact ⟨3, ρ, hρ⟩

end Suzuki


end CFSGOutside.Leemans
