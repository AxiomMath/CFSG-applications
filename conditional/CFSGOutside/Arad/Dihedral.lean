import CFSGOutside.Arad.Defs

/-!
# Arad, Theorem B(iii): dihedral or abelian Sylow `2`-subgroups pass to subgroups and quotients

Subgroups and quotients of dihedral groups are dihedral or abelian, so the hypothesis of Theorem B(iii) is
inherited by subgroups and quotient groups.
-/

namespace CFSGOutside.Arad

/-- A group is commutative or dihedral. -/
def DihOrAb (K : Type*) [Group K] : Prop :=
  IsMulCommutative K ∨ ∃ n : ℕ, Nonempty (K ≃* DihedralGroup n)

lemma isMulCommutative_of_comm {K : Type*} [Mul K] (h : ∀ a b : K, a * b = b * a) :
    IsMulCommutative K := ⟨⟨h⟩⟩

lemma DihOrAb.of_equiv {K L : Type*} [Group K] [Group L] (e : K ≃* L) (h : DihOrAb L) :
    DihOrAb K := by
  rcases h with h | ⟨n, ⟨f⟩⟩
  · exact Or.inl (isMulCommutative_of_comm fun a b => e.injective (by
      simpa using h.is_comm.comm (e a) (e b)))
  · exact Or.inr ⟨n, ⟨e.trans f⟩⟩

section Gen

variable {K : Type*} [Group K]

lemma pow_val_add (x : K) [NeZero (orderOf x)] (a b : ZMod (orderOf x)) :
    x ^ (a + b).val = x ^ a.val * x ^ b.val := by
  rw [ZMod.val_add, pow_mod_orderOf, pow_add]

lemma pow_val_neg (x : K) [NeZero (orderOf x)] (a : ZMod (orderOf x)) :
    x ^ (-a).val = (x ^ a.val)⁻¹ := by
  refine eq_inv_of_mul_eq_one_left ?_
  rw [← pow_val_add]; simp

lemma pow_val_conj (u x : K) [NeZero (orderOf x)] (hu : u * u = 1) (hux : u * x * u = x⁻¹)
    (a : ZMod (orderOf x)) : u * x ^ a.val = x ^ (-a).val * u := by
  have h1 : u * x = x⁻¹ * u := by
    calc u * x = u * x * u * u := by rw [mul_assoc _ u u, hu, mul_one]
      _ = x⁻¹ * u := by rw [hux]
  have : ∀ n : ℕ, u * x ^ n = (x ^ n)⁻¹ * u := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ', ← mul_assoc, h1, mul_assoc, ih, ← mul_assoc, ← mul_inv_rev,
        (Commute.self_pow x n).eq]
  rw [this, pow_val_neg]

/-- The homomorphism from the dihedral group onto the group generated by two involutions. -/
noncomputable def dihHom (u v : K) (hu : u * u = 1) (hv : v * v = 1)
    [NeZero (orderOf (u * v))] : DihedralGroup (orderOf (u * v)) →* K where
  toFun
    | .r i => (u * v) ^ i.val
    | .sr i => u * (u * v) ^ i.val
  map_one' := by
    show (u * v) ^ (0 : ZMod (orderOf (u * v))).val = 1
    simp
  map_mul' := by
    have hux : u * (u * v) * u = (u * v)⁻¹ := by
      have hv' : v⁻¹ = v := inv_eq_of_mul_eq_one_right hv
      have hu' : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
      rw [mul_inv_rev, hv', hu', ← mul_assoc, hu, one_mul]
    have hc := pow_val_conj u (u * v) hu hux
    rintro (i | i) (j | j)
    · simp [DihedralGroup.r_mul_r, pow_val_add]
    · simp only [DihedralGroup.r_mul_sr, MonoidHom.coe_mk, OneHom.coe_mk]
      have h := hc (-i)
      rw [neg_neg] at h
      rw [sub_eq_neg_add, pow_val_add, ← mul_assoc, h, mul_assoc]
    · simp only [DihedralGroup.sr_mul_r, MonoidHom.coe_mk, OneHom.coe_mk]
      rw [pow_val_add, mul_assoc]
    · simp only [DihedralGroup.sr_mul_sr, MonoidHom.coe_mk, OneHom.coe_mk]
      rw [sub_eq_neg_add, pow_val_add, hc i, mul_assoc, ← mul_assoc u, hu, one_mul]


lemma dihHom_r (u v : K) (hu : u * u = 1) (hv : v * v = 1) [NeZero (orderOf (u * v))] (i : ZMod (orderOf (u * v))) :
    dihHom u v hu hv (DihedralGroup.r i) = (u * v) ^ i.val := rfl

lemma dihHom_sr (u v : K) (hu : u * u = 1) (hv : v * v = 1) [NeZero (orderOf (u * v))] (i : ZMod (orderOf (u * v))) :
    dihHom u v hu hv (DihedralGroup.sr i) = u * (u * v) ^ i.val := rfl

/-- A finite group generated by two involutions is commutative or dihedral. -/
theorem dihOrAb_of_closure_involutions [Finite K] (u v : K) (hu : u * u = 1) (hv : v * v = 1)
    (hK : Subgroup.closure {u, v} = ⊤) : DihOrAb K := by
  haveI : NeZero (orderOf (u * v)) := ⟨(orderOf_pos _).ne'⟩
  set x := u * v with hx
  have hnat : ∀ n : ℕ, dihHom u v hu hv (DihedralGroup.r (n : ZMod (orderOf x))) = x ^ n := by
    intro n
    rw [dihHom_r, ZMod.val_natCast, pow_mod_orderOf]
  have hsurj : Function.Surjective (dihHom u v hu hv) := by
    rw [← MonoidHom.range_eq_top, eq_top_iff, ← hK, Subgroup.closure_le]
    have h1 : u ∈ (dihHom u v hu hv).range := ⟨DihedralGroup.sr 0, by simp [dihHom_sr]⟩
    have h2 : x ∈ (dihHom u v hu hv).range := ⟨DihedralGroup.r ((1 : ℕ) : ZMod (orderOf x)), by
      rw [hnat, pow_one]⟩
    have h3 : v ∈ (dihHom u v hu hv).range := by
      have e : u * x = v := by rw [hx, ← mul_assoc, hu, one_mul]
      have := mul_mem h1 h2
      rwa [e] at this
    intro y hy
    rcases hy with rfl | rfl
    · exact h1
    · simpa using h3
  by_cases hux : u ∈ Subgroup.zpowers x
  · left
    have hv' : v ∈ Subgroup.zpowers x := by
      have e : u * x = v := by rw [hx, ← mul_assoc, hu, one_mul]
      have := mul_mem hux (Subgroup.mem_zpowers x)
      rwa [e] at this
    have hall : ∀ g : K, g ∈ Subgroup.zpowers x := by
      intro g
      have : g ∈ Subgroup.closure {u, v} := hK ▸ Subgroup.mem_top g
      refine (Subgroup.closure_le _).mpr ?_ this
      intro y hy
      rcases hy with rfl | rfl
      · exact hux
      · exact hv'
    refine isMulCommutative_of_comm fun a b => ?_
    obtain ⟨i, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hall a)
    obtain ⟨j, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hall b)
    exact (Commute.zpow_zpow_self x i j).eq
  · right
    refine ⟨orderOf x, ⟨MulEquiv.symm (MulEquiv.ofBijective (dihHom u v hu hv) ⟨?_, hsurj⟩)⟩⟩
    rw [injective_iff_map_eq_one]
    rintro (i | i) h
    · rw [dihHom_r] at h
      have : i.val = 0 := by
        have := orderOf_dvd_of_pow_eq_one h
        exact Nat.eq_zero_of_dvd_of_lt this (ZMod.val_lt i)
      have : i = 0 := (ZMod.val_eq_zero i).mp this
      rw [this]; rfl
    · exfalso
      rw [dihHom_sr] at h
      apply hux
      have : u = (x ^ i.val)⁻¹ := eq_inv_of_mul_eq_one_left h
      rw [this]
      exact inv_mem (pow_mem (Subgroup.mem_zpowers x) _)


/-- A finite subgroup generated by two involutions is commutative or dihedral. -/
theorem dihOrAb_subgroup_of_closure {G : Type*} [Group G] (H : Subgroup G) [Finite H] (u v : G)
    (hu : u * u = 1) (hv : v * v = 1) (hH : H = Subgroup.closure {u, v}) : DihOrAb H := by
  have hu' : u ∈ H := hH ▸ Subgroup.subset_closure (by simp)
  have hv' : v ∈ H := hH ▸ Subgroup.subset_closure (by simp)
  refine dihOrAb_of_closure_involutions (⟨u, hu'⟩ : H) ⟨v, hv'⟩ (Subtype.ext hu) (Subtype.ext hv) ?_
  have hmap : (Subgroup.closure {(⟨u, hu'⟩ : H), ⟨v, hv'⟩}).map H.subtype = H := by
    rw [MonoidHom.map_closure]
    have : H.subtype '' {(⟨u, hu'⟩ : H), ⟨v, hv'⟩} = {u, v} := by simp [Set.image_pair]
    rw [this]; exact hH.symm
  rw [eq_top_iff]
  intro y _
  have : y.1 ∈ (Subgroup.closure {(⟨u, hu'⟩ : H), ⟨v, hv'⟩}).map H.subtype := by
    rw [hmap]; exact y.2
  obtain ⟨z, hz, hzy⟩ := this
  have : z = y := Subtype.ext hzy
  exact this ▸ hz

end Gen

lemma dihedral_closure_sr {n : ℕ} [NeZero n] :
    Subgroup.closure {(DihedralGroup.sr 0 : DihedralGroup n), DihedralGroup.sr 1} = ⊤ := by
  set S := Subgroup.closure {(DihedralGroup.sr 0 : DihedralGroup n), DihedralGroup.sr 1}
  have h0 : (DihedralGroup.sr 0 : DihedralGroup n) ∈ S := Subgroup.subset_closure (by simp)
  have h1 : (DihedralGroup.sr 1 : DihedralGroup n) ∈ S := Subgroup.subset_closure (by simp)
  have hr1 : (DihedralGroup.r 1 : DihedralGroup n) ∈ S := by
    have := mul_mem h0 h1
    simpa [DihedralGroup.sr_mul_sr] using this
  have hr : ∀ i : ZMod n, (DihedralGroup.r i : DihedralGroup n) ∈ S := by
    intro i
    have := pow_mem hr1 i.val
    rwa [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val] at this
  rw [eq_top_iff]
  rintro (i | i) _
  · exact hr i
  · have := mul_mem h0 (hr i)
    simpa [DihedralGroup.sr_mul_r] using this

/-- A finite surjective image of a dihedral group is commutative or dihedral. -/
theorem dihOrAb_of_surjective {n : ℕ} [NeZero n] {K : Type*} [Group K] [Finite K]
    (f : DihedralGroup n →* K) (hf : Function.Surjective f) : DihOrAb K := by
  have hu : f (DihedralGroup.sr 0) * f (DihedralGroup.sr 0) = 1 := by
    rw [← map_mul]; simp [DihedralGroup.sr_mul_sr]
  have hv : f (DihedralGroup.sr 1) * f (DihedralGroup.sr 1) = 1 := by
    rw [← map_mul]; simp [DihedralGroup.sr_mul_sr]
  refine dihOrAb_of_closure_involutions _ _ hu hv ?_
  have := congrArg (Subgroup.map f) (dihedral_closure_sr (n := n))
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, MonoidHom.range_eq_top.mpr hf] at this
  simpa [Set.image_pair] using this

lemma dihedral_r_mem_zpowers {n : ℕ} [NeZero n] (i : ZMod n) :
    (DihedralGroup.r i : DihedralGroup n) ∈ Subgroup.zpowers (DihedralGroup.r 1) := by
  have := pow_mem (Subgroup.mem_zpowers (DihedralGroup.r 1 : DihedralGroup n)) i.val
  rwa [DihedralGroup.r_one_pow, ZMod.natCast_zmod_val] at this

lemma dihedral_exists_r_of_mem_zpowers {n : ℕ} (g : DihedralGroup n)
    (hg : g ∈ Subgroup.zpowers (DihedralGroup.r 1)) : ∃ i, g = DihedralGroup.r i := by
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
  exact ⟨k, DihedralGroup.r_one_zpow k⟩

/-- Every subgroup of a finite dihedral group is commutative or dihedral. -/
theorem dihOrAb_subgroup_dihedral {n : ℕ} [NeZero n] (H : Subgroup (DihedralGroup n)) :
    DihOrAb H := by
  by_cases hs : ∃ j, (DihedralGroup.sr j : DihedralGroup n) ∈ H
  · obtain ⟨j, hj⟩ := hs
    set R : Subgroup (DihedralGroup n) := H ⊓ Subgroup.zpowers (DihedralGroup.r 1) with hR
    have hRle : R ≤ Subgroup.zpowers (DihedralGroup.r 1) := inf_le_right
    haveI : IsCyclic R := Subgroup.isCyclic_of_le hRle
    obtain ⟨c, hc⟩ := IsCyclic.exists_generator (α := R)
    obtain ⟨d, hd⟩ := dihedral_exists_r_of_mem_zpowers c.1 (hRle c.2)
    have hcH : (DihedralGroup.r d : DihedralGroup n) ∈ H := hd ▸ c.2.1
    have hu : (DihedralGroup.sr j : DihedralGroup n) * DihedralGroup.sr j = 1 := by
      simp [DihedralGroup.sr_mul_sr]
    have hv : (DihedralGroup.sr j * DihedralGroup.r d : DihedralGroup n) *
        (DihedralGroup.sr j * DihedralGroup.r d) = 1 := by
      simp [DihedralGroup.sr_mul_r, DihedralGroup.sr_mul_sr]
    refine dihOrAb_subgroup_of_closure H _ _ hu hv ?_
    set S := Subgroup.closure {(DihedralGroup.sr j : DihedralGroup n),
      DihedralGroup.sr j * DihedralGroup.r d}
    have hu' : (DihedralGroup.sr j : DihedralGroup n) ∈ S := Subgroup.subset_closure (by simp)
    have hv' : (DihedralGroup.sr j * DihedralGroup.r d : DihedralGroup n) ∈ S :=
      Subgroup.subset_closure (by simp)
    have hrd : (DihedralGroup.r d : DihedralGroup n) ∈ S := by
      have := mul_mem hu' hv'
      rwa [← mul_assoc, hu, one_mul] at this
    have hrot : ∀ i : ZMod n, (DihedralGroup.r i : DihedralGroup n) ∈ H →
        (DihedralGroup.r i : DihedralGroup n) ∈ S := by
      intro i hi
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hc ⟨_, hi, dihedral_r_mem_zpowers i⟩)
      have : ((c ^ k : R) : DihedralGroup n) = DihedralGroup.r i := by rw [hk]
      rw [Subgroup.coe_zpow, hd] at this
      rw [← this]
      exact zpow_mem hrd k
    apply le_antisymm
    · rintro (i | i) hi
      · exact hrot i hi
      · have h1 : (DihedralGroup.r (i - j) : DihedralGroup n) ∈ H := by
          have := mul_mem hj hi
          simpa [DihedralGroup.sr_mul_sr] using this
        have := mul_mem hu' (hrot _ h1)
        simpa [DihedralGroup.sr_mul_r] using this
    · rw [Subgroup.closure_le]
      intro y hy
      rcases hy with rfl | rfl
      · exact hj
      · exact mul_mem hj hcH
  · push Not at hs
    left
    refine isMulCommutative_of_comm fun a b => ?_
    obtain ⟨a, ha⟩ := a
    obtain ⟨b, hb⟩ := b
    rcases a with i | i
    · rcases b with j | j
      · apply Subtype.ext
        simp [DihedralGroup.r_mul_r, add_comm]
      · exact absurd hb (hs j)
    · exact absurd ha (hs i)


lemma DihOrAb.subgroup {P : Type*} [Group P] [Finite P] (hP : DihOrAb P) (S : Subgroup P) :
    DihOrAb S := by
  rcases hP with hP | ⟨n, ⟨e⟩⟩
  · exact Or.inl (isMulCommutative_of_comm fun a b => Subtype.ext (hP.is_comm.comm a.1 b.1))
  · haveI : Finite (DihedralGroup n) := Finite.of_equiv P e
    haveI : NeZero n := by
      refine ⟨fun h0 => ?_⟩
      have h1 : Nat.card (DihedralGroup n) = 0 := by rw [DihedralGroup.nat_card, h0]; rfl
      exact (Nat.card_pos (α := DihedralGroup n)).ne' h1
    exact DihOrAb.of_equiv (S.equivMapOfInjective e.toMonoidHom e.injective)
      (dihOrAb_subgroup_dihedral _)

lemma DihOrAb.of_surjective' {P K : Type*} [Group P] [Group K] [Finite P] [Finite K]
    (f : P →* K) (hf : Function.Surjective f) (hP : DihOrAb P) : DihOrAb K := by
  rcases hP with hP | ⟨n, ⟨e⟩⟩
  · refine Or.inl (isMulCommutative_of_comm fun a b => ?_)
    obtain ⟨a, rfl⟩ := hf a
    obtain ⟨b, rfl⟩ := hf b
    rw [← map_mul, ← map_mul, hP.is_comm.comm a b]
  · haveI : Finite (DihedralGroup n) := Finite.of_equiv P e
    haveI : NeZero n := by
      refine ⟨fun h0 => ?_⟩
      have h1 : Nat.card (DihedralGroup n) = 0 := by rw [DihedralGroup.nat_card, h0]; rfl
      exact (Nat.card_pos (α := DihedralGroup n)).ne' h1
    exact dihOrAb_of_surjective (f.comp e.symm.toMonoidHom) (hf.comp e.symm.surjective)

theorem sylowTwoDihedralOrAbelian_subgroup {G : Type*} [Group G] [Finite G]
    (h : SylowTwoDihedralOrAbelian G) (H : Subgroup G) : SylowTwoDihedralOrAbelian H := by
  intro Q
  have hQ' : IsPGroup 2 (Q.map H.subtype) := (Q.isPGroup').map H.subtype
  obtain ⟨P, hle⟩ := hQ'.exists_le_sylow
  have h1 : DihOrAb (Q.map H.subtype) :=
    DihOrAb.of_equiv (Subgroup.subgroupOfEquivOfLe hle).symm (DihOrAb.subgroup (h P) _)
  exact DihOrAb.of_equiv (Subgroup.equivMapOfInjective (Q : Subgroup H) H.subtype H.subtype_injective) h1

open scoped Pointwise in
theorem sylowTwoDihedralOrAbelian_quotient {G : Type*} [Group G] [Finite G]
    (h : SylowTwoDihedralOrAbelian G) (N : Subgroup G) [N.Normal] :
    SylowTwoDihedralOrAbelian (G ⧸ N) := by
  intro Q
  have hsurj := QuotientGroup.mk'_surjective N
  obtain ⟨P0⟩ : Nonempty (Sylow 2 G) := inferInstance
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (G ⧸ N) (Sylow.mapSurjective hsurj P0) Q
  have h1 : DihOrAb (Sylow.mapSurjective hsurj P0 : Subgroup (G ⧸ N)) := by
    refine DihOrAb.of_surjective' (P := (P0 : Subgroup G)) ?_ ?_ (h P0)
    · exact ((QuotientGroup.mk' N).comp (P0 : Subgroup G).subtype).codRestrict _ (fun x => by
        rw [Sylow.coe_mapSurjective]; exact ⟨x, x.2, rfl⟩)
    · rintro ⟨y, hy⟩
      rw [Sylow.coe_mapSurjective] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      exact ⟨⟨x, hx⟩, rfl⟩
  have h2 : (Q : Subgroup (G ⧸ N)) = ConjAct.toConjAct g • (Sylow.mapSurjective hsurj P0 : Subgroup (G ⧸ N)) := by
    rw [← hg]; rfl
  rw [h2]
  exact DihOrAb.of_equiv (Subgroup.equivSMul (ConjAct.toConjAct g) _).symm h1

end CFSGOutside.Arad
