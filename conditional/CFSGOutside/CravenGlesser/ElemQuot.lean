import CFSGOutside.CravenGlesser.Basic

/-!
# Elementary abelian quotients as `𝔽₂`-vector spaces

For a characteristic subgroup `N` of `G` containing every square and commutator, `G ⧸ N` is an
elementary abelian 2-group. `ElemQuot N` is that quotient written additively, as a `ZMod 2`-module, and
each automorphism of `G` induces a linear endomorphism of it.
-/

namespace CFSGOutside.CravenGlesser

open Subgroup

variable {G : Type*} [Group G]

/-- `N` is characteristic and contains every square and every commutator. -/
class IsElemQuot (N : Subgroup G) : Prop where
  normal : N.Normal
  sq_mem : ∀ x : G, x ^ 2 ∈ N
  comm_mem : ∀ x y : G, x * y * x⁻¹ * y⁻¹ ∈ N
  map_mem : ∀ σ : MulAut G, ∀ x ∈ N, σ x ∈ N

attribute [instance] IsElemQuot.normal

/-- The quotient `G ⧸ N`, written additively. -/
def ElemQuot (N : Subgroup G) : Type _ := Additive (G ⧸ N)

namespace ElemQuot

variable (N : Subgroup G) [IsElemQuot N]

instance : AddCommGroup (ElemQuot N) :=
  { (inferInstance : AddGroup (Additive (G ⧸ N))) with
    add_comm := by
      intro a b
      change Additive.ofMul (Additive.toMul a * Additive.toMul b) =
        Additive.ofMul (Additive.toMul b * Additive.toMul a)
      congr 1
      induction Additive.toMul a using QuotientGroup.induction_on with | H x => ?_
      induction Additive.toMul b using QuotientGroup.induction_on with | H y => ?_
      rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
      have := IsElemQuot.comm_mem (N := N) y⁻¹ x⁻¹
      simpa [mul_assoc] using this }

/-- The image of an element. -/
def mk (x : G) : ElemQuot N := Additive.ofMul (x : G ⧸ N)

variable {N}

theorem mk_mul (x y : G) : mk N (x * y) = mk N x + mk N y := rfl

theorem mk_one : mk N 1 = 0 := rfl

theorem mk_inv (x : G) : mk N x⁻¹ = - mk N x := rfl

theorem mk_eq_zero {x : G} : mk N x = 0 ↔ x ∈ N := QuotientGroup.eq_one_iff x

theorem mk_eq_mk {x y : G} : mk N x = mk N y ↔ x⁻¹ * y ∈ N := QuotientGroup.eq

theorem mk_surjective : Function.Surjective (mk N) := fun v =>
  QuotientGroup.mk_surjective (Additive.toMul v)

theorem induction_on {p : ElemQuot N → Prop} (v : ElemQuot N) (h : ∀ x, p (mk N x)) : p v := by
  obtain ⟨x, rfl⟩ := mk_surjective v; exact h x

theorem two_nsmul_eq_zero (v : ElemQuot N) : 2 • v = 0 := by
  induction v using induction_on with | h x => ?_
  rw [two_nsmul, ← mk_mul, ← sq, mk_eq_zero]
  exact IsElemQuot.sq_mem x

instance : Module (ZMod 2) (ElemQuot N) := AddCommGroup.zmodModule two_nsmul_eq_zero

theorem add_self (v : ElemQuot N) : v + v = 0 := by
  rw [← two_nsmul]; exact two_nsmul_eq_zero v

theorem neg_eq (v : ElemQuot N) : -v = v := by
  rw [neg_eq_iff_add_eq_zero, add_self]

instance [Finite G] : Finite (ElemQuot N) := inferInstanceAs (Finite (G ⧸ N))

instance [Finite G] : FiniteDimensional (ZMod 2) (ElemQuot N) := Module.Finite.of_finite

variable (N)

/-- The additive endomorphism induced by an automorphism. -/
def inducedAdd (σ : MulAut G) : ElemQuot N →+ ElemQuot N where
  toFun v := Additive.ofMul (QuotientGroup.map N N σ.toMonoidHom
    (fun x hx => IsElemQuot.map_mem σ x hx) (Additive.toMul v))
  map_zero' := congrArg Additive.ofMul (map_one _)
  map_add' a b := congrArg Additive.ofMul (map_mul _ (Additive.toMul a) (Additive.toMul b))

/-- The linear endomorphism induced by an automorphism. -/
def induced (σ : MulAut G) : Module.End (ZMod 2) (ElemQuot N) :=
  AddMonoidHom.toZModLinearMap 2 (inducedAdd N σ)

variable {N}

@[simp] theorem induced_mk (σ : MulAut G) (x : G) : induced N σ (mk N x) = mk N (σ x) := rfl

variable (N)

/-- Inducing is a monoid homomorphism. -/
def inducedHom : MulAut G →* Module.End (ZMod 2) (ElemQuot N) where
  toFun := induced N
  map_one' := by
    ext v
    induction v using induction_on with | h x => ?_
    simp
  map_mul' σ τ := by
    ext v
    induction v using induction_on with | h x => ?_
    simp [MulAut.mul_apply]

variable {N}

theorem inducedHom_apply (σ : MulAut G) : inducedHom N σ = induced N σ := rfl

theorem induced_pow_mk (σ : MulAut G) (k : ℕ) (x : G) :
    (induced N σ ^ k) (mk N x) = mk N ((σ ^ k) x) := by
  rw [← inducedHom_apply, ← map_pow, inducedHom_apply, induced_mk]

/-- The induced map is the identity iff `σ` acts trivially modulo `N`. -/
theorem induced_eq_one_iff (σ : MulAut G) : induced N σ = 1 ↔ ∀ x, x⁻¹ * σ x ∈ N := by
  constructor
  · intro h x
    have := congrArg (fun f => f (mk N x)) h
    simp only [induced_mk, Module.End.one_apply] at this
    exact (mk_eq_mk.mp this.symm)
  · intro h
    ext v
    induction v using induction_on with | h x => ?_
    simp only [induced_mk, Module.End.one_apply]
    exact (mk_eq_mk.mpr (h x)).symm

/-- If `G` is generated by `S`, the images of `S` span `ElemQuot N`. -/
theorem finrank_le_card [Finite G] [DecidableEq (ElemQuot N)] {S : Finset G}
    (hS : closure (S : Set G) = ⊤) : Module.finrank (ZMod 2) (ElemQuot N) ≤ S.card := by
  have hspan : Submodule.span (ZMod 2) ((S.image (mk N) : Finset (ElemQuot N)) : Set (ElemQuot N)) = ⊤ := by
    rw [eq_top_iff]
    rintro v -
    induction v using induction_on with | h x => ?_
    have hx : x ∈ closure (S : Set G) := by rw [hS]; trivial
    induction hx using closure_induction with
    | mem y hy =>
      apply Submodule.subset_span
      simp only [Finset.coe_image]
      exact ⟨y, hy, rfl⟩
    | one => rw [mk_one]; exact Submodule.zero_mem _
    | mul a b _ _ ha hb => rw [mk_mul]; exact Submodule.add_mem _ ha hb
    | inv a _ ha => rw [mk_inv]; exact Submodule.neg_mem _ ha
  calc Module.finrank (ZMod 2) (ElemQuot N)
      = Module.finrank (ZMod 2) (⊤ : Submodule (ZMod 2) (ElemQuot N)) := finrank_top _ _ |>.symm
    _ = Module.finrank (ZMod 2) (Submodule.span (ZMod 2)
          ((S.image (mk N) : Finset (ElemQuot N)) : Set (ElemQuot N))) := by rw [hspan]
    _ ≤ (S.image (mk N)).card := finrank_span_finset_le_card _
    _ ≤ S.card := Finset.card_image_le

end ElemQuot

/-- The Frattini subgroup of a finite 2-group satisfies `IsElemQuot`. -/
theorem isElemQuot_frattini [Finite G] (hG : IsPGroup 2 G) : IsElemQuot (frattini G) where
  normal := haveI := frattini_characteristic (G := G); inferInstance
  sq_mem := sq_mem_frattini hG
  comm_mem := comm_mem_frattini hG
  map_mem σ x hx := by
    have hc := (frattini_characteristic (G := G)).fixed σ
    rw [← hc] at hx
    exact hx

end CFSGOutside.CravenGlesser
