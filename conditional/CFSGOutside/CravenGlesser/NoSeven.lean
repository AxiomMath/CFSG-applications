import CFSGOutside.CravenGlesser.SquareCommutator
import CFSGOutside.Corpus.Defs.OpenVocabulary

/-!
# A 2-group of 2-rank at most 2 has no automorphism of order 7

Craven–Glesser exclude `o(φ) = 7` in Lemma 6.11 by a minimal counterexample argument that uses their
Proposition 6.10 (no invariant maximal subgroup), which rests on a Magma computation. We give a direct
proof. Take a `ψ`-invariant subgroup `R`, minimal such that `ψ` acts nontrivially on it. Then `[R, ψ] = R`,
every proper `ψ`-invariant subgroup is centralized, and the subgroup `D` generated by squares and
commutators is central of exponent 2 and fixed by `ψ`. On `V = R / D`, `ψ` induces `T` with `T⁷ = 1` and
`T ≠ 1`. Since `X⁷ + 1 = (X + 1)(X³ + X + 1)(X³ + X² + 1)` over `𝔽₂`, some `u ≠ 0` spans a 3-dimensional
`T`-cyclic subspace on whose nonzero vectors `T` acts transitively. Squaring is `ψ`-invariant, so it is
constant on these seven vectors, and expanding the square of a product of three lifts shows that the
constant is 1. The lifts are then commuting involutions with independent images, and they generate an
elementary abelian subgroup of order 8.
-/

namespace CFSGOutside.CravenGlesser

open Subgroup Polynomial
open CFSGOutside.Corpus.Open (IsElemAbelian)

section Linear

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

theorem add_self_zmod2 (v : V) : v + v = 0 := by
  rw [← two_smul (ZMod 2) v, show (2 : ZMod 2) = 0 from rfl, zero_smul]

theorem eq_add_of_sum_eq_zero {a b c : V} (h : a + b + c = 0) : a = b + c := by
  rw [← sub_eq_zero, sub_eq_add_neg, neg_eq_iff_add_eq_zero.mpr (add_self_zmod2 (b + c)), ← add_assoc]
  exact h

theorem polyid :
    (X ^ 3 + X + 1) * (X ^ 3 + X ^ 2 + 1) * (X + 1) = (X ^ 7 + 1 : Polynomial (ZMod 2)) := by
  have h2 : (2 : Polynomial (ZMod 2)) = 0 := by
    have := CharP.cast_eq_zero (Polynomial (ZMod 2)) 2; simpa using this
  linear_combination (X ^ 6 + X ^ 5 + 2 * X ^ 4 + 2 * X ^ 3 + X ^ 2 + X) * h2

/-- A linear map of order 7 on an `𝔽₂`-space has a nonzero vector annihilated by one of the two irreducible
cubics. -/
theorem exists_cubic (T : Module.End (ZMod 2) V) (h7 : T ^ 7 = 1) (h1 : T ≠ 1) :
    ∃ u : V, u ≠ 0 ∧ ((T ^ 3) u = T u + u ∨ (T ^ 3) u = (T ^ 2) u + u) := by
  obtain ⟨v, hv⟩ : ∃ v, T v ≠ v := by
    by_contra h
    push Not at h
    exact h1 (LinearMap.ext h)
  have hw : T v + v ≠ 0 := by
    intro h
    apply hv
    have := eq_add_of_sum_eq_zero (show T v + v + 0 = 0 by rw [add_zero, h])
    rwa [add_zero] at this
  have hkey : aeval T ((X ^ 3 + X + 1) * (X ^ 3 + X ^ 2 + 1) * (X + 1) : Polynomial (ZMod 2)) = 0 := by
    rw [polyid]
    simp only [map_add, map_pow, aeval_X, map_one, h7]
    ext x
    simp [add_self_zmod2]
  have happ := congrArg (fun f => f v) hkey
  simp only [map_mul, Module.End.mul_apply, LinearMap.zero_apply] at happ
  set w := T v + v with hwdef
  have hXw : aeval T (X + 1 : Polynomial (ZMod 2)) v = w := by simp [hwdef]
  rw [hXw] at happ
  set y := aeval T (X ^ 3 + X ^ 2 + 1 : Polynomial (ZMod 2)) w with hy
  have hyw : y = (T ^ 3) w + (T ^ 2) w + w := by simp [hy]
  by_cases hy0 : y = 0
  · refine ⟨w, hw, Or.inr ?_⟩
    rw [hyw] at hy0
    exact eq_add_of_sum_eq_zero hy0
  · refine ⟨y, hy0, Or.inl ?_⟩
    have : (T ^ 3) y + T y + y = 0 := by simpa using happ
    exact eq_add_of_sum_eq_zero this

/-- Distinctness of the orbit of a vector under `T` of order dividing 7. -/
theorem orbit_facts (T : Module.End (ZMod 2) V) (h7 : T ^ 7 = 1) {u : V} (hu : u ≠ 0) (hTu : T u ≠ u) :
    (∀ a, (T ^ a) u ≠ 0) ∧ ∀ a b, a < b → b < 7 → (T ^ a) u ≠ (T ^ b) u := by
  have h7u : ∀ v, (T ^ 7) v = v := fun v => by rw [h7]; rfl
  have hpow : ∀ k, 0 < k → k < 7 → (T ^ k) u ≠ u := by
    intro k hk0 hk7 hk
    have hmul : ∀ n, (T ^ (k * n)) u = u := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [Nat.mul_succ, pow_add, Module.End.mul_apply, hk, ih]
    have hT : ∀ m, T ^ (7 * m + 1) = T := by
      intro m; rw [pow_add, pow_mul, h7, one_pow, one_mul, pow_one]
    apply hTu
    interval_cases k
    · simpa using hk
    · have := hmul 4; rwa [show 2 * 4 = 7 * 1 + 1 by norm_num, hT] at this
    · have := hmul 5; rwa [show 3 * 5 = 7 * 2 + 1 by norm_num, hT] at this
    · have := hmul 2; rwa [show 4 * 2 = 7 * 1 + 1 by norm_num, hT] at this
    · have := hmul 3; rwa [show 5 * 3 = 7 * 2 + 1 by norm_num, hT] at this
    · have := hmul 6; rwa [show 6 * 6 = 7 * 5 + 1 by norm_num, hT] at this
  have hinj : ∀ a v w, (T ^ a) v = (T ^ a) w → v = w := by
    intro a v w h
    have hv : ∀ x, (T ^ (7 * a)) x = x := fun x => by rw [pow_mul, h7, one_pow]; rfl
    have hsplit : ∀ x, (T ^ (7 * a)) x = (T ^ (7 * a - a)) ((T ^ a) x) := by
      intro x
      rw [← Module.End.mul_apply, ← pow_add, Nat.sub_add_cancel (by omega)]
    rw [← hv v, ← hv w, hsplit, hsplit, h]
  refine ⟨fun a ha => hu (hinj a u 0 (by rw [ha, map_zero])), fun a b hab hb7 h => ?_⟩
  apply hpow (b - a) (by omega) (by omega)
  apply hinj a
  rw [← Module.End.mul_apply, ← pow_add, Nat.add_sub_cancel' hab.le]
  exact h.symm

end Linear

section Group

variable {G : Type*} [Group G]

/-- Three pairwise commuting involutions generate an elementary abelian 2-subgroup. -/
theorem isElemAbelian_closure_three {x₀ x₁ x₂ : G} (h₀ : x₀ ^ 2 = 1) (h₁ : x₁ ^ 2 = 1)
    (h₂ : x₂ ^ 2 = 1) (h₀₁ : x₀ * x₁ = x₁ * x₀) (h₀₂ : x₀ * x₂ = x₂ * x₀)
    (h₁₂ : x₁ * x₂ = x₂ * x₁) :
    IsElemAbelian 2 (closure ({x₀, x₁, x₂} : Set G)) := by
  have hk : ({x₀, x₁, x₂} : Set G).Pairwise Commute := by
    intro x hx y hy _
    show x * y = y * x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;> simp_all
  let C := closureCommGroupOfComm hk
  have hcomm : ∀ a ∈ closure ({x₀, x₁, x₂} : Set G), ∀ b ∈ closure ({x₀, x₁, x₂} : Set G),
      a * b = b * a := fun a ha b hb => congrArg Subtype.val (C.mul_comm ⟨a, ha⟩ ⟨b, hb⟩)
  refine ⟨⟨⟨fun a b => Subtype.ext (hcomm a.1 a.2 b.1 b.2)⟩⟩, fun g hg => ?_⟩
  induction hg using closure_induction with
  | mem y hy =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy
    rcases hy with rfl | rfl | rfl <;> assumption
  | one => exact one_pow 2
  | mul a b ha hb iha ihb => rw [(Commute.mul_pow (hcomm a ha b hb) 2), iha, ihb, one_mul]
  | inv a _ iha => rw [inv_pow, iha, inv_one]

end Group

section Minimal

variable {G : Type*} [Group G] [Finite G] (hG : IsPGroup 2 G) (ψ : MulAut G)
  (hodd : Odd (orderOf ψ)) (hfix : ∀ d ∈ sqCommSubgroup G, ψ d = d) (htop : commAut ψ = ⊤)

include hG hodd hfix htop in
/-- Squares of three lifts: if all the relevant squares agree, the common value is 1 and the lifts commute. -/
theorem three_lifts {x₀ x₁ x₂ c : G} (h₀ : x₀ ^ 2 = c) (h₁ : x₁ ^ 2 = c) (h₂ : x₂ ^ 2 = c)
    (h₁₀ : (x₁ * x₀) ^ 2 = c) (h₂₁ : (x₂ * x₁) ^ 2 = c) (h₂₀ : (x₂ * x₀) ^ 2 = c)
    (h₂₁₀ : (x₂ * x₁ * x₀) ^ 2 = c) :
    c = 1 ∧ x₀ * x₁ = x₁ * x₀ ∧ x₀ * x₂ = x₂ * x₀ ∧ x₁ * x₂ = x₂ * x₁ := by
  have hcD : c ∈ sqCommSubgroup G := h₀ ▸ sq_mem_sqComm x₀
  have hcc : c * c = 1 := by rw [← sq]; exact sqComm_sq_eq_one hG ψ hodd hfix htop hcD
  have hb : ∀ {x y : G}, x ^ 2 = c → y ^ 2 = c → (x * y) ^ 2 = c → beta x y = c := by
    intro x y hx hy hxy
    rw [sq_mul ψ hfix htop, hx, hy, hcc, one_mul] at hxy
    exact hxy
  have b₁₀ := hb h₁ h₀ h₁₀
  have b₂₁ := hb h₂ h₁ h₂₁
  have b₂₀ := hb h₂ h₀ h₂₀
  have hc1 : c = 1 := by
    rw [mul_assoc, sq_mul ψ hfix htop, h₂, h₁₀, beta_mul_right ψ hfix htop, b₂₁, b₂₀, hcc,
      one_mul] at h₂₁₀
    exact h₂₁₀.symm
  have hcomm : ∀ {x y : G}, beta x y = 1 → y * x = x * y := by
    intro x y h
    calc y * x = x * beta x y * y := by simp only [beta]; group
      _ = x * y := by rw [h, mul_one]
  exact ⟨hc1, hcomm (b₁₀.trans hc1), hcomm (b₂₀.trans hc1), hcomm (b₂₁.trans hc1)⟩

include hG hodd hfix htop in
/-- The minimal configuration is impossible when `ψ⁷ = 1`, `ψ ≠ 1` and there is no elementary abelian
subgroup of order 8. -/
theorem minimal_contra (h7 : ψ ^ 7 = 1) (hne : ψ ≠ 1)
    (hE : ∀ E : Subgroup G, IsElemAbelian 2 E → Nat.card E ≤ 4) : False := by
  classical
  set N := sqCommSubgroup G
  set T := ElemQuot.induced N ψ with hTdef
  have hT7 : T ^ 7 = 1 := by rw [hTdef, ← ElemQuot.inducedHom_apply, ← map_pow, h7, map_one]
  have hT1 : T ≠ 1 := fun h =>
    hne (eq_one_of_fix_of_mem hG ψ hodd N hfix ((ElemQuot.induced_eq_one_iff ψ).mp h))
  obtain ⟨u, hu, hrel⟩ := exists_cubic T hT7 hT1
  have hTu : T u ≠ u := by
    intro h
    have h3 : (T ^ 3) u = u := by
      rw [show (3 : ℕ) = 1 + 1 + 1 from rfl, pow_add, pow_add, pow_one, Module.End.mul_apply,
        Module.End.mul_apply, h, h, h]
    have h2 : (T ^ 2) u = u := by
      rw [sq, Module.End.mul_apply, h, h]
    rcases hrel with hr | hr
    · rw [h3, h, add_self_zmod2] at hr; exact hu hr
    · rw [h3, h2, add_self_zmod2] at hr; exact hu hr
  obtain ⟨hne0, hdist⟩ := orbit_facts T hT7 hu hTu
  obtain ⟨x₀, rfl⟩ := ElemQuot.mk_surjective (N := N) u
  set x : ℕ → G := fun i => (ψ ^ i) x₀ with hx
  have hmk : ∀ i, ElemQuot.mk N (x i) = (T ^ i) (ElemQuot.mk N x₀) := fun i =>
    (ElemQuot.induced_pow_mk ψ i x₀).symm
  have hfixpow : ∀ i, ∀ d ∈ N, (ψ ^ i) d = d := by
    intro i d hd
    induction i with
    | zero => rfl
    | succ i ih => rw [pow_succ', MulAut.mul_apply, ih, hfix d hd]
  have hsq : ∀ i, (x i) ^ 2 = x₀ ^ 2 := fun i => by
    simp only [hx]; rw [← map_pow, hfixpow i _ (sq_mem_sqComm x₀)]
  have hq : ∀ a b : G, ElemQuot.mk N a = ElemQuot.mk N b → a ^ 2 = b ^ 2 := by
    intro a b h
    have hd : a⁻¹ * b ∈ N := ElemQuot.mk_eq_mk.mp h
    have : b = a * (a⁻¹ * b) := by group
    rw [this, (Commute.mul_pow (sqComm_commute ψ hfix htop hd a) 2),
      sqComm_sq_eq_one hG ψ hodd hfix htop hd, mul_one]
  set u := ElemQuot.mk N x₀ with hudef
  have hshift : ∀ k a b, (T ^ 3) u = (T ^ a) u + (T ^ b) u →
      (T ^ (k + 3)) u = (T ^ (k + a)) u + (T ^ (k + b)) u := by
    intro k a b h
    rw [pow_add, Module.End.mul_apply, h, map_add, ← Module.End.mul_apply, ← Module.End.mul_apply,
      ← pow_add, ← pow_add]
  have cancel2 : ∀ a b c : ElemQuot N, a + b + (b + c) = a + c := by
    intro a b c
    rw [show a + b + (b + c) = a + c + (b + b) by abel, add_self_zmod2, add_zero]
  -- the eight elements and their images
  let U : Fin 8 → ElemQuot N := fun i => if (i : ℕ) = 0 then 0 else (T ^ ((i : ℕ) - 1)) u
  have hU : Function.Injective U := by
    intro i j h
    simp only [U] at h
    by_cases hi : (i : ℕ) = 0 <;> by_cases hj : (j : ℕ) = 0
    · exact Fin.ext (hi.trans hj.symm)
    · rw [if_pos hi, if_neg hj] at h; exact absurd h.symm (hne0 _)
    · rw [if_neg hi, if_pos hj] at h; exact absurd h (hne0 _)
    · rw [if_neg hi, if_neg hj] at h
      apply Fin.ext
      rcases lt_trichotomy ((i : ℕ) - 1) ((j : ℕ) - 1) with hl | he | hl
      · exact absurd h (hdist _ _ hl (by omega))
      · omega
      · exact absurd h.symm (hdist _ _ hl (by omega))
  have hcard8 : ∀ (E : Subgroup G) (e₀ e₁ e₂ e₃ e₄ e₅ e₆ e₇ : G),
      e₀ ∈ E → e₁ ∈ E → e₂ ∈ E → e₃ ∈ E → e₄ ∈ E → e₅ ∈ E → e₆ ∈ E → e₇ ∈ E →
      ElemQuot.mk N e₀ = 0 → ElemQuot.mk N e₁ = (T ^ 0) u → ElemQuot.mk N e₂ = (T ^ 1) u →
      ElemQuot.mk N e₃ = (T ^ 2) u → ElemQuot.mk N e₄ = (T ^ 3) u → ElemQuot.mk N e₅ = (T ^ 4) u →
      ElemQuot.mk N e₆ = (T ^ 5) u → ElemQuot.mk N e₇ = (T ^ 6) u → 8 ≤ Nat.card E := by
    intro E e₀ e₁ e₂ e₃ e₄ e₅ e₆ e₇ m₀ m₁ m₂ m₃ m₄ m₅ m₆ m₇ k₀ k₁ k₂ k₃ k₄ k₅ k₆ k₇
    let e : Fin 8 → G := ![e₀, e₁, e₂, e₃, e₄, e₅, e₆, e₇]
    have he : ∀ i, e i ∈ E := by
      intro i; fin_cases i
      · exact m₀
      · exact m₁
      · exact m₂
      · exact m₃
      · exact m₄
      · exact m₅
      · exact m₆
      · exact m₇
    have hmke : ∀ i, ElemQuot.mk N (e i) = U i := by
      intro i; fin_cases i
      · exact k₀
      · exact k₁
      · exact k₂
      · exact k₃
      · exact k₄
      · exact k₅
      · exact k₆
      · exact k₇
    have hinj : Function.Injective (fun i => (⟨e i, he i⟩ : E)) := by
      intro i j h
      apply hU
      rw [← hmke, ← hmke]
      exact congrArg (fun g : E => ElemQuot.mk N g.1) h
    simpa using Nat.card_le_card_of_injective _ hinj
  set S : Set G := {x 0, x 1, x 2}
  have m0 : x 0 ∈ closure S := subset_closure (by simp [S])
  have m1 : x 1 ∈ closure S := subset_closure (by simp [S])
  have m2 : x 2 ∈ closure S := subset_closure (by simp [S])
  have hsq0 : (x 0) ^ 2 = (x 0) ^ 2 := rfl
  have hsqi : ∀ i, (x i) ^ 2 = (x 0) ^ 2 := hsq
  have hq' : ∀ a b : G, ElemQuot.mk N a = ElemQuot.mk N b → b ^ 2 = (x 0) ^ 2 → a ^ 2 = (x 0) ^ 2 :=
    fun a b h hb => (hq a b h).trans hb
  rcases hrel with hr | hr
  · -- `T³u = Tu + u`
    have v3 : (T ^ 3) u = (T ^ 1) u + (T ^ 0) u := by rw [pow_one, pow_zero]; exact hr
    have v4 := hshift 1 1 0 v3
    have v5 : (T ^ 5) u = (T ^ 2) u + ((T ^ 1) u + (T ^ 0) u) := by
      rw [hshift 2 1 0 v3, ← v3]; abel
    have v6 : (T ^ 6) u = (T ^ 2) u + (T ^ 0) u := by
      rw [hshift 3 1 0 v3, v4, v3, cancel2]
    have e4 : ElemQuot.mk N (x 1 * x 0) = (T ^ 3) u := by rw [ElemQuot.mk_mul, hmk, hmk, v3]
    have e5 : ElemQuot.mk N (x 2 * x 1) = (T ^ 4) u := by rw [ElemQuot.mk_mul, hmk, hmk, v4]
    have e6 : ElemQuot.mk N (x 2 * (x 1 * x 0)) = (T ^ 5) u := by
      rw [ElemQuot.mk_mul, ElemQuot.mk_mul, hmk, hmk, hmk, v5]
    have e7 : ElemQuot.mk N (x 2 * x 0) = (T ^ 6) u := by rw [ElemQuot.mk_mul, hmk, hmk, v6]
    obtain ⟨hc1, h01, h02, h12⟩ := three_lifts hG ψ hodd hfix htop hsq0 (hsqi 1) (hsqi 2)
      (hq' _ _ (e4.trans (hmk 3).symm) (hsqi 3)) (hq' _ _ (e5.trans (hmk 4).symm) (hsqi 4))
      (hq' _ _ (e7.trans (hmk 6).symm) (hsqi 6))
      (by rw [mul_assoc]; exact hq' _ _ (e6.trans (hmk 5).symm) (hsqi 5))
    have hEA := isElemAbelian_closure_three (by rw [← hc1]) (by rw [← hc1]; exact hsqi 1)
      (by rw [← hc1]; exact hsqi 2) h01 h02 h12
    have h8 := hcard8 (closure S) 1 (x 0) (x 1) (x 2) (x 1 * x 0) (x 2 * x 1) (x 2 * (x 1 * x 0))
      (x 2 * x 0) (one_mem _) m0 m1 m2 (mul_mem m1 m0) (mul_mem m2 m1) (mul_mem m2 (mul_mem m1 m0))
      (mul_mem m2 m0) ElemQuot.mk_one (hmk 0) (hmk 1) (hmk 2) e4 e5 e6 e7
    have h4 : Nat.card (closure S) ≤ 4 := hE (closure S) hEA
    omega
  · -- `T³u = T²u + u`
    have v3 : (T ^ 3) u = (T ^ 2) u + (T ^ 0) u := by rw [pow_zero]; exact hr
    have v4 : (T ^ 4) u = (T ^ 2) u + ((T ^ 1) u + (T ^ 0) u) := by
      rw [hshift 1 2 0 v3, show 1 + 2 = 3 from rfl, v3]; abel
    have v5 : (T ^ 5) u = (T ^ 1) u + (T ^ 0) u := by
      rw [hshift 2 2 0 v3, show 2 + 2 = 4 from rfl, v4]
      rw [show (T ^ 2) u + ((T ^ 1) u + (T ^ 0) u) + (T ^ (2 + 0)) u
        = (T ^ 1) u + (T ^ 0) u + ((T ^ 2) u + (T ^ 2) u) by rw [Nat.add_zero]; abel,
        add_self_zmod2, add_zero]
    have v6 : (T ^ 6) u = (T ^ 2) u + (T ^ 1) u := by
      rw [hshift 3 2 0 v3, show 3 + 2 = 5 from rfl, v5, Nat.add_zero, v3]
      rw [show (T ^ 1) u + (T ^ 0) u + ((T ^ 2) u + (T ^ 0) u)
        = (T ^ 2) u + (T ^ 1) u + ((T ^ 0) u + (T ^ 0) u) by abel, add_self_zmod2, add_zero]
    have e4 : ElemQuot.mk N (x 2 * x 0) = (T ^ 3) u := by rw [ElemQuot.mk_mul, hmk, hmk, v3]
    have e5 : ElemQuot.mk N (x 2 * (x 1 * x 0)) = (T ^ 4) u := by
      rw [ElemQuot.mk_mul, ElemQuot.mk_mul, hmk, hmk, hmk, v4]
    have e6 : ElemQuot.mk N (x 1 * x 0) = (T ^ 5) u := by rw [ElemQuot.mk_mul, hmk, hmk, v5]
    have e7 : ElemQuot.mk N (x 2 * x 1) = (T ^ 6) u := by rw [ElemQuot.mk_mul, hmk, hmk, v6]
    obtain ⟨hc1, h01, h02, h12⟩ := three_lifts hG ψ hodd hfix htop hsq0 (hsqi 1) (hsqi 2)
      (hq' _ _ (e6.trans (hmk 5).symm) (hsqi 5)) (hq' _ _ (e7.trans (hmk 6).symm) (hsqi 6))
      (hq' _ _ (e4.trans (hmk 3).symm) (hsqi 3))
      (by rw [mul_assoc]; exact hq' _ _ (e5.trans (hmk 4).symm) (hsqi 4))
    have hEA := isElemAbelian_closure_three (by rw [← hc1]) (by rw [← hc1]; exact hsqi 1)
      (by rw [← hc1]; exact hsqi 2) h01 h02 h12
    have h8 := hcard8 (closure S) 1 (x 0) (x 1) (x 2) (x 2 * x 0) (x 2 * (x 1 * x 0)) (x 1 * x 0)
      (x 2 * x 1) (one_mem _) m0 m1 m2 (mul_mem m2 m0) (mul_mem m2 (mul_mem m1 m0)) (mul_mem m1 m0)
      (mul_mem m2 m1) ElemQuot.mk_one (hmk 0) (hmk 1) (hmk 2) e4 e5 e6 e7
    have h4 : Nat.card (closure S) ≤ 4 := hE (closure S) hEA
    omega

end Minimal

section Induction

universe u

theorem isElemAbelian_map_subtype {G : Type*} [Group G] {R : Subgroup G} {E : Subgroup R}
    (h : IsElemAbelian 2 E) : IsElemAbelian 2 (E.map R.subtype) := by
  obtain ⟨⟨⟨hc⟩⟩, hsq⟩ := h
  refine ⟨⟨⟨?_⟩⟩, ?_⟩
  · rintro ⟨_, a, ha, rfl⟩ ⟨_, b, hb, rfl⟩
    apply Subtype.ext
    exact congrArg (fun g : E => (g : G)) (hc ⟨a, ha⟩ ⟨b, hb⟩)
  · rintro _ ⟨a, ha, rfl⟩
    have := hsq a ha
    simpa using congrArg Subtype.val this

/-- The restriction of an automorphism to an invariant subgroup of a finite group. -/
noncomputable def restrictAut {G : Type*} [Group G] [Finite G] (ψ : MulAut G) (R : Subgroup G)
    (hR : ∀ x ∈ R, ψ x ∈ R) : MulAut R :=
  MulEquiv.ofBijective ((ψ.toMonoidHom.comp R.subtype).codRestrict R (fun x => hR x.1 x.2))
    (Finite.injective_iff_bijective.mp
      (fun a b h => Subtype.ext (ψ.injective (congrArg Subtype.val h))))

theorem restrictAut_pow_apply {G : Type*} [Group G] [Finite G] (ψ : MulAut G) (R : Subgroup G)
    (hR : ∀ x ∈ R, ψ x ∈ R) (k : ℕ) (x : R) : ((restrictAut ψ R hR ^ k) x : G) = (ψ ^ k) x := by
  induction k with
  | zero => rfl
  | succ k ih => rw [pow_succ', MulAut.mul_apply, pow_succ', MulAut.mul_apply, ← ih]; rfl

theorem no_aut_order_seven_aux (n : ℕ) : ∀ (G : Type u) [Group G] [Finite G], Nat.card G ≤ n →
    IsPGroup 2 G → (∀ E : Subgroup G, IsElemAbelian 2 E → Nat.card E ≤ 4) →
    ∀ ψ : MulAut G, ψ ^ 7 = 1 → ψ ≠ 1 → False := by
  induction n with
  | zero =>
    intro G _ _ hc
    have := Nat.card_pos (α := G)
    omega
  | succ n ih =>
    intro G _ _ hc hG hE ψ h7 hne
    have hodd : Odd (orderOf ψ) := Odd.of_dvd_nat (by decide) (orderOf_dvd_of_pow_eq_one h7)
    by_cases hex : ∃ R : Subgroup G, R ≠ ⊤ ∧ (∀ x ∈ R, ψ x ∈ R) ∧ ∃ x ∈ R, ψ x ≠ x
    · obtain ⟨R, hRt, hR, x, hxR, hx⟩ := hex
      have hlt : Nat.card R < Nat.card G :=
        lt_of_le_of_ne (Subgroup.card_le_card_group R) (fun h => hRt ((card_eq_iff_eq_top R).mp h))
      apply ih R (by omega) (hG.to_subgroup R)
        (fun E hEa => (Subgroup.card_map_of_injective R.subtype_injective).symm.le.trans
          (hE _ (isElemAbelian_map_subtype hEa)))
        (restrictAut ψ R hR)
      · ext y
        have := restrictAut_pow_apply ψ R hR 7 y
        rw [h7] at this
        exact this
      · intro h
        apply hx
        have := restrictAut_pow_apply ψ R hR 1 ⟨x, hxR⟩
        rw [pow_one, pow_one, h] at this
        exact this.symm
    · push Not at hex
      have htop : commAut ψ = ⊤ := by
        by_contra hK
        exact hne (eq_one_of_fix_of_mem hG ψ hodd _ (hex _ hK (map_mem_commAut ψ))
          (fun x => subset_closure ⟨x, rfl⟩))
      haveI : Nontrivial G := by
        by_contra h
        rw [not_nontrivial_iff_subsingleton] at h
        exact hne (MulEquiv.ext fun x => Subsingleton.elim _ _)
      have hfix := hex _ (sqComm_ne_top hG) (map_mem_sqComm ψ)
      exact minimal_contra hG ψ hodd hfix htop h7 hne hE

/-- **No automorphism of order 7.** A finite 2-group all of whose elementary abelian subgroups have order
at most 4 has no automorphism of order 7. -/
theorem no_aut_order_seven {G : Type u} [Group G] [Finite G] (hG : IsPGroup 2 G)
    (hE : ∀ E : Subgroup G, IsElemAbelian 2 E → Nat.card E ≤ 4) (ψ : MulAut G) (h7 : orderOf ψ = 7) :
    False :=
  no_aut_order_seven_aux _ G le_rfl hG hE ψ (h7 ▸ pow_orderOf_eq_one ψ)
    (fun h => by rw [h, orderOf_one] at h7; exact absurd h7 (by norm_num))

end Induction

end CFSGOutside.CravenGlesser
