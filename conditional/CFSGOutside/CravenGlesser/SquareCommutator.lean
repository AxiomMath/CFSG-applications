import CFSGOutside.CravenGlesser.ElemQuot

/-!
# The subgroup generated by squares and commutators

`sqCommSubgroup G` is the normal closure of all squares and commutators of `G`. For a finite 2-group it lies in
every maximal subgroup. When an automorphism `ψ` of odd order fixes it pointwise and `[G, ψ] = G`, it is
central of exponent 2, and squaring is an invariant quadratic map. This is the setting of `NoSeven`.
-/

namespace CFSGOutside.CravenGlesser

open Subgroup

variable {G : Type*} [Group G]

/-- Squares and commutators. -/
def sqCommSet (G : Type*) [Group G] : Set G :=
  {y | ∃ x, y = x ^ 2} ∪ {y | ∃ x z, y = x * z * x⁻¹ * z⁻¹}

/-- The normal subgroup generated by squares and commutators. -/
def sqCommSubgroup (G : Type*) [Group G] : Subgroup G := normalClosure (sqCommSet G)

instance : (sqCommSubgroup G).Normal := normalClosure_normal

theorem sq_mem_sqComm (x : G) : x ^ 2 ∈ sqCommSubgroup G :=
  subset_normalClosure (Or.inl ⟨x, rfl⟩)

theorem comm_mem_sqComm (x y : G) : x * y * x⁻¹ * y⁻¹ ∈ sqCommSubgroup G :=
  subset_normalClosure (Or.inr ⟨x, y, rfl⟩)

theorem map_mem_sqComm (σ : MulAut G) : ∀ x ∈ sqCommSubgroup G, σ x ∈ sqCommSubgroup G := by
  have hle : sqCommSubgroup G ≤ (sqCommSubgroup G).comap σ.toMonoidHom := by
    haveI : ((sqCommSubgroup G).comap σ.toMonoidHom).Normal :=
      Normal.comap inferInstance _
    apply normalClosure_le_normal
    rintro y (⟨x, rfl⟩ | ⟨x, z, rfl⟩)
    · change σ (x ^ 2) ∈ sqCommSubgroup G
      rw [map_pow]; exact sq_mem_sqComm _
    · change σ (x * z * x⁻¹ * z⁻¹) ∈ sqCommSubgroup G
      simp only [map_mul, map_inv]; exact comm_mem_sqComm _ _
  exact fun x hx => hle hx

instance : IsElemQuot (sqCommSubgroup G) where
  normal := inferInstance
  sq_mem := sq_mem_sqComm
  comm_mem := comm_mem_sqComm
  map_mem := map_mem_sqComm

theorem sqComm_le_coatom [Finite G] (hG : IsPGroup 2 G) {M : Subgroup G} (hM : IsCoatom M) :
    sqCommSubgroup G ≤ M := by
  haveI := normal_of_isCoatom hG hM
  apply normalClosure_le_normal
  rintro y (⟨x, rfl⟩ | ⟨x, z, rfl⟩)
  · exact sq_mem_of_isCoatom hG hM x
  · exact comm_mem_of_isCoatom hG hM x z

theorem sqComm_ne_top [Finite G] [Nontrivial G] (hG : IsPGroup 2 G) : sqCommSubgroup G ≠ ⊤ := by
  rcases eq_top_or_exists_le_coatom (⊥ : Subgroup G) with h | ⟨M, hM, -⟩
  · exact absurd h bot_ne_top
  · intro htop
    exact hM.1 (top_le_iff.mp (htop ▸ sqComm_le_coatom hG hM))

/-! ### The commutator subgroup `[G, ψ]` -/

/-- The subgroup generated by the elements `x⁻¹ * ψ x`. -/
def commAut (ψ : MulAut G) : Subgroup G := closure {y | ∃ x, y = x⁻¹ * ψ x}

theorem map_mem_commAut (ψ : MulAut G) : ∀ y ∈ commAut ψ, ψ y ∈ commAut ψ := by
  intro y hy
  induction hy using closure_induction with
  | mem y hy =>
    obtain ⟨x, rfl⟩ := hy
    rw [map_mul, map_inv]
    exact subset_closure ⟨ψ x, rfl⟩
  | one => rw [map_one]; exact one_mem _
  | mul a b _ _ ha hb => rw [map_mul]; exact mul_mem ha hb
  | inv a _ ha => rw [map_inv]; exact inv_mem ha

/-! ### The minimal configuration -/

section Minimal

variable [Finite G] (hG : IsPGroup 2 G) (ψ : MulAut G) (hodd : Odd (orderOf ψ))
  (hfix : ∀ d ∈ sqCommSubgroup G, ψ d = d) (htop : commAut ψ = ⊤)

include hfix htop in
/-- The subgroup generated by squares and commutators is central. -/
theorem sqComm_central {d : G} (hd : d ∈ sqCommSubgroup G) (g : G) : g * d = d * g := by
  have hle : commAut ψ ≤ centralizer {d} := by
    rw [commAut, closure_le]
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, mem_centralizer_iff]
    rintro h rfl
    have hconj : x * h * x⁻¹ ∈ sqCommSubgroup G := Normal.conj_mem inferInstance h hd x
    have heq := hfix _ hconj
    rw [map_mul, map_mul, map_inv, hfix h hd] at heq
    have h1 : ψ x * h = x * h * x⁻¹ * ψ x := by rw [← heq]; group
    calc h * (x⁻¹ * ψ x) = x⁻¹ * (x * h * x⁻¹ * ψ x) := by group
      _ = x⁻¹ * (ψ x * h) := by rw [h1]
      _ = x⁻¹ * ψ x * h := by group
  have hg : g ∈ centralizer {d} := hle (htop ▸ mem_top g)
  rw [mem_centralizer_iff] at hg
  exact (hg d rfl).symm

include hfix htop in
theorem sqComm_commute {d : G} (hd : d ∈ sqCommSubgroup G) (g : G) : Commute g d :=
  sqComm_central ψ hfix htop hd g

include hfix htop in
/-- Commutators have order dividing 2. -/
theorem comm_sq_eq_one (x y : G) : (x * y * x⁻¹ * y⁻¹) ^ 2 = 1 := by
  set c := x * y * x⁻¹ * y⁻¹ with hc
  have hcD : c ∈ sqCommSubgroup G := comm_mem_sqComm x y
  have h1 : x * y * x⁻¹ = c * y := by rw [hc]; group
  have h2 : y * x ^ 2 = x ^ 2 * y := sqComm_central ψ hfix htop (sq_mem_sqComm x) y
  have h3 : x * c = c * x := sqComm_central ψ hfix htop hcD x
  have h4 : x * (x * y * x⁻¹) * x⁻¹ = c * c * y := by
    calc x * (x * y * x⁻¹) * x⁻¹ = x * (c * y) * x⁻¹ := by rw [h1]
      _ = (x * c) * y * x⁻¹ := by group
      _ = c * (x * y * x⁻¹) := by rw [h3]; group
      _ = c * c * y := by rw [h1]; group
  have h5 : x * (x * y * x⁻¹) * x⁻¹ = y := by
    calc x * (x * y * x⁻¹) * x⁻¹ = x ^ 2 * y * (x ^ 2)⁻¹ := by rw [sq]; group
      _ = y := by rw [← h2]; group
  rw [h5] at h4
  rw [sq]
  have := congrArg (· * y⁻¹) h4
  simpa using this.symm

/-- `β x y = x⁻¹ * y * x * y⁻¹`, the correction term of squaring. -/
def beta (x y : G) : G := x⁻¹ * y * x * y⁻¹

theorem beta_mem (x y : G) : beta x y ∈ sqCommSubgroup G := by
  have := comm_mem_sqComm x⁻¹ y
  simpa [beta] using this

include hfix htop in
theorem sq_mul (x y : G) : (x * y) ^ 2 = x ^ 2 * y ^ 2 * beta x y := by
  have h : (x * y) ^ 2 = x ^ 2 * beta x y * y ^ 2 := by simp only [beta, sq]; group
  rw [h, mul_assoc, mul_assoc, (sqComm_commute ψ hfix htop (beta_mem x y) (y ^ 2))]

include hfix htop in
theorem beta_mul_right (x y z : G) : beta x (y * z) = beta x y * beta x z := by
  have h : beta x (y * z) = beta x y * (y * beta x z * y⁻¹) := by simp only [beta]; group
  rw [h, sqComm_central ψ hfix htop (beta_mem x z) y]
  group

include hG hodd hfix htop in
/-- Every element has order dividing 4. -/
theorem pow_four_eq_one (x : G) : x ^ 4 = 1 := by
  have hmul : ∀ a b : G, (a * b) ^ 4 = a ^ 4 * b ^ 4 := by
    intro a b
    have hc := comm_sq_eq_one ψ hfix htop a⁻¹ b
    have hcomm : ∀ g, ∀ d ∈ sqCommSubgroup G, Commute g d := fun g d hd =>
      sqComm_commute ψ hfix htop hd g
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, sq_mul ψ hfix htop,
      (hcomm _ _ (beta_mem a b)).mul_pow, (hcomm _ _ (sq_mem_sqComm b)).mul_pow,
      ← pow_mul, ← pow_mul]
    have : beta a b ^ 2 = 1 := by simpa [beta] using hc
    rw [this, mul_one]
  have hsub : ∀ g ∈ commAut ψ, g ^ 4 = 1 := by
    intro g hg
    induction hg using closure_induction with
    | mem y hy =>
      obtain ⟨x, rfl⟩ := hy
      have h4 : x ^ 4 ∈ sqCommSubgroup G := by
        rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul]; exact sq_mem_sqComm _
      rw [hmul, inv_pow, ← map_pow, hfix _ h4, inv_mul_cancel]
    | one => simp
    | mul a b _ _ ha hb => rw [hmul, ha, hb, one_mul]
    | inv a _ ha => rw [inv_pow, ha, inv_one]
  exact hsub x (htop ▸ mem_top x)

include hG hodd hfix htop in
/-- Elements of the square-commutator subgroup have order dividing 2. -/
theorem sqComm_sq_eq_one {d : G} (hd : d ∈ sqCommSubgroup G) : d ^ 2 = 1 := by
  let E : Subgroup G :=
    { carrier := {g | (∀ h : G, h * g = g * h) ∧ g ^ 2 = 1}
      mul_mem' := fun {a b} ha hb => by
        refine ⟨fun h => ?_, ?_⟩
        · rw [← mul_assoc, ha.1 h, mul_assoc, hb.1 h, mul_assoc]
        · rw [(Commute.mul_pow (ha.1 b).symm 2), ha.2, hb.2, one_mul]
      one_mem' := ⟨fun h => by simp, one_pow 2⟩
      inv_mem' := fun {a} ha => by
        refine ⟨fun h => ?_, by rw [inv_pow, ha.2, inv_one]⟩
        rw [mul_inv_eq_iff_eq_mul, mul_assoc, ha.1 h, inv_mul_cancel_left] }
  haveI : E.Normal := ⟨fun n hn g => by
    have : g * n * g⁻¹ = n := by rw [hn.1 g, mul_inv_cancel_right]
    rw [this]; exact hn⟩
  have hle : sqCommSubgroup G ≤ E := by
    apply normalClosure_le_normal
    rintro y (⟨x, rfl⟩ | ⟨x, z, rfl⟩)
    · refine ⟨fun h => sqComm_central ψ hfix htop (sq_mem_sqComm x) h, ?_⟩
      rw [← pow_mul]; exact pow_four_eq_one hG ψ hodd hfix htop x
    · exact ⟨fun h => sqComm_central ψ hfix htop (comm_mem_sqComm x z) h,
        comm_sq_eq_one ψ hfix htop x z⟩
  exact (hle hd).2

end Minimal

end CFSGOutside.CravenGlesser
