import CFSGOutside.Corpus.Defs.OuterAutomorphisms

/-!
# Robinson: definitions used by the statements

The definitions of `CFSGOutside/Robinson/Paper.lean` that its headline statements mention, with the instances
those statements need (normality of `centerIn D` and of `derivedLimit G`). See `Paper.lean` for the paper and
its conventions.
-/

namespace CFSGOutside.Robinson

open Subgroup QuotientGroup

section Defs

variable {G : Type*} [Group G]

/-- `H/K` is a chief factor of `G`: `K < H` are normal subgroups of `G` and no normal subgroup of
`G` lies strictly between them. -/
def IsChiefFactor (H K : Subgroup G) : Prop :=
  H.Normal ∧ K.Normal ∧ K < H ∧
    ∀ L : Subgroup G, L.Normal → K ≤ L → L ≤ H → L = K ∨ L = H

/-- The factor group `H/K`, realised as the subgroup `HK/K` of `G/K`. -/
abbrev factor (H K : Subgroup G) [K.Normal] : Subgroup (G ⧸ K) := H.map (QuotientGroup.mk' K)

variable (G) in
/-- SC-group: every chief factor is simple. -/
def IsSC : Prop :=
  ∀ (H K : Subgroup G) [K.Normal], IsChiefFactor H K → IsSimpleGroup (factor H K)

variable (G) in
/-- SNAC-group: every non-abelian chief factor is simple. -/
def IsSNAC : Prop :=
  ∀ (H K : Subgroup G) [K.Normal], IsChiefFactor H K →
    (∃ a b : factor H K, a * b ≠ b * a) → IsSimpleGroup (factor H K)

/-- `D` is the direct product of a finite family of `G`-invariant (normal) simple subgroups. -/
def IsDirectProductOfInvariantSimple (D : Subgroup G) : Prop :=
  ∃ 𝒯 : Finset (Subgroup G), (∀ T ∈ 𝒯, T.Normal ∧ IsSimpleGroup T) ∧
    sSupIndep (𝒯 : Set (Subgroup G)) ∧ sSup (𝒯 : Set (Subgroup G)) = D

/-- `H/K` is cyclic: `H` is generated by `K` and one element of `H`. -/
def CyclicFactor (H K : Subgroup G) : Prop :=
  ∃ g ∈ H, H = K ⊔ zpowers g

/-- A series `A = f 0 ≤ f 1 ≤ ⋯ ≤ f n = B` of normal subgroups of `G` with cyclic factors. -/
def NormalCyclicSeries (A B : Subgroup G) : Prop :=
  ∃ (n : ℕ) (f : ℕ → Subgroup G), f 0 = A ∧ f n = B ∧ (∀ i, (f i).Normal) ∧
    ∀ i < n, CyclicFactor (f (i + 1)) (f i)

/-- `A` is supersolubly embedded in `G`: there is a `G`-admissible series in `A` with cyclic
factors. -/
def IsSupersolublyEmbedded (A : Subgroup G) : Prop := NormalCyclicSeries ⊥ A

variable (G) in
/-- `G` is supersoluble: it has a normal series with cyclic factors. -/
def IsSupersoluble : Prop := IsSupersolublyEmbedded (⊤ : Subgroup G)

/-- The centre `Z(D)` of a subgroup `D`, as a subgroup of `G`. -/
def centerIn (D : Subgroup G) : Subgroup G := D ⊓ centralizer (D : Set G)

end Defs

section Basic

variable {G : Type*} [Group G]

lemma mem_centerIn {D : Subgroup G} {x : G} :
    x ∈ centerIn D ↔ x ∈ D ∧ ∀ y ∈ D, y * x = x * y := by
  simp [centerIn, mem_centralizer_iff]

instance centerIn_normal (D : Subgroup G) [hD : D.Normal] : (centerIn D).Normal := by
  constructor
  intro x hx g
  rw [mem_centerIn] at hx ⊢
  refine ⟨hD.conj_mem x hx.1 g, fun y hy => ?_⟩
  have h := hx.2 (g⁻¹ * y * g) (by simpa using hD.conj_mem y hy g⁻¹)
  calc y * (g * x * g⁻¹) = g * ((g⁻¹ * y * g) * x) * g⁻¹ := by group
    _ = g * (x * (g⁻¹ * y * g)) * g⁻¹ := by rw [h]
    _ = g * x * g⁻¹ * y := by group

/-- Membership in `A ⊔ N` for normal `N`. -/
lemma mem_sup_normal_right {A N : Subgroup G} [N.Normal] {x : G} :
    x ∈ A ⊔ N ↔ ∃ a ∈ A, ∃ n ∈ N, a * n = x := mem_sup_of_normal_right
end Basic

/-- `G^(∞)`, the limit of the derived series. -/
def derivedLimit (G : Type*) [Group G] : Subgroup G := ⨅ n, derivedSeries G n

instance derivedLimit_normal (G : Type*) [Group G] : (derivedLimit G).Normal := by
  constructor
  intro x hx g
  rw [derivedLimit, mem_iInf] at hx ⊢
  intro i
  exact (derivedSeries_normal G i).conj_mem x (hx i) g

section Followup

variable {G : Type} [Group G] [Finite G]

open CFSGOutside.Corpus.ComponentClassification.OuterAutomorphisms in
/-- Conjugation `G → Out(D)` for a normal subgroup `D`. -/
noncomputable def conjOuter (D : Subgroup G) [D.Normal] : G →* Outer D :=
  (QuotientGroup.mk' (inner D)).comp (MulAut.conjNormal (H := D))

open CFSGOutside.Corpus.ComponentClassification.OuterAutomorphisms in
lemma conjOuter_eq_one_iff (D : Subgroup G) [D.Normal] (g : G) :
    conjOuter D g = 1 ↔ g ∈ D ⊔ centralizer (D : Set G) := by
  haveI : (centralizer (D : Set G)).Normal := normal_centralizer
  rw [conjOuter, MonoidHom.comp_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  constructor
  · rintro ⟨d, hd⟩
    have key : ∀ y ∈ D, g * y * g⁻¹ = (d : G) * y * (d : G)⁻¹ := by
      intro y hy
      have := congrArg (fun σ : MulAut D => ((σ ⟨y, hy⟩ : D) : G)) hd
      simpa [MulAut.conjNormal_apply, MulAut.conj_apply] using this.symm
    have hc : (d : G)⁻¹ * g ∈ centralizer (D : Set G) := by
      rw [mem_centralizer_iff]
      intro y hy
      have := key y hy
      calc y * ((d : G)⁻¹ * g) = (d : G)⁻¹ * ((d : G) * y * (d : G)⁻¹) * g := by group
        _ = (d : G)⁻¹ * (g * y * g⁻¹) * g := by rw [this]
        _ = (d : G)⁻¹ * g * y := by group
    have : g = (d : G) * ((d : G)⁻¹ * g) := by group
    rw [this]
    exact mul_mem (mem_sup_left d.2) (mem_sup_right hc)
  · intro hg
    obtain ⟨d, hd, c, hc, rfl⟩ := mem_sup_normal_right.mp hg
    refine ⟨⟨d, hd⟩, ?_⟩
    ext x
    have hcx := mem_centralizer_iff.mp hc x x.2
    simp only [MulAut.conj_apply, MulAut.conjNormal_apply, coe_mul, coe_inv]
    calc (d : G) * x * d⁻¹ = d * (c * x * c⁻¹) * d⁻¹ := by rw [← hcx]; group
      _ = d * c * x * (d * c)⁻¹ := by group

lemma le_ker_conjOuter (D : Subgroup G) [D.Normal] : D ≤ (conjOuter D).ker := by
  intro d hd
  exact (conjOuter_eq_one_iff D d).mpr (mem_sup_left hd)

open CFSGOutside.Corpus.ComponentClassification.OuterAutomorphisms in
/-- The coupling `χ : G/D → Out(D)` of the extension `D ↣ G ↠ G/D`. -/
noncomputable def coupling (D : Subgroup G) [D.Normal] : G ⧸ D →* Outer D :=
  QuotientGroup.lift D (conjOuter D) (le_ker_conjOuter D)
end Followup

/-- A T-group: normality is transitive (`H ⊴ K ⊴ G` implies `H ⊴ G`). -/
def IsTGroup (X : Type*) [Group X] : Prop :=
  ∀ H K : Subgroup X, H ≤ K → (H.subgroupOf K).Normal → K.Normal → H.Normal

end CFSGOutside.Robinson
