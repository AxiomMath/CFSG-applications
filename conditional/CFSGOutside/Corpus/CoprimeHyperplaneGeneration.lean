import CFSGOutside.Corpus.Defs.ElementaryAbelian
import CFSGOutside.Corpus.Defs.Frobenius

/-!
# Corpus input: coprime hyperplane generation

Statement of `CFSG.SolvableHall.coprime_hyperplane_generation`, copied verbatim from
`CFSG/GroupTheory/HyperplaneGeneration.lean` (line 420, with the section variables of line 218) at
AxiomMath/CFSG commit 69cb972f587a3ecc035e092253167ff2e303c962. `IsElementaryAbelian` and
`fixedPointSubgroup` are the copies in `CFSGOutside.Corpus.Defs`.

A noncyclic elementary abelian `p`-group acting on a finite `p'`-group `H` (Gorenstein 6.2.4): `H` is
generated by the centralizers of the hyperplanes of `A`. The corpus theorem is universe polymorphic, so the
class takes the universes of `H` and of `A` as parameters. The clean build provides every instance, in
`clean/CFSGOutsideClean/Corpus/CoprimeHyperplaneGeneration.lean`.
-/

namespace CFSGOutside.Corpus

/-- Coprime hyperplane generation, as `CFSG.SolvableHall.coprime_hyperplane_generation` states it. -/
class CoprimeHyperplaneGeneration.{u, v} : Prop where
  coprime_hyperplane_generation : ∀ {p : ℕ} [Fact p.Prime] {A : Type v} [Group A] [Finite A]
    [IsElementaryAbelian p A] [Nontrivial A] {H : Type u} [Group H] [Finite H]
    [MulDistribMulAction A H] (_hp : ¬ p ∣ Nat.card H),
    ⨆ (B : Subgroup A) (_ : B.index = p), fixedPointSubgroup B H = ⊤

end CFSGOutside.Corpus
