/-! ### `CFSG/Sporadic/Co1/Module/OrbitsBase.lean` -/

/-- Corpus: `CFSG.Sporadic.Co1.Module.Vec24`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:20. -/
abbrev Vec24 : Type := Fin 24 → ZMod 2

/-- Corpus: `CFSG.Sporadic.Co1.Module.v₂`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:32. -/
def v₂ : Vec24 := Pi.single 1 1

/-- Corpus: `CFSG.Sporadic.Co1.Module.v₃`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:34. -/
def v₃ : Vec24 := Pi.single 12 1

/-- Corpus: `CFSG.Sporadic.Co1.Module.v₄`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:36. -/
def v₄ : Vec24 := Pi.single 0 1

/-- Corpus: `CFSG.Sporadic.Co1.Module.reps`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:38. -/
def reps : Fin 3 → Vec24 := ![v₂, v₃, v₄]

/-- Corpus: `CFSG.Sporadic.Co1.Module.co1Act`, CFSG/Sporadic/Co1/Module/OrbitsBase.lean:284. -/
def co1Act (g : Co1) (v : Vec24) : Vec24 :=
  (g.val.val : Matrix (Fin 24) (Fin 24) (ZMod 2)).mulVec v

/-! ### `CFSG/Sporadic/Co1/Module/PairsCheckBase.lean` -/

/-- Corpus: `CFSG.Sporadic.Co1.Module.Pairs.tyOrbC`,
CFSG/Sporadic/Co1/Module/PairsCheckBase.lean:156. -/
def tyOrbC : ℕ → Set Vec24
  | 0 => {0}
  | 1 => MulAction.orbit Co1 v₄
  | 2 => MulAction.orbit Co1 v₃
  | _ => MulAction.orbit Co1 v₂

/-- Corpus: `CFSG.Sporadic.Co1.Module.Pairs.cls`,
CFSG/Sporadic/Co1/Module/PairsCheckBase.lean:169. -/
def cls (j : ℕ) : Set Vec24 :=
  {y | y ∈ MulAction.orbit Co1 v₂ ∧ v₂ + y ∈ tyOrbC j}

/-! ### Corpus theorems -/

/-- Corpus theorems about the native model of `Co₁`. -/
class Orbits : Prop where
  /-- The native model of `Co₁` is isomorphic to the TauCeti presented group.
  Corpus: `CFSG.Sporadic.Bridge.Co1.nonempty_mulEquiv`, CFSG/Sporadic/Bridge/Co1Surj.lean:61. -/
  nonempty_mulEquiv : Nonempty (Co1 ≃* TauCeti.SporadicName.Co1.Group)
  /-- Every non-zero vector of `𝔽₂²⁴` lies in exactly one of the `Co₁`-orbits of `v₂`, `v₃`, `v₄`.
  Corpus: `CFSG.Sporadic.Co1.Module.co1_exists_unique_orbit`,
  CFSG/Sporadic/Co1/Module/Orbits.lean:136. -/
  co1_exists_unique_orbit
    {v : Vec24} (hv : v ≠ 0) :
    ∃! i : Fin 3, v ∈ Set.range (fun g : Co1 => co1Act g (reps i))
  /-- The stabilizer of `v₂` is transitive on each class `cls j` (`j < 4`) of the orbit of `v₂`.
  Corpus: `CFSG.Sporadic.Co1.Module.Pairs.cls_trans`, CFSG/Sporadic/Co1/Module/PairsCheck.lean:99. -/
  cls_trans
    {j : ℕ} (hj : j < 4) {y y' : Vec24} (hy : y ∈ cls j) (hy' : y' ∈ cls j) :
    ∃ g : Co1, g • v₂ = v₂ ∧ g • y = y'

end CFSGOutside.Corpus.Co1
