import Mathlib.LinearAlgebra.Projectivization.Action
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
import Mathlib.GroupTheory.GroupAction.Primitive
import TauCeti.GroupTheory.SpecificGroups.CFSG.Classification

/-!
# Corpus input for the Suzuki groups

The Suzuki group `Sz(q)`, `q = 2^{2a+1}`, as the subgroup of `GL₄(K)` generated by the corpus
generators, its ovoid `Ω ⊆ ℙ³(K)`, and three corpus theorems: the TauCeti carrier of `²B₂(q)` is
isomorphic to this group, `Sz(q)` preserves `Ω`, and acts 2-transitively on it.

Definitions copied verbatim from AxiomMath/CFSG @ 69cb972: `CFSG.Blueprint.suzukiN`, `suzukiS`,
`suzukiD`, `suzukiW`, `suzukiGroup`, `SuzukiModel` (CFSG/Blueprint/Catalog.lean:97–124),
`CFSG.LieType.Ree.suzukiLine`, `suzukiInfty`, `suzukiOmega` (CFSG/LieType/Ree/SuzukiLocalData.lean:41–50),
`CFSG.LieType.Ree.suzukiOmegaSub` (CFSG/LieType/Ree/SuzukiOvoidAction.lean:72).
-/

namespace CFSGOutside.Corpus.Lie

open Matrix
open scoped LinearAlgebra.Projectivization

noncomputable section

section Suzuki

variable (a : ℕ) {K : Type} [Field K]

/-- Corpus: `CFSG.Blueprint.suzukiN`, CFSG/Blueprint/Catalog.lean:97. -/
def suzukiN (u v : K) : K :=
  u ^ (2 ^ (a + 1) + 2) + u * v + v ^ 2 ^ (a + 1)

/-- Corpus: `CFSG.Blueprint.suzukiS`, CFSG/Blueprint/Catalog.lean:100. -/
def suzukiS (u v : K) : Matrix (Fin 4) (Fin 4) K :=
  !![1, 0, 0, 0;
    u, 1, 0, 0;
    v, u ^ 2 ^ (a + 1), 1, 0;
    suzukiN a u v, u ^ (2 ^ (a + 1) + 1) + v, u, 1]

/-- Corpus: `CFSG.Blueprint.suzukiD`, CFSG/Blueprint/Catalog.lean:106. -/
def suzukiD (l : Kˣ) : Matrix (Fin 4) (Fin 4) K :=
  Matrix.diagonal ![((l ^ (1 + (2 ^ a : ℤ)) : Kˣ) : K), ((l ^ (2 ^ a : ℤ) : Kˣ) : K),
    ((l ^ (-(2 ^ a : ℤ)) : Kˣ) : K), ((l ^ (-1 - (2 ^ a : ℤ)) : Kˣ) : K)]

variable (K) in
/-- Corpus: `CFSG.Blueprint.suzukiW`, CFSG/Blueprint/Catalog.lean:111. -/
def suzukiW : Matrix (Fin 4) (Fin 4) K :=
  Matrix.of fun i j => if i.val + j.val = 3 then 1 else 0

variable (K) in
/-- Corpus: `CFSG.Blueprint.suzukiGroup`, CFSG/Blueprint/Catalog.lean:115. -/
def suzukiGroup : Subgroup (Matrix.GeneralLinearGroup (Fin 4) K) :=
  Subgroup.closure {g | (∃ u v : K, (g : Matrix (Fin 4) (Fin 4) K) = suzukiS a u v) ∨
    (∃ l : Kˣ, (g : Matrix (Fin 4) (Fin 4) K) = suzukiD a l) ∨
    (g : Matrix (Fin 4) (Fin 4) K) = suzukiW K}

end Suzuki

/-- Corpus: `CFSG.Blueprint.SuzukiModel`, CFSG/Blueprint/Catalog.lean:122. -/
def SuzukiModel (G : Type) [Group G] (p f : ℕ) : Prop :=
  p = 2 ∧ ∃ a : ℕ, 1 ≤ a ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K),
    f = 2 * a + 1 ∧ Nat.card K = 2 ^ f ∧ Nonempty (G ≃* suzukiGroup a K)

section Ovoid

variable (a : ℕ) (K : Type) [Field K]

/-- Corpus: `CFSG.LieType.Ree.suzukiLine`, CFSG/LieType/Ree/SuzukiLocalData.lean:41. -/
def suzukiLine (u v : K) : ℙ K (Fin 4 → K) :=
  Projectivization.mk K (![1, u, v, suzukiN a u v] : Fin 4 → K) fun h => by
    simpa using congrFun h 0

/-- Corpus: `CFSG.LieType.Ree.suzukiInfty`, CFSG/LieType/Ree/SuzukiLocalData.lean:45. -/
def suzukiInfty : ℙ K (Fin 4 → K) :=
  Projectivization.mk K (![0, 0, 0, 1] : Fin 4 → K) fun h => by
    simpa using congrFun h 3

/-- Corpus: `CFSG.LieType.Ree.suzukiOmega`, CFSG/LieType/Ree/SuzukiLocalData.lean:49. -/
def suzukiOmega : Set (ℙ K (Fin 4 → K)) :=
  Set.range (fun p : K × K => suzukiLine a K p.1 p.2) ∪ {suzukiInfty K}

end Ovoid

section OvoidAction

variable {a : ℕ} {K : Type} [Field K]

/-- The Suzuki group preserves its ovoid. -/
class SuzukiOmega : Prop where
  /-- Corpus: `CFSG.LieType.Ree.suzuki_smul_mem_suzukiOmega`,
  CFSG/LieType/Ree/SuzukiOvoidAction.lean:61. -/
  suzuki_smul_mem_suzukiOmega {a : ℕ} {K : Type} [Field K]
    [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1))
    (g : suzukiGroup a K) {x : ℙ K (Fin 4 → K)} (hx : x ∈ suzukiOmega a K) :
    g • x ∈ suzukiOmega a K

section
variable [h0 : Corpus.Lie.SuzukiOmega]
include h0

/-- Corpus: `CFSG.LieType.Ree.suzukiOmegaSub`, CFSG/LieType/Ree/SuzukiOvoidAction.lean:72. -/
def suzukiOmegaSub
    [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    SubMulAction (suzukiGroup a K) (ℙ K (Fin 4 → K)) where
  carrier := suzukiOmega a K
  smul_mem' g _ hx := Corpus.Lie.SuzukiOmega.suzuki_smul_mem_suzukiOmega hK g hx

end

/-- Double transitivity of the Suzuki group on its ovoid, and the model of the catalogue group. -/
class SuzukiOvoid [Corpus.Lie.SuzukiOmega] : Prop where
  /-- Corpus: `CFSG.LieType.Ree.suzuki_ovoid_double_transitivity`,
  CFSG/LieType/Ree/SuzukiOvoidAction.lean:131. -/
  suzuki_ovoid_double_transitivity {a : ℕ} {K : Type} [Field K]
    [Finite K] (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    (∀ g : suzukiGroup a K, ∀ x ∈ suzukiOmega a K, g • x ∈ suzukiOmega a K) ∧
    (∀ x ∈ suzukiOmega a K, ∀ y ∈ suzukiOmega a K, ∀ x' ∈ suzukiOmega a K,
      ∀ y' ∈ suzukiOmega a K, x ≠ y → x' ≠ y' →
        ∃ g : suzukiGroup a K, g • x = x' ∧ g • y = y') ∧
    MulAction.IsMultiplyPretransitive (suzukiGroup a K) (suzukiOmegaSub hK) 2 ∧
    Nonempty (suzukiOmegaSub hK) ∧
    MulAction.IsPreprimitive (suzukiGroup a K) (suzukiOmegaSub hK)
  /-- Corpus: `CFSG.RankThree.PartTwo.Sec4.Census.suzukiModel_of_index`,
  CFSG/RankThree/PartTwo/Sec4/Census/BridgeSuzuki.lean:16. -/
  suzukiModel_of_index (m : ℕ) (hm : (TauCeti.LieTypeIndex.suzuki m).Valid) :
    SuzukiModel (TauCeti.CFSGIndex.lie ⟨.suzuki m, hm⟩).Group 2 (2 * m + 1)

end OvoidAction

end

end CFSGOutside.Corpus.Lie
