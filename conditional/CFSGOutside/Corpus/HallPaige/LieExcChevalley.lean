/-!
# Corpus input for the adjoint Chevalley groups `G₂, F₄, E₆, E₇, E₈`

The adjoint Chevalley group `adjointGroup τ K ≤ GL(L(K))` of the corpus (generated by the root
operators `xOp`, `yOp` on the Chevalley lattice), its Borel, torus and monomial subgroups, the
Weyl group `WeylGroup τ` (the Coxeter group of the Cartan matrix) and its action on the root
lattice, with the corpus theorems used for the Hall–Paige theorem.

All definitions are copied verbatim from AxiomMath/CFSG @ 69cb972 (only `@[expose]` and the
module-system keywords are dropped, and all names are put in the namespace
`CFSGOutside.Corpus.Exc`); each docstring gives the corpus name and file:line. Corpus theorems are
stated as classes whose fields are the corpus statements. Proof fields of copied definitions use restated
corpus lemmas.
-/

set_option autoImplicit false

namespace CFSGOutside.Corpus.Exc

noncomputable section

open scoped Pointwise

/-! ### `CFSG/Blueprint/Chevalley.lean` -/

section Core

inductive Tag
  | G2 | F4 | D4 | E6 | E7 | E8
  deriving DecidableEq, Repr

namespace Tag

def rank : Tag → ℕ
  | G2 => 2
  | F4 => 4
  | D4 => 4
  | E6 => 6
  | E7 => 7
  | E8 => 8

def cartanE (r : ℕ) : Matrix (Fin r) (Fin r) ℤ :=
  fun i j =>
    if i = j then 2
    else if (i.val = 0 ∧ j.val = 2) ∨ (i.val = 2 ∧ j.val = 0) ∨ (i.val = 1 ∧ j.val = 3) ∨
        (i.val = 3 ∧ j.val = 1) ∨ (2 ≤ i.val ∧ j.val = i.val + 1) ∨
        (2 ≤ j.val ∧ i.val = j.val + 1) then -1
    else 0

def cartan : (τ : Tag) → Matrix (Fin τ.rank) (Fin τ.rank) ℤ
  | G2 => !![2, -1; -3, 2]
  | F4 => !![2, -1, 0, 0; -1, 2, -1, 0; 0, -2, 2, -1; 0, 0, -1, 2]
  | D4 => !![2, 0, -1, 0; 0, 2, -1, 0; -1, -1, 2, -1; 0, 0, -1, 2]
  | E6 => cartanE 6
  | E7 => cartanE 7
  | E8 => cartanE 8

def symmetrizer : (τ : Tag) → Matrix (Fin τ.rank) (Fin τ.rank) ℤ
  | G2 => Matrix.diagonal ![3, 1]
  | F4 => Matrix.diagonal ![2, 2, 1, 1]
  | D4 => 1
  | E6 => 1
  | E7 => 1
  | E8 => 1

def symmetrizedCartan (τ : Tag) : Matrix (Fin τ.rank) (Fin τ.rank) ℤ :=
  τ.symmetrizer * τ.cartan

end Tag

def reflect (τ : Tag) (i : Fin τ.rank) (v : Fin τ.rank → ℤ) : Fin τ.rank → ℤ :=
  v - (∑ j, τ.cartan i j * v j) • Pi.single i 1

/-- The set of roots of the root datum `τ`, as a parameter. In the corpus, `CFSG.Blueprint.Chevalley.IsRoot`
(CFSG/Blueprint/Chevalley.lean:55) is the inductive predicate generated by the simple roots (`basis`) and closed
under the simple reflections. A copy of an inductive predicate cannot be shown equal to it by `rfl`, so every copied
definition below that mentions it takes this class instead, and the clean build instantiates the class with the corpus
predicate. -/
class RootPred : Type where
  IsRoot : (τ : Tag) → (Fin τ.rank → ℤ) → Prop
  /-- Corpus: `CFSG.Blueprint.Chevalley.IsRoot.basis`, the constructor of the inductive predicate. -/
  basis : ∀ (τ : Tag) (j : Fin τ.rank), IsRoot τ (Pi.single j 1)

def height {τ : Tag} (v : Fin τ.rank → ℤ) : ℤ :=
  ∑ j, v j

section
variable [h0 : Corpus.Exc.RootPred]
include h0

abbrev Label (τ : Tag) : Type :=
  Fin τ.rank ⊕ {v : Fin τ.rank → ℤ // RootPred.IsRoot τ v}

abbrev RootModule (τ : Tag) (R : Type) [CommRing R] : Type _ :=
  Label τ →₀ R

end

variable (τ : Tag) (R : Type) [CommRing R]

section
variable [h0 : Corpus.Exc.RootPred]
include h0

def hVec (i : Fin τ.rank) : RootModule τ R :=
  Finsupp.single (Sum.inl i) 1

open Classical in
def rootVec (β : Fin τ.rank → ℤ) : RootModule τ R :=
  if h : RootPred.IsRoot τ β then Finsupp.single (Sum.inr ⟨β, h⟩) 1 else 0

def stringUp (i : Fin τ.rank) (α : Fin τ.rank → ℤ) : ℕ :=
  sSup {k : ℕ | RootPred.IsRoot τ (α + (k : ℤ) • Pi.single i 1)}

def stringDown (i : Fin τ.rank) (α : Fin τ.rank → ℤ) : ℕ :=
  sSup {k : ℕ | RootPred.IsRoot τ (α - (k : ℤ) • Pi.single i 1)}

end

/-- The operators of the adjoint Chevalley group, as parameters. In the corpus the root operators
`CFSG.Blueprint.Chevalley.xOp` and `yOp` (CFSG/Blueprint/Chevalley.lean:96, 110) and the weight
`CFSG.Blueprint.Chevalley.Label.latticeWeight` (CFSG/Blueprint/ChevalleyRootGroupsTorus.lean:13) are defined by a `match` on the
label of a root vector. Two definitions by `match` are not definitionally equal in Lean, so every copied definition
below that mentions them takes this class instead, and the clean build instantiates the class with the corpus
operators. The two `latticeWeight` equations are the defining equations of the corpus definition. -/
class Ops [RootPred] : Type 1 where
  xOp (τ : Tag) (R : Type) [CommRing R] (i : Fin τ.rank) (c : R) : Module.End R (RootModule τ R)
  yOp (τ : Tag) (R : Type) [CommRing R] (i : Fin τ.rank) (c : R) : Module.End R (RootModule τ R)
  latticeWeight {τ : Tag} : Label τ → Fin τ.rank → ℤ
  latticeWeight_inl {τ : Tag} (i : Fin τ.rank) : latticeWeight (Sum.inl i : Label τ) = 0
  latticeWeight_inr {τ : Tag} (α : {v : Fin τ.rank → ℤ // RootPred.IsRoot τ v}) :
    latticeWeight (Sum.inr α : Label τ) = α.1

attribute [simp] Ops.latticeWeight_inl Ops.latticeWeight_inr

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops]
include h0 h1

/-- Corpus: `CFSG.Blueprint.Chevalley.xOp`, CFSG/Blueprint/Chevalley.lean:96. -/
def xOp (i : Fin τ.rank) (c : R) : Module.End R (RootModule τ R) := Ops.xOp τ R i c

/-- Corpus: `CFSG.Blueprint.Chevalley.yOp`, CFSG/Blueprint/Chevalley.lean:110. -/
def yOp (i : Fin τ.rank) (c : R) : Module.End R (RootModule τ R) := Ops.yOp τ R i c

end

section
variable [h0 : Corpus.Exc.RootPred]
include h0

abbrev ModGL (K : Type) [Field K] : Type _ :=
  LinearMap.GeneralLinearGroup K (RootModule τ K)

end

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops]
include h0 h1

def adjointGroup (K : Type) [Field K] : Subgroup (ModGL τ K) :=
  Subgroup.closure {g | ∃ (i : Fin τ.rank) (c : K),
    (g : Module.End K (RootModule τ K)) = xOp τ K i c ∨
      (g : Module.End K (RootModule τ K)) = yOp τ K i c}

end

end Core

/-! ### `CFSG/Blueprint/ChevalleyParameterAddition.lean` -/

section ParameterAddition

section
variable [h0 : Corpus.Exc.RootPred]
include h0

def UpTransport (τ : Tag) : Prop :=
  ∀ (i : Fin τ.rank) (α : Fin τ.rank → ℤ), RootPred.IsRoot τ α → α ≠ Pi.single i 1 →
    α ≠ -Pi.single i 1 → ∀ k : ℕ, k ≤ stringUp τ i α →
      RootPred.IsRoot τ (α + (k : ℤ) • Pi.single i 1) ∧ α + (k : ℤ) • Pi.single i 1 ≠ Pi.single i 1 ∧
        α + (k : ℤ) • Pi.single i 1 ≠ -Pi.single i 1 ∧
        stringUp τ i (α + (k : ℤ) • Pi.single i 1) = stringUp τ i α - k ∧
        stringDown τ i (α + (k : ℤ) • Pi.single i 1) = stringDown τ i α + k

def DownTransport (τ : Tag) : Prop :=
  ∀ (i : Fin τ.rank) (α : Fin τ.rank → ℤ), RootPred.IsRoot τ α → α ≠ Pi.single i 1 →
    α ≠ -Pi.single i 1 → ∀ k : ℕ, k ≤ stringDown τ i α →
      RootPred.IsRoot τ (α - (k : ℤ) • Pi.single i 1) ∧ α - (k : ℤ) • Pi.single i 1 ≠ Pi.single i 1 ∧
        α - (k : ℤ) • Pi.single i 1 ≠ -Pi.single i 1 ∧
        stringDown τ i (α - (k : ℤ) • Pi.single i 1) = stringDown τ i α - k ∧
        stringUp τ i (α - (k : ℤ) • Pi.single i 1) = stringUp τ i α + k

end

variable {τ : Tag} {R : Type} [CommRing R]

/-- Chevalley root operators are invertible. -/
class ParameterAddition [Corpus.Exc.RootPred] [Corpus.Exc.Ops] : Prop where
  /-- Corpus: `CFSG.Blueprint.Chevalley.xOp_mul_xOp_neg`,
  CFSG/Blueprint/ChevalleyParameterAddition.lean:227. -/
  xOp_mul_xOp_neg {τ : Tag} {R : Type} [CommRing R] (h : UpTransport τ) (i : Fin τ.rank) (c : R) :
    xOp τ R i c * xOp τ R i (-c) = 1
  /-- Corpus: `CFSG.Blueprint.Chevalley.xOp_neg_mul_xOp`,
  CFSG/Blueprint/ChevalleyParameterAddition.lean:231. -/
  xOp_neg_mul_xOp {τ : Tag} {R : Type} [CommRing R] (h : UpTransport τ) (i : Fin τ.rank) (c : R) :
    xOp τ R i (-c) * xOp τ R i c = 1
  /-- Corpus: `CFSG.Blueprint.Chevalley.yOp_mul_yOp_neg`,
  CFSG/Blueprint/ChevalleyParameterAddition.lean:235. -/
  yOp_mul_yOp_neg {τ : Tag} {R : Type} [CommRing R] (h : DownTransport τ) (i : Fin τ.rank) (c : R) :
    yOp τ R i c * yOp τ R i (-c) = 1
  /-- Corpus: `CFSG.Blueprint.Chevalley.yOp_neg_mul_yOp`,
  CFSG/Blueprint/ChevalleyParameterAddition.lean:239. -/
  yOp_neg_mul_yOp {τ : Tag} {R : Type} [CommRing R] (h : DownTransport τ) (i : Fin τ.rank) (c : R) :
    yOp τ R i (-c) * yOp τ R i c = 1
  /-- Corpus: `CFSG.Blueprint.Chevalley.upTransport`, CFSG/Blueprint/ChevalleySimpleRoots.lean:12. -/
  upTransport (τ : Tag) : UpTransport τ
  /-- Corpus: `CFSG.Blueprint.Chevalley.downTransport`,
  CFSG/Blueprint/ChevalleySimpleRoots.lean:18. -/
  downTransport (τ : Tag) : DownTransport τ

end ParameterAddition

/-! ### `CFSG/Blueprint/ChevalleyWeyl.lean` -/

section Definitions

variable (τ : Tag) (R : Type) [CommRing R]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition]
include h0 h1 h2

def xUnit (i : Fin τ.rank) (c : R) : (Module.End R (RootModule τ R))ˣ where
  val := xOp τ R i c
  inv := xOp τ R i (-c)
  val_inv := Corpus.Exc.ParameterAddition.xOp_mul_xOp_neg (Corpus.Exc.ParameterAddition.upTransport τ) i c
  inv_val := Corpus.Exc.ParameterAddition.xOp_neg_mul_xOp (Corpus.Exc.ParameterAddition.upTransport τ) i c

def yUnit (i : Fin τ.rank) (c : R) : (Module.End R (RootModule τ R))ˣ where
  val := yOp τ R i c
  inv := yOp τ R i (-c)
  val_inv := Corpus.Exc.ParameterAddition.yOp_mul_yOp_neg (Corpus.Exc.ParameterAddition.downTransport τ) i c
  inv_val := Corpus.Exc.ParameterAddition.yOp_neg_mul_yOp (Corpus.Exc.ParameterAddition.downTransport τ) i c

def weylElt (i : Fin τ.rank) (t : Rˣ) : (Module.End R (RootModule τ R))ˣ where
  val := xOp τ R i t * yOp τ R i (-((t⁻¹ : Rˣ) : R)) * xOp τ R i t
  inv := xOp τ R i (-(t : R)) * yOp τ R i ((t⁻¹ : Rˣ) : R) * xOp τ R i (-(t : R))
  val_inv := by
    calc xOp τ R i t * yOp τ R i (-((t⁻¹ : Rˣ) : R)) * xOp τ R i t *
          (xOp τ R i (-(t : R)) * yOp τ R i ((t⁻¹ : Rˣ) : R) * xOp τ R i (-(t : R))) =
        xOp τ R i t * (yOp τ R i (-((t⁻¹ : Rˣ) : R)) *
          (xOp τ R i t * xOp τ R i (-(t : R))) * yOp τ R i ((t⁻¹ : Rˣ) : R)) *
            xOp τ R i (-(t : R)) := by
          simp only [mul_assoc]
      _ = 1 := by
          rw [Corpus.Exc.ParameterAddition.xOp_mul_xOp_neg (Corpus.Exc.ParameterAddition.upTransport τ), mul_one, Corpus.Exc.ParameterAddition.yOp_neg_mul_yOp (Corpus.Exc.ParameterAddition.downTransport τ),
            mul_one, Corpus.Exc.ParameterAddition.xOp_mul_xOp_neg (Corpus.Exc.ParameterAddition.upTransport τ)]
  inv_val := by
    calc xOp τ R i (-(t : R)) * yOp τ R i ((t⁻¹ : Rˣ) : R) * xOp τ R i (-(t : R)) *
          (xOp τ R i t * yOp τ R i (-((t⁻¹ : Rˣ) : R)) * xOp τ R i t) =
        xOp τ R i (-(t : R)) * (yOp τ R i ((t⁻¹ : Rˣ) : R) *
          (xOp τ R i (-(t : R)) * xOp τ R i t) * yOp τ R i (-((t⁻¹ : Rˣ) : R))) *
            xOp τ R i t := by
          simp only [mul_assoc]
      _ = 1 := by
          rw [Corpus.Exc.ParameterAddition.xOp_neg_mul_xOp (Corpus.Exc.ParameterAddition.upTransport τ), mul_one, Corpus.Exc.ParameterAddition.yOp_mul_yOp_neg (Corpus.Exc.ParameterAddition.downTransport τ),
            mul_one, Corpus.Exc.ParameterAddition.xOp_neg_mul_xOp (Corpus.Exc.ParameterAddition.upTransport τ)]

def torusElt (i : Fin τ.rank) (t : Rˣ) : (Module.End R (RootModule τ R))ˣ :=
  weylElt τ R i t * weylElt τ R i (-1)

end

end Definitions

