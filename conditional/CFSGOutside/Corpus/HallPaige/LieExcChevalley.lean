section Borel

variable (τ : Tag) (R : Type) [CommRing R]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition]
include h0 h1 h2

def torusGroup
    : Subgroup (Module.End R (RootModule τ R))ˣ :=
  Subgroup.closure (Set.range fun p : Fin τ.rank × Rˣ => torusElt τ R p.1 p.2)

def monomialSubgroup
    : Subgroup (Module.End R (RootModule τ R))ˣ :=
  torusGroup τ R ⊔ Subgroup.closure (Set.range fun i : Fin τ.rank => weylElt τ R i 1)

def borelGroup
    : Subgroup (Module.End R (RootModule τ R))ˣ :=
  torusGroup τ R ⊔ posUnipotent τ R

end

end Borel

/-! ### `CFSG/LieType/RootSystem/Basic.lean` -/

section RootSystem

variable {I : Type} [Fintype I] [DecidableEq I]

def coroot (A : Matrix I I ℤ) (i : I) : (I → ℤ) →ₗ[ℤ] ℤ :=
  ∑ j, A i j • LinearMap.proj j

def reflection (A : Matrix I I ℤ) (i : I) : Module.End ℤ (I → ℤ) :=
  LinearMap.id - (coroot A i).smulRight (Pi.single i 1)

variable {A : Matrix I I ℤ} (hA : TauCeti.IsFiniteType A)

abbrev coxeterMatrix : CoxeterMatrix I :=
  TauCeti.coxeterMatrixOfCartanMatrix A hA.apply_self fun _ _ h => hA.apply_mul_apply_mem_of_ne h

/-- Liftability of the Weyl group action. -/
class Liftable : Prop where
  /-- Corpus: `CFSG.LieType.RootSystem.isLiftable`, CFSG/LieType/RootSystem/Basic.lean:147. -/
  isLiftable {I : Type} [Fintype I] [DecidableEq I] {A : Matrix I I ℤ} (hA : TauCeti.IsFiniteType A) : (coxeterMatrix hA).IsLiftable (reflection A)

section
variable [h0 : Corpus.Exc.Liftable]
include h0

noncomputable def weylAction : (coxeterMatrix hA).Group →* Module.End ℤ (I → ℤ) :=
  (coxeterMatrix hA).toCoxeterSystem.lift ⟨reflection A, Corpus.Exc.Liftable.isLiftable hA⟩

end

/-- Right descents and the Weyl group action on the root lattice. -/
class Descent [Corpus.Exc.Liftable] : Prop where
  /-- Corpus: `CFSG.LieType.RootSystem.nonpos_of_isRightDescent`,
  CFSG/LieType/RootSystem/Positivity.lean:123. -/
  nonpos_of_isRightDescent {I : Type} [Fintype I] [DecidableEq I] {A : Matrix I I ℤ} (hA : TauCeti.IsFiniteType A) {w : (coxeterMatrix hA).Group} {i : I}
    (hw : (coxeterMatrix hA).toCoxeterSystem.IsRightDescent w i) :
    weylAction hA w (Pi.single i 1) ≤ 0
  /-- Corpus: `CFSG.LieType.RootSystem.weylAction_injective`,
  CFSG/LieType/RootSystem/Positivity.lean:157. -/
  weylAction_injective {I : Type} [Fintype I] [DecidableEq I] {A : Matrix I I ℤ} (hA : TauCeti.IsFiniteType A) : Function.Injective (weylAction hA)

end RootSystem

/-! ### `CFSG/LieType/Chevalley/WeylRoots.lean` -/

theorem cartanE_eq (r : ℕ) : Tag.cartanE r = CartanMatrix.E r := by
  ext i j
  simp only [Tag.cartanE, CartanMatrix.E, Matrix.of_apply]
  by_cases hij : i = j
  · simp [hij]
  · have : i.val ≠ j.val := fun h => hij (Fin.ext h)
    simp only [hij, ite_false]
    congr 1
    apply propext
    omega

theorem isFiniteType_cartan : ∀ τ : Tag, TauCeti.IsFiniteType τ.cartan
  | .G2 => by
    have h : Tag.cartan .G2 = CartanMatrix.G₂.transpose := by
      ext i j
      fin_cases i <;> fin_cases j <;> rfl
    rw [h, ← TauCeti.DynkinType.cartanMatrix_G2]
    exact TauCeti.DynkinType.isFiniteType_cartanMatrix_G2
  | .F4 => by
    have h : Tag.cartan .F4 = CartanMatrix.F₄.transpose := by
      ext i j
      fin_cases i <;> fin_cases j <;> rfl
    rw [h, ← TauCeti.DynkinType.cartanMatrix_F4]
    exact TauCeti.DynkinType.isFiniteType_cartanMatrix_F4.transpose
  | .D4 => by
    have h : Tag.cartan .D4 =
        (CartanMatrix.D 4).submatrix (Equiv.swap (1 : Fin 4) 2) (Equiv.swap (1 : Fin 4) 2) := by
      ext i j
      fin_cases i <;> fin_cases j <;> rfl
    rw [h]
    exact (TauCeti.isFiniteType_cartanMatrix_D 4).submatrix (Equiv.swap _ _).injective
  | .E6 => by
    change TauCeti.IsFiniteType (Tag.cartanE 6)
    rw [cartanE_eq, ← TauCeti.DynkinType.cartanMatrix_E6]
    exact TauCeti.DynkinType.isFiniteType_cartanMatrix_E6
  | .E7 => by
    change TauCeti.IsFiniteType (Tag.cartanE 7)
    rw [cartanE_eq, ← TauCeti.DynkinType.cartanMatrix_E7]
    exact TauCeti.DynkinType.isFiniteType_cartanMatrix_E7
  | .E8 => by
    change TauCeti.IsFiniteType (Tag.cartanE 8)
    rw [cartanE_eq, ← TauCeti.DynkinType.cartanMatrix_E8]
    exact TauCeti.DynkinType.isFiniteType_cartanMatrix_E8

abbrev WeylGroup (τ : Tag) : Type :=
  (coxeterMatrix (isFiniteType_cartan τ)).Group

abbrev coxeterSystem (τ : Tag) :
    CoxeterSystem (coxeterMatrix (isFiniteType_cartan τ)) (WeylGroup τ) :=
  (coxeterMatrix (isFiniteType_cartan τ)).toCoxeterSystem

abbrev simple (τ : Tag) (i : Fin τ.rank) : WeylGroup τ :=
  (coxeterSystem τ).simple i

