/-! ### `CFSG/LieType/Chevalley/ChevalleySplitBN.lean` -/

section SplitBNDefs

variable (τ : Tag) (K : Type) [Field K]

section
variable [h0 : Corpus.Exc.RootPred] [h1 : Corpus.Exc.Ops] [h2 : Corpus.Exc.ParameterAddition]
include h0 h1 h2

abbrev borelSub
    : Subgroup (adjointGroup τ K) :=
  (borelGroup τ K).subgroupOf (adjointGroup τ K)

abbrev monomialSub
    : Subgroup (adjointGroup τ K) :=
  (monomialSubgroup τ K).subgroupOf (adjointGroup τ K)

abbrev posUnipotentSub
    : Subgroup (adjointGroup τ K) :=
  (posUnipotent τ K).subgroupOf (adjointGroup τ K)

abbrev torusSub
    : Subgroup (adjointGroup τ K) :=
  (torusGroup τ K).subgroupOf (adjointGroup τ K)

/-- `weylElt τ K i t` lies in the adjoint group (corpus:
`CFSG.Blueprint.Chevalley.weylElt_mem_adjointGroup`, CFSG/Blueprint/ChevalleyWeyl.lean:187;
reproved here). -/
theorem weylElt_mem_adjointGroup (i : Fin τ.rank) (t : Kˣ) :
    weylElt τ K i t ∈ adjointGroup τ K := by
  have hx : ∀ c : K, xUnit τ K i c ∈ adjointGroup τ K := fun c =>
    Subgroup.subset_closure ⟨i, c, Or.inl rfl⟩
  have hy : ∀ c : K, yUnit τ K i c ∈ adjointGroup τ K := fun c =>
    Subgroup.subset_closure ⟨i, c, Or.inr rfl⟩
  have : weylElt τ K i t = xUnit τ K i t * yUnit τ K i (-((t⁻¹ : Kˣ) : K)) * xUnit τ K i t :=
    Units.ext rfl
  rw [this]
  exact mul_mem (mul_mem (hx _) (hy _)) (hx _)

/-- `weylElt τ K i 1` lies in the monomial subgroup (corpus:
`CFSG.LieType.Chevalley.weylElt_mem_monomialSubgroup`,
CFSG/LieType/Chevalley/WeylNormalizerQuotient.lean:222; same proof). -/
theorem weylElt_mem_monomialSubgroup (i : Fin τ.rank) :
    weylElt τ K i 1 ∈ monomialSubgroup τ K :=
  Subgroup.mem_sup_right (Subgroup.subset_closure ⟨i, rfl⟩)

def weylRep
    (i : Fin τ.rank) : monomialSub τ K :=
  ⟨⟨weylElt τ K i 1, weylElt_mem_adjointGroup τ K i 1⟩, weylElt_mem_monomialSubgroup τ K i⟩

/-! ### `CFSG/LieType/Chevalley/SimpleBruhatMultiplication.lean` -/

def bruhatCell
    (w : WeylGroup τ) : Set (ModGL τ K) :=
  (borelGroup τ K : Set (ModGL τ K)) * {canonicalRep (coxeterSystem τ) K w} *
    (borelGroup τ K : Set (ModGL τ K))

end

end SplitBNDefs

/-! ### `CFSG/GroupActions/SplitBNPair.lean` -/

section SplitBNPair

variable {G : Type*} [Group G]

def SplitBN (B N U : Subgroup G) {I : Type*} (n : I → N) : Prop :=
  ∃ _ : ((B ⊓ N).subgroupOf N).Normal,
    B ⊔ N = ⊤ ∧
    Function.Injective (fun i => (n i : N ⧸ (B ⊓ N).subgroupOf N)) ∧
    (∀ i, orderOf (n i : N ⧸ (B ⊓ N).subgroupOf N) = 2) ∧
    Subgroup.closure (Set.range fun i => (n i : N ⧸ (B ⊓ N).subgroupOf N)) = ⊤ ∧
    (∀ i, ∀ x ∈ N, {((n i : N) : G)} * (B : Set G) * {x} ⊆
      (B : Set G) * {((n i : N) : G) * x} * (B : Set G) ∪ (B : Set G) * {x} * (B : Set G)) ∧
    (∀ i, ¬ {((n i : N) : G)} * (B : Set G) * {((n i : N) : G)⁻¹} ⊆ (B : Set G)) ∧
    U ≤ B ∧ (U.subgroupOf B).Normal ∧ Group.IsNilpotent U ∧
    (∀ x ∈ B ⊓ N, ∀ y ∈ B ⊓ N, x * y = y * x) ∧
    (B : Set G) = (U : Set G) * ((B ⊓ N : Subgroup G) : Set G) ∧
    U ⊓ (B ⊓ N) = ⊥

end SplitBNPair

/-! ### Corpus theorems -/

section Theorems

variable (τ : Tag) (K : Type) [Field K]

/-- In an adjoint Chevalley group the intersection of the Borel and monomial subgroups is normal in the monomial subgroup. -/
class BorelNormal [Corpus.Exc.RootPred] [Corpus.Exc.Ops] [Corpus.Exc.ParameterAddition] : Prop where
  /-- Corpus: the instance `CFSG.LieType.Chevalley.normal_borelSub_inf_monomialSub`,
  CFSG/LieType/Chevalley/ChevalleySplitBN.lean:62. -/
  normal_borelSub_inf_monomialSub (τ : Tag) (K : Type) [Field K] :
    ((borelSub τ K ⊓ monomialSub τ K).subgroupOf (monomialSub τ K)).Normal

attribute [instance] Corpus.Exc.BorelNormal.normal_borelSub_inf_monomialSub

/-- The adjoint Chevalley group has a split BN-pair. -/
class Chevalley [Corpus.Exc.RootPred] [Corpus.Exc.Ops] [Corpus.Exc.ParameterAddition] [Corpus.Exc.BorelNormal] : Prop where
  /-- Corpus: `CFSG.LieType.Chevalley.chevalley_split_bn_pair`,
  CFSG/LieType/Chevalley/ChevalleySplitBN.lean:320. The adjoint Chevalley group has a split
  `(B, N)`-pair whose Weyl group is the Coxeter group of type `τ`, with simple reflections the
  images of `weylRep τ K i`. -/
  chevalley_split_bn_pair (τ : Tag) (K : Type) [Field K] :
    SplitBN (borelSub τ K) (monomialSub τ K) (posUnipotentSub τ K) (weylRep τ K) ∧
    borelSub τ K ⊓ monomialSub τ K = torusSub τ K ∧
    (∃ ψ : WeylGroup τ ≃*
        monomialSub τ K ⧸ (borelSub τ K ⊓ monomialSub τ K).subgroupOf (monomialSub τ K),
      ∀ i, ψ (simple τ i) = (weylRep τ K i : monomialSub τ K ⧸
        (borelSub τ K ⊓ monomialSub τ K).subgroupOf (monomialSub τ K))) ∧
    (∀ (i : Fin τ.rank) (w : WeylGroup τ),
      ({weylElt τ K i 1} : Set (ModGL τ K)) * (borelGroup τ K : Set (ModGL τ K)) *
          {canonicalRep (coxeterSystem τ) K w} ⊆
        bruhatCell τ K (simple τ i * w) ∪ bruhatCell τ K w) ∧
    ((posUnipotentSub τ K).subgroupOf (borelSub τ K)).Normal ∧
    posUnipotentSub τ K ⊓ torusSub τ K = ⊥ ∧
    posUnipotentSub τ K ⊔ torusSub τ K = borelSub τ K ∧
    ∀ [Finite K] (p : ℕ) [CharP K p],
      Finite (posUnipotentSub τ K) ∧ IsPGroup p (posUnipotentSub τ K)
  /-- Corpus: `CFSG.LieType.Chevalley.center_adjointGroup_eq_bot`,
  CFSG/LieType/Chevalley/AdjointCenter.lean:101. -/
  center_adjointGroup_eq_bot {τ : Tag} {K : Type} [Field K] [Finite K] :
    Subgroup.center (adjointGroup τ K) = ⊥
  /-- Corpus: `CFSG.LieType.Chevalley.finite_modGL`,
  CFSG/LieType/Chevalley/SylowOpposition.lean:34. -/
  finite_modGL {τ : Tag} {K : Type} [Field K] [Finite K] : Finite (ModGL τ K)

end Theorems

section Torus

variable {τ : Tag} {R : Type} [CommRing R]

/-- The torus elements of an adjoint Chevalley group act diagonally on the root operators. -/
class TorusElt [Corpus.Exc.RootPred] [Corpus.Exc.Ops] [Corpus.Exc.ParameterAddition] : Prop where
  /-- Corpus: `CFSG.Blueprint.Chevalley.torusElt_apply_eq`,
  CFSG/Blueprint/ChevalleyRootGroupsTorus.lean:211. -/
  torusElt_apply_eq {τ : Tag} {R : Type} [CommRing R] (i : Fin τ.rank) (t : Rˣ) (x : RootModule τ R) (a : Label τ) :
    (torusElt τ R i t : Module.End R (RootModule τ R)) x a =
      ((t ^ (∑ j, τ.cartan i j * a.latticeWeight j) : Rˣ) : R) * x a

end Torus

section Sylow

variable {G : Type*} [Group G]

/-- Corpus: `CFSG.QuasithinUnique.IsSylowTwoOf`,
CFSG/LocalAnalysis/QuasithinUnique/Defs.lean:19. -/
def IsSylowTwoOf (S H : Subgroup G) : Prop :=
  S ≤ H ∧ IsPGroup 2 S ∧ ¬ 2 ∣ (S.subgroupOf H).index

end Sylow

/-- The positive unipotent group is a Sylow `2`-subgroup in characteristic `2`. -/
class SylowTwo [Corpus.Exc.RootPred] [Corpus.Exc.Ops] [Corpus.Exc.ParameterAddition] : Prop where
  /-- Corpus: `CFSG.LieType.Chevalley.isSylowTwoOf_posUnipotent`,
  CFSG/LieType/Chevalley/PosUnipotentSylow.lean:16. -/
  isSylowTwoOf_posUnipotent {K : Type} [Field K]
    [Finite K] [CharP K 2] (τ : Tag) :
    IsSylowTwoOf (posUnipotent τ K) (adjointGroup τ K)

/-! ### The bridges to the TauCeti carriers -/

open TauCeti

