/-- Corpus: `CFSG.Blueprint.AdjointQuotient`, CFSG/Blueprint/Catalog.lean:23. -/
abbrev AdjointQuotient (τ : Tag) (K : Type) [Field K] : Type :=
  ↥(adjointGroup τ K) ⧸ Subgroup.center ↥(adjointGroup τ K)

/-- Corpus: `CFSG.TauCetiBridge.UntwistedBridge`,
CFSG/Adapters/TauCetiExceptional/Interface.lean:12. -/
def UntwistedBridge (τ : Tag) (c : PrimePower → LieTypeIndex) : Prop :=
  ∀ (q : PrimePower) (hv : (c q).Valid), q.p ≠ 2 →
    ∀ (K : Type) [Field K] [Finite K], Nat.card K = q.card →
      Nonempty (AdjointQuotient τ K ≃* ValidLieTypeIndex.Group ⟨c q, hv⟩)

/-- Corpus: `CFSG.TauCetiBridge.Even.UntwistedBridgeEven`,
CFSG/Adapters/TauCetiExceptional/EvenInterface.lean:13. -/
def UntwistedBridgeEven (τ : Tag) (c : PrimePower → LieTypeIndex) : Prop :=
  ∀ (q : PrimePower) (hv : (c q).Valid), q.p = 2 →
    ∀ (K : Type) [Field K] [Finite K], Nat.card K = q.card →
      Nonempty (AdjointQuotient τ K ≃* ValidLieTypeIndex.Group ⟨c q, hv⟩)

end

