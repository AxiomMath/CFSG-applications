import Mathlib

/-!
# Copied corpus definitions: quasisimple groups, components, the layer and the soluble radical

Verbatim copies, under `CFSGOutside.Corpus`, of definitions from AxiomMath/CFSG at commit
69cb972f587a3ecc035e092253167ff2e303c962. `clean/CFSGOutsideClean/Corpus/Defs/Components.lean` shows that each
copy equals its original.

The elementary theory the proofs need is proved here, following the corpus proofs: two distinct components
commute (`LocalCores.distinct_components_commute`), the layer is characteristic, and the components multiply
into the layer (`LocalCores.layerMul`).
-/

universe u

namespace CFSGOutside.Corpus

open Subgroup

variable {G : Type*} [Group G]

/-- A quasisimple group: perfect, with simple nonabelian central quotient. Copy of `CFSG.IsQuasisimple`,
`CFSG/Foundations/Basic.lean` line 35. -/
def IsQuasisimple (Q : Type*) [Group Q] : Prop :=
  Group.IsPerfect Q ∧ IsSimpleGroup (Q ⧸ center Q) ∧
    ∃ a b : Q ⧸ center Q, a * b ≠ b * a

/-- A component: a subnormal quasisimple subgroup. Copy of `CFSG.IsComponent`, `CFSG/Foundations/Basic.lean`
line 39. -/
def IsComponent (K : Subgroup G) : Prop :=
  IsQuasisimple K ∧ K.IsSubnormal

variable (G) in
/-- The layer `E(G)`, the subgroup generated by the components. Copy of `CFSG.layer`,
`CFSG/Foundations/Basic.lean` line 43, with `CFSG.WholeGroup.layerOf`
(`CFSG/GroupTheory/Fitting/WholeGroupConstruction.lean` line 11) unfolded. -/
def layer : Subgroup G :=
  sSup {K : Subgroup G | IsComponent K}

variable (G) in
theorem layer.eq_sSup : layer G = sSup {K : Subgroup G | IsComponent K} :=
  rfl

variable (G) in
/-- The soluble radical: the subgroup generated by the normal soluble subgroups. Copy of
`CFSG.solvableRadical`, `CFSG/Foundations/Basic.lean` line 76. -/
def solvableRadical : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Group.IsSolvable N}

theorem IsQuasisimple.of_mulEquiv {H : Type*} [Group H] (e : G ≃* H) (h : IsQuasisimple H) :
    IsQuasisimple G := by
  obtain ⟨hperfect, hsimple, a, b, hab⟩ := h
  let f := QuotientGroup.congr (Subgroup.center G) (Subgroup.center H) e (Subgroup.map_center_eq e)
  refine ⟨Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective,
    f.isSimpleGroup, f.symm a, f.symm b, fun hcomm => hab ?_⟩
  simpa only [map_mul, MulEquiv.apply_symm_apply] using congrArg f hcomm

/-! ### The soluble radical -/

instance solvableRadical_normal : (solvableRadical G).Normal :=
  Subgroup.sSup_normal _ fun _ hN => hN.1

theorem le_solvableRadical {N : Subgroup G} (hN : N.Normal) (hs : Group.IsSolvable N) :
    N ≤ solvableRadical G :=
  le_sSup ⟨hN, hs⟩

theorem isSolvable_sup_of_normal_solvable (N₁ N₂ : Subgroup G) [hN₁ : N₁.Normal]
    [N₂.Normal] [Group.IsSolvable N₁] [Group.IsSolvable N₂] :
    Group.IsSolvable (N₁ ⊔ N₂ : Subgroup G) := by
  let L : Subgroup G := N₁ ⊔ N₂
  let M : Subgroup L := N₁.subgroupOf L
  have hM : M.Normal := Subgroup.normal_subgroupOf
  have hMsolv : Group.IsSolvable M :=
    Group.isSolvable_of_isSolvable_injective (f := (Subgroup.subgroupOfEquivOfLe
      (le_sup_left : N₁ ≤ L)).toMonoidHom) (Subgroup.subgroupOfEquivOfLe le_sup_left).injective
  let f : N₂ →* L ⧸ M :=
    (QuotientGroup.mk' M).comp (Subgroup.inclusion (le_sup_right : N₂ ≤ L))
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨⟨x, hx⟩, rfl⟩ := QuotientGroup.mk'_surjective M y
    obtain ⟨a, ha, b, hb, rfl⟩ := (Subgroup.mem_sup_of_normal_left (s := N₁) (t := N₂)).mp hx
    refine ⟨⟨b, hb⟩, ?_⟩
    simp only [f, MonoidHom.comp_apply]
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq,
      Subgroup.mem_subgroupOf]
    simpa [mul_assoc] using hN₁.conj_mem' a ha b
  have : Group.IsSolvable (L ⧸ M) := Group.isSolvable_of_surjective hf
  exact Group.isSolvable_of_subgroup_quotient M

theorem isSolvable_solvableRadical [Finite G] : Group.IsSolvable (solvableRadical G) := by
  classical
  obtain ⟨M, -, hM⟩ := Finite.exists_le_maximal
    (p := fun N : Subgroup G => N.Normal ∧ Group.IsSolvable N) (a := ⊥)
    ⟨inferInstance, inferInstance⟩
  have hge : ∀ N : Subgroup G, N.Normal ∧ Group.IsSolvable N → N ≤ M := by
    rintro N ⟨hN, hNs⟩
    have : M.Normal := hM.1.1
    have : Group.IsSolvable M := hM.1.2
    have h := hM.eq_of_le ⟨inferInstance, isSolvable_sup_of_normal_solvable M N⟩ le_sup_left
    rw [h]
    exact le_sup_right
  have heq : solvableRadical G = M := le_antisymm (sSup_le hge) (le_sSup hM.1)
  rw [heq]
  exact hM.1.2

namespace LocalCores

/-! ### Quasisimple groups -/

theorem perfect_double_commutator {P X : Subgroup G} (hP : Group.IsPerfect P)
    (h : ⁅⁅P, X⁆, P⁆ = ⊥) : ⁅P, X⁆ = ⊥ := by
  have h2 : ⁅⁅X, P⁆, P⁆ = ⊥ := by
    rw [Subgroup.commutator_comm X P]
    exact h
  have h3 := Subgroup.commutator_commutator_eq_bot_of_rotate (H₁ := P) (H₂ := P) (H₃ := X) h h2
  rwa [Subgroup.isPerfect_iff.mp hP] at h3

theorem isQuasisimple_nontrivial {Q : Type*} [Group Q] (hQ : IsQuasisimple Q) : Nontrivial Q := by
  obtain ⟨-, -, a, b, hab⟩ := hQ
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
  refine ⟨a * b, b * a, fun h => hab ?_⟩
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, h]

theorem isQuasisimple_of_mulEquiv {A B : Type*} [Group A] [Group B] (e : A ≃* B)
    (hA : IsQuasisimple A) : IsQuasisimple B :=
  hA.of_mulEquiv e.symm

theorem quasisimple_normal_subgroups {Q : Type*} [Group Q] (hQ : IsQuasisimple Q)
    {N : Subgroup Q} (hN : N.Normal) : N = ⊤ ∨ N ≤ center Q := by
  obtain ⟨hp, hs, -⟩ := hQ
  have := hN.map (QuotientGroup.mk' (center Q)) (QuotientGroup.mk'_surjective _)
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (N.map (QuotientGroup.mk' (center Q))) with
    h | h
  · right
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
  · left
    have hsup : N ⊔ center Q = ⊤ := by
      have := Subgroup.comap_map_eq (QuotientGroup.mk' (center Q)) N
      rw [h, Subgroup.comap_top, QuotientGroup.ker_mk'] at this
      exact this.symm
    have hZ : ⁅center Q, center Q⁆ = ⊥ :=
      Subgroup.commutator_eq_bot_iff_le_centralizer.mpr (Subgroup.center_le_centralizer _)
    have hmap : (⊤ : Subgroup Q).map (QuotientGroup.mk' N) =
        (center Q).map (QuotientGroup.mk' N) := by
      rw [← hsup, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq]
    have hcomm : commutator Q ≤ N := by
      rw [_root_.commutator_def, ← QuotientGroup.ker_mk' N, ← Subgroup.map_eq_bot_iff,
        Subgroup.map_commutator, hmap, ← Subgroup.map_commutator, hZ, Subgroup.map_bot]
    rw [Group.isPerfect_def] at hp
    exact eq_top_iff.mpr (hp ▸ hcomm)

section CentralExtension

variable {P Q : Type*} [Group P] [Group Q]

theorem comap_center_eq_of_perfect (hP : Group.IsPerfect P) (f : P →* Q)
    (hf : Function.Surjective f) (hker : f.ker ≤ center P) :
    (center Q).comap f = center P := by
  apply le_antisymm
  · have h1 : ⁅(⊤ : Subgroup P), (center Q).comap f⁆ ≤ center P := by
      refine (commutator_le.mpr fun g _ b hb => ?_).trans hker
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mem_center_iff.mp hb (f g)
    have h2 : ⁅⁅(⊤ : Subgroup P), (center Q).comap f⁆, ⊤⁆ = ⊥ :=
      le_bot_iff.mp ((commutator_mono h1 le_rfl).trans (commutator_center_left _).le)
    exact commutator_top_left_eq_bot_iff_le_center.mp
      (perfect_double_commutator (Group.IsPerfect.top_iff.mpr hP) h2)
  · intro z hz
    rw [mem_comap, mem_center_iff]
    intro q
    obtain ⟨g, rfl⟩ := hf q
    rw [← map_mul, ← map_mul, mem_center_iff.mp hz g]

theorem isQuasisimple_iff_of_surjective (hP : Group.IsPerfect P) (f : P →* Q)
    (hf : Function.Surjective f) (hker : f.ker ≤ center P) :
    IsQuasisimple P ↔ IsQuasisimple Q := by
  have hQ : Group.IsPerfect Q := by have := hP; exact Group.IsPerfect.ofSurjective hf
  have hc : center P = ((QuotientGroup.mk' (center Q)).comp f).ker := by
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk', comap_center_eq_of_perfect hP f hf hker]
  let e : P ⧸ center P ≃* Q ⧸ center Q := (QuotientGroup.quotientMulEquivOfEq hc).trans
    (QuotientGroup.quotientKerEquivOfSurjective _ ((QuotientGroup.mk'_surjective _).comp hf))
  constructor
  · rintro ⟨-, hs, a, b, hab⟩
    refine ⟨hQ, e.symm.isSimpleGroup, e a, e b, fun h => hab (e.injective ?_)⟩
    rw [map_mul, map_mul, h]
  · rintro ⟨-, hs, a, b, hab⟩
    refine ⟨hP, e.isSimpleGroup, e.symm a, e.symm b, fun h => hab (e.symm.injective ?_)⟩
    rw [map_mul, map_mul, h]

theorem isQuasisimple_of_surjective (hP : IsQuasisimple P) (f : P →* Q)
    (hf : Function.Surjective f) (hker : f.ker ≤ center P) : IsQuasisimple Q :=
  (isQuasisimple_iff_of_surjective hP.1 f hf hker).mp hP

theorem isQuasisimple_of_isSimpleGroup [IsSimpleGroup Q] (hQ : ∃ a b : Q, a * b ≠ b * a) :
    IsQuasisimple Q ∧ center Q = ⊥ := by
  obtain ⟨a, b, hab⟩ := hQ
  have hZ : center Q = ⊥ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (center Q) with h | h
    · exact h
    · exact absurd (mem_center_iff.mp (by rw [h]; exact mem_top b) a) hab
  have hP : Group.IsPerfect Q := by
    rw [Group.isPerfect_def]
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (commutator Q) with h | h
    · refine absurd ?_ hab
      rw [← commutatorElement_eq_one_iff_mul_comm, ← mem_bot, ← h, commutator_def]
      exact commutator_mem_commutator (mem_top a) (mem_top b)
    · exact h
  let e : Q ⧸ center Q ≃* Q :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans QuotientGroup.quotientBot
  refine ⟨⟨hP, e.isSimpleGroup, e.symm a, e.symm b, fun h => hab (e.symm.injective ?_)⟩, hZ⟩
  rw [map_mul, map_mul, h]

theorem isQuasisimple_map {K : Subgroup P} (hK : IsQuasisimple K) (f : P →* Q)
    (hKf : ¬ K ≤ f.ker) : IsQuasisimple (K.map f) := by
  refine isQuasisimple_of_surjective hK (f.subgroupMap K) (f.subgroupMap_surjective K) ?_
  rcases quasisimple_normal_subgroups hK (f.subgroupMap K).normal_ker with h | h
  · refine absurd (fun x hx => ?_) hKf
    have hx' : (⟨x, hx⟩ : K) ∈ (f.subgroupMap K).ker := by rw [h]; exact mem_top _
    rw [MonoidHom.mem_ker] at hx' ⊢
    exact congrArg Subtype.val hx'
  · exact h

end CentralExtension

/-! ### Components -/

theorem component_overgroup {K H : Subgroup G} (hK : IsComponent K) (hKH : K ≤ H) :
    IsComponent (K.subgroupOf H) :=
  ⟨isQuasisimple_of_mulEquiv (Subgroup.subgroupOfEquivOfLe hKH).symm hK.1, hK.2.subgroupOf⟩

theorem isComponent_map_mulEquiv {H : Type*} [Group H] (f : G ≃* H) {K : Subgroup G}
    (hK : IsComponent K) : IsComponent (K.map f.toMonoidHom) :=
  ⟨isQuasisimple_of_mulEquiv (K.equivMapOfInjective f.toMonoidHom f.injective) hK.1,
    hK.2.map f.surjective⟩

theorem isComponent_conj {L : Subgroup G} (hL : IsComponent L) (g : G) :
    IsComponent (L.map (MulAut.conj g).toMonoidHom) :=
  isComponent_map_mulEquiv (MulAut.conj g) hL

theorem map_map_symm {H : Type*} [Group H] (f : G ≃* H) (K : Subgroup G) :
    (K.map f.toMonoidHom).map f.symm.toMonoidHom = K := by
  rw [Subgroup.map_map]
  convert Subgroup.map_id K
  ext x
  simp

theorem component_isomorphism {H : Type*} [Group H] (f : G ≃* H) :
    (∀ K : Subgroup G, IsComponent K ↔ IsComponent (K.map f.toMonoidHom)) ∧
      Set.BijOn (fun K : Subgroup G => K.map f.toMonoidHom) {K | IsComponent K}
        {L | IsComponent L} := by
  have hiff : ∀ K : Subgroup G, IsComponent K ↔ IsComponent (K.map f.toMonoidHom) :=
    fun K => ⟨fun hK => isComponent_map_mulEquiv f hK, fun hK => by
      simpa only [map_map_symm] using isComponent_map_mulEquiv f.symm hK⟩
  refine ⟨hiff, fun K hK => (hiff K).mp hK, fun K _ L _ h => ?_, fun L hL => ?_⟩
  · exact Subgroup.map_injective f.injective h
  · refine ⟨L.map f.symm.toMonoidHom, isComponent_map_mulEquiv f.symm hL, ?_⟩
    have := map_map_symm f.symm L
    simpa only [MulEquiv.symm_symm] using this

theorem le_of_subgroupOf_le {K H L : Subgroup G} (hKL : K ≤ L)
    (h : K.subgroupOf L ≤ H.subgroupOf L) : K ≤ H := by
  have := Subgroup.map_mono (f := L.subtype) h
  rw [Subgroup.subgroupOf_map_subtype, Subgroup.subgroupOf_map_subtype,
    inf_eq_left.mpr hKL] at this
  exact this.trans inf_le_left

theorem commutator_inf_eq_bot_of_subgroupOf {K H L : Subgroup G} (hKL : K ≤ L)
    (h : ⁅K.subgroupOf L, H.subgroupOf L⁆ = ⊥) : ⁅K, H ⊓ L⁆ = ⊥ := by
  have := congrArg (Subgroup.map L.subtype) h
  rwa [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype, Subgroup.subgroupOf_map_subtype,
    inf_eq_left.mpr hKL, Subgroup.map_bot] at this

theorem component_normal_subgroup_aux (n : ℕ) :
    ∀ (G : Type u) [Group G] [Finite G], Nat.card G = n → ∀ {K N : Subgroup G},
      IsComponent K → N.Normal → K ≤ N ∨ ⁅K, N⁆ = ⊥ := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro G _ _ hcard K N hK hN
  by_cases hKtop : K = ⊤
  · subst hKtop
    have hQ : IsQuasisimple G := isQuasisimple_of_mulEquiv Subgroup.topEquiv hK.1
    rcases quasisimple_normal_subgroups hQ hN with h | h
    · exact Or.inl (le_of_eq h.symm)
    · exact Or.inr (Subgroup.commutator_top_left_eq_bot_iff_le_center.mpr h)
  obtain ⟨M, hMn, hKM, hMlt⟩ := hK.2.lt_normal.resolve_left hKtop
  have hMcard : Nat.card M < n := by
    rw [← hcard, ← Subgroup.card_top (G := G)]
    exact Subgroup.card_lt_of_lt hMlt
  rcases ih _ hMcard M rfl (component_overgroup hK hKM) (hN.subgroupOf M) with h | h
  · exact Or.inl (le_of_subgroupOf_le hKM h)
  · right
    have hKNM : ⁅K, N ⊓ M⁆ = ⊥ := commutator_inf_eq_bot_of_subgroupOf hKM h
    have hle : ⁅K, N⁆ ≤ N ⊓ M := by
      have : ⁅K, N⁆ ≤ ⁅M, N⁆ := Subgroup.commutator_mono hKM le_rfl
      exact this.trans ((Subgroup.commutator_le_inf M N).trans (inf_comm M N).le)
    have hP : Group.IsPerfect K := hK.1.1
    refine perfect_double_commutator hP (le_bot_iff.mp ?_)
    calc ⁅⁅K, N⁆, K⁆ ≤ ⁅N ⊓ M, K⁆ := Subgroup.commutator_mono hle le_rfl
      _ = ⁅K, N ⊓ M⁆ := Subgroup.commutator_comm _ _
      _ = ⊥ := hKNM

theorem component_normal_subgroup {G : Type u} [Group G] [Finite G] {K N : Subgroup G}
    (hK : IsComponent K) (hN : N.Normal) : K ≤ N ∨ ⁅K, N⁆ = ⊥ :=
  component_normal_subgroup_aux _ G rfl hK hN

theorem component_subnormal_subgroup {G : Type u} [Group G] [Finite G] {K U : Subgroup G}
    (hK : IsComponent K) (hU : U.IsSubnormal) : K ≤ U ∨ ⁅K, U⁆ = ⊥ := by
  induction hU with
  | top => exact Or.inl le_top
  | step A L hAL _ hAn ih =>
    rcases ih with hKL | hKL
    · rcases component_normal_subgroup (component_overgroup hK hKL) hAn with h | h
      · exact Or.inl (le_of_subgroupOf_le hKL h)
      · right
        have := commutator_inf_eq_bot_of_subgroupOf hKL h
        rwa [inf_eq_left.mpr hAL] at this
    · exact Or.inr (le_bot_iff.mp (hKL ▸ Subgroup.commutator_mono le_rfl hAL))

/-- Two components are equal or commute. -/
theorem distinct_components_commute {G : Type u} [Group G] [Finite G] {K L : Subgroup G}
    (hK : IsComponent K) (hL : IsComponent L) : K = L ∨ ⁅K, L⁆ = ⊥ := by
  rcases component_subnormal_subgroup hK hL.2 with hKL | h
  · rcases component_subnormal_subgroup hL hK.2 with hLK | h'
    · exact Or.inl (le_antisymm hKL hLK)
    · right
      rw [Subgroup.commutator_comm]
      exact h'
  · exact Or.inr h

theorem component_commute {G : Type u} [Group G] [Finite G] {L₁ L₂ : Subgroup G}
    (h₁ : IsComponent L₁) (h₂ : IsComponent L₂) (hne : L₁ ≠ L₂) :
    ∀ a ∈ L₁, ∀ b ∈ L₂, a * b = b * a := by
  rcases distinct_components_commute h₁ h₂ with h | h
  · exact absurd h hne
  · intro a ha b hb
    exact (mem_centralizer_iff.1 (commutator_eq_bot_iff_le_centralizer.1 h ha) b hb).symm

/-! ### The layer -/

theorem component_le_layer {K : Subgroup G} (hK : IsComponent K) : K ≤ layer G :=
  le_sSup hK

theorem layer_eq_bot_of_forall (h : ∀ K : Subgroup G, ¬ IsComponent K) : layer G = ⊥ :=
  sSup_eq_bot.mpr fun K hK => absurd hK (h K)

theorem layer_characteristic : (layer G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro φ
  have hbij := (component_isomorphism φ).2
  change MulEquiv.mapSubgroup φ (sSup {K : Subgroup G | IsComponent K}) = layer G
  rw [OrderIso.map_sSup, ← sSup_image]
  exact congrArg sSup hbij.image_eq

instance layer_normal : (layer G).Normal := by
  haveI : (layer G).Characteristic := layer_characteristic
  infer_instance

theorem layer_le_normalizer {G : Type u} [Group G] [Finite G] {K : Subgroup G}
    (hK : IsComponent K) : layer G ≤ normalizer (K : Set G) := by
  refine sSup_le fun L hL => ?_
  rcases distinct_components_commute hL hK with rfl | h
  · exact le_normalizer
  · exact (commutator_eq_bot_iff_le_centralizer.mp h).trans (centralizer_le_normalizer _)

theorem center_component_le_centralizer_layer {G : Type u} [Group G] [Finite G] {K : Subgroup G}
    (hK : IsComponent K) : (center K).map K.subtype ≤ centralizer (layer G : Set G) := by
  rw [le_centralizer_iff]
  refine sSup_le fun L hL => ?_
  rcases distinct_components_commute hL hK with rfl | h
  · intro y hy
    rw [mem_centralizer_iff]
    rintro _ ⟨z, hz, rfl⟩
    exact (congrArg Subtype.val (mem_center_iff.mp hz ⟨y, hy⟩)).symm
  · exact (commutator_eq_bot_iff_le_centralizer.mp h).trans
      (centralizer_le (map_subtype_le (center K)))

/-! ### Multiplying the components into the layer -/

section Multiplication

variable (G) in
/-- The components of `G`, as an index type. Copy of `CFSG.LocalCores.ComponentIndex`,
`CFSG/GroupTheory/LocalCores/Layer.lean` line 68. -/
abbrev ComponentIndex : Type _ := {K : Subgroup G // IsComponent K}

noncomputable instance [Finite G] : Fintype (ComponentIndex G) := Fintype.ofFinite _

noncomputable instance : DecidableEq (ComponentIndex G) := Classical.decEq _

theorem mem_centralizer_layer_of_forall (g : G)
    (h : ∀ C : ComponentIndex G, ∀ c ∈ C.1, g * c = c * g) :
    g ∈ centralizer (layer G : Set G) := by
  have hle : layer G ≤ centralizer ({g} : Set G) := by
    refine sSup_le fun C hC c hc => ?_
    rw [mem_centralizer_singleton_iff]
    exact (h ⟨C, hC⟩ c hc).symm
  exact mem_centralizer_iff.mpr fun x hx => mem_centralizer_singleton_iff.mp (hle hx)

variable {G : Type u} [Group G] [Finite G]

theorem componentIndex_commute :
    Pairwise fun K L : ComponentIndex G => ∀ x y : G, x ∈ K.1 → y ∈ L.1 → Commute x y := by
  intro K L hKL x y hx hy
  rcases distinct_components_commute K.2 L.2 with h | h
  · exact absurd (Subtype.ext h) hKL
  · exact (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp h hx) y hy).symm

variable (G) in
/-- The product map `∏ components → G`. Copy of `CFSG.LocalCores.layerMul`,
`CFSG/GroupTheory/LocalCores/Layer.lean` line 84. -/
noncomputable def layerMul : (∀ K : ComponentIndex G, K.1) →* G :=
  noncommPiCoprod (componentIndex_commute (G := G))

theorem layerMul_apply (x : ∀ K : ComponentIndex G, K.1) :
    layerMul G x = Finset.univ.noncommProd (fun K => (x K : G))
      (fun K _ L _ h => componentIndex_commute h _ _ (x K).2 (x L).2) :=
  noncommPiCoprod_apply _ x

@[simp]
theorem layerMul_mulSingle (K : ComponentIndex G) (k : K.1) :
    layerMul G (Pi.mulSingle K k) = k :=
  noncommPiCoprod_mulSingle K k

theorem layerMul_range : (layerMul G).range = layer G := by
  refine (noncommPiCoprod_range (H := fun K : ComponentIndex G => K.1)).trans ?_
  refine le_antisymm (iSup_le fun K => component_le_layer K.2) (sSup_le fun K hK => ?_)
  exact le_iSup (fun L : ComponentIndex G => L.1) ⟨K, hK⟩

theorem exists_layerMul_eq {g : G} (hg : g ∈ layer G) : ∃ x, layerMul G x = g := by
  rw [← layerMul_range] at hg
  exact hg

theorem layerMul_mem {H : Subgroup G} (x : ∀ K : ComponentIndex G, K.1)
    (hx : ∀ K, (x K : G) ∈ H) : layerMul G x ∈ H := by
  rw [layerMul_apply]
  exact noncommProd_mem H _ fun K _ => hx K

theorem layerMul_eq_mul_update (x : ∀ K : ComponentIndex G, K.1) (K : ComponentIndex G) :
    layerMul G x = (x K : G) * layerMul G (Function.update x K 1) := by
  have hx : Pi.mulSingle K (x K) * Function.update x K 1 = x := by
    funext L
    by_cases h : L = K
    · subst h
      simp
    · simp [Pi.mulSingle_eq_of_ne h, Function.update_of_ne h]
  calc layerMul G x = layerMul G (Pi.mulSingle K (x K) * Function.update x K 1) := by rw [hx]
    _ = _ := by rw [map_mul, layerMul_mulSingle]

theorem commute_layerMul_update (x : ∀ K : ComponentIndex G, K.1) (K : ComponentIndex G)
    {k : G} (hk : k ∈ K.1) : Commute k (layerMul G (Function.update x K 1)) := by
  have h : layerMul G (Function.update x K 1) ∈ centralizer {k} := by
    refine layerMul_mem _ fun L => ?_
    by_cases hL : L = K
    · subst hL
      simp
    · rw [Function.update_of_ne hL, mem_centralizer_singleton_iff]
      exact componentIndex_commute hL _ _ (x L).2 hk
  exact (mem_centralizer_singleton_iff.mp h).symm

theorem commute_layerMul_iff (x : ∀ K : ComponentIndex G, K.1) (K : ComponentIndex G) {k : G}
    (hk : k ∈ K.1) : Commute k (layerMul G x) ↔ Commute k (x K : G) := by
  have hu := commute_layerMul_update x K hk
  rw [layerMul_eq_mul_update x K]
  refine ⟨fun h => ?_, fun h => h.mul_right hu⟩
  have := h.mul_right hu.inv_right
  rwa [mul_inv_cancel_right] at this

theorem layerMul_mem_centralizer_iff (x : ∀ K : ComponentIndex G, K.1) :
    layerMul G x ∈ centralizer (layer G : Set G) ↔ ∀ K, x K ∈ center K.1 := by
  refine ⟨fun h K => mem_center_iff.mpr fun k => Subtype.ext ?_, fun h => ?_⟩
  · have hk : Commute (k : G) (layerMul G x) :=
      mem_centralizer_iff.mp h k (component_le_layer K.2 k.2)
    exact ((commute_layerMul_iff x K k.2).mp hk).eq
  · exact layerMul_mem x fun K =>
      center_component_le_centralizer_layer K.2 (mem_map_of_mem _ (h K))

theorem layerMul_ker_le : (layerMul G).ker ≤ Subgroup.pi Set.univ fun K => center K.1 := by
  intro x hx K _
  have h : layerMul G x ∈ centralizer (layer G : Set G) := by
    rw [MonoidHom.mem_ker.mp hx]
    exact one_mem _
  exact (layerMul_mem_centralizer_iff x).mp h K

variable (G) in
/-- `layerMul` with codomain the layer. Copy of `CFSG.LocalCores.layerMulOnto`,
`CFSG/GroupTheory/LocalCores/Layer.lean` line 166. -/
noncomputable def layerMulOnto : (∀ K : ComponentIndex G, K.1) →* layer G :=
  (layerMul G).codRestrict (layer G) fun x => by
    rw [← layerMul_range]
    exact ⟨x, rfl⟩

@[simp]
theorem layerMulOnto_coe (x : ∀ K : ComponentIndex G, K.1) :
    (layerMulOnto G x : G) = layerMul G x :=
  rfl

theorem layerMulOnto_surjective : Function.Surjective (layerMulOnto G) := fun g => by
  obtain ⟨x, hx⟩ := exists_layerMul_eq g.2
  exact ⟨x, Subtype.ext hx⟩

theorem layerMul_injective (hZ : ∀ C : ComponentIndex G, center C.1 = ⊥) :
    Function.Injective (layerMul G) := by
  rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
  intro x hx
  have h := layerMul_ker_le hx
  rw [Subgroup.mem_bot]
  funext C
  have hC : x C ∈ center C.1 := ((Subgroup.mem_pi Set.univ).1 h) C (Set.mem_univ C)
  rw [hZ C, Subgroup.mem_bot] at hC
  exact hC

/-- When every component has trivial centre, the layer is the direct product of the components. -/
noncomputable def layerEquiv (hZ : ∀ C : ComponentIndex G, center C.1 = ⊥) :
    (∀ C : ComponentIndex G, C.1) ≃* layer G :=
  MulEquiv.ofBijective (layerMulOnto G)
    ⟨fun x y h => layerMul_injective hZ (congrArg Subtype.val h), layerMulOnto_surjective⟩

end Multiplication

