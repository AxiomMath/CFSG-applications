import Mathlib

/-!
# Copied corpus definitions: the Fitting subgroup and `p`-cores

Copied verbatim from AxiomMath/CFSG at commit 69cb972f587a3ecc035e092253167ff2e303c962, under
`CFSGOutside.Corpus`. The clean build proves `fittingSubgroup` equal to its corpus original in
`clean/CFSGOutsideClean/Corpus/Defs/Fitting.lean`. The elementary facts the proofs need are proved here.
-/

namespace CFSGOutside.Corpus

/-- The Fitting subgroup of `G`. Copy of `CFSG.fittingSubgroup`,
`CFSG/ThirdParty/QiuzhenCFSG/FeitThompson/Fitting/Core.lean` line 34. -/
def fittingSubgroup (G : Type*) [Group G] : Subgroup G :=
  sSup {N : Subgroup G | N.Normal ∧ Group.IsNilpotent N}

/-- The `p`-core of `G`: the supremum of all normal `p`-subgroups. Copy of `CFSG.pCore`,
`CFSG/ThirdParty/QiuzhenCFSG/FeitThompson/PCore/Defs.lean` line 30. -/
def pCore (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  sSup {K : Subgroup G | K.Normal ∧ IsPGroup p K}

/-- The subgroup generated by a family of normal subgroups is normal. -/
theorem normal_sSup {G : Type*} [Group G] (S : Set (Subgroup G))
    (h : ∀ H ∈ S, H.Normal) : (sSup S).Normal := by
  have hle : sSup S ≤ (sSup S).normalCore :=
    sSup_le fun H hH => (Subgroup.normal_le_normalCore (hN := h H hH)).mpr (le_sSup hH)
  rw [← le_antisymm (Subgroup.normalCore_le _) hle]
  infer_instance

instance fittingSubgroup_normal {G : Type*} [Group G] : (fittingSubgroup G).Normal :=
  normal_sSup _ fun _ hN => hN.1

instance pCore_normal {p : ℕ} {G : Type*} [Group G] : (pCore p G).Normal :=
  normal_sSup _ fun _ hK => hK.1

theorem pCore_isPGroup {p : ℕ} [Fact p.Prime] {G : Type*} [Group G] :
    IsPGroup p (pCore p G) := by
  let S : Set (Subgroup G) := {K : Subgroup G | K.Normal ∧ IsPGroup p K}
  have hdir : DirectedOn (· ≤ ·) S := by
    rintro K ⟨hKn, hKp⟩ L ⟨hLn, hLp⟩
    haveI := hKn
    haveI := hLn
    exact ⟨K ⊔ L, ⟨inferInstance, hKp.to_sup_of_normal_right hLp⟩,
      le_sup_left, le_sup_right⟩
  have hne : S.Nonempty := ⟨⊥, inferInstance, IsPGroup.of_bot⟩
  rw [IsPGroup.iff_orderOf]
  rintro ⟨x, hx⟩
  obtain ⟨K, ⟨_, hKp⟩, hxK⟩ := (Subgroup.mem_sSup_of_directedOn hne hdir).mp hx
  obtain ⟨k, hk⟩ := (IsPGroup.iff_orderOf.mp hKp) ⟨x, hxK⟩
  refine ⟨k, ?_⟩
  simp only [Subgroup.orderOf_mk] at hk ⊢
  exact hk

end CFSGOutside.Corpus
