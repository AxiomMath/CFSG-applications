import CFSGOutside.Corpus.Defs.ElementaryAbelian

/-!
# Copied corpus definitions: `p`-rank, the Thompson subgroup `J_e`, normal `p`-complements, Sylow subgroups of
subgroups

Verbatim copies, under `CFSGOutside.Corpus`, of definitions from AxiomMath/CFSG at commit
69cb972f587a3ecc035e092253167ff2e303c962. `clean/CFSGOutsideClean/Corpus/Defs/ElemThompson.lean` shows that each
copy equals its original. The elementary facts the proofs need are proved here.
-/

universe u

namespace CFSGOutside.Corpus

open Subgroup

/-- The `p`-rank: the largest `r` with an elementary abelian subgroup of order `p ^ r`. Copy of `CFSG.pRank`,
`CFSG/Foundations/Basic.lean` line 83. -/
noncomputable def pRank (p : ℕ) (H : Type*) [Group H] : ℕ :=
  sSup {r : ℕ | ∃ A : Subgroup H, IsElementaryAbelian p A ∧ Nat.card A = p ^ r}

variable (G : Type*) [Group G]

/-- The elementary abelian subgroups of maximal rank. Copy of `CFSG.elemThompsonFamily`,
`CFSG/Foundations/Basic.lean` line 136. -/
def elemThompsonFamily (p : ℕ) : Set (Subgroup G) :=
  {A | IsElementaryAbelian p A ∧ Nat.card A = p ^ pRank p G}

/-- The Thompson subgroup `J_e(G)`, generated by the elementary abelian subgroups of maximal rank. Copy of
`CFSG.elemThompson`, `CFSG/Foundations/Basic.lean` line 140. -/
def elemThompson (p : ℕ) : Subgroup G :=
  sSup (elemThompsonFamily G p)

/-- `G` has a normal `p`-complement: a normal subgroup of `p'`-order with `p`-group quotient. Copy of
`CFSG.HasNormalPComplement`, `CFSG/ThirdParty/QiuzhenCFSG/FeitThompson/BGsection1/Defs.lean` line 140. -/
def HasNormalPComplement (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ (N : Subgroup G) (_ : N.Normal), Nat.Coprime p (Nat.card N) ∧ IsPGroup p (G ⧸ N)

/-- `P` is a Sylow `p`-subgroup of `K`. Copy of `CFSG.ABGLocalTools.IsSylowOf`,
`CFSG/GroupTheory/ABGLocalTools/Basic.lean` line 13. -/
def ABGLocalTools.IsSylowOf {G : Type*} [Group G] (p : ℕ) (P K : Subgroup G) : Prop :=
  ∃ Q : Sylow p K, (Q : Subgroup K).map K.subtype = P

variable {G}

theorem IsElementaryAbelian.of_mulEquiv {p : ℕ} {H K : Type*} [Group H] [Group K] (e : H ≃* K)
    (h : IsElementaryAbelian p H) : IsElementaryAbelian p K where
  toIsMulCommutative := ⟨⟨fun a b => e.symm.injective (by
    rw [map_mul, map_mul]
    exact h.toIsMulCommutative.is_comm.comm _ _)⟩⟩
  exponent_dvd_p := by
    rw [← Monoid.exponent_eq_of_mulEquiv e]
    exact h.exponent_dvd_p

theorem IsElementaryAbelian.isPGroup (p : ℕ) (H : Type u) [Group H] [IsElementaryAbelian p H] :
    IsPGroup p H :=
  fun _ => ⟨1, by
    rcases IsElementaryAbelian.exponent_dvd_p p H with ⟨_, rfl⟩
    rw [pow_one, pow_mul, Monoid.pow_exponent_eq_one, one_pow]⟩

theorem IsElementaryAbelian.zpowers_of_pow_eq_one {p : ℕ} {x : G} (hxpow : x ^ p = 1) :
    IsElementaryAbelian p (Subgroup.zpowers x) := by
  refine
    { toIsMulCommutative := Subgroup.zpowers_isMulCommutative x
      exponent_dvd_p := ?_ }
  refine Monoid.exponent_dvd_iff_forall_pow_eq_one.2 ?_
  intro y
  apply Subtype.ext
  have hy_dvd : orderOf ((y : Subgroup.zpowers x) : G) ∣ p :=
    (orderOf_dvd_of_mem_zpowers y.2).trans (orderOf_dvd_of_pow_eq_one hxpow)
  simpa using (orderOf_dvd_iff_pow_eq_one.mp hy_dvd)

theorem isElementaryAbelian_bot (p : ℕ) : IsElementaryAbelian p (⊥ : Subgroup G) where
  toIsMulCommutative := ⟨⟨fun a b => Subsingleton.elim _ _⟩⟩
  exponent_dvd_p := Monoid.exponent_dvd_of_forall_pow_eq_one fun g => Subsingleton.elim _ _

theorem mem_pRank_set_map {p r : ℕ} {H : Type*} [Group H] (e : G ≃* H)
    (h : r ∈ {r : ℕ | ∃ A : Subgroup G, IsElementaryAbelian p A ∧ Nat.card A = p ^ r}) :
    r ∈ {r : ℕ | ∃ A : Subgroup H, IsElementaryAbelian p A ∧ Nat.card A = p ^ r} := by
  obtain ⟨A, hA, hc⟩ := h
  exact ⟨A.map e.toMonoidHom, hA.of_mulEquiv (A.equivMapOfInjective _ e.injective), by
    rw [Subgroup.card_map_of_injective e.injective, hc]⟩

theorem pRank_congr_of_mulEquiv {H : Type*} [Group H] (e : G ≃* H) (p : ℕ) :
    pRank p G = pRank p H := by
  unfold pRank
  congr 1
  ext r
  exact ⟨mem_pRank_set_map e, mem_pRank_set_map e.symm⟩

theorem mem_elemThompsonFamily_map_mulEquiv {H : Type*} [Group H] (e : G ≃* H)
    (p : ℕ) {A : Subgroup G} (hA : A ∈ elemThompsonFamily G p) :
    A.map e.toMonoidHom ∈ elemThompsonFamily H p :=
  ⟨hA.1.of_mulEquiv (A.equivMapOfInjective _ e.injective), by
    rw [Subgroup.card_map_of_injective e.injective, hA.2, pRank_congr_of_mulEquiv e p]⟩

theorem elemThompson_map_mulEquiv {H : Type*} [Group H] (e : G ≃* H) (p : ℕ) :
    (elemThompson G p).map e.toMonoidHom = elemThompson H p := by
  apply le_antisymm
  · rw [Subgroup.map_le_iff_le_comap]
    refine sSup_le fun A hA => ?_
    rw [← Subgroup.map_le_iff_le_comap]
    exact le_sSup (mem_elemThompsonFamily_map_mulEquiv e p hA)
  · refine sSup_le fun B hB => ?_
    have hB' : B.map e.symm.toMonoidHom ∈ elemThompsonFamily G p :=
      mem_elemThompsonFamily_map_mulEquiv e.symm p hB
    intro y hy
    have : e.symm y ∈ elemThompson G p := le_sSup hB' ⟨y, hy, rfl⟩
    exact ⟨e.symm y, this, e.apply_symm_apply y⟩

section Finite

variable (R : Type*) [Group R] [Finite R] (p : ℕ) [Fact p.Prime]

theorem bddAbove_pRank_set :
    BddAbove {r : ℕ | ∃ A : Subgroup R, IsElementaryAbelian p A ∧ Nat.card A = p ^ r} := by
  refine ⟨Nat.card R, ?_⟩
  rintro r ⟨A, -, hA⟩
  have h1 : r < p ^ r := Nat.lt_pow_self (Fact.out : p.Prime).one_lt
  have h2 : p ^ r ≤ Nat.card R := hA ▸ A.card_le_card_group
  omega

variable {R p} in
theorem card_le_pow_pRank {A : Subgroup R} (hA : IsElementaryAbelian p A) :
    Nat.card A ≤ p ^ pRank p R := by
  obtain ⟨k, hk⟩ := IsPGroup.iff_card.mp (IsElementaryAbelian.isPGroup p A)
  have hk' : k ≤ pRank p R := le_csSup (bddAbove_pRank_set R p) ⟨A, hA, hk⟩
  rw [hk]
  exact Nat.pow_le_pow_right (Fact.out : p.Prime).pos hk'

theorem exists_card_eq_pow_pRank :
    ∃ A : Subgroup R, IsElementaryAbelian p A ∧ Nat.card A = p ^ pRank p R := by
  have hne : {r : ℕ | ∃ A : Subgroup R, IsElementaryAbelian p A ∧ Nat.card A = p ^ r}.Nonempty :=
    ⟨0, ⊥, isElementaryAbelian_bot p, by simp⟩
  exact Nat.sSup_mem hne (bddAbove_pRank_set R p)

end Finite

namespace ABGLocalTools

/-! ### Sylow subgroups of subgroups, with the corpus proofs from `CFSG/GroupTheory/ABGLocalTools/Basic.lean` -/

variable {G : Type*} [Group G]

theorem relIndex_sup_eq_relIndex_of_normal [Finite G] (N P : Subgroup G) [N.Normal] :
    P.relIndex (N ⊔ P) = P.relIndex N := by
  have h1 := Subgroup.relIndex_mul_card P (N ⊔ P)
  have h2 := Subgroup.relIndex_mul_card N (N ⊔ P)
  have h3 := Subgroup.relIndex_mul_card N P
  have h4 := Subgroup.relIndex_mul_card P N
  have h5 : N.relIndex (N ⊔ P) = N.relIndex P := Subgroup.relIndex_sup_left P N
  rw [inf_eq_left.mpr (le_sup_right : P ≤ N ⊔ P)] at h1
  rw [inf_eq_left.mpr (le_sup_left : N ≤ N ⊔ P), h5] at h2
  rw [inf_comm] at h4
  have hpos : 0 < N.relIndex P * Nat.card (N ⊓ P : Subgroup G) := by
    rw [h3]
    exact Nat.card_pos
  apply Nat.eq_of_mul_eq_mul_right hpos
  calc P.relIndex (N ⊔ P) * (N.relIndex P * Nat.card (N ⊓ P : Subgroup G))
      = P.relIndex (N ⊔ P) * Nat.card P := by rw [h3]
    _ = N.relIndex P * Nat.card N := by rw [h1, h2]
    _ = P.relIndex N * (N.relIndex P * Nat.card (N ⊓ P : Subgroup G)) := by
        rw [← h4]
        ring

namespace IsSylowOf

variable {p : ℕ} {P K N : Subgroup G}

theorem le (h : IsSylowOf p P K) : P ≤ K := by
  obtain ⟨Q, rfl⟩ := h
  exact Subgroup.map_subtype_le _

theorem isPGroup (h : IsSylowOf p P K) : IsPGroup p P := by
  obtain ⟨Q, rfl⟩ := h
  exact Q.isPGroup'.map K.subtype

theorem exists_sylow_eq_subgroupOf (h : IsSylowOf p P K) :
    ∃ Q : Sylow p K, (Q : Subgroup K) = P.subgroupOf K := by
  obtain ⟨Q, rfl⟩ := h
  refine ⟨Q, ?_⟩
  rw [Subgroup.subgroupOf, Subgroup.comap_map_eq_self_of_injective K.subtype_injective]

end IsSylowOf

variable {p : ℕ}

theorem isSylowOf_iff [Finite G] [Fact p.Prime] {P K : Subgroup G} :
    IsSylowOf p P K ↔ P ≤ K ∧ IsPGroup p P ∧ ¬ p ∣ P.relIndex K := by
  constructor
  · intro h
    refine ⟨h.le, h.isPGroup, ?_⟩
    obtain ⟨Q, hQ⟩ := h.exists_sylow_eq_subgroupOf
    have := Q.not_dvd_index
    rwa [hQ] at this
  · rintro ⟨hle, hP, hdvd⟩
    have hP' : IsPGroup p (P.subgroupOf K) := hP.comap_subtype
    have hdvd' : ¬ p ∣ (P.subgroupOf K).index := hdvd
    refine ⟨hP'.toSylow hdvd', ?_⟩
    rw [IsPGroup.toSylow_coe, Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr hle]

theorem IsSylowOf.inf_of_le_normalizer [Finite G] [Fact p.Prime] {P K N : Subgroup G}
    (h : IsSylowOf p P K) (hNK : N ≤ K) (hKN : K ≤ normalizer (N : Set G)) :
    IsSylowOf p (P ⊓ N) N := by
  rw [isSylowOf_iff] at h ⊢
  obtain ⟨_, hP, hdvd⟩ := h
  refine ⟨inf_le_right, hP.to_inf_left, ?_⟩
  rw [Subgroup.inf_relIndex_right]
  have : (N.subgroupOf K).Normal := (Subgroup.normal_subgroupOf_iff_le_normalizer hNK).mpr hKN
  rw [← Subgroup.relIndex_subgroupOf hNK,
    ← relIndex_sup_eq_relIndex_of_normal (N.subgroupOf K) (P.subgroupOf K)]
  intro hdvd'
  exact hdvd (hdvd'.trans (Subgroup.relIndex_dvd_index_of_le le_sup_right))

end ABGLocalTools

end CFSGOutside.Corpus
