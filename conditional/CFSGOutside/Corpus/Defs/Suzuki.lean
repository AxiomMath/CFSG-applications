import Mathlib

/-!
# Copied corpus definitions: the Suzuki groups

Verbatim copies, under `CFSGOutside.Corpus`, of the definitions in `CFSG/Blueprint/Catalog.lean` (lines 93–124)
and `CFSG/Quasithin/Background/A3StructureDefs.lean` (line 59) at AxiomMath/CFSG commit
69cb972f587a3ecc035e092253167ff2e303c962. `clean/CFSGOutsideClean/Corpus/Defs/Suzuki.lean` shows each copy
equals its original.
-/

noncomputable section

namespace CFSGOutside.Corpus

section Suzuki

variable (a : ℕ) {K : Type} [Field K]

/-- The function `N(u, v)` in the Suzuki matrix `S(u, v)`, `CFSG.Blueprint.suzukiN`. -/
def suzukiN (u v : K) : K :=
  u ^ (2 ^ (a + 1) + 2) + u * v + v ^ 2 ^ (a + 1)

/-- The unipotent matrix `S(u, v)` of the Suzuki group, `CFSG.Blueprint.suzukiS`. -/
def suzukiS (u v : K) : Matrix (Fin 4) (Fin 4) K :=
  !![1, 0, 0, 0;
    u, 1, 0, 0;
    v, u ^ 2 ^ (a + 1), 1, 0;
    suzukiN a u v, u ^ (2 ^ (a + 1) + 1) + v, u, 1]

/-- The diagonal matrix `D(λ)` of the Suzuki group, `CFSG.Blueprint.suzukiD`. -/
def suzukiD (l : Kˣ) : Matrix (Fin 4) (Fin 4) K :=
  Matrix.diagonal ![((l ^ (1 + (2 ^ a : ℤ)) : Kˣ) : K), ((l ^ (2 ^ a : ℤ) : Kˣ) : K),
    ((l ^ (-(2 ^ a : ℤ)) : Kˣ) : K), ((l ^ (-1 - (2 ^ a : ℤ)) : Kˣ) : K)]

variable (K) in
/-- The antidiagonal matrix `W` of the Suzuki group, `CFSG.Blueprint.suzukiW`. -/
def suzukiW : Matrix (Fin 4) (Fin 4) K :=
  Matrix.of fun i j => if i.val + j.val = 3 then 1 else 0

variable (K) in
/-- The Suzuki group `Sz_a(K) ≤ GL₄(K)`, generated by `S(u, v)`, `D(λ)` and `W`, `CFSG.Blueprint.suzukiGroup`.
For `|K| = 2 ^ (2a+1)` this is `Sz(q)` with `q = 2 ^ (2a+1)`. -/
def suzukiGroup : Subgroup (Matrix.GeneralLinearGroup (Fin 4) K) :=
  Subgroup.closure {g | (∃ u v : K, (g : Matrix (Fin 4) (Fin 4) K) = suzukiS a u v) ∨
    (∃ l : Kˣ, (g : Matrix (Fin 4) (Fin 4) K) = suzukiD a l) ∨
    (g : Matrix (Fin 4) (Fin 4) K) = suzukiW K}

end Suzuki

/-- `G` is isomorphic to a Suzuki group `Sz_a(K)` with `|K| = 2 ^ f` and `f = 2a + 1`, `a ≥ 1`,
`CFSG.Blueprint.SuzukiModel`. -/
def SuzukiModel (G : Type) [Group G] (p f : ℕ) : Prop :=
  p = 2 ∧ ∃ a : ℕ, 1 ≤ a ∧ ∃ (K : Type) (_ : Field K) (_ : Finite K),
    f = 2 * a + 1 ∧ Nat.card K = 2 ^ f ∧ Nonempty (G ≃* suzukiGroup a K)

/-- `X ≅ Sz(2 ^ e)`, `CFSG.Quasithin.IsSz`. -/
def IsSz (e : ℕ) (X : Type) [Group X] : Prop := SuzukiModel X 2 e

end CFSGOutside.Corpus

end
