import CFSGOutside.HallOrthogonal.Basic

/-!
# Hall (2008), Theorem 1.1, orthogonal case: the groups generated by a class of reflections

Over a finite field of characteristic not `2` or `3`, let `C` be the subgroup of `O(V)` generated by the
reflections in vectors of norm `c ≠ 0`. With the spinor norm `θ`, `C` is the kernel of `θ` when `c` is a
square, and the kernel of the product of `θ` and the determinant otherwise. Moreover `C` has index at most two
in `O(V)`. This rests on Cartan–Dieudonné (TauCeti) and on the corpus lemma that a product of two
reflections of equal norm lies in `C` (`Corpus.ReflectMulReflectClosure`).
-/

namespace CFSGOutside.HallOrthogonal

open Module QuadraticMap TauCeti
open CFSGOutside.Corpus.ClassicalGroups.Orthogonal (reflect)

variable {K V : Type} [Field K] [AddCommGroup V] [Module K V] {Q : QuadraticForm K V}

/-- The subgroup generated by the reflections in vectors of norm `c`. -/
def classClosure (Q : QuadraticForm K V) (c : K) : Subgroup (V ≃ₗ[K] V) :=
  Subgroup.closure (reflect Q '' {x | Q x = c})

theorem classClosure_le (c : K) : classClosure Q c ≤ orthGroup Q :=
  (Subgroup.closure_le _).2 (by rintro _ ⟨x, -, rfl⟩; exact reflect_mem Q x)

theorem conj_mem_classClosure {g h : V ≃ₗ[K] V} {c : K} (hg : g ∈ orthGroup Q)
    (hh : h ∈ classClosure Q c) : g * h * g⁻¹ ∈ classClosure Q c := by
  induction hh using Subgroup.closure_induction with
  | mem t ht =>
    obtain ⟨x, hx, rfl⟩ := ht
    rw [reflect_conj hg]
    refine Subgroup.subset_closure ⟨g x, ?_, rfl⟩
    rw [Set.mem_setOf_eq, TauCeti.QuadraticMap.map_app_of_mem_orthogonalGroup hg]
    exact hx
  | one => simp
  | mul a b _ _ ha hb =>
    have : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [this]; exact Subgroup.mul_mem _ ha hb
  | inv a _ ha =>
    have : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [this]; exact Subgroup.inv_mem _ ha

/-- A reflection whose norm lies in the square class of `c` belongs to `classClosure Q c`. -/
theorem reflect_mem_classClosure {c : K} (hc : c ≠ 0) {y : V} (hy : Q y ≠ 0)
    (hsq : IsSquare (c * Q y)) : reflect Q y ∈ classClosure Q c := by
  obtain ⟨r, hr⟩ := hsq
  have hr0 : r ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hr
    exact mul_ne_zero hc hy hr
  have ht : r / Q y ≠ 0 := div_ne_zero hr0 hy
  rw [← reflect_smul Q ht y]
  refine Subgroup.subset_closure ⟨_, ?_, rfl⟩
  rw [Set.mem_setOf_eq, QuadraticMap.map_smul, smul_eq_mul]
  field_simp
  linear_combination (-1 : K) * hr

section Finite

variable [Fintype K] [DecidableEq K] [FiniteDimensional K V]

theorem isSquare_mul_of_not (a b : K) (ha : a ≠ 0) (hb : b ≠ 0) (hna : ¬ IsSquare a)
    (hnb : ¬ IsSquare b) : IsSquare (a * b) := by
  rw [← quadraticChar_one_iff_isSquare (mul_ne_zero ha hb), map_mul,
    quadraticChar_neg_one_iff_not_isSquare.2 hna, quadraticChar_neg_one_iff_not_isSquare.2 hnb]
  norm_num

variable [hR : CFSGOutside.Corpus.ReflectMulReflectClosure]
  (h2 : (2 : K) ≠ 0) (h3 : (3 : K) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
include hR h2 h3 hQ

/-- Two reflections outside the square class of `c` have product in `classClosure Q c`. -/
theorem reflect_mul_mem_classClosure {c : K} (hc : c ≠ 0) {e y : V} (he : Q e ≠ 0) (hy : Q y ≠ 0)
    (hne : ¬ IsSquare (c * Q e)) (hny : ¬ IsSquare (c * Q y)) :
    reflect Q e * reflect Q y ∈ classClosure Q c := by
  have hsq : IsSquare (Q e * Q y) := by
    have := isSquare_mul_of_not _ _ (mul_ne_zero hc he) (mul_ne_zero hc hy) hne hny
    obtain ⟨r, hr⟩ := this
    refine ⟨r / c, ?_⟩
    field_simp
    linear_combination hr
  obtain ⟨r, hr⟩ := hsq
  have hr0 : r ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hr
    exact mul_ne_zero he hy hr
  have ht : r / Q y ≠ 0 := div_ne_zero hr0 hy
  have hQ' : Q e = Q ((r / Q y) • y) := by
    rw [QuadraticMap.map_smul, smul_eq_mul]
    field_simp
    linear_combination hr
  rw [← reflect_smul Q ht y]
  exact hR.reflect_mul_reflect_mem_closure_reflect h2 h3 hQ hQ' hc

/-- `classClosure Q c` has index at most two in `O(V)`: some `s ∈ O(V)` has `O(V) = C ∪ sC`. -/
theorem exists_index_two {c : K} (hc : c ≠ 0) :
    ∃ s ∈ orthGroup Q, s * s = 1 ∧ (∀ g ∈ orthGroup Q, g ∈ classClosure Q c ∨ s * g ∈ classClosure Q c) ∧
      (s ∉ classClosure Q c → ∃ e, Q e ≠ 0 ∧ ¬ IsSquare (c * Q e) ∧ s = reflect Q e) := by
  have hinv : Invertible (2 : K) := invertibleOfNonzero h2
  have hQnd : Q.Nondegenerate := QuadraticMap.nondegenerate_polar_iff.mp hQ
  -- the reflection to multiply by
  obtain ⟨s, hsO, hss, hsC, hsform⟩ : ∃ s ∈ orthGroup Q, s * s = 1 ∧
      (∀ y, Q y ≠ 0 → reflect Q y ∈ classClosure Q c ∨ s * reflect Q y ∈ classClosure Q c) ∧
      (s ∉ classClosure Q c → ∃ e, Q e ≠ 0 ∧ ¬ IsSquare (c * Q e) ∧ s = reflect Q e) := by
    by_cases hex : ∃ e, Q e ≠ 0 ∧ ¬ IsSquare (c * Q e)
    · obtain ⟨e, he, hne⟩ := hex
      refine ⟨reflect Q e, reflect_mem Q e, reflect_mul_self Q e, fun y hy => ?_,
        fun _ => ⟨e, he, hne, rfl⟩⟩
      by_cases hsy : IsSquare (c * Q y)
      · exact Or.inl (reflect_mem_classClosure hc hy hsy)
      · exact Or.inr (reflect_mul_mem_classClosure h2 h3 hQ hc he hy hne hsy)
    · push Not at hex
      refine ⟨1, (orthGroup Q).one_mem, one_mul 1, fun y hy => Or.inl
        (reflect_mem_classClosure hc hy (hex y hy)), fun h => absurd (classClosure Q c).one_mem h⟩
  refine ⟨s, hsO, hss, fun g hg => ?_, hsform⟩
  have hsinv : s⁻¹ = s := inv_eq_of_mul_eq_one_left hss
  obtain ⟨l, hl, -, hprod⟩ :=
    TauCeti.QuadraticMap.exists_reflectionOrthogonal_list_prod_eq Q hQnd ⟨g, hg⟩
  have hgl : g = ((l.prod : orthGroup Q) : V ≃ₗ[K] V) := by rw [hprod]
  rw [hgl]
  clear hgl hprod
  induction l with
  | nil => exact Or.inl (by simpa using (classClosure Q c).one_mem)
  | cons r l ih =>
    obtain ⟨v, x, hrv⟩ := hl r List.mem_cons_self
    have hv : Q v ≠ 0 := (isUnit_of_invertible (Q v)).ne_zero
    have hr : (r : V ≃ₗ[K] V) = reflect Q v := by
      rw [← hrv, TauCeti.QuadraticMap.coe_reflectionOrthogonal]
      simp only [reflect, dif_pos hv]
      congr
      exact Subsingleton.elim _ _
    rw [List.prod_cons, Subgroup.coe_mul, hr]
    have hcon : ∀ h ∈ classClosure Q c, s * h * s⁻¹ ∈ classClosure Q c :=
      fun h hh => conj_mem_classClosure hsO hh
    set L := ((l.prod : orthGroup Q) : V ≃ₗ[K] V)
    rcases hsC v hv with hrC | hrC <;>
      rcases ih (fun r' hr' => hl r' (List.mem_cons_of_mem r hr')) with hlC | hlC
    · exact Or.inl ((classClosure Q c).mul_mem hrC hlC)
    · right
      have e : s * (reflect Q v * L) = (s * reflect Q v * s⁻¹) * (s * L) := by group
      rw [e]
      exact (classClosure Q c).mul_mem (hcon _ hrC) hlC
    · right
      rw [← mul_assoc]
      exact (classClosure Q c).mul_mem hrC hlC
    · left
      have e : (s * (s * reflect Q v) * s⁻¹) * (s * L) = reflect Q v * L := by
        rw [show (s * (s * reflect Q v) * s⁻¹) * (s * L) = (s * s) * reflect Q v * (s⁻¹ * s) * L by
          group, hss, inv_mul_cancel, one_mul, mul_one]
      rw [← e]
      exact (classClosure Q c).mul_mem (hcon _ hrC) hlC

end Finite

section SpinorNorm

variable [FiniteDimensional K V] [Invertible (2 : K)]

theorem spinorNorm_reflect (hQnd : Q.Nondegenerate) {v : V} (hv : Q v ≠ 0) :
    CliffordAlgebra.orthogonalSpinorNorm Q hQnd ⟨reflect Q v, reflect_mem Q v⟩ =
      squareClassHom (Units.mk0 (Q v) hv) := by
  letI : Invertible (Q v) := invertibleOfNonzero hv
  have : (⟨reflect Q v, reflect_mem Q v⟩ : orthGroup Q) =
      TauCeti.QuadraticMap.reflectionOrthogonal Q v := by
    apply Subtype.ext
    rw [TauCeti.QuadraticMap.coe_reflectionOrthogonal]
    simp only [reflect, dif_pos hv]
  rw [this, CliffordAlgebra.orthogonalSpinorNorm_reflectionOrthogonal]
  congr 1

theorem squareClassHom_eq_one_iff {a : K} (ha : a ≠ 0) :
    squareClassHom (Units.mk0 a ha) = 1 ↔ IsSquare a := by
  rw [← MonoidHom.mem_ker, ker_squareClassHom, Subgroup.mem_square]
  constructor
  · rintro ⟨r, hr⟩
    exact ⟨r, by simpa using congrArg Units.val hr⟩
  · rintro ⟨r, hr⟩
    have hr0 : r ≠ 0 := by rintro rfl; exact ha (by simpa using hr)
    exact ⟨Units.mk0 r hr0, Units.ext (by simpa using hr)⟩

end SpinorNorm


section Kernel

variable [Fintype K] [DecidableEq K] [FiniteDimensional K V] [Invertible (2 : K)]
  [hR : CFSGOutside.Corpus.ReflectMulReflectClosure]
  (h2 : (2 : K) ≠ 0) (h3 : (3 : K) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
include hR h2 h3 hQ

/-- The square class of a nonzero scalar. -/
noncomputable abbrev sc (a : K) (ha : a ≠ 0) : Multiplicative (SquareClassGroup K) :=
  squareClassHom (Units.mk0 a ha)

omit hR h2 h3 hQ in
theorem sc_mul_self (a : K) (ha : a ≠ 0) : sc a ha * sc a ha = 1 := by
  have : Units.mk0 a ha * Units.mk0 a ha = Units.mk0 (a * a) (mul_ne_zero ha ha) := Units.ext rfl
  rw [sc, ← map_mul, this, squareClassHom_eq_one_iff]
  exact ⟨a, rfl⟩

omit hR h3 hQ in
theorem neg_one_ne_one_units : (-1 : Kˣ) ≠ 1 := by
  intro h
  have := congrArg Units.val h
  simp only [Units.val_neg, Units.val_one] at this
  apply h2
  linear_combination -this

/-- The class closure is described by the spinor norm and the determinant. -/
theorem classClosure_spinor {c : K} (hc : c ≠ 0) :
    ∀ g (hg : g ∈ orthGroup Q),
      (g ∈ classClosure Q c ↔
        ((CliffordAlgebra.orthogonalSpinorNorm Q (QuadraticMap.nondegenerate_polar_iff.mp hQ)
          ⟨g, hg⟩ = 1 ∧ LinearEquiv.det g = 1) ∨
        (CliffordAlgebra.orthogonalSpinorNorm Q (QuadraticMap.nondegenerate_polar_iff.mp hQ)
          ⟨g, hg⟩ = sc c hc ∧ LinearEquiv.det g = -1))) := by
  set hQnd := QuadraticMap.nondegenerate_polar_iff.mp hQ
  set θ := CliffordAlgebra.orthogonalSpinorNorm Q hQnd
  have hcc := sc_mul_self c hc
  -- the forward direction, by closure induction
  have fwd : ∀ g ∈ classClosure Q c, ∀ hg : g ∈ orthGroup Q,
      (θ ⟨g, hg⟩ = 1 ∧ LinearEquiv.det g = 1) ∨ (θ ⟨g, hg⟩ = sc c hc ∧ LinearEquiv.det g = -1) := by
    intro g hgC
    induction hgC using Subgroup.closure_induction with
    | mem t ht =>
      obtain ⟨x, hx, rfl⟩ := ht
      intro hg
      have hx0 : Q x ≠ 0 := by rw [Set.mem_setOf_eq.mp hx]; exact hc
      right
      refine ⟨?_, det_reflect hx0⟩
      rw [spinorNorm_reflect hQnd hx0]
      congr 1
      exact Units.ext (Set.mem_setOf_eq.mp hx)
    | one =>
      intro hg
      left
      refine ⟨?_, map_one _⟩
      have : (⟨1, hg⟩ : orthGroup Q) = 1 := rfl
      rw [this, map_one]
    | mul a b haC hbC ha hb =>
      intro hg
      have haO := classClosure_le c haC
      have hbO := classClosure_le c hbC
      have hθ : θ ⟨a * b, hg⟩ = θ ⟨a, haO⟩ * θ ⟨b, hbO⟩ := by
        rw [← map_mul]; rfl
      rw [hθ, map_mul]
      rcases ha haO with ⟨h1, h2'⟩ | ⟨h1, h2'⟩ <;> rcases hb hbO with ⟨h3', h4⟩ | ⟨h3', h4⟩
      · left; rw [h1, h3', h2', h4, one_mul, one_mul]; exact ⟨rfl, rfl⟩
      · right; rw [h1, h3', h2', h4, one_mul, one_mul]; exact ⟨rfl, rfl⟩
      · right; rw [h1, h3', h2', h4, mul_one, mul_one]; exact ⟨rfl, rfl⟩
      · left; rw [h1, h3', h2', h4, hcc, neg_one_mul, neg_neg]; exact ⟨rfl, rfl⟩
    | inv a haC ha =>
      intro hg
      have haO := classClosure_le c haC
      have hθ : θ ⟨a⁻¹, hg⟩ = (θ ⟨a, haO⟩)⁻¹ := by
        rw [← map_inv]; rfl
      rw [hθ, map_inv]
      rcases ha haO with ⟨h1, h2'⟩ | ⟨h1, h2'⟩
      · left; rw [h1, h2', inv_one, inv_one]; exact ⟨rfl, rfl⟩
      · right
        rw [h1, h2', inv_neg_one]
        refine ⟨?_, rfl⟩
        rw [inv_eq_of_mul_eq_one_left hcc]
  intro g hg
  refine ⟨fun h => fwd g h hg, fun hP => ?_⟩
  by_contra hgC
  obtain ⟨s, hsO, hss, hdec, hsform⟩ := exists_index_two h2 h3 hQ hc
  have hsg : s * g ∈ classClosure Q c := (hdec g hg).resolve_left hgC
  have hsC : s ∉ classClosure Q c := by
    intro hsC
    apply hgC
    have := (classClosure Q c).mul_mem ((classClosure Q c).inv_mem hsC) hsg
    rwa [inv_mul_cancel_left] at this
  obtain ⟨e, he, hne, rfl⟩ := hsform hsC
  have hθg : θ ⟨reflect Q e * g, (orthGroup Q).mul_mem hsO hg⟩ = sc (Q e) he * θ ⟨g, hg⟩ := by
    rw [show sc (Q e) he = θ ⟨reflect Q e, reflect_mem Q e⟩ from
      (spinorNorm_reflect hQnd he).symm, ← map_mul]; rfl
  have hdg : LinearEquiv.det (reflect Q e * g) = -LinearEquiv.det g := by
    rw [map_mul, det_reflect he, neg_one_mul]
  have hP' := fwd _ hsg ((orthGroup Q).mul_mem hsO hg)
  rw [hθg, hdg] at hP'
  -- the class of `Q e` differs from that of `c`
  have hne' : sc (Q e) he ≠ sc c hc := by
    intro h
    apply hne
    have := congrArg (· * sc c hc) h
    rw [hcc, ← map_mul] at this
    have h1 := (squareClassHom_eq_one_iff (mul_ne_zero he hc)).1 (by rw [← this]; congr 1; exact Units.ext rfl)
    rwa [mul_comm] at h1
  have hn1 := neg_one_ne_one_units h2
  rcases hP with ⟨h1, h1'⟩ | ⟨h1, h1'⟩ <;> rcases hP' with ⟨h3', h4⟩ | ⟨h3', h4⟩
  · rw [h1'] at h4; exact hn1 h4
  · rw [h1, mul_one] at h3'; exact hne' h3'
  · apply hne'
    rw [h1] at h3'
    calc sc (Q e) he = sc (Q e) he * sc c hc * sc c hc := by rw [mul_assoc, hcc, mul_one]
      _ = sc c hc := by rw [h3', one_mul]
  · rw [h1', neg_neg] at h4
    exact hn1 h4.symm


theorem det_eq_one_or_neg_one {g : V ≃ₗ[K] V} (hg : g ∈ orthGroup Q) :
    LinearEquiv.det g = 1 ∨ LinearEquiv.det g = -1 := by
  have h1 : (1 : K) ≠ 0 := one_ne_zero
  have hdC : ∀ h ∈ classClosure Q 1, LinearEquiv.det h = 1 ∨ LinearEquiv.det h = -1 := by
    intro h hh
    rcases (classClosure_spinor h2 h3 hQ h1 h (classClosure_le 1 hh)).1 hh with ⟨-, hd⟩ | ⟨-, hd⟩
    · exact Or.inl hd
    · exact Or.inr hd
  obtain ⟨s, hsO, hss, hdec, hsform⟩ := exists_index_two h2 h3 hQ h1
  rcases hdec g hg with hgC | hsg
  · exact hdC g hgC
  · by_cases hsC : s ∈ classClosure Q 1
    · have := (classClosure Q 1).mul_mem ((classClosure Q 1).inv_mem hsC) hsg
      rw [inv_mul_cancel_left] at this
      exact hdC g this
    · obtain ⟨e, he, -, rfl⟩ := hsform hsC
      have hd : LinearEquiv.det (reflect Q e * g) = -LinearEquiv.det g := by
        rw [map_mul, det_reflect he, neg_one_mul]
      rcases hdC _ hsg with h | h <;> rw [hd] at h
      · right; rw [← neg_neg (LinearEquiv.det g), h]
      · left; rw [← neg_neg (LinearEquiv.det g), h, neg_neg]

theorem eq_sc_of_ne_one {c : K} (hc : c ≠ 0) (hcns : ¬ IsSquare c) (y : Multiplicative (SquareClassGroup K))
    (hy : y ≠ 1) : y = sc c hc := by
  set u : Kˣ := Additive.toMul (Quotient.out (Multiplicative.toAdd y))
  have hyu : y = squareClassHom u := by
    rw [squareClassHom_apply, squareClass_toMul_out]; rfl
  have hu : (u : K) ≠ 0 := u.ne_zero
  have hu' : Units.mk0 (u : K) hu = u := Units.ext rfl
  rw [hyu, ← hu'] at hy ⊢
  have hns : ¬ IsSquare (u : K) := fun h => hy ((squareClassHom_eq_one_iff hu).2 h)
  have := isSquare_mul_of_not _ _ hu hc hns hcns
  have h' : squareClassHom (Units.mk0 (u : K) hu * (Units.mk0 c hc)⁻¹) = 1 := by
    rw [← MonoidHom.mem_ker, ker_squareClassHom, Subgroup.mem_square]
    obtain ⟨r, hr⟩ := this
    have hr0 : r ≠ 0 := by rintro rfl; exact mul_ne_zero hu hc (by rw [hr, mul_zero])
    refine ⟨Units.mk0 (r / c) (div_ne_zero hr0 hc), Units.ext ?_⟩
    simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0]
    field_simp
    linear_combination hr
  rw [map_mul, map_inv, mul_inv_eq_one] at h'
  exact h'

/-- **Kernel of the spinor norm.** For `c` a nonzero square, `classClosure Q c = ker θ`. -/
theorem classClosure_iff_spinor_eq_one {c : K} (hc : c ≠ 0) (hcsq : IsSquare c) (g : V ≃ₗ[K] V)
    (hg : g ∈ orthGroup Q) :
    g ∈ classClosure Q c ↔
      CliffordAlgebra.orthogonalSpinorNorm Q (QuadraticMap.nondegenerate_polar_iff.mp hQ) ⟨g, hg⟩ = 1 := by
  have hsc : sc c hc = 1 := (squareClassHom_eq_one_iff hc).2 hcsq
  rw [classClosure_spinor h2 h3 hQ hc g hg, hsc]
  constructor
  · rintro (⟨h, -⟩ | ⟨h, -⟩) <;> exact h
  · intro h
    rcases det_eq_one_or_neg_one h2 h3 hQ hg with hd | hd
    · exact Or.inl ⟨h, hd⟩
    · exact Or.inr ⟨h, hd⟩

/-- **Kernel of the product of the spinor norm and the determinant.** For `c` a nonsquare,
`classClosure Q c` consists of the `g` with `θ g = 1 ↔ det g = 1`. -/
theorem classClosure_iff_spinor_det {c : K} (hc : c ≠ 0) (hcns : ¬ IsSquare c) (g : V ≃ₗ[K] V)
    (hg : g ∈ orthGroup Q) :
    g ∈ classClosure Q c ↔
      (CliffordAlgebra.orthogonalSpinorNorm Q (QuadraticMap.nondegenerate_polar_iff.mp hQ) ⟨g, hg⟩ = 1 ↔
        LinearEquiv.det g = 1) := by
  have hsc : sc c hc ≠ 1 := fun h => hcns ((squareClassHom_eq_one_iff hc).1 h)
  have hn1 := neg_one_ne_one_units h2
  rw [classClosure_spinor h2 h3 hQ hc g hg]
  constructor
  · rintro (⟨h, hd⟩ | ⟨h, hd⟩)
    · exact ⟨fun _ => hd, fun _ => h⟩
    · rw [h, hd]
      exact ⟨fun h' => absurd h' hsc, fun h' => absurd h' hn1⟩
  · intro h
    rcases det_eq_one_or_neg_one h2 h3 hQ hg with hd | hd
    · exact Or.inl ⟨h.2 hd, hd⟩
    · refine Or.inr ⟨eq_sc_of_ne_one h2 h3 hQ hc hcns _ fun h1 => hn1 ?_, hd⟩
      rw [← hd, h.1 h1]

end Kernel

end CFSGOutside.HallOrthogonal
