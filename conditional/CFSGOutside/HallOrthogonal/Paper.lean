import CFSGOutside.HallOrthogonal.Weyl
import CFSGOutside.HallOrthogonal.Shear
import CFSGOutside.Corpus.ZSUseInput

/-!
# Hall (2008), Theorem 1.1, orthogonal case

C. Hall, *Big symplectic or orthogonal monodromy modulo `ℓ`*, Duke Math. J. 141 (2008), no. 1, 179–203,
DOI 10.1215/S0012-7094-08-14115-8, Theorem 1.1 (p. 2):

> Let `V` be an `F_ℓ`-vector space together with a perfect pairing `V × V → F_ℓ` and let `G ≤ GL(V)` be an
> irreducible primitive subgroup which preserves the pairing. If the pairing is symmetric, `G` contains a
> reflection and an isotropic shear, and `ℓ ≥ 5`, then `G` is one of the following:
> 1. the full orthogonal group `O(V)`;
> 2. the kernel of the spinor norm;
> 3. the kernel of the product of the spinor norm and the determinant.

The pairing is the polar form of `Q`; `O(V)` is `orthogonalGroup Q`; the spinor norm is TauCeti's
`CliffordAlgebra.orthogonalSpinorNorm`, with values in the square classes `F_ℓ^×/F_ℓ^×²`, a group of order
two. The product of the spinor norm and the determinant is taken in that group of order two: its kernel
consists of the `g` with `θ g = 1 ↔ det g = 1`.

The proof follows Hall §3. It shows that the subgroup `R` generated by the reflections is irreducible (Lemma 3.2
with primitivity). It finds two reflections whose product has order `ℓ` (Lemma 3.6). It then reads `R` off the
Zalesskiĭ–Serežkin classification, eliminating the other families by Lemmas 3.6 and 3.7, and finally passes
from `R` to `G`.
-/

namespace CFSGOutside.HallOrthogonal

open Module QuadraticMap
open CFSGOutside.Corpus.ClassicalGroups.Orthogonal (reflect)
open CFSGOutside.Corpus.StandardType.ZS

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

variable {ℓ : ℕ} [hℓp : Fact ℓ.Prime] {V : Type} [AddCommGroup V] [Module (ZMod ℓ) V]
  [FiniteDimensional (ZMod ℓ) V]

/-- **The reflection subgroup.** Under Hall's hypotheses, the subgroup `R` generated by the reflections of
`G` is `O(V)` or the group generated by the reflections of one norm class. -/
theorem reflGroup_eq [CFSGOutside.Corpus.ZSUseInput] [CFSGOutside.Corpus.GGSecFiveRootRefl]
    [CFSGOutside.Corpus.GGSecFiveCoxProd] (hℓ : 5 ≤ ℓ) {Q : QuadraticForm (ZMod ℓ) V}
    (hQ : (polarBilin Q).Nondegenerate) {G : Subgroup (V ≃ₗ[ZMod ℓ] V)} (hGO : G ≤ orthGroup Q)
    (hirr : IsIrreducible G) (hprim : IsPrimitive G) (hrefl : ∃ g ∈ G, IsReflection Q g)
    (hshear : ∃ σ ∈ G, IsIsotropicShear Q σ) :
    (∀ g, g ∈ reflGroup Q G ↔ g ∈ orthGroup Q) ∨
      ∃ c : ZMod ℓ, c ≠ 0 ∧ reflGroup Q G = classClosure Q c := by
  have h2 := two_ne_zero_of hℓ
  obtain ⟨t, htG, htR⟩ := hrefl
  have hT : ∃ t, t ∈ reflSet Q G := ⟨t, htG, htR⟩
  obtain ⟨σ, hσG, hσ⟩ := hshear
  set R := reflGroup Q G
  have hRO : R ≤ orthGroup Q := reflGroup_le.trans hGO
  have hRirr : IsIrreducible R := reflGroup_irreducible h2 hQ hGO hirr hprim hT
  have hdim : 4 ≤ finrank (ZMod ℓ) V := four_le_finrank h2 hQ hσ
  obtain ⟨a, ha, rfl⟩ := (isReflection_iff h2 hQ).1 htR
  have haR : reflect Q a ∈ R := Subgroup.subset_closure ⟨htG, htR⟩
  -- Lemma 3.6
  obtain ⟨b, c, hb, hc, hbR, hcR, hbc⟩ :=
    exists_reflect_mul_orderOf h2 hQ (p := ℓ) (by omega) hGO hRirr hT hσG hσ
  have hpair : ∃ x ∈ R, ∃ y ∈ R, IsRefl ℓ x ∧ IsRefl ℓ y ∧ orderOf (x * y) = ℓ :=
    ⟨_, hbR, _, hcR, (isInvRankOne_iff h2 hQ (reflect_mem Q b)).2 ⟨b, hb, rfl⟩,
      (isInvRankOne_iff h2 hQ (reflect_mem Q c)).2 ⟨c, hc, rfl⟩, hbc⟩
  -- the hypotheses of Zalesskiĭ–Serežkin
  have hgen : ReflGen ℓ R := by
    apply le_antisymm
    · refine (Subgroup.closure_le _).2 fun g hg => Subgroup.subset_closure ⟨Subgroup.subset_closure hg, ?_⟩
      obtain ⟨d, hd, rfl⟩ := (isReflection_iff h2 hQ).1 hg.2
      exact (isInvRankOne_iff h2 hQ (reflect_mem Q d)).2 ⟨d, hd, rfl⟩
    · exact (Subgroup.closure_le _).2 fun g hg => hg.1
  have habs : AbsIrred ℓ R := ⟨hRirr.2, fun T hT' => commute_eq_scalar h2 hRirr ha haR T hT'⟩
  have hF : Family ℓ R :=
    CFSGOutside.Corpus.ZSUseInput.useInput_holds ℓ V R (by omega) (by omega) hgen habs
  rcases family_cases hℓ hQ hRO hRirr ha haR hdim hpair hF with hW | hO | hC
  · exact absurd hW (not_linWeyl hℓ hQ hRO hRirr hdim hpair)
  · exact Or.inl hO
  · exact Or.inr hC

/-- **Hall, Theorem 1.1, orthogonal case.** Let `V` be a vector space over `F_ℓ`, `ℓ ≥ 5`, with the
nondegenerate symmetric pairing given by the polar form of `Q`. Let `G ≤ O(V)` be irreducible and primitive and
contain a reflection and an isotropic shear. Then `G` is `O(V)`, the kernel of the spinor norm, or the kernel of
the product of the spinor norm and the determinant. -/
theorem theorem_1_1_orthogonal [CFSGOutside.Corpus.ZSUseInput] [CFSGOutside.Corpus.GGSecFiveRootRefl]
    [CFSGOutside.Corpus.GGSecFiveCoxProd] [CFSGOutside.Corpus.ReflectMulReflectClosure]
    [Invertible (2 : ZMod ℓ)] (hℓ : 5 ≤ ℓ)
    (Q : QuadraticForm (ZMod ℓ) V) (hQ : (polarBilin Q).Nondegenerate)
    (G : Subgroup (V ≃ₗ[ZMod ℓ] V)) (hGO : G ≤ orthGroup Q) (hirr : IsIrreducible G)
    (hprim : IsPrimitive G) (hrefl : ∃ g ∈ G, IsReflection Q g)
    (hshear : ∃ σ ∈ G, IsIsotropicShear Q σ) :
    G = orthGroup Q ∨
      (∀ g (hg : g ∈ orthGroup Q), g ∈ G ↔
        CliffordAlgebra.orthogonalSpinorNorm Q (nondegenerate_polar_iff.mp hQ) ⟨g, hg⟩ = 1) ∨
      (∀ g (hg : g ∈ orthGroup Q), g ∈ G ↔
        (CliffordAlgebra.orthogonalSpinorNorm Q (nondegenerate_polar_iff.mp hQ) ⟨g, hg⟩ = 1 ↔
          LinearEquiv.det g = 1)) := by
  have h2 := two_ne_zero_of hℓ
  have h3 := three_ne_zero_of hℓ
  have hRG : reflGroup Q G ≤ G := reflGroup_le
  rcases reflGroup_eq hℓ hQ hGO hirr hprim hrefl hshear with hO | ⟨c, hc, hRc⟩
  · left
    exact le_antisymm hGO fun g hg => hRG ((hO g).2 hg)
  · -- `G` lies between the class closure and `O(V)`, of index two
    by_cases hGC : ∀ g ∈ G, g ∈ classClosure Q c
    · have hGeq : ∀ g, g ∈ G ↔ g ∈ classClosure Q c :=
        fun g => ⟨hGC g, fun h => hRG (hRc ▸ h)⟩
      right
      by_cases hcsq : IsSquare c
      · left
        intro g hg
        rw [hGeq, classClosure_iff_spinor_eq_one h2 h3 hQ hc hcsq g hg]
      · right
        intro g hg
        rw [hGeq, classClosure_iff_spinor_det h2 h3 hQ hc hcsq g hg]
    · left
      push Not at hGC
      obtain ⟨g, hgG, hgC⟩ := hGC
      obtain ⟨s, hsO, hss, hdec, -⟩ := exists_index_two h2 h3 hQ hc
      have hCG : ∀ h ∈ classClosure Q c, h ∈ G := fun h hh => hRG (hRc ▸ hh)
      have hsg := (hdec g (hGO hgG)).resolve_left hgC
      have hsG : s ∈ G := by
        have := G.mul_mem (hCG _ hsg) (G.inv_mem hgG)
        rwa [mul_inv_cancel_right] at this
      refine le_antisymm hGO fun h hh => ?_
      rcases hdec h hh with hhC | hshC
      · exact hCG h hhC
      · have := G.mul_mem (G.inv_mem hsG) (hCG _ hshC)
        rwa [inv_mul_cancel_left] at this

end CFSGOutside.HallOrthogonal
