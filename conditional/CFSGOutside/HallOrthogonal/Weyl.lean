import CFSGOutside.HallOrthogonal.Families
import CFSGOutside.Corpus.GGSecFiveRootRefl
import CFSGOutside.Corpus.GGSecFiveCoxProd

/-!
# Hall (2008), Theorem 1.1, orthogonal case: the Weyl family

Let `A ≤ O(V)` be irreducible with `dim V ≥ 4`, and suppose `A` contains two reflections whose product has
order `p ≥ 5`. Then `A` is not a Weyl group acting by reflections (`LinWeyl p A`).

* Type `G₂` has two simple reflections. Their roots span an `A`-invariant subspace of dimension at most `2`.
* In every other type, embed `A` in the affine group `G = V ⋊ A` with `B* = V`. Since `A ≤ O(V)` contains no
  transvections, the corpus says every reflection of `A` is a Coxeter reflection
  (`Corpus.GGSecFiveRootRefl`), and a product of two Coxeter reflections has order at most `4`
  (`Corpus.GGSecFiveCoxProd`).
-/

namespace CFSGOutside.HallOrthogonal

open Module QuadraticMap
open CFSGOutside.Corpus.ClassicalGroups.Orthogonal (reflect)
open CFSGOutside.Corpus.StandardType CFSGOutside.Corpus.StandardType.ZS CFSGOutside.Corpus.Open

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

variable {p : ℕ} [hp : Fact p.Prime] {U : Type} [AddCommGroup U] [Module (ZMod p) U]
  [FiniteDimensional (ZMod p) U] {Q : QuadraticForm (ZMod p) U}

section Span

/-- The span of the roots of finitely many reflections is invariant under the group they generate. -/
theorem span_isInvariant {ι : Type} (a : ι → U) :
    IsInvariant (Subgroup.closure (Set.range fun i => reflect Q (a i)))
      (Submodule.span (ZMod p) (Set.range a)) := by
  set W := Submodule.span (ZMod p) (Set.range a)
  have hgen : ∀ i, ∀ w ∈ W, reflect Q (a i) w ∈ W := by
    intro i w hw
    by_cases hai : Q (a i) = 0
    · rw [reflect_of_eq_zero Q hai]; exact hw
    · rw [reflect_apply Q hai]
      exact W.sub_mem hw (W.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩))
  intro g hg
  induction hg using Subgroup.closure_induction'' with
  | mem g hg => obtain ⟨i, rfl⟩ := hg; exact hgen i
  | inv_mem g hg => obtain ⟨i, rfl⟩ := hg; rw [reflect_inv]; exact hgen i
  | one => intro w hw; exact hw
  | mul g h _ _ hg' hh' => intro w hw; exact hg' _ (hh' w hw)

/-- A linear Weyl group with fewer simple reflections than the dimension is not irreducible. -/
theorem linWeyl_card_false (h2 : (2 : ZMod p) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
    {A : Subgroup (U ≃ₗ[ZMod p] U)} (hAO : A ≤ orthGroup Q) (hirr : IsIrreducible A) {ι : Type}
    [Fintype ι] {M : CoxeterMatrix ι} (f : M.Group ≃* ↥A)
    (hf : ∀ i, IsRefl p (f (M.simple i) : U ≃ₗ[ZMod p] U)) (hcard : Fintype.card ι < finrank (ZMod p) U) (hdim2 : 2 ≤ finrank (ZMod p) U) :
    False := by
  have hroot : ∀ i, ∃ a, Q a ≠ 0 ∧ (f (M.simple i) : U ≃ₗ[ZMod p] U) = reflect Q a := fun i =>
    (isInvRankOne_iff h2 hQ (hAO (f (M.simple i)).2)).1 (hf i)
  choose a ha hfa using hroot
  -- `A` is generated by the simple reflections
  have hAle : A ≤ Subgroup.closure (Set.range fun i => reflect Q (a i)) := by
    intro g hg
    have hw : f.symm ⟨g, hg⟩ ∈ Subgroup.closure (Set.range M.simple) := by
      rw [← CoxeterMatrix.toCoxeterSystem_simple, CoxeterSystem.subgroup_closure_range_simple]
      trivial
    have hmap := Subgroup.mem_map_of_mem (A.subtype.comp f.toMonoidHom) hw
    rw [MonoidHom.map_closure] at hmap
    have hg' : (A.subtype.comp f.toMonoidHom) (f.symm ⟨g, hg⟩) = g := by
      simp
    rw [hg'] at hmap
    convert hmap using 2
    ext x
    simp only [Set.mem_range, Set.mem_image, MonoidHom.coe_comp, Subgroup.coe_subtype,
      MulEquiv.coe_toMonoidHom, Function.comp_apply]
    constructor
    · rintro ⟨i, rfl⟩; exact ⟨M.simple i, ⟨i, rfl⟩, hfa i⟩
    · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, (hfa i).symm⟩
  have hinv : IsInvariant A (Submodule.span (ZMod p) (Set.range a)) :=
    fun g hg => span_isInvariant (Q := Q) a g (hAle hg)
  rcases hirr.2 _ hinv with h | h
  · -- no simple reflections: `A` is trivial, contradicting irreducibility in dimension `≥ 1`
    by_cases hι : Nonempty ι
    · obtain ⟨i⟩ := hι
      have : a i ∈ Submodule.span (ZMod p) (Set.range a) := Submodule.subset_span ⟨i, rfl⟩
      rw [h, Submodule.mem_bot] at this
      exact ha i (by rw [this, QuadraticMap.map_zero])
    · rw [not_nonempty_iff] at hι
      rw [Fintype.card_eq_zero] at hcard
      obtain ⟨v, hv⟩ := Module.finrank_pos_iff_exists_ne_zero.mp hcard
      have hinv' : IsInvariant A ((ZMod p) ∙ v) := by
        intro g hg w hw
        have : g = 1 := by
          have h1 := hAle hg
          rw [Set.range_eq_empty, Subgroup.closure_empty, Subgroup.mem_bot] at h1
          exact h1
        rw [this]; exact hw
      rcases hirr.2 _ hinv' with h' | h'
      · exact hv ((Submodule.span_singleton_eq_bot).1 h')
      · have := finrank_span_singleton (K := ZMod p) hv
        rw [h', finrank_top] at this
        omega
  · have := finrank_range_le_card (R := ZMod p) (b := a)
    rw [Set.finrank, h, finrank_top] at this
    omega

end Span


noncomputable section Affine

variable [Finite U] (A : Subgroup (U ≃ₗ[ZMod p] U))

/-- The action of `A` on `Multiplicative U`. -/
noncomputable def actHom : ↥A →* MulAut (Multiplicative U) where
  toFun a := AddEquiv.toMultiplicative ((a : U ≃ₗ[ZMod p] U).toAddEquiv)
  map_one' := by ext x; rfl
  map_mul' a b := by ext x; rfl

theorem actHom_apply (a : ↥A) (u : U) :
    actHom A a (Multiplicative.ofAdd u) = Multiplicative.ofAdd ((a : U ≃ₗ[ZMod p] U) u) := rfl

/-- The affine group `V ⋊ A`. -/
noncomputable abbrev Aff := Multiplicative U ⋊[actHom A] ↥A

instance : Finite (Multiplicative U) := Finite.of_equiv U Multiplicative.ofAdd

instance : Finite (U ≃ₗ[ZMod p] U) :=
  Finite.of_injective (fun g : U ≃ₗ[ZMod p] U => (g : U → U)) fun g h hgh =>
    LinearEquiv.ext fun x => congrFun hgh x

instance : Finite (Aff A) :=
  Finite.of_injective (fun x : Aff A => (x.left, x.right)) fun x y h => by
    simp only [Prod.mk.injEq] at h
    exact SemidirectProduct.ext h.1 h.2

/-- `B* = V` inside the affine group. -/
def bstar : Subgroup (Aff A) := (SemidirectProduct.inl : Multiplicative U →* Aff A).range

instance bstar_normal : (bstar A).Normal := by
  rw [bstar, SemidirectProduct.range_inl_eq_ker_rightHom]
  infer_instance

/-- `Multiplicative U ≃* B*`. -/
noncomputable def eB : Multiplicative U ≃* ↥(bstar A) :=
  MonoidHom.ofInjective SemidirectProduct.inl_injective

theorem eB_coe (n : Multiplicative U) : ((eB A n : ↥(bstar A)) : Aff A) = SemidirectProduct.inl n :=
  rfl

/-- The automorphism of `B*` induced by `a ∈ A`. -/
noncomputable def Ψ : ↥A →* MulAut ↥(bstar A) where
  toFun a := ((eB A).symm.trans (actHom A a)).trans (eB A)
  map_one' := MulEquiv.ext fun b => by
    simp only [MulEquiv.trans_apply, map_one, MulAut.one_apply, MulEquiv.apply_symm_apply]
  map_mul' a b := MulEquiv.ext fun x => by
    simp only [MulEquiv.trans_apply, map_mul, MulAut.mul_apply, MulEquiv.symm_apply_apply]

theorem Ψ_eB (a : ↥A) (n : Multiplicative U) : Ψ A a (eB A n) = eB A (actHom A a n) := by
  simp [Ψ]

theorem eB_surj (b : ↥(bstar A)) : ∃ n, b = eB A n := ⟨(eB A).symm b, by simp⟩

theorem Ψ_injective : Function.Injective (Ψ A) := by
  rw [injective_iff_map_eq_one]
  intro a ha
  apply Subtype.ext
  apply LinearEquiv.ext
  intro u
  have := congrArg (fun φ : MulAut ↥(bstar A) => φ (eB A (Multiplicative.ofAdd u))) ha
  simp only [Ψ_eB, MulAut.one_apply] at this
  have := congrArg Multiplicative.toAdd ((eB A).injective this)
  simpa [actHom_apply] using this

theorem mem_normalizer_bstar (g : Aff A) : g ∈ Subgroup.normalizer ((bstar A : Subgroup (Aff A)) : Set (Aff A)) := by
  rw [Subgroup.mem_normalizer_iff]
  intro h
  constructor
  · intro hh; exact (bstar_normal A).conj_mem h hh g
  · intro hh
    have := (bstar_normal A).conj_mem _ hh g⁻¹
    rwa [show g⁻¹ * (g * h * g⁻¹) * g⁻¹⁻¹ = h by group] at this

theorem Ψ_mem_ggInduced (a : ↥A) : Ψ A a ∈ ggInduced ⊤ (bstar A) := by
  refine ⟨SemidirectProduct.inr a, trivial, mem_normalizer_bstar A _, ?_⟩
  · intro b
    obtain ⟨n, rfl⟩ := eB_surj A b
    rw [Ψ_eB, eB_coe, eB_coe, SemidirectProduct.inl_aut, map_inv]

theorem eq_Ψ_of_mem_ggInduced {ψ : MulAut ↥(bstar A)} (hψ : ψ ∈ ggInduced ⊤ (bstar A)) :
    ∃ a, ψ = Ψ A a := by
  obtain ⟨g, -, -, hg⟩ := hψ
  refine ⟨g.right, MulEquiv.ext fun b => Subtype.ext ?_⟩
  obtain ⟨n, rfl⟩ := eB_surj A b
  rw [hg, Ψ_eB, eB_coe, eB_coe]
  conv_lhs => rw [← SemidirectProduct.inl_left_mul_inr_right g]
  rw [show SemidirectProduct.inl g.left * SemidirectProduct.inr g.right * SemidirectProduct.inl n *
      (SemidirectProduct.inl g.left * SemidirectProduct.inr g.right)⁻¹ =
      SemidirectProduct.inl g.left * (SemidirectProduct.inr g.right * SemidirectProduct.inl n *
        (SemidirectProduct.inr g.right)⁻¹) * (SemidirectProduct.inl g.left)⁻¹ by group]
  rw [← map_inv SemidirectProduct.inr, ← SemidirectProduct.inl_aut, ← map_inv, ← map_mul, ← map_mul,
    mul_comm, inv_mul_cancel_left]

theorem isElemAbelian_bstar : IsElemAbelian p (bstar A) := by
  refine ⟨⟨⟨fun x y => ?_⟩⟩, fun x hx => ?_⟩
  · obtain ⟨m, rfl⟩ := eB_surj A x
    obtain ⟨n, rfl⟩ := eB_surj A y
    rw [← map_mul, ← map_mul, mul_comm]
  · obtain ⟨n, rfl⟩ := hx
    rw [← map_pow]
    have : n ^ p = 1 := by
      apply Multiplicative.toAdd.injective
      rw [toAdd_pow, toAdd_one]
      rw [← Nat.cast_smul_eq_nsmul (ZMod p), ZMod.natCast_self, zero_smul]
    rw [this, map_one]

/-- Fixed points of `Ψ a` correspond to the fixed space of `a`. -/
theorem card_fix_Ψ (a : ↥A) :
    Nat.card {b : ↥(bstar A) // Ψ A a b = b} = Nat.card (fixSpace (a : U ≃ₗ[ZMod p] U)) := by
  refine Nat.card_congr
    { toFun := fun b => ⟨Multiplicative.toAdd ((eB A).symm b.1), ?_⟩
      invFun := fun u => ⟨eB A (Multiplicative.ofAdd u.1), ?_⟩
      left_inv := fun b => by apply Subtype.ext; simp
      right_inv := fun u => by apply Subtype.ext; simp }
  · obtain ⟨b, hb⟩ := b
    obtain ⟨n, rfl⟩ := eB_surj A b
    rw [Ψ_eB] at hb
    have := congrArg Multiplicative.toAdd ((eB A).injective hb)
    change ((((a : U ≃ₗ[ZMod p] U) : U →ₗ[ZMod p] U) - LinearMap.id : U →ₗ[ZMod p] U) _) = 0
    simp only [MulEquiv.symm_apply_apply]
    rw [LinearMap.sub_apply, LinearEquiv.coe_coe, LinearMap.id_apply, sub_eq_zero]
    simpa [actHom] using this
  · obtain ⟨u, hu⟩ := u
    change ((((a : U ≃ₗ[ZMod p] U) : U →ₗ[ZMod p] U) - LinearMap.id : U →ₗ[ZMod p] U) u) = 0 at hu
    rw [LinearMap.sub_apply, LinearEquiv.coe_coe, LinearMap.id_apply, sub_eq_zero] at hu
    rw [Ψ_eB, actHom_apply, hu]

theorem card_bstar : Nat.card ↥(bstar A) = p ^ finrank (ZMod p) U := by
  rw [← Nat.card_congr (eB A).toEquiv, Nat.card_congr Multiplicative.toAdd,
    Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod]

theorem card_fixSpace (g : U ≃ₗ[ZMod p] U) :
    Nat.card (fixSpace g) = p ^ finrank (ZMod p) (fixSpace g) := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod]

theorem finrank_fix_add_one {g : U ≃ₗ[ZMod p] U}
    (hg : finrank (ZMod p) (LinearMap.range ((g : U →ₗ[ZMod p] U) - LinearMap.id)) = 1) :
    finrank (ZMod p) (fixSpace g) + 1 = finrank (ZMod p) U := by
  have h := LinearMap.finrank_range_add_finrank_ker ((g : U →ₗ[ZMod p] U) - LinearMap.id)
  change _ + finrank (ZMod p) (fixSpace g) = _ at h
  omega

/-- A reflection of `U` induces a reflection of `B*`. -/
theorem ggIsReflection_Ψ {a : ↥A} (ha : IsRefl p (a : U ≃ₗ[ZMod p] U)) :
    GGIsReflection p (Ψ A a) := by
  refine ⟨?_, ?_⟩
  · have : a * a = 1 := Subtype.ext ha.1
    rw [pow_two, ← map_mul, this, map_one]
  · rw [card_fix_Ψ, card_fixSpace, card_bstar, ← pow_succ, finrank_fix_add_one ha.2]

/-- Conversely, a reflection or transvection of `B*` comes from an `a` with `rank (a - 1) = 1`. -/
theorem finrank_range_of_card {a : ↥A}
    (h : Nat.card {b : ↥(bstar A) // Ψ A a b = b} * p = Nat.card ↥(bstar A)) :
    finrank (ZMod p) (LinearMap.range (((a : U ≃ₗ[ZMod p] U) : U →ₗ[ZMod p] U) - LinearMap.id)) = 1 := by
  rw [card_fix_Ψ, card_fixSpace, card_bstar, ← pow_succ] at h
  have h' := Nat.pow_right_injective hp.out.two_le h
  have hr := LinearMap.finrank_range_add_finrank_ker
    (((a : U ≃ₗ[ZMod p] U) : U →ₗ[ZMod p] U) - LinearMap.id)
  change _ + finrank (ZMod p) (fixSpace (a : U ≃ₗ[ZMod p] U)) = _ at hr
  omega

theorem ggNoTransvection_bstar (hp5 : 5 ≤ p) (hQ : (polarBilin Q).Nondegenerate)
    (hAO : A ≤ orthGroup Q) : GGNoTransvection p (bstar A) := by
  intro ψ hψ ⟨hcard, hsq⟩
  obtain ⟨a, rfl⟩ := eq_Ψ_of_mem_ggInduced A hψ
  have h2 := two_ne_zero_of hp5
  obtain ⟨w, φ, hw, hφ, hx⟩ :=
    exists_rankOne ((a : U ≃ₗ[ZMod p] U) : U →ₗ[ZMod p] U) (finrank_range_of_card A hcard)
  replace hx : ∀ x, (a : U ≃ₗ[ZMod p] U) x = x + φ x • w := fun x => hx x
  -- `(a - 1)² = 0` gives `φ w = 0`
  have hφw : φ w = 0 := by
    obtain ⟨x, hxφ⟩ : ∃ x, φ x ≠ 0 := by
      by_contra hc; push Not at hc; exact hφ (LinearMap.ext hc)
    have := hsq (eB A (Multiplicative.ofAdd x))
    rw [← map_inv, Ψ_eB, ← map_mul, Ψ_eB] at this
    have h1 := congrArg Multiplicative.toAdd ((eB A).injective this)
    simp only [actHom, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_mul, toAdd_inv, toAdd_ofAdd] at h1
    change (a : U ≃ₗ[ZMod p] U) (-x + (a : U ≃ₗ[ZMod p] U) x) =
      -x + (a : U ≃ₗ[ZMod p] U) x at h1
    rw [hx x, neg_add_cancel_left, map_smul, hx w, smul_add, smul_smul, add_eq_left] at h1
    rcases smul_eq_zero.mp h1 with h | h
    · exact (mul_eq_zero.mp h).resolve_left hxφ
    · exact absurd h hw
  exact transvection_not_isometry h2 hQ hw hφ hφw fun z => by
    rw [← hx]; exact TauCeti.QuadraticMap.map_app_of_mem_orthogonalGroup (hAO a.2) z

end Affine

/-- **The Weyl family is excluded.** -/
theorem not_linWeyl [hRR : CFSGOutside.Corpus.GGSecFiveRootRefl]
    [hCP : CFSGOutside.Corpus.GGSecFiveCoxProd] (hp5 : 5 ≤ p) (hQ : (polarBilin Q).Nondegenerate)
    {A : Subgroup (U ≃ₗ[ZMod p] U)} (hAO : A ≤ orthGroup Q) (hirr : IsIrreducible A)
    (hdim : 4 ≤ finrank (ZMod p) U)
    (hpair : ∃ x ∈ A, ∃ y ∈ A, IsRefl p x ∧ IsRefl p y ∧ orderOf (x * y) = p) :
    ¬ LinWeyl p A := by
  rintro ⟨ι, M, hM, f, hf⟩
  haveI : Finite U := Module.finite_of_finite (ZMod p)
  have h2 := two_ne_zero_of hp5
  obtain ⟨x, hxA, y, hyA, hx, hy, hxy⟩ := hpair
  by_cases hG2 : ∃ e : Fin 2 ≃ ι, M = CoxeterMatrix.G₂.reindex e
  · obtain ⟨e, -⟩ := hG2
    haveI : Fintype ι := Fintype.ofEquiv _ e
    exact linWeyl_card_false h2 hQ hAO hirr f hf
      (by rw [← Fintype.card_congr e, Fintype.card_fin]; omega) (by omega)
  · -- the affine group
    have hinj := Ψ_injective A
    let A' : Subgroup (MulAut ↥(bstar A)) := (Ψ A).range
    have hA' : A' ≤ ggInduced ⊤ (bstar A) := by
      rintro _ ⟨a, rfl⟩
      exact Ψ_mem_ggInduced A a
    let e' : ↥A ≃* ↥A' := MonoidHom.ofInjective hinj
    let f' : M.Group ≃* ↥A' := f.trans e'
    have hf' : ∀ i, GGIsReflection p ((f' (M.simple i) : ↥A') : MulAut ↥(bstar A)) :=
      fun i => ggIsReflection_Ψ A (hf i)
    have hroot := hRR.ggSecFiveRootReflInput_holds (Aff A) p (bstar A) hp.out (by omega)
      (isElemAbelian_bstar A) (ggNoTransvection_bstar A hp5 hQ hAO) A' hA' ι M hM hG2 f' hf'
    have hcox : ∀ z : ↥A, IsRefl p (z : U ≃ₗ[ZMod p] U) →
        ∃ (i : ι) (g : M.Group), z = f (g * M.simple i * g⁻¹) := by
      intro z hz
      obtain ⟨i, g, hig⟩ := hroot (e' z) (ggIsReflection_Ψ A hz)
      refine ⟨i, g, ?_⟩
      apply e'.injective
      rw [hig]
      rfl
    obtain ⟨i, g, hxg⟩ := hcox ⟨x, hxA⟩ hx
    obtain ⟨j, h, hyh⟩ := hcox ⟨y, hyA⟩ hy
    have hle := hCP.ggSecFiveCoxProdInput_holds ι M hM hG2 i j g h
    have hord : orderOf ((⟨x, hxA⟩ : ↥A) * ⟨y, hyA⟩) ≤ 4 := by
      rw [hxg, hyh, ← map_mul, MulEquiv.orderOf_eq]
      exact hle
    rw [← Subgroup.orderOf_coe, Subgroup.coe_mul, hxy] at hord
    omega

end CFSGOutside.HallOrthogonal
