import CFSGOutside.HallOrthogonal.Basic

/-!
# Hall (2008), Theorem 1.1, orthogonal case: the reflection subgroup is irreducible

`R ⊴ G` is the subgroup generated by the reflections of `G`. Hall's Lemma 3.2 says that a minimal nonzero
`R`-invariant `W` is nondegenerate and `V` is the direct sum of its distinct `G`-translates. When `G` is
primitive this forces `W = V`, so `R` is irreducible. Since its roots are eigenvectors of every endomorphism
commuting with `R`, `R` is then absolutely irreducible.
-/

namespace CFSGOutside.HallOrthogonal

open Module QuadraticMap
open CFSGOutside.Corpus.ClassicalGroups.Orthogonal (reflect)

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {Q : QuadraticForm K V}

/-- The reflections of `G`. -/
def reflSet (Q : QuadraticForm K V) (G : Subgroup (V ≃ₗ[K] V)) : Set (V ≃ₗ[K] V) :=
  {t | t ∈ G ∧ IsReflection Q t}

/-- `R`, the subgroup generated by the reflections of `G`. -/
def reflGroup (Q : QuadraticForm K V) (G : Subgroup (V ≃ₗ[K] V)) : Subgroup (V ≃ₗ[K] V) :=
  Subgroup.closure (reflSet Q G)

variable {G : Subgroup (V ≃ₗ[K] V)}

theorem inv_apply_apply (g : V ≃ₗ[K] V) (x : V) : g⁻¹ (g x) = x := by
  rw [← LinearEquiv.mul_apply, inv_mul_cancel]; rfl

theorem apply_inv_apply (g : V ≃ₗ[K] V) (x : V) : g (g⁻¹ x) = x := by
  rw [← LinearEquiv.mul_apply, mul_inv_cancel]; rfl

theorem reflGroup_le : reflGroup Q G ≤ G :=
  (Subgroup.closure_le _).2 fun _ ht => ht.1

section Conj

variable [FiniteDimensional K V] (h2 : (2 : K) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
  (hGO : G ≤ orthGroup Q)
include h2 hQ hGO

theorem conj_mem_reflSet {g t : V ≃ₗ[K] V} (hg : g ∈ G) (ht : t ∈ reflSet Q G) :
    g * t * g⁻¹ ∈ reflSet Q G := by
  obtain ⟨htG, htR⟩ := ht
  obtain ⟨a, ha, rfl⟩ := (isReflection_iff h2 hQ).1 htR
  refine ⟨G.mul_mem (G.mul_mem hg htG) (G.inv_mem hg), ?_⟩
  rw [reflect_conj (hGO hg)]
  exact (isReflection_iff h2 hQ).2 ⟨g a, by
    rwa [TauCeti.QuadraticMap.map_app_of_mem_orthogonalGroup (hGO hg)], rfl⟩

theorem conj_mem_reflGroup {g r : V ≃ₗ[K] V} (hg : g ∈ G) (hr : r ∈ reflGroup Q G) :
    g * r * g⁻¹ ∈ reflGroup Q G := by
  induction hr using Subgroup.closure_induction with
  | mem t ht => exact Subgroup.subset_closure (conj_mem_reflSet h2 hQ hGO hg ht)
  | one => simp
  | mul a b _ _ ha hb =>
    have : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [this]; exact Subgroup.mul_mem _ ha hb
  | inv a _ ha =>
    have : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [this]; exact Subgroup.inv_mem _ ha

theorem isInvariant_map {W : Submodule K V} (hW : IsInvariant (reflGroup Q G) W)
    {g : V ≃ₗ[K] V} (hg : g ∈ G) :
    IsInvariant (reflGroup Q G) (W.map (g : V →ₗ[K] V)) := by
  rintro r hr _ ⟨w, hw, rfl⟩
  have hc : g⁻¹ * r * g⁻¹⁻¹ ∈ reflGroup Q G := conj_mem_reflGroup h2 hQ hGO (G.inv_mem hg) hr
  rw [inv_inv] at hc
  refine ⟨_, hW _ hc w hw, ?_⟩
  simp only [LinearEquiv.coe_coe, LinearEquiv.mul_apply, apply_inv_apply]

end Conj

/-- A minimal nonzero invariant subspace inside a nonzero invariant subspace. -/
theorem exists_minimal [FiniteDimensional K V] (H : Subgroup (V ≃ₗ[K] V))
    (U : Submodule K V) (hU : U ≠ ⊥) (hUinv : IsInvariant H U) :
    ∃ W ≤ U, W ≠ ⊥ ∧ IsInvariant H W ∧
      ∀ W' ≤ W, IsInvariant H W' → W' = ⊥ ∨ W' = W := by
  classical
  have hex : ∃ n, ∃ W ≤ U, W ≠ ⊥ ∧ IsInvariant H W ∧ finrank K W = n :=
    ⟨_, U, le_rfl, hU, hUinv, rfl⟩
  obtain ⟨W, hWU, hW0, hWinv, hWn⟩ := Nat.find_spec hex
  refine ⟨W, hWU, hW0, hWinv, fun W' hW' hW'inv => ?_⟩
  by_cases h0 : W' = ⊥
  · exact Or.inl h0
  right
  have h1 : Nat.find hex ≤ finrank K W' :=
    Nat.find_min' hex ⟨W', hW'.trans hWU, h0, hW'inv, rfl⟩
  exact Submodule.eq_of_le_of_finrank_le hW' (hWn ▸ h1)

theorem finrank_map_equiv [FiniteDimensional K V] (W : Submodule K V) (g : V ≃ₗ[K] V) :
    finrank K (W.map (g : V →ₗ[K] V)) = finrank K W :=
  LinearEquiv.finrank_eq (Submodule.equivMapOfInjective _ g.injective W).symm

theorem map_mul_eq (W : Submodule K V) (g h : V ≃ₗ[K] V) :
    W.map ((g * h : V ≃ₗ[K] V) : V →ₗ[K] V) = (W.map (h : V →ₗ[K] V)).map (g : V →ₗ[K] V) := by
  rw [← Submodule.map_comp]; rfl

section Lemma32

variable [FiniteDimensional K V] (h2 : (2 : K) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
  (hGO : G ≤ orthGroup Q)
include h2 hQ hGO

theorem isInvariant_iSup_translates (W : Submodule K V) :
    IsInvariant G (⨆ g : G, W.map ((g : V ≃ₗ[K] V) : V →ₗ[K] V)) := by
  intro g0 hg0 x hx
  have hle : (⨆ g : G, W.map ((g : V ≃ₗ[K] V) : V →ₗ[K] V)) ≤
      (⨆ g : G, W.map ((g : V ≃ₗ[K] V) : V →ₗ[K] V)).comap (g0 : V →ₗ[K] V) :=
    iSup_le fun g => by
      rintro _ ⟨w, hw, rfl⟩
      exact Submodule.mem_iSup_of_mem ⟨g0 * g, G.mul_mem hg0 g.2⟩ ⟨w, hw, rfl⟩
  exact hle hx

/-- **Hall, Lemma 3.2.** If `W` is a minimal nonzero `R`-invariant subspace, then `V` is the direct sum of
the distinct `G`-translates of `W`. -/
theorem minimal_decomp (hGirr : IsIrreducible G) (hT : ∃ t, t ∈ reflSet Q G) (W : Submodule K V)
    (hW0 : W ≠ ⊥) (hWinv : IsInvariant (reflGroup Q G) W)
    (hWmin : ∀ W' ≤ W, IsInvariant (reflGroup Q G) W' → W' = ⊥ ∨ W' = W) :
    sSupIndep (translates G W) ∧ sSup (translates G W) = ⊤ := by
  classical
  have hRG := reflGroup_le (Q := Q) (G := G)
  have hpol : ∀ g ∈ G, ∀ x y, polar Q (g x) (g y) = polar Q x y :=
    fun g hg => TauCeti.QuadraticMap.polar_apply_of_mem_orthogonalGroup (hGO hg)
  have hTR : ∀ t ∈ reflSet Q G, t ∈ reflGroup Q G := fun t ht => Subgroup.subset_closure ht
  have hform : ∀ t ∈ reflSet Q G, ∃ a, Q a ≠ 0 ∧ t = reflect Q a :=
    fun t ht => (isReflection_iff h2 hQ).1 ht.2
  set U : Submodule K V := ⨆ g : G, W.map ((g : V ≃ₗ[K] V) : V →ₗ[K] V) with hU
  have hWU : W ≤ U := fun w hw => Submodule.mem_iSup_of_mem (1 : G) ⟨w, hw, rfl⟩
  have hUtop : U = ⊤ := (hGirr.2 U (isInvariant_iSup_translates h2 hQ hGO W)).resolve_left
    fun h => hW0 (le_bot_iff.1 (h ▸ hWU))
  -- (i) some reflection acts nontrivially on `W`
  have hS : ∃ t ∈ reflSet Q G, ∃ w ∈ W, t w ≠ w := by
    by_contra hc
    push Not at hc
    obtain ⟨t, ht⟩ := hT
    obtain ⟨a, ha, rfl⟩ := hform t ht
    have hfix : ∀ x ∈ U, reflect Q a x = x := by
      intro x hx
      refine Submodule.iSup_induction _ (motive := fun x => reflect Q a x = x) hx ?_ ?_ ?_
      · rintro g _ ⟨w, hw, rfl⟩
        have hc' := hc _ (conj_mem_reflSet h2 hQ hGO (G.inv_mem g.2) ht) w hw
        rw [inv_inv] at hc'
        simp only [LinearEquiv.mul_apply] at hc'
        have := congrArg (g : V ≃ₗ[K] V) hc'
        simpa [apply_inv_apply] using this
      · simp
      · intro x y hx hy
        rw [map_add, hx, hy]
    have := hfix a (hUtop ▸ Submodule.mem_top)
    rw [reflect_apply_self Q ha] at this
    have h2a : (2 : K) • a = 0 := by
      rw [two_smul]
      nth_rewrite 1 [← this]
      rw [neg_add_cancel]
    rcases smul_eq_zero.mp h2a with h | h
    · exact h2 h
    · exact ha (by rw [h, QuadraticMap.map_zero])
  -- the roots of reflections moving `W`
  let S : Set (V ≃ₗ[K] V) := {t | t ∈ reflSet Q G ∧ ∃ w ∈ W, t w ≠ w}
  have hroot : ∀ t ∈ S, ∃ a ∈ W, Q a ≠ 0 ∧ t = reflect Q a ∧ ∃ w ∈ W, polar Q a w ≠ 0 := by
    rintro t ⟨htT, w, hw, htw⟩
    obtain ⟨a, ha, rfl⟩ := hform t htT
    have hpw : polar Q a w ≠ 0 := fun h0 => htw (by
      rw [reflect_apply Q ha, h0, zero_div, zero_smul, sub_zero])
    have haW : a ∈ W := by
      have h1 : reflect Q a w - w ∈ W := sub_mem (hWinv _ (hTR _ htT) w hw) hw
      rw [reflect_apply Q ha, sub_sub_cancel_left] at h1
      have := W.smul_mem (-(polar Q a w / Q a))⁻¹ h1
      rwa [← neg_smul, smul_smul, inv_mul_cancel₀ (neg_ne_zero.2 (div_ne_zero hpw ha)),
        one_smul] at this
    exact ⟨a, haW, ha, rfl, w, hw, hpw⟩
  have hrange : ∀ t ∈ S, ∀ y, t y - y ∈ W := by
    intro t htS y
    obtain ⟨a, haW, ha, rfl, -⟩ := hroot t htS
    rw [reflect_apply Q ha, sub_sub_cancel_left]
    exact W.neg_mem (W.smul_mem _ haW)
  let U2 : Submodule K V := Submodule.span K {x | ∃ t ∈ S, ∃ y, x = t y - y}
  have hU2W : U2 ≤ W := Submodule.span_le.2 (by rintro _ ⟨t, htS, y, rfl⟩; exact hrange t htS y)
  have hU2inv : IsInvariant (reflGroup Q G) U2 := by
    intro r hr x hx
    have hle : U2 ≤ U2.comap (r : V →ₗ[K] V) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨t, ⟨htT, w, hw, htw⟩, y, rfl⟩
      refine Submodule.subset_span ⟨r * t * r⁻¹, ⟨conj_mem_reflSet h2 hQ hGO (hRG hr) htT,
        r w, hWinv r hr w hw, ?_⟩, r y, ?_⟩
      · simp only [LinearEquiv.mul_apply, inv_apply_apply]
        intro h
        apply htw
        have := congrArg (r⁻¹ : V ≃ₗ[K] V) h
        rwa [inv_apply_apply, inv_apply_apply] at this
      · simp only [SetLike.mem_coe, Submodule.mem_comap, LinearEquiv.coe_coe, map_sub,
          LinearEquiv.mul_apply, inv_apply_apply]
    exact hle hx
  have hU2ne : U2 ≠ ⊥ := by
    obtain ⟨t, htT, w, hw, htw⟩ := hS
    intro h
    have : t w - w ∈ U2 := Submodule.subset_span ⟨t, ⟨htT, w, hw, htw⟩, w, rfl⟩
    rw [h, Submodule.mem_bot, sub_eq_zero] at this
    exact htw this
  have hU2 : U2 = W := (hWmin U2 hU2W hU2inv).resolve_left hU2ne
  -- vectors orthogonal to every root moving `W` are orthogonal to `W`
  have hspan : ∀ x, (∀ t ∈ S, t x = x) → ∀ u ∈ W, polar Q u x = 0 := by
    intro x hx u hu
    have hle : U2 ≤ LinearMap.ker ((polarBilin Q).flip x) := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨t, htS, y, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, LinearMap.flip_apply,
        polarBilin_apply_apply]
      have h1 := hpol t htS.1.1 y x
      rw [hx t htS] at h1
      rw [h1, sub_self]
    have := hle (hU2.symm ▸ hu)
    simpa using this
  -- (iii) `W` is nondegenerate
  have hrad : ∀ x ∈ W, (∀ u ∈ W, polar Q u x = 0) → x = 0 := by
    let Rd : Submodule K V := W ⊓ LinearMap.BilinForm.orthogonal (polarBilin Q) W
    have hRdinv : IsInvariant (reflGroup Q G) Rd := by
      rintro r hr x ⟨hxW, hxo⟩
      refine ⟨hWinv r hr x hxW, ?_⟩
      rw [SetLike.mem_coe, LinearMap.BilinForm.mem_orthogonal_iff] at hxo ⊢
      intro n hn
      have h1 := hpol r (hRG hr) (r⁻¹ n) x
      rw [apply_inv_apply] at h1
      change polarBilin Q n (r x) = 0
      rw [polarBilin_apply_apply, h1]
      have := hxo _ (hWinv _ (Subgroup.inv_mem _ hr) n hn)
      rwa [polarBilin_apply_apply] at this
    rcases hWmin Rd inf_le_left hRdinv with h | h
    · intro x hxW hx
      have : x ∈ Rd := ⟨hxW, (LinearMap.BilinForm.mem_orthogonal_iff).2 fun n hn => by
        rw [polarBilin_apply_apply]; exact hx n hn⟩
      rw [h] at this
      exact (Submodule.mem_bot K).1 this
    · exfalso
      obtain ⟨t, htT, w, hw, htw⟩ := hS
      obtain ⟨a, haW, -, -, w', hw', hpw⟩ := hroot t ⟨htT, w, hw, htw⟩
      have haRd : a ∈ Rd := h ▸ haW
      have := (LinearMap.BilinForm.mem_orthogonal_iff).1 haRd.2 w' hw'
      rw [polarBilin_apply_apply, polar_comm] at this
      exact hpw this
  -- (iv) distinct translates are orthogonal to `W`
  have horth : ∀ g ∈ G, W.map (g : V →ₗ[K] V) ≠ W →
      ∀ x ∈ W.map (g : V →ₗ[K] V), ∀ u ∈ W, polar Q u x = 0 := by
    intro g hg hne x hx u hu
    have hdisj : W.map (g : V →ₗ[K] V) ⊓ W = ⊥ := by
      have hinv : IsInvariant (reflGroup Q G) (W.map (g : V →ₗ[K] V) ⊓ W) :=
        fun r hr y hy => ⟨isInvariant_map h2 hQ hGO hWinv hg r hr y hy.1, hWinv r hr y hy.2⟩
      refine (hWmin _ inf_le_right hinv).resolve_right fun h => hne ?_
      have hle : W ≤ W.map (g : V →ₗ[K] V) := by
        intro y hy
        have : y ∈ W.map (g : V →ₗ[K] V) ⊓ W := by rw [h]; exact hy
        exact this.1
      exact (Submodule.eq_of_le_of_finrank_le hle (finrank_map_equiv W g).le).symm
    have hfix : ∀ t ∈ S, t x = x := by
      intro t htS
      have h1 : t x - x ∈ W.map (g : V →ₗ[K] V) ⊓ W :=
        ⟨sub_mem (isInvariant_map h2 hQ hGO hWinv hg t (hTR t htS.1) x hx) hx, hrange t htS x⟩
      rw [hdisj, Submodule.mem_bot, sub_eq_zero] at h1
      exact h1
    exact hspan x hfix u hu
  -- (v) the distinct translates are pairwise orthogonal
  have hpair : ∀ g1 g2 : G, W.map ((g1 : V ≃ₗ[K] V) : V →ₗ[K] V) ≠
      W.map ((g2 : V ≃ₗ[K] V) : V →ₗ[K] V) →
      ∀ a ∈ W.map ((g1 : V ≃ₗ[K] V) : V →ₗ[K] V),
      ∀ b ∈ W.map ((g2 : V ≃ₗ[K] V) : V →ₗ[K] V), polar Q a b = 0 := by
    intro g1 g2 hne a ha b hb
    set h : V ≃ₗ[K] V := (g1 : V ≃ₗ[K] V)⁻¹ * g2
    have hhG : h ∈ G := G.mul_mem (G.inv_mem g1.2) g2.2
    have hg2 : (g2 : V ≃ₗ[K] V) = g1 * h := by simp [h]
    have hhne : W.map (h : V →ₗ[K] V) ≠ W := by
      intro heq
      apply hne
      rw [hg2, map_mul_eq, heq]
    obtain ⟨m, hm, rfl⟩ := ha
    obtain ⟨w, hw, rfl⟩ := hb
    simp only [LinearEquiv.coe_coe]
    rw [hg2, LinearEquiv.mul_apply, hpol _ g1.2]
    exact horth h hhG hhne _ ⟨w, hw, rfl⟩ m hm
  have hindep : sSupIndep (translates G W) := by
    rintro a ⟨g1, rfl⟩
    rw [Submodule.disjoint_def]
    intro x hx hxs
    have hle : sSup (translates G W \ {W.map ((g1 : V ≃ₗ[K] V) : V →ₗ[K] V)}) ≤
        LinearMap.BilinForm.orthogonal (polarBilin Q) (W.map ((g1 : V ≃ₗ[K] V) : V →ₗ[K] V)) := by
      refine sSup_le ?_
      rintro b ⟨⟨g2, rfl⟩, hb⟩
      intro y hy
      rw [LinearMap.BilinForm.mem_orthogonal_iff]
      intro n hn
      rw [polarBilin_apply_apply]
      exact hpair g1 g2 (fun h => hb (h ▸ rfl)) n hn y hy
    have hxo := (LinearMap.BilinForm.mem_orthogonal_iff).1 (hle hxs)
    obtain ⟨m, hm, rfl⟩ := hx
    have hm0 : m = 0 := hrad m hm fun u hu => by
      have := hxo _ ⟨u, hu, rfl⟩
      rw [polarBilin_apply_apply] at this
      simp only [LinearEquiv.coe_coe] at this
      rwa [hpol _ g1.2] at this
    rw [hm0, map_zero]
  refine ⟨hindep, ?_⟩
  rw [translates, sSup_range]
  exact hUtop

/-- **Hall, Lemma 3.2 with primitivity.** The reflection subgroup `R` is irreducible. -/
theorem reflGroup_irreducible (hGirr : IsIrreducible G) (hprim : IsPrimitive G)
    (hT : ∃ t, t ∈ reflSet Q G) : IsIrreducible (reflGroup Q G) := by
  refine ⟨hGirr.1, fun U hU => ?_⟩
  by_cases h0 : U = ⊥
  · exact Or.inl h0
  right
  obtain ⟨W, hWU, hW0, hWinv, hWmin⟩ := exists_minimal _ U h0 hU
  by_contra hWtop'
  have hWtop : W ≠ ⊤ := fun h => hWtop' (top_le_iff.1 (h ▸ hWU))
  exact hprim W hW0 hWtop (minimal_decomp h2 hQ hGO hGirr hT W hW0 hWinv hWmin)

end Lemma32

section AbsIrred

variable (h2 : (2 : K) ≠ 0) (hQ : (polarBilin Q).Nondegenerate)
include h2

theorem mem_span_of_reflect_eq_neg {a x : V} (ha : Q a ≠ 0) (hx : reflect Q a x = -x) :
    ∃ c : K, x = c • a := by
  rw [reflect_apply Q ha] at hx
  refine ⟨(polar Q a x / Q a) / 2, ?_⟩
  have : (2 : K) • x = (polar Q a x / Q a) • a := by
    rw [two_smul]
    nth_rewrite 1 [← neg_neg x]
    rw [← hx]
    abel
  rw [div_eq_inv_mul, mul_smul, ← this, smul_smul, inv_mul_cancel₀ h2, one_smul]

/-- An irreducible group containing a reflection has only scalar commuting endomorphisms. -/
theorem commute_eq_scalar {H : Subgroup (V ≃ₗ[K] V)} (hirr : IsIrreducible H) {a : V}
    (ha : Q a ≠ 0) (haH : reflect Q a ∈ H) (T : Module.End K V)
    (hT : ∀ h ∈ H, T ∘ₗ (h : V →ₗ[K] V) = (h : V →ₗ[K] V) ∘ₗ T) :
    ∃ c : K, T = c • LinearMap.id := by
  have hTa : reflect Q a (T a) = -(T a) := by
    have := congrArg (fun f : Module.End K V => f a) (hT _ haH)
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, reflect_apply_self Q ha, map_neg] at this
    exact this.symm
  obtain ⟨c, hc⟩ := mem_span_of_reflect_eq_neg h2 ha hTa
  refine ⟨c, ?_⟩
  let E : Submodule K V := LinearMap.ker (T - c • LinearMap.id)
  have hEinv : IsInvariant H E := by
    intro h hh x hx
    rw [LinearMap.mem_ker] at hx ⊢
    have := congrArg (fun f : Module.End K V => f x) (hT h hh)
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at this
    rw [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply] at hx ⊢
    rw [this, sub_eq_zero.1 hx, map_smul, sub_self]
  have haE : a ∈ E := by
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply, hc,
      sub_self]
  rcases hirr.2 E hEinv with h | h
  · exfalso
    have : a ∈ (⊥ : Submodule K V) := h ▸ haE
    exact ha (by rw [(Submodule.mem_bot K).1 this, QuadraticMap.map_zero])
  · ext x
    have hx : x ∈ E := h ▸ Submodule.mem_top
    rw [LinearMap.mem_ker, LinearMap.sub_apply, sub_eq_zero] at hx
    exact hx

end AbsIrred

end CFSGOutside.HallOrthogonal
