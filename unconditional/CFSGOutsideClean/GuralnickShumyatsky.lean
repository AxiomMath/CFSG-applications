/-!
# Guralnick–Shumyatsky, Theorems 3.1 and 3.6

R. Guralnick and P. Shumyatsky, *Derived subgroups of fixed points*, Israel J. Math. 126 (2001),
345–362, DOI 10.1007/BF02784161. Let `A` be an elementary abelian group of order `q³` acting coprimely on a
finite group `G`, realised as subgroups `A`, `G` of a finite group `X` with `A` normalizing `G`. Every corpus
input of the fast build is supplied by an instance in `CFSGOutsideClean.Corpus`, so the statements below have
no hypotheses beyond the paper's. `IsSylowOf` is the copy of `CFSG.ABGLocalTools.IsSylowOf`, equal to it by
`CFSGOutsideClean.Corpus.isSylowOf_iff`.
-/

namespace CFSGOutsideClean.GuralnickShumyatsky

open CFSGOutside.GuralnickShumyatsky Subgroup

/-- **Derived subgroups of fixed points.** Let A be an elementary abelian group of order q³, q prime, acting coprimely
on a finite group G, and write C_G(a)′ for the derived subgroup of the centralizer of a. For every prime p and every
A-invariant Sylow p-subgroup P of G, P ∩ G′ is generated by the subgroups P ∩ C_G(a)′ with a ≠ 1. Consequently G′ is
generated by the C_G(a)′ with a ≠ 1, a prime divides |G′| exactly when it divides some |C_G(a)′|, |G′| ≤
m^(2(q²+q+1)) when every |C_G(a)′| ≤ m, and G′ is generated by m(q²+q+1) elements when every C_G(a)′ is generated by
m.

Source: R. M. Guralnick and P. Shumyatsky, Derived subgroups of fixed points, Israel J. Math. 126 (2001), 345–362,
Theorems 3.1 and 3.6, Corollaries 3.3–3.5. https://doi.org/10.1007/BF02784161 -/
theorem theorem_3_1 {X : Type} [Group X] [Finite X] {q p : ℕ} [Fact p.Prime]
    {G A P : Subgroup X} (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3) (hP : IsSylowOf p P G)
    (hAP : A ≤ normalizer (P : Set X)) :
    P ⊓ ⁅G, G⁆ = CFSGOutside.GuralnickShumyatsky.gens P G A :=
  CFSGOutside.GuralnickShumyatsky.theorem_3_1 hA hA3 hP hAP

/-- **Guralnick–Shumyatsky, Theorem 3.6 (= Theorem 1.1).** Let `A` be an elementary abelian group
of order `q³` acting coprimely on the finite group `G` (here: subgroups of a finite group `X`,
`A` normalizing `G`, `q ∤ |G|`). If `|C_G(a)'| ≤ m` for every `a ∈ A#`, then
`|G'| ≤ m ^ (2(q² + q + 1))`. -/
theorem theorem_3_6 {X : Type} [Group X] [Finite X] {q m : ℕ} {G A : Subgroup X}
    (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3)
    (hm : ∀ a ∈ A, a ≠ 1 → Nat.card (⁅cen G a, cen G a⁆ : Subgroup X) ≤ m) :
    Nat.card (⁅G, G⁆ : Subgroup X) ≤ m ^ (2 * (q ^ 2 + q + 1)) :=
  CFSGOutside.GuralnickShumyatsky.theorem_3_6 hA hA3 hm

/-- **Guralnick–Shumyatsky, Corollary 3.3.** Under the same hypotheses,
`π(G') = ⋃_{a ∈ A#} π(C_G(a)')`. -/
theorem corollary_3_3 {X : Type} [Group X] [Finite X] {q : ℕ} {G A : Subgroup X}
    (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3) (p : ℕ) (hp : p.Prime) :
    p ∣ Nat.card (⁅G, G⁆ : Subgroup X) ↔
      ∃ a ∈ A, a ≠ 1 ∧ p ∣ Nat.card (⁅cen G a, cen G a⁆ : Subgroup X) :=
  CFSGOutside.GuralnickShumyatsky.corollary_3_3 hA hA3 p hp

/-- **Guralnick–Shumyatsky, Corollary 3.4.** If `A` is elementary abelian of order `q³` and acts
coprimely on the finite group `G`, then `G' = ⟨C_G(a)' | a ∈ A#⟩`. -/
theorem corollary_3_4 {X : Type} [Group X] [Finite X] {q : ℕ} {G A : Subgroup X}
    (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3) :
    ⁅G, G⁆ = ⨆ (a : X) (_ : a ∈ A) (_ : a ≠ 1), ⁅cen G a, cen G a⁆ :=
  CFSGOutside.GuralnickShumyatsky.corollary_3_4 hA hA3

/-- **Guralnick–Shumyatsky, Corollary 3.5.** If `A` is elementary abelian of order `q³` acting
coprimely on the finite group `G` and each `C_G(a)'` (`a ∈ A#`) can be generated by at most `m`
elements, then `G'` can be generated by at most `m(q² + q + 1)` elements. -/
theorem corollary_3_5 {X : Type} [Group X] [Finite X] {q m : ℕ} {G A : Subgroup X}
    (hA : CopAct q G A) (hA3 : Nat.card A = q ^ 3)
    (hm : ∀ a ∈ A, a ≠ 1 → ∃ s : Finset X, s.card ≤ m ∧
      closure (s : Set X) = ⁅cen G a, cen G a⁆) :
    ∃ s : Finset X, s.card ≤ m * (q ^ 2 + q + 1) ∧ closure (s : Set X) = ⁅G, G⁆ :=
  CFSGOutside.GuralnickShumyatsky.corollary_3_5 hA hA3 hm

end CFSGOutsideClean.GuralnickShumyatsky
