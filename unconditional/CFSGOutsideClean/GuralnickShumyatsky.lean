import CFSGOutside.GuralnickShumyatsky.Paper
import CFSGOutsideClean.Corpus.CfsgClassification
import CFSGOutsideClean.Corpus.Defs.ElemThompson
import CFSGOutsideClean.Corpus.ExistsConjEqOfIsSylowOfNormalizedOfCoprime
import CFSGOutsideClean.Corpus.ExistsIsSylowOfNormalizedGeOfCoprime
import CFSGOutsideClean.Corpus.ExistsIsSylowOfNormalizedOfCoprime
import CFSGOutsideClean.Corpus.Gaschutz
