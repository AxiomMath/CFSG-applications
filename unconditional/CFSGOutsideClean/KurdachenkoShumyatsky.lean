import Comparator.Solution
import CFSGOutside.KurdachenkoShumyatsky.Paper
import CFSGOutsideClean.Corpus.MinimalNormalSimpleFactors
import CFSGOutsideClean.Corpus.OddOrder
import CFSGOutsideClean.Corpus.Schreier

/-!
# Kurdachenko–Shumyatsky, Lemma `schrei` (clean path)

L. A. Kurdachenko, P. Shumyatsky, *The ranks of central factor and commutator groups*, Math. Proc.
Cambridge Philos. Soc. 154 (2013), 63–69, DOI 10.1017/S0305004112000412 (arXiv:1204.4641).
The classification statement is supplied by the corpus, `CFSGComparator.classification`, and the corpus
theorems by the instances in `CFSGOutsideClean.Corpus`.
-/

open CFSGOutside.KurdachenkoShumyatsky

/-- **Ranks of finite groups.** Let G be a finite group of rank r, so that every subgroup of G can be generated by r
elements, whose only soluble normal subgroup is trivial. Then G has normal subgroups M ≤ T such that M is a direct
product of at most r nonabelian simple groups, T/M is soluble, and |G : T| ≤ r!.

Source: L. A. Kurdachenko and P. Shumyatsky, The ranks of central factor and commutator groups, Math. Proc.
Cambridge Philos. Soc. 154 (2013), 63–69, lemma before the proof of Theorem 1.
https://doi.org/10.1017/S0305004112000412 -/
theorem CFSGOutsideClean.KurdachenkoShumyatsky.schrei {G : Type} [Group G] [Finite G]
    {r : ℕ} (hr : rank G = r)
    (hrad : ∀ N : Subgroup G, N.Normal → Group.IsSolvable N → N = ⊥) :
    ∃ (M T : Subgroup G) (_ : M.Normal) (_ : T.Normal), M ≤ T ∧
      (∃ (ι : Type) (_ : Fintype ι) (S : ι → Type) (_ : ∀ i, Group (S i)),
        Fintype.card ι ≤ r ∧ (∀ i, IsSimpleGroup (S i)) ∧
        (∀ i, ∃ a b : S i, a * b ≠ b * a) ∧ Nonempty (M ≃* ((i : ι) → S i))) ∧
      Group.IsSolvable (T ⧸ M.subgroupOf T) ∧ Nat.card (G ⧸ T) ≤ r.factorial :=
  CFSGOutside.KurdachenkoShumyatsky.schrei CFSGComparator.classification.{0} hr hrad
