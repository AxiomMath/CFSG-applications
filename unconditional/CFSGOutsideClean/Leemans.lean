/-! Leemans (2006), Theorem 1, with the corpus theorems on `Sz(q)` supplied. `Sz(q)` is the copy
`CFSGOutside.Corpus.suzukiGroup` of `CFSG.Blueprint.suzukiGroup`, and `inner` is the copy of
`CFSG.ComponentClassification.OuterAutomorphisms.inner`; they equal the originals by
`CFSGOutsideClean.Corpus.suzukiGroup_eq` and
`CFSGOutsideClean.Corpus.ComponentClassification.OuterAutomorphisms.inner_eq`. -/

open CFSGOutside.Corpus (suzukiGroup)
open CFSGOutside.Corpus.ComponentClassification
open CFSGOutside.Leemans (IsCGroup IsStringCGroup)

namespace CFSGOutsideClean.Leemans

variable {a : ℕ} {K : Type} [Field K] [Finite K]

theorem eq_inner_of_closure_involutions
    (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G)
    (X : Set (MulAut (suzukiGroup a K))) (hX : ∀ x ∈ X, orderOf x = 2)
    (hgen : Subgroup.closure X = G) : G = OuterAutomorphisms.inner (suzukiGroup a K) :=
  CFSGOutside.Leemans.eq_inner_of_closure_involutions ha hK G hG X hX hgen

theorem leemans_suzuki (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G)
    {n : ℕ} (ρ : Fin n → G) (hρ : IsStringCGroup ρ) :
    G = OuterAutomorphisms.inner (suzukiGroup a K) ∧ n = 3 :=
  CFSGOutside.Leemans.leemans_suzuki ha hK G hG ρ hρ

theorem exists_isStringCGroup_inner (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1)) :
    ∃ ρ : Fin 3 → OuterAutomorphisms.inner (suzukiGroup a K), IsStringCGroup ρ :=
  CFSGOutside.Leemans.exists_isStringCGroup_inner ha hK

/-- **Polytopes of Suzuki groups.** Let q = 2^(2a+1) with a ≥ 1 and let G be a group of automorphisms of the Suzuki
group Sz(q) containing all inner automorphisms. Then G is generated by a tuple of involutions with the intersection
property ⟨ρᵢ : i ∈ I⟩ ∩ ⟨ρⱼ : j ∈ J⟩ = ⟨ρₖ : k ∈ I ∩ J⟩ if and only if G is the inner automorphism group, the same
holds for string C-group representations (where ρᵢ and ρⱼ commute whenever |i − j| ≥ 2), and every string C-group
representation of Sz(q) has exactly 3 generators.

Source: D. Leemans, Almost simple groups of Suzuki type acting on polytopes, Proc. Amer. Math. Soc. 134 (2006),
3649–3651, Theorem 1. https://doi.org/10.1090/S0002-9939-06-08448-6 -/
theorem leemans_theorem_1 (ha : 1 ≤ a) (hK : Nat.card K = 2 ^ (2 * a + 1))
    (G : Subgroup (MulAut (suzukiGroup a K))) (hG : OuterAutomorphisms.inner (suzukiGroup a K) ≤ G) :
    ((∃ (n : ℕ) (ρ : Fin n → G), IsCGroup ρ) ↔ G = OuterAutomorphisms.inner (suzukiGroup a K)) ∧
      ((∃ (n : ℕ) (ρ : Fin n → G), IsStringCGroup ρ) ↔ G = OuterAutomorphisms.inner (suzukiGroup a K)) ∧
      ∀ (n : ℕ) (ρ : Fin n → G), IsStringCGroup ρ → n = 3 :=
  CFSGOutside.Leemans.leemans_theorem_1 ha hK G hG

end CFSGOutsideClean.Leemans
